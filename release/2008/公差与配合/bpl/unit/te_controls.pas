procedure TTeBitmap.Draw(DC: HDC; DstRect, SrcRect: TRect; Transparent: boolean = false);
var
  SrcW, SrcH, DstW, DstH: integer;
  R: TRect;
  SFX, SFY: integer;
  B, F: PKColor;
  DstX, DstY, SrcX: integer;
  SX, SY: integer;
  DX, DY: integer;
  FP: PKColor;
  Alpha: byte;
  BitmapW, BitmapH, BitmapBCount: integer;
  BitmapBits: PKColorArray;
  P: TPoint;
begin
  BitmapBits := GetBitmapBitsFromDeviceContext(DC, BitmapW, BitmapH, BitmapBCount);
  if (BitmapBits <> nil) and (BitmapBCount = 32) then
  begin
    { Ajust WindowOrg }
    GetWindowOrgEx(DC, P);
    OffsetRect(DstRect, -P.X, -P.Y);
    { Draw to DIB }
    IntersectRect(R, SrcRect, Rect(0, 0, FWidth, FHeight));
    if (RectWidth(R) <= 0) or (RectHeight(R) <= 0) then Exit;
    if (RectWidth(DstRect) <= 0) or (RectHeight(DstRect) <= 0) then Exit;
    IntersectRect(R, DstRect, Rect(0, 0, BitmapW, BitmapH));
    if (RectWidth(R) <= 0) or (RectHeight(R) <= 0) then Exit;

    SrcW := RectWidth(SrcRect);
    SrcH := RectHeight(SrcRect);
    DstW := RectWidth(DstRect);
    DstH := RectHeight(DstRect);

    SFX := MulDiv((R.Left - DstRect.Left) * SrcW, 65535, DstW);
    SFY := MulDiv((R.Top - DstRect.Top) * SrcH, 65535, DstH);

    DX := (SrcW shl 16) div DstW;
    DY := (SrcH shl 16) div DstH;
    SY := SFY;

    if Transparent then
    begin
      { Transparent }
      for DstY := R.Top to R.Bottom - 1 do
      begin
        F := @Bits[SrcRect.Left + (SY shr 16 + SrcRect.Top) * FWidth];
        B := @BitmapBits[R.Left + (({BitmapH - }DstY) * BitmapW)];
        SX := SFX;
        for DstX := R.Left to R.Right - 1 do
        begin
          SrcX := SX shr 14 and $FFFFFFFC;
          Inc(SX, DX);
          { Get fore pixel }
          FP := PKColor(Integer(F) + SrcX);
          { Transparent }
          if (FP^ and not AlphaMask) <> ckTransparent then
            B^ := FP^;

          Inc(B);
        end;
        Inc(SY, DY);
      end;
    end
    else
    begin
      { Copy }
      for DstY := R.Top to R.Bottom - 1 do
      begin
        F := @Bits[SrcRect.Left + (SY shr 16 + SrcRect.Top) * FWidth];
        B := @BitmapBits[R.Left + (({BitmapH - }DstY) * BitmapW)];
        SX := SFX;
        for DstX := R.Left to R.Right - 1 do
        begin
          SrcX := SX shr 14 and $FFFFFFFC;
          Inc(SX, DX);
          { Get fore pixel }
          FP := PKColor(Integer(F) + SrcX);
          { Copy }
          B^ := FP^;

          Inc(B);
        end;
        Inc(SY, DY);
      end;
    end
  end
  else
  begin
    { Draw to DC }
    if Transparent then
    begin
      if @TransparentBltFunc <> nil then
        TransparentBltFunc(DC, DstRect.Left, DstRect.Top, RectWidth(DstRect), RectHeight(DstRect),
          FDC, SrcRect.Left, SrcRect.Top, RectWidth(SrcRect), RectHeight(SrcRect), ckTransparent)
      else
        _TransparentBltFunc(DC, DstRect.Left, DstRect.Top, RectWidth(DstRect), RectHeight(DstRect),
          Self, SrcRect.Left, SrcRect.Top, RectWidth(SrcRect), RectHeight(SrcRect), ckTransparent);
    end
    else
      StretchBlt(DC, DstRect.Left, DstRect.Top, RectWidth(DstRect), RectHeight(DstRect),
        FDC, SrcRect.Left, SrcRect.Top, RectWidth(SrcRect), RectHeight(SrcRect), SRCCOPY);
  end;
{  if Transparent then
  begin
    if @TransparentBlt <> nil then
      TransparentBlt(DC, DstRect.Left, DstRect.Top, RectWidth(DstRect), RectHeight(DstRect),
        FDC, SrcRect.Left, SrcRect.Top, RectWidth(SrcRect), RectHeight(SrcRect), ckTransparent)
    else
      StretchBltTransparent(DC, DstRect.Left, DstRect.Top, RectWidth(DstRect), RectHeight(DstRect),
        Self, SrcRect.Left, SrcRect.Top, RectWidth(SrcRect), RectHeight(SrcRect), ckTransparent);
  end
  else
    StretchBlt(DC, DstRect.Left, DstRect.Top, RectWidth(DstRect), RectHeight(DstRect),
      FDC, SrcRect.Left, SrcRect.Top, RectWidth(SrcRect), RectHeight(SrcRect), SRCCOPY); }
end;

