  InitWindowsBlend;

  FillChar(BitBtnGlyphs, SizeOf(BitBtnGlyphs), 0);

  BufferWidth := Screen.Width + BufferBorder;
  BufferHeight := Screen.Height + BufferBorder;

  SharedBuffer := TTeBitmap.Create;

  Randomize;

  InitCaptionFont;
  InitSysMenuImages;
  InitSysMetrics;

  InitHintFont;

  HookList := nil;

  VerInfo.dwOsVersionInfoSize := SizeOf(VerInfo);
  GetVersionEx(VerInfo);
  IsWinNt := VerInfo.dwPlatformId = VER_PLATFORM_WIN32_NT;
  IsWin98 := (VerInfo.dwPlatformID = VER_PLATFORM_WIN32_WINDOWS) and
    (VerInfo.dwMinorVersion > 0);
  InitTrueTypeBitmap;

  InitMenuSize;
  InitMenuFont;
  InitSubMenuBitmap;
  RegisterClasses([TTeCustomItem]);

  ClickHandler := TTeClickHandler.CreateHandler;

  FillChar(ButtonWidths, SizeOf(ButtonWidths), 0);
  GlobalMsgComp := TTeCustomMessage.Create(Application);

  RegisterClasses([TTeSpeedContainer, TTeSpeedDivider]);

  User32Lib := LoadLibrary('user32.dll');
  if User32Lib > 0 then
  begin
    _GetScrollBarInfo := GetProcAddress(User32Lib, 'GetScrollBarInfo');
  end;

  RegisterClass(TTeCustomTabSheet);

  RegisterClass(TTeBlending);
  RegisterClass(TTeShadow);
  RegisterClass(TTeGravitation);
  RegisterClass(TTeDragging);
  RegisterClass(TTeFormOptions);
  RegisterClass(TTePopupMenuOptions);
  RegisterClass(TTeAnimation);

  User32Handle := GetModuleHandle(user32);
  MonitorFromRectFunc := GetProcAddress(User32Handle, 'MonitorFromRect');
  MonitorFromPointFunc := GetProcAddress(User32Handle, 'MonitorFromPoint');
  MonitorFromWindowFunc := GetProcAddress(User32Handle, 'MonitorFromWindow');
  GetMonitorInfoFunc := GetProcAddress(User32Handle, 'GetMonitorInfoA');

  CheckNT;

  Sig := Sig;

finalization
  if MSImg32Lib <> 0 then
    FreeLibrary(MSImg32Lib);

  FreeBitmaps;

  SharedBuffer.Free;
  SharedBuffer := nil;

  SysMenuImages.Free;
  SmCaptionFont.Free;
  SmCaptionFont := nil;
  CaptionFont.Free;
  CaptionFont := nil;

  HintFont.Free;

  DropHookList;

  if TrueTypeBmp <> nil then TrueTypeBmp.Free;

  ClickHandler.Free;
  ClickHandler := nil;

  FreeContainerClassList;
  SubMenuBitmap.Free;
  SubMenubitmap := nil;
  MenuFont.Free;
  MenuFont := nil;

  if (GlobalMsgComp <> nil) and (GlobalMsgComp.Owner = Application) then
    FreeAndNil(GlobalMsgComp);

  if User32Lib > 0 then
    FreeLibrary(User32Lib);
  _GetScrollBarInfo := nil;

end.
