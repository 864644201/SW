procedure TTeCustomSpinButton.MouseDown(Button: TMouseButton;
  Shift: TShiftState; X, Y: Integer);
var
  SliderRect: TRect;
begin
  inherited;

  if (mbLeft = Button) and (FEnabledSlider) then
  begin
    SliderRect := Rect(0, FHeight div 2 - 1, FWidth, FHeight div 2 + 1);
    if PtInRect(SliderRect, Point(X, Y)) then
    begin
      FSliderPos := Point(X, Y);
      FSliderActive := true;
    end;
  end;
end;

procedure TTeCustomSpinButton.MouseMove(Shift: TShiftState; X, Y: Integer);
var
  SliderRect: TRect;
  Delta: integer;
begin
  inherited;

  if not FEnabledSlider then Exit;
  
  if FSliderActive then
  begin
    Delta := FSliderPos.Y - Y;
    Position := FPosition + FIncrement * Delta;
  end
  else
  begin
    SliderRect := Rect(0, FHeight div 2 - 1, FWidth, FHeight div 2 + 1);
    if PtInRect(FUpButton.BoundsRect, Point(X, Y)) or
       PtInRect(FDownButton.BoundsRect, Point(X, Y))
    then
      Cursor := crDefault
    else
      Cursor := crSizeNS
  end;
end;

