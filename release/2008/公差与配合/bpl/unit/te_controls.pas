constructor TTeCustomTabControl.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);
  ControlStyle := ControlStyle + [csAcceptsControls, csClickEvents, csDoubleClicks];
  ParentColor := true;

  FTabIndex := -1;

  FTabs := TTeTabStringList.Create;
  TTeTabStringList(FTabs).FTabControl := Self;

  FPages := TTePageList.Create;
  TTePageList(FPages).FTabControl := Self;

  with FTabSize do
  begin
    y := 0;
    x := 0;
  end;

  FMouseOnLeftBtn := false;
  FMouseOnRightBtn := false;
  FMouseOnTabIndex := -1;

  FFirstVisibleTab := 0;

  FTabPosition := tpTop;
  FUpdating := false;
  FScrollOpposite := false;
  FHotTrack := False;
  FMultiLine := False;
  FOwnerDraw := False;
  FTabPosition := tpTop;
  FTabIndex := -1;
  FRaggedRight := false;
  FTransparent := false;

  Width := 289;
  Height := 193;
  TabStop := True;

  Realign;
end;

destructor TTeCustomTabControl.Destroy;
var
  i: integer;
begin
  for i := 0 to FPages.Count - 1 do
    TTeCustomTabSheet(FPages[I]).FTabControl := nil;
  FPages.Free;

  FTabs.Free;
  FRepeatTimer.Free;
  inherited Destroy;
end;

procedure TTeCustomTabControl.Loaded;
begin
  inherited;

  if FUsePages then
  begin
    SetActivePageIndex(GetPageIndexFromTabIndex(FStoredTabIndex));

    UpdateTabRows;
    Realign;
  end;
end;

procedure TTeCustomTabControl.GetChildren(Proc: TGetChildProc; Root: TComponent);
var
  I: Integer;
begin
  if FUsePages then
    for I := 0 to FPages.Count - 1 do Proc(TComponent(FPages[I]))
  else
    inherited ;
end;

procedure TTeCustomTabControl.AddPage(Page: TTeCustomTabSheet);
begin
  if FPages.Count > 0 then
    InsertPage(FPages.Count, Page)
  else
    InsertPage(0, Page);
end;

procedure TTeCustomTabControl.InsertPage(Index: integer; Page: TTeCustomTabSheet);
var
  i, C: integer;
  S: string;
  Unique: boolean;
begin
  FPages.Insert(Index, Page);

  Page.Parent := Self;
  Page.FTabControl := Self;

  if Page.Caption = '' then
    Page.Caption := 'New Page ' + IntToStr(FTabs.Count - 1);

  if (Page.Name = '') and (csDesigning in ComponentState) and (Owner is TForm) then
  begin
    { Make Unique name }
    C := 1;
    Unique := false;
    while not Unique do
    begin
      Unique := true;
      
      S := Copy(Page.ClassName, 2, $FFF) + IntToStr(C);
      for i := 0 to (Owner as TForm).ComponentCount - 1 do
        if (Owner as TForm).Components[i].Name = S then
          Unique := false;

      Inc(C);
    end;
    Page.Name := S;
  end;

  Invalidate;
end;

procedure TTeCustomTabControl.RemovePage(Page: TTeCustomTabSheet);
begin
  if FPages.IndexOf(Page) < 0 then Exit;

  FTabsChanging := true;
  try
    FTabs.Delete(GetTabIndexFromPageIndex(Page.PageIndex));
    FPages.Remove(Page);
  finally
    FTabsChanging := false;
  end;

  Page.FTabControl := nil;

  if FActivePage = Page then
  begin
    if FTabs.Count > 0 then
    begin
      FTabIndex := 0;
      SetActivePageIndex(0);
    end
    else
    begin
      FTabIndex := -1;
      FActivePage := nil;
    end;
  end;

  if not Page.FDestoying then
  begin
    Page.Free;
    Page := nil;
  end;

  Invalidate;
end;

function TTeCustomTabControl.GetTabIndexFromPageIndex(APageIndex: integer): integer;
var
  i: integer;
begin
  Result := -1;
  if FUsePages and (PageCount <= 0) then Exit;
  if APageIndex > FPages.Count then Exit;

  for i := 0 to APageIndex do
  begin
    if Pages[i].PageVisible then
      Inc(Result);
  end;
end;

function TTeCustomTabControl.GetPageIndexFromTabIndex(ATabIndex: integer): integer;
var
  i: integer;
begin
  Result := -1;
  if FUsePages and (PageCount <= 0) then Exit;

  for i := 0 to PageCount - 1 do
  begin
    if Pages[i].PageVisible then
      Inc(Result);

    if Result = ATabIndex then
    begin
      Result := i;
      Exit;
    end;
  end;

  Result := -1;
end;

procedure TTeCustomTabControl.SetActivePage(Page: TTeCustomTabSheet);
begin
  if not Page.PageVisible then
    if FActivePage <> Page then
    begin
      if FActivePage <> nil then
        FActivePage.Visible := false;

      FActivePage := Page;
      FActivePage.Visible := true;
      FActivePage.BringToFront;
      FTabIndex := FActivePage.PageIndex;

      if PageCount > 0 then
         InvalidateTabs;
      Change;
    end
    else
    begin
      FActivePage.Visible := true;
      FActivePage.BringToFront;
    end
  else
    if FActivePage <> Page then
    begin
      if FActivePage <> nil then
        FActivePage.Visible := false;

      FActivePage := Page;
      FActivePage.Visible := true;
      FActivePage.BringToFront;
      FTabIndex := GetTabIndexFromPageIndex(FActivePage.PageIndex);

      InvalidateTabs;
      Change;
    end
    else
    begin
      FActivePage.Visible := true;
      FActivePage.BringToFront;
    end;
end;

procedure TTeCustomTabControl.SetActivePageIndex(const Value: Integer);
begin
  if (Value >= 0) and (Value < FPages.Count) then
    SetActivePage(FPages[Value]);
end;

procedure TTeCustomTabControl.AdjustClientRect(var Rect: TRect);
var
  LBorderRect: TRect;
begin
  inherited;
  LBorderRect := GetBorderRect;
  with Rect do
  begin
    Left := LBorderRect.Left + GetLeftMargin + 1;
    Top := LBorderRect.Top + GetTopMargin + 1;
    Right := LBorderRect.Right - GetRightMargin - 1;
    Bottom := LBorderRect.Bottom - GetBottomMargin - 1;
  end;
end;

procedure TTeCustomTabControl.DrawTabFace(ATabIndex: integer; ATabPosition: TTabPosition; ARect: TRect);
var
  Theme: HTheme;
  Part, tState: integer;
begin
  Canvas.Font.Assign(Self.Font);

  if not UseThemes then
    with ARect do
    begin
      { Default drawing }
      if ATabIndex = TabIndex then
      begin
        case FTabPosition of
          tpLeft: begin
            InflateRect(ARect, 2, 2);
            Dec(ARect.Right, 2);
          end;
          tpTop: begin
            InflateRect(ARect, 2, 2);
            Dec(ARect.Bottom, 2);
          end;
          tpRight: begin
            InflateRect(ARect, 2, 2);
            Inc(ARect.Left, 2);
          end;
          tpBottom: begin
            InflateRect(ARect, 2, 2);
            Inc(ARect.Top, 2);
          end;
        end;
      end;

      { Draw face }
      case ATabPosition of
        tpLeft:
          begin
            FillRoundRect(Canvas, Rect(Left, Top + 1, Right, Bottom - 1), 4, clBtnFace);
            FillRect(Canvas, Rect(Left + 2, Top + 1, Right, Bottom), clBtnFace);

            if Focused and (ATabIndex = TabIndex) then
            begin
              DrawFocusRect(Canvas, Rect(Left + GetLeftMargin + 1, Top + GetTopMargin + 1,
                Right - GetLeftMargin - 1, Bottom - GetTopMargin - 1), clBtnFace);
            end;

            DrawTopLine(Left + 3, Right - 1, Top, Canvas);
            DrawLeftLine(Left, Top + 3, Bottom - 3, Canvas);
            DrawBottomLine(Left + 3, Right - 1, Bottom, Canvas);
            DrawLeftTopCorner(Left, Top, Canvas);
            DrawLeftBottomCorner(Left, Bottom, Canvas);
          end;
        tpTop:
          begin
            FillRoundRect(Canvas, Rect(Left + 1, Top + 1, Right - 1, Bottom), 4, clBtnFace);
            FillRect(Canvas, Rect(Left + 1, Top + 2, Right - 1, Bottom), clBtnFace);

            if Focused and (ATabIndex = TabIndex) then
            begin
              DrawFocusRect(Canvas, Rect(Left + GetLeftMargin + 1, Top + GetTopMargin + 1,
                Right - GetLeftMargin - 1, Bottom - GetTopMargin - 1), clBtnFace);
            end;

            DrawTopLine(Left + 3, Right - 3, Top, Canvas);
            DrawLeftLine(Left, Top + 3, Bottom - 1, Canvas);
            DrawRightLine(Right, Top + 3, Bottom - 1, Canvas);
            DrawLeftTopCorner(Left, Top, Canvas);
            DrawRightTopCorner(Right, Top, Canvas);
          end;
        tpRight:
          begin
            FillRoundRect(Canvas, Rect(Left, Top + 1, Right, Bottom - 1), 4, clBtnFace);
            FillRect(Canvas, Rect(Left, Top + 1, Right - 2, Bottom - 1), clBtnFace);

            if Focused and (ATabIndex = TabIndex) then
            begin
              DrawFocusRect(Canvas, Rect(Left + GetLeftMargin + 1, Top + GetTopMargin + 1,
                Right - GetLeftMargin - 1, Bottom - GetTopMargin - 1), clBtnFace);
            end;

            DrawTopLine(Left, Right - 3, Top, Canvas);
            DrawRightLine(Right, Top + 3, Bottom - 3, Canvas);
            DrawBottomLine(Left + 1, Right - 3, Bottom, Canvas);
            DrawRightTopCorner(Right, Top, Canvas);
            DrawRightBottomCorner(Right, Bottom, Canvas);
          end;
        tpBottom:
          begin
            FillRoundRect(Canvas, Rect(Left + 1, Top, Right - 1, Bottom), 4, clBtnFace);
            FillRect(Canvas, Rect(Left + 1, Top + 2, Right - 1, Bottom), clBtnFace);

            if Focused and (ATabIndex = TabIndex) then
            begin
              DrawFocusRect(Canvas, Rect(Left + GetLeftMargin + 1, Top + GetTopMargin + 1,
                Right - GetLeftMargin - 1, Bottom - GetTopMargin - 1), clBtnFace);
            end;

            DrawLeftLine(Left, Top, Bottom - 3, Canvas);
            DrawRightLine(Right, Top + 1, Bottom - 3, Canvas);
            DrawBottomLine(Left + 3, Right - 3, Bottom, Canvas);
            DrawLeftBottomCorner(Left, Bottom, Canvas);
            DrawRightBottomCorner(Right, Bottom, Canvas);
          end;
      end;
  end
  else
  begin
    { XP Style }
    if TabIndex <> ATabIndex then
      if ATabPosition in [tpLeft, tpRight] then
        InflateRect(ARect, -GetLeftMargin, 0)
      else
        InflateRect(ARect, 0, -GetLeftMargin);

    if (ATabIndex = 0) and (ATabPosition in [tpTop, tpBottom]) then
      ARect.Left := 0;

    Theme := OpenThemeData(0, 'Tab');

    Part := integer(TABP_TABITEM);

    if not Enabled then
      tState := integer(TIS_DISABLED)
    else
      if ATabIndex = TabIndex then
        tState := integer(TIS_SELECTED)
      else
        if MouseOnTabIndex = ATabIndex then
          tState := integer(TIS_HOT)
        else
          tState := integer(TIS_NORMAL);

    DrawThemeBackground(Theme, Canvas.Handle, Part, tState, ARect, nil);

    CloseThemeData(Theme);
  end;
end;

procedure TTeCustomTabControl.DrawTabText(ATabIndex: integer; ATabPosition: TTabPosition; ARect: TRect);
var
  TextRect: TRect;
begin
  { Draw face }
  Canvas.Font.Assign(Self.Font);

  if ATabIndex = TabIndex then
    InflateRect(ARect, 1, 1);

  case ATabPosition of
    tpLeft:
      begin
        if HotTrack and (ATabIndex = MouseOnTabIndex) then
          Canvas.Font.Color := clHighlight;

        TextRect := ARect;
        if TabIndex = ATabIndex then InflateRect(TextRect, -1, -1);
        TextRect.Right := TextRect.Left + GetTabHeight;
        DrawVerticalText(Canvas, Tabs[ATabIndex], TextRect, DT_CENTER or DT_VCENTER or DT_SINGLELINE, false);
      end;
    tpTop:
      begin
        if HotTrack and (ATabIndex = MouseOnTabIndex) then
          Canvas.Font.Color := clHighlight;

        if TabIndex <> ATabIndex then Inc(ARect.Top);

        TextRect := ARect;
        if TabIndex = ATabIndex then InflateRect(TextRect, -1, -1);
        TextRect.Bottom := TextRect.Top + GetTabHeight;
        DrawText(Canvas, Tabs[ATabIndex], TextRect, DrawTextBiDiModeFlags(DT_CENTER or DT_VCENTER or DT_SINGLELINE));
      end;
    tpRight:
      begin
        if HotTrack and (ATabIndex = MouseOnTabIndex) then
          Canvas.Font.Color := clHighlight;

        TextRect := ARect;
        if TabIndex = ATabIndex then InflateRect(TextRect, -1, -1);
        TextRect.Left := TextRect.Right - GetTabHeight;
        DrawVerticalText(Canvas, Tabs[ATabIndex], TextRect, DT_CENTER or DT_VCENTER or DT_SINGLELINE, true);
      end;
    tpBottom:
      begin
        if HotTrack and (ATabIndex = MouseOnTabIndex) then
          Canvas.Font.Color := clHighlight;

        TextRect := ARect;
        if TabIndex = ATabIndex then InflateRect(TextRect, -1, -1);
        TextRect.Top := TextRect.Bottom - GetTabHeight;
        DrawText(Canvas, Tabs[ATabIndex], TextRect, DrawTextBiDiModeFlags(DT_CENTER or DT_VCENTER or DT_SINGLELINE));
      end;
  end;
end;

procedure TTeCustomTabControl.DrawTabGlyph(ATabIndex: integer; ATabPosition: TTabPosition; ARect: TRect);
var
  GlyphRect: TRect;
  Page: TTeCustomTabSheet;
begin
  { Draw glyph }
  if ATabIndex = TabIndex then
    InflateRect(ARect, 1, 1);

  Page := Pages[GetPageIndexFromTabIndex(ATabIndex)];
  if Page = nil then Exit;

  GlyphRect := ARect;
  InflateRect(GlyphRect, -3, -3);

  case ATabPosition of
    tpLeft:
      begin
        GlyphRect.Right := GlyphRect.Left + GetTabHeight;
        GlyphRect.Top := GlyphRect.Bottom - GetTabHeight;

        Images.Draw(Canvas, GlyphRect.Left, GlyphRect.Top, Page.ImageIndex);
      end;
    tpTop:
      begin
        GlyphRect.Right := GlyphRect.Left + GetTabHeight;
        GlyphRect.Bottom := GlyphRect.Top + RectHeight(GlyphRect);

        Images.Draw(Canvas, GlyphRect.Left, GlyphRect.Top, Page.ImageIndex);
      end;
    tpRight:
      begin
        GlyphRect.Left := GlyphRect.Right - GetTabHeight;
        GlyphRect.Bottom := GlyphRect.Top + GetTabHeight;

        Images.Draw(Canvas, GlyphRect.Left, GlyphRect.Top, Page.ImageIndex);
      end;
    tpBottom:
      begin
        GlyphRect.Right := GlyphRect.Left + GetTabHeight;
        GlyphRect.Top := GlyphRect.Bottom - RectHeight(GlyphRect);

        Images.Draw(Canvas, GlyphRect.Left, GlyphRect.Top, Page.ImageIndex);
      end;
  end;
end;

procedure TTeCustomTabControl.DrawTab(ATabIndex: integer);
var
  LRect: TRect;
  LTabPosition: TTabPosition;
  Theme: HTheme;
  Part, tState, Index: integer;
begin
  if ATabIndex < 0 then Exit;

  Canvas.Font.Assign(Self.Font);

  LRect := GetTabRect(ATabIndex);

  if IsTabOnOpositeSide(ATabIndex) then
    case TabPosition of
      tpTop: LTabPosition := tpBottom;
      tpLeft: LTabPosition := tpRight;
      tpRight: LTabPosition := tpLeft;
    else
      { tpBottom }
      LTabPosition := tpTop;
    end
  else
    LTabPosition := TabPosition;

  if OwnerDraw then
    DoDrawTab(ATabIndex, LRect, ATabIndex = TabIndex)
  else
  begin
    DrawTabFace(ATabIndex, LTabPosition, LRect);

    { Draw Glyph }
    if UsePages and (Images <> nil) then
    begin
      Index := GetPageIndexFromTabIndex(ATabIndex);
      if (Index >= 0) and (Index < Images.Count) then
      begin
        if Pages[Index].ImageIndex >= 0 then
        begin
          DrawTabGlyph(ATabIndex, LTabPosition, LRect);
          { Change LRect for DrawText }
          case LTabPosition of
            tpLeft, tpBottom: Dec(LRect.Bottom, GetTabHeight);
            tpTop: Inc(LRect.Left, GetTabHeight);
            tpRight: Inc(LRect.Top, GetTabHeight);
          end;
        end;
      end;
    end;

    { Draw Text }
    if TabPosition in [tpTop, tpBottom] then
    begin
      if RectWidth(LRect) > 8 then
        DrawTabText(ATabIndex, LTabPosition, LRect);
    end
    else
    begin
      if RectHeight(LRect) > 8 then
        DrawTabText(ATabIndex, LTabPosition, LRect);
    end;
  end;
end;

procedure TTeCustomTabControl.DrawTabs(Active: boolean);
var
  i: integer;
  LLastVisibleTab: integer;
  CurRow, LRowCount: integer;
  RowBegTab, RowEndTab: integer;
  CurTab: integer;
begin
  Canvas.Font.Assign(Self.Font);

  UpdateTabRows;

  if GetTabCount <= 0 then Exit;

  if Active then
  begin
    if (TabIndex >= 0) and (TabIndex < FTabs.Count) then
      DrawTab(TabIndex);
    Exit;
  end;

  if MultiLine then
  begin
    LRowCount := GetTabRowCount;
    if LRowCount <= 0 then
      Exit;

    if not ScrollOpposite then
      for CurRow := GetTabRow(TabIndex) - 1 downto 0 do
      begin
        if CurRow > 0 then
          RowBegTab := FTabRows[CurRow - 1].LastTab + 1
        else
          RowBegTab := 0;
        RowEndTab := FTabRows[CurRow].LastTab;
        for CurTab := RowBegTab to RowEndTab do
          DrawTab(CurTab);
      end;

    for CurRow := LRowCount - 1 downto GetTabRow(TabIndex) do
    begin
      if CurRow > 0 then
        RowBegTab := FTabRows[CurRow - 1].LastTab + 1
      else
        RowBegTab := 0;
      RowEndTab := FTabRows[CurRow].LastTab;
      for CurTab := RowBegTab to RowEndTab do
        DrawTab(CurTab);
    end;

    if ScrollOpposite then
      for CurRow := 0 to GetTabRow(TabIndex) - 1 do
      begin
        if CurRow > 0 then
          RowBegTab := FTabRows[CurRow - 1].LastTab + 1
        else
          RowBegTab := 0;
        RowEndTab := FTabRows[CurRow].LastTab;
        for CurTab := RowBegTab to RowEndTab do
          DrawTab(CurTab);
      end;

  end
  else
  begin
    i := FFirstVisibleTab;
    LLastVisibleTab := GetLastVisibleTab(false);
    while (i <= GetTabCount - 1) and (i <= LLastVisibleTab) do
    begin
      if i <> TabIndex then
        DrawTab(i);
      i := i + 1;
    end;
  end;
end;

function TTeCustomTabControl.GetBorderRect: TRect;
begin
  with Result do
  begin
    Left := 0;
    Top := 0;
    Right := FWidth;
    Bottom := FHeight;

    case TabPosition of
      tpLeft:
        begin
          Left := Left + GetTabLineHeight;
          Right := Right - GetOppositeTabLineHeight;
        end;
      tpTop:
        begin
          Top := Top + GetTabLineHeight;
          Bottom := Bottom - GetOppositeTabLineHeight;
        end;
      tpRight:
        begin
          Right := Right - GetTabLineHeight;
          Left := Left + GetOppositeTabLineHeight;
        end;
      tpBottom:
        begin
          Bottom := Bottom - GetTabLineHeight;
          Top := Top + GetOppositeTabLineHeight;
        end;
    end;
  end;
end;

function TTeCustomTabControl.GetBottomMargin: integer;
begin
  Result := 2;
end;

function TTeCustomTabControl.GetLastVisibleTab(FullVisible: boolean): integer;
var
  LTabAreaWidth, SumWidth: integer;
  TmpRect: TRect;
begin
  Result := -1;

  if GetTabCount = 0 then Exit;

  case TabPosition of
    tpTop, tpBottom: LTabAreaWidth := Width - GetLeftMargin - GetRightMargin;
  else
    LTabAreaWidth := Height - GetTopMargin - GetBottomMargin;
  end;

  SumWidth := GetTabWidth(FFirstVisibleTab);
  for Result := FFirstVisibleTab to GetTabCount - 2 do
    if (SumWidth + GetTabWidth(Result + 1) <= LTabAreaWidth)
      and (Result <= GetTabCount - 2) then
      SumWidth := SumWidth + GetTabWidth(Result + 1)
    else
      Break;

  if Result + 1 <= GetTabCount - 1 then
    Result := Result + 1;

  if FullVisible then
  begin
    while (Result > 0) and ((GetTabRect(Result).Right > Width) or
      (IntersectRect(TmpRect, GetTabRect(Result), GetLeftScrlBtnRect) or
      IntersectRect(TmpRect, GetTabRect(Result), GetRightScrlBtnRect))) do
      Result := Result - 1;
  end;
end;

function TTeCustomTabControl.GetLeftMargin: integer;
begin
  Result := 2;
end;

function TTeCustomTabControl.GetRightMargin: integer;
begin
  Result := 2;
end;

function TTeCustomTabControl.GetTabCount: integer;
begin
  Result := Tabs.Count;
end;

function TTeCustomTabControl.GetTabHeight: integer;
begin
  if TabHeight <= 0 then
  begin
    if (Images = nil) then
      Result := Canvas.TextHeight('Pq') + 4
    else
      Result := Max(Canvas.TextHeight('Pq')+4, Images.Height+4)
  end
  else
    Result := TabHeight;
end;

function TTeCustomTabControl.GetTabRect(ATabIndex: integer): TRect;
var
  i: integer;
  CurShift: integer;
  TabRow,
    FirstTabInRow: integer;
  LRowHeight,
    LTabLineHeight: integer;
  LTabPosition: TTabPosition;
begin
  UpdateTabRows;

  CurShift := 0;

  if MultiLine then
  begin
    TabRow := GetTabRow(ATabIndex);

    if TabRow = 0 then
      FirstTabInRow := 0
    else
      FirstTabInRow := FTabRows[TabRow - 1].LastTab + 1;

    for i := FirstTabInRow to ATabIndex - 1 do
      CurShift := CurShift + GetTabExtendedWidth(i);

  end
  else
  begin
    if ATabIndex >= FFirstVisibleTab then
      for i := FFirstVisibleTab to ATabIndex - 1 do
        CurShift := CurShift + GetTabExtendedWidth(i)
    else
      for i := FFirstVisibleTab - 1 downto ATabIndex do
        CurShift := CurShift - GetTabExtendedWidth(i);
  end;

  if IsTabOnOpositeSide(ATabIndex) then
  begin
    case TabPosition of
      tpTop: LTabPosition := tpBottom;
      tpLeft: LTabPosition := tpRight;
      tpRight: LTabPosition := tpLeft;
    else // tpBottom
      LTabPosition := tpTop;
    end;
    LRowHeight := GetTabRowHeight(GetTabRow(ATabIndex));
    LTabLineHeight := GetOppositeTabLineHeight;
  end
  else
  begin
    LTabPosition := TabPosition;
    LRowHeight := GetTabRowHeight(GetTabRow(ATabIndex));
    LTabLineHeight := GetTabLineHeight;
  end;

  with Result do
  begin
{    if ATabIndex <> TabIndex then }
      case LTabPosition of
        tpLeft:
          begin
            Left := LTabLineHeight - LRowHeight;
            Right := LTabLineHeight + GetLeftMargin;
            Top := CurShift + GetTopMargin;
            Bottom := Top + GetTabExtendedWidth(ATabIndex);
          end;
        tpTop:
          begin
            Left := CurShift + GetLeftMargin;
            Right := Left + GetTabExtendedWidth(ATabIndex);
            Top := LTabLineHeight - LRowHeight;
            Bottom := LTabLineHeight + GetTopMargin;
          end;
        tpRight:
          begin
            Right := Width - (LTabLineHeight - LRowHeight);
            Left := Width - LTabLineHeight - GetRightMargin;
            Top := CurShift + GetTopMargin;
            Bottom := Top + GetTabExtendedWidth(ATabIndex);
          end;
        tpBottom:
          begin
            Left := CurShift + GetLeftMargin;
            Right := Left + GetTabExtendedWidth(ATabIndex);
            Bottom := Height - (LTabLineHeight - LRowHeight);
            Top := Height - LTabLineHeight - GetBottomMargin;
          end;
      end
(*    else
      case LTabPosition of
        tpLeft:
          begin
            Left := LTabLineHeight - LRowHeight - GetLeftMargin;
            Right := LTabLineHeight + GetLeftMargin;
            Top := CurShift;
            Bottom := Top + GetTabExtendedWidth(ATabIndex) + GetTopMargin * 2;
          end;
        tpTop:
          begin
            Left := CurShift;
            Right := Left + GetTabExtendedWidth(ATabIndex) + GetLeftMargin * 2;
            Top := LTabLineHeight - LRowHeight - GetTopMargin {*2};
            Bottom := LTabLineHeight + GetTopMargin;
          end;
        tpRight:
          begin
            Right := Width - (LTabLineHeight - LRowHeight) + GetRightMargin;
            Left := Width - LTabLineHeight - GetRightMargin;
            Top := CurShift;
            Bottom := Top + GetTabExtendedWidth(ATabIndex) + GetTopMargin * 2;
          end;
        tpBottom:
          begin
            Left := CurShift;
            Right := Left + GetTabExtendedWidth(ATabIndex) + GetLeftMargin * 2;

            Bottom := Height - (LTabLineHeight - LRowHeight) + GetBottomMargin;
            Top := Height - LTabLineHeight - GetBottomMargin;
          end;
      end *)

  end;
end;

function TTeCustomTabControl.GetTabRowCount: integer;
begin
  if not Multiline then
    Result := 1
  else
    Result := FTabRowCount;
end;

function TTeCustomTabControl.GetTabWidth(ATabIndex: integer): integer;
var
  Index: integer;
begin
  Result := 0;

  if ATabIndex < 0 then Exit;
  if ATabIndex >= FTabs.Count then
  begin
    Result := 0;
    Exit;
  end;
  
  if FTabSize.x = 0 then
  begin
    Canvas.Font.Assign(Font);
    Result := TextWidth(Canvas, Tabs[ATabIndex]) + 12;

    { Draw Glyph }
    if UsePages and (Images <> nil) then
    begin
      Index := GetPageIndexFromTabIndex(ATabIndex);
      if (Index >= 0) and (Index < PageCount) then
        if Pages[Index].ImageIndex >= 0 then
          Result := Result + Images.Width;
    end;

    case TabPosition of
      tpLeft:
        if Result < (GetTabHeight + GetLeftMargin) * 2 then
          Result := (GetTabHeight + GetLeftMargin) * 2;
      tpTop:
        if Result < (GetTabHeight + GetTopMargin) * 2 then
          Result := (GetTabHeight + GetTopMargin) * 2;
      tpRight:
        if Result < (GetTabHeight + GetRightMargin) * 2 then
          Result := (GetTabHeight + GetRightMargin) * 2;
      tpBottom:
        if Result < (GetTabHeight + GetBottomMargin) * 2 then
          Result := (GetTabHeight + GetBottomMargin) * 2;
    end;
  end
  else
    Result := FTabSize.x;
end;

function TTeCustomTabControl.GetTopMargin: integer;
begin
  Result := 2;
end;

function TTeCustomTabControl.GetTabLineHeight: integer;
begin
  if GetTabCount > 0 then
  begin
    if not ScrollOpposite then
      Result := GetTabHeight * GetTabRowCount
    else
      Result := GetTabHeight * (GetTabRowCount - GetTabRow(TabIndex));
    case TabPosition of
      tpLeft: Result := Result + GetLeftMargin;
      tpTop: Result := Result + GetTopMargin;
      tpRight: Result := Result + GetRightMargin;
      tpBottom: Result := Result + GetBottomMargin;
    end;
  end
  else
    Result := 0;
end;

procedure TTeCustomTabControl.InvalidateTabs;
var
  ClipRect: TRect;
  i, SaveIndex: integer;
  Buffer: TTeBitmap;
  PaintDC, SavedDC: HDC;
  P: TPoint;
begin
  if Tabs = nil then Exit;
  if Parent = nil then Exit;
  if not HandleAllocated then Exit;

  if csDesigning in ComponentState then
  begin
    Invalidate;
    Exit;
  end;

  if Performance = kspNoBuffer then
  begin
    ClipRect := Rect(0, 0, 0, 0);
    for i := 0 to Tabs.Count - 1 do
      UnionRect(ClipRect, ClipRect, GetTabRect(i));

    if IsRectEmpty(ClipRect) then Exit;

    { Extract to full size }
    if TabPosition in [tpTop, tpBottom] then
    begin
      InflateRect(ClipRect, 0, 2);
      ClipRect.Left := 0;
      ClipRect.Right := Width;
    end
    else
    begin
      InflateRect(ClipRect, 2, 0);
      ClipRect.Top := 0;
      ClipRect.Bottom := Height;
    end;

    Buffer := TTeBitmap.Create;
    Buffer.SetSize(RectWidth(ClipRect), RectHeight(ClipRect));

    MoveWindowOrg(Buffer.DC, -ClipRect.Left, -ClipRect.Top);

    PaintDC := Canvas.Handle;
    Buffer.Font := Self.Font;
    SelectObject(Buffer.DC, Buffer.Font.Handle);
    Canvas.Handle := Buffer.DC;

    SaveIndex := SaveDC(Buffer.DC);
    if Transparent then
    begin
      if (Parent is TTeCustomTabSheet) and (TTeCustomTabSheet(Parent).Parent is TTeCustomTabControl) then
      begin
        P := ClientOrigin;
        Windows.ScreenToClient(TTeCustomTabControl(TTeCustomTabSheet(Parent).Parent).Handle, P);

        MoveWindowOrg(Buffer.DC, -P.X, -P.Y);

        SavedDC := TTeCustomTabControl(TTeCustomTabSheet(Parent).Parent).Canvas.Handle;
        TTeCustomTabControl(TTeCustomTabSheet(Parent).Parent).Canvas.Handle := Buffer.DC;
        TTeCustomTabControl(TTeCustomTabSheet(Parent).Parent).PaintBuffer;
        TTeCustomTabControl(TTeCustomTabSheet(Parent).Parent).Canvas.Handle := SavedDC;

        MoveWindowOrg(Buffer.DC, P.X, P.Y);
      end
      else
        PaintOwnerBackground(Canvas.Handle)
    end
    else
      inherited PaintBuffer;

    RestoreDC(Buffer.DC, SaveIndex);

    DrawTabs(false);
    DrawBorder;

    DrawTabs(true);

    if GetScrlBtnsVisible then
    begin
      DrawLeftScrlBtn;
      DrawRightScrlBtn;
    end;

    Canvas.Handle := PaintDC;

    MoveWindowOrg(Buffer.DC, ClipRect.Left, ClipRect.Top);
    Buffer.Draw(PaintDC, ClipRect.Left, ClipRect.Top);
    Buffer.Free;
  end
  else
    Invalidate;
end;

procedure TTeCustomTabControl.PaintBuffer;
var
  R: TRect;
  SaveIndex: integer;
begin
  if Tabs = nil then Exit;

  if not (csDesigning in ComponentState) then
  begin
    SaveIndex := SaveDC(Canvas.Handle);

    if Transparent then
    begin
      R := ClientRect;
      AdjustClientRect(R);
      with R do
        ExcludeClipRect(Canvas.Handle, Left, Top, Right, Bottom);

      PaintOwnerBackground(Canvas.Handle)
    end
    else
      inherited ;

    RestoreDC(Canvas.Handle, SaveIndex);
  end
  else
    inherited ;

  DrawTabs(false);
  DrawBorder;

  DrawTabs(true);

  if GetScrlBtnsVisible then
  begin
    DrawLeftScrlBtn;
    DrawRightScrlBtn;
  end;
end;

procedure TTeCustomTabControl.DrawBorder;
var
  LRect: TRect;
  Theme: HTheme;
  Part, tState: integer;
begin
  Canvas.Font.Assign(Self.Font);

  LRect := GetBorderRect;

  if not UseThemes then
  begin
    FillRect(Canvas, LRect, clBtnFace);

    DrawEdge(Canvas, LRect, clBtnHighlight, cl3DDkShadow);
    InflateRect(LRect, -1, -1);
    DrawEdge(Canvas, LRect, clBtnFace, clBtnShadow);
  end
  else
  begin
    Theme := OpenThemeData(0, 'Tab');

    Part := integer(TABP_PANE);
    tState := 1;

    DrawThemeBackground(Theme, Canvas.Handle, Part, tState, LRect, nil);

    CloseThemeData(Theme);
  end;
end;

procedure TTeCustomTabControl.TabsChanged;
var
  i, j: integer;
  Page: TTeCustomTabSheet;
  TCount, PCount: integer;
  SaveTabs: string;
begin
  if FTabsChanging then Exit;

  FTabsChanging := true;
  try

    if FTabs.Count <= 0 then
    begin
      FTabIndex := -1;
    end
    else
      if FTabIndex >= FTabs.Count-1 then
        FTabIndex := FTabs.Count-1
      else
        if FTabIndex = -1 then
          FTabIndex := 0;

    if (FUsePages) and not (csLoading in ComponentState) then
    begin
      { Add new Pages, from Tabs }

      for i := 0 to FTabs.Count - 1 do
      begin
        { Calc tabcount = Tabs[i] }
        TCount := 0;
        for j := 0 to FTabs.Count - 1 do
          if FTabs[i] = FTabs[j] then
            Inc(TCount);

        { Calc pagecount = Tabs[i] }
        PCount := 0;
        for j := 0 to PageCount - 1 do
          if Tabs[i] = Pages[j].Caption then
            Inc(PCount);

        if TCount > PCount then
        begin
          Page := TTeCustomTabSheet.Create(Owner);
          Page.Caption := FTabs[i];
          InsertPage(i, Page);

          FActivePage := Page;
          FTabIndex := i;
        end;
      end;
    end;

    if FUsePages then
    begin
      { Arrage Tabs by Pages }
      SaveTabs := FTabs.CommaText;

      FTabs.Clear;
      for i := 0 to FPages.Count - 1 do
        if (Pages[i].PageVisible) then
          FTabs.Add(Pages[i].Caption);

{      for i := 0 to FPages.Count - 1 do
        if (Pages[i].PageVisible) then
        begin
          j := GetTabIndexFromPageIndex(i);
          if (j >= 0) and (j < FTabs.Count) then
            FTabs[j] := Pages[i].Caption
          else
            if j >= 0 then
              FTabs.Add(Pages[i].Caption);
        end; }

      if SaveTabs <> FTabs.CommaText then
        SetActivePageIndex(GetPageIndexFromTabIndex(FTabIndex));
    end;

    if not FUpdating then
    begin
      InvalidateTabs;
      if UsePages then Realign;
    end;
  finally
    FTabsChanging := false;
  end;
end;

function TTeCustomTabControl.PtInTab(x, y: integer): integer;
var
  i, LLastVisibleTab: integer;
  LRect: TRect;
  CurRow, LRowCount: integer;
  RowBegTab, RowEndTab: integer;
  CurTab: integer;
begin
  Result := -1;

  if GetTabCount <= 0 then Exit;

  if (((TabPosition = tpTop) and PtInRect(Rect(Width - GetScrollBtnSize.x * 2,
    0,
    Width,
    GetTabLineHeight), Point(x, y)))
    or ((TabPosition = tpBottom) and PtInRect(Rect(Width - GetScrollBtnSize.x * 2,
    Height - GetTabLineHeight,
    Width,
    Height), Point(x, y))))
    and GetScrlBtnsVisible then
      Exit;

  if PtInRect(GetTabRect(TabIndex), Point(x, y)) then
  begin
    Result := TabIndex;
    Exit;
  end;

  if MultiLine then
  begin
    LRowCount := GetTabRowCount;
    if LRowCount <= 0 then
      Exit;
   
    if ScrollOpposite then
      for CurRow := GetTabRow(TabIndex) - 1 downto 0 do
      begin
        if CurRow > 0 then
          RowBegTab := FTabRows[CurRow - 1].LastTab + 1
        else
          RowBegTab := 0;
        RowEndTab := FTabRows[CurRow].LastTab;
        for CurTab := RowBegTab to RowEndTab do
          if PtInRect(GetTabRect(CurTab), Point(x, y)) then
          begin
            Result := CurTab;
            Exit;
          end;
      end;

    for CurRow := GetTabRow(TabIndex) to LRowCount - 1 do
    begin
      if CurRow > 0 then
        RowBegTab := FTabRows[CurRow - 1].LastTab + 1
      else
        RowBegTab := 0;
      RowEndTab := FTabRows[CurRow].LastTab;
      for CurTab := RowBegTab to RowEndTab do
        if PtInRect(GetTabRect(CurTab), Point(x, y)) then
        begin
          Result := CurTab;
          Exit;
        end;
    end;

    if not ScrollOpposite then
      for CurRow := 0 to GetTabRow(TabIndex) - 1 do
      begin
        if CurRow > 0 then
          RowBegTab := FTabRows[CurRow - 1].LastTab + 1
        else
          RowBegTab := 0;
        RowEndTab := FTabRows[CurRow].LastTab;
        for CurTab := RowBegTab to RowEndTab do
          if PtInRect(GetTabRect(CurTab), Point(x, y)) then
          begin
            Result := CurTab;
            Exit;
          end;
      end;


  end
  else
  begin
    i := FFirstVisibleTab;
    LLastVisibleTab := GetLastVisibleTab(false);
    while (i <= GetTabCount - 1) and (i <= LLastVisibleTab) do
    begin
      LRect := GetTabRect(i);
      with LRect do
        case TabPosition of
          tpLeft: Right := Right + GetLeftMargin;
          tpTop: Bottom := Bottom - GetTopMargin;
          tpRight: Left := Left + GetRightMargin;
          tpBottom: Top := Top + GetBottomMargin;
        end;

      if PtInRect(LRect, Point(x, y)) then
      begin
        Result := i;
        Exit;
      end
      else
        Inc(i);
    end;
  end;
end;

procedure TTeCustomTabControl.MouseDown(Button: TMouseButton;
  Shift: TShiftState; x, y: integer);
var
  A: integer;
  OldLeftBtnPressed,
    OldRightBtnPressed: boolean;
begin
  inherited MouseDown(Button, Shift, x, y);

  if Button <> mbLeft then Exit;

  OldLeftBtnPressed := LeftBtnPressed;
  OldRightBtnPressed := RightBtnPressed;

  if PtInLeftBtn(x, y) then
    FMDownOnLeftBtn := true;

  if PtInRightBtn(x, y) then
    FMDownOnRightBtn := true;

  if ((OldLeftBtnPressed = false) and (LeftBtnPressed = true)) or
    ((OldRightBtnPressed = false) and (RightBtnPressed = true)) then
  begin
    InvalidateTabs;
    PartPress(True);
  end
  else
  begin
    A := PtInTab(x, y);
    if A <> -1 then
    begin
      if not (csDesigning in ComponentState) and CanFocus and not Focused then
        SetFocus;
      TabIndex := A;
    end;
  end;
end;

procedure TTeCustomTabControl.ScrollTabs(Delta: Integer);
var
  WasTrimmmed: boolean;
begin
  if Delta = 0 then Exit;

  if GetTabCount > 0 then
  begin
    FFirstVisibleTab := FFirstVisibleTab + Delta;
    if FFirstVisibleTab < 0 then
      FFirstVisibleTab := 0
    else
    begin
      if FFirstVisibleTab > GetTabCount - 1 then
        FFirstVisibleTab := GetTabCount - 1;

      WasTrimmmed := false;
      while (FFirstVisibleTab > 0) and
        (GetLastVisibleTab(true) = GetTabCount - 1) do
      begin
        FFirstVisibleTab := FFirstVisibleTab - 1;
        WasTrimmmed := true;
      end;
      if WasTrimmmed then
        FFirstVisibleTab := FFirstVisibleTab + 1;
    end;
  end
  else
    FFirstVisibleTab := -1;

  InvalidateTabs;
end;

function TTeCustomTabControl.GetScrollBtnSize: TPoint;
begin
  with Result do
  begin
    x := Font.Size * 2;
    y := x;
  end;
end;

function TTeCustomTabControl.GetLeftScrlBtnRect: TRect;
var
  BtnSize: TPoint;
begin
  BtnSize := GetScrollBtnSize;
  with Result do
  begin
    Right := Width - BtnSize.x;
    Left := Right - BtnSize.x;
    if TabPosition = tpTop then
      Top := GetTabLineHeight - BtnSize.y - GetTopMargin {-1}
    else
      Top := Height - GetTabLineHeight + GetBottomMargin;
    Bottom := Top + BtnSize.y;
  end;
end;

function TTeCustomTabControl.GetRightScrlBtnRect: TRect;
var
  BtnSize: TPoint;
begin
  BtnSize := GetScrollBtnSize;
  with Result do
  begin
    Right := Width;
    Left := Right - BtnSize.x;
    if TabPosition = tpTop then
      Top := GetTabLineHeight - BtnSize.y - GetTopMargin {-1}
    else
      Top := Height - GetTabLineHeight + GetBottomMargin;
    Bottom := Top + BtnSize.y;
  end;
end;

procedure TTeCustomTabControl.DrawLeftScrlBtn;
var
  TmpRect: TRect;
  Flags: UINT;
  Theme: HTheme;
  Part, tState: integer;
begin
  TmpRect := GetLeftScrlBtnRect;

  if not UseThemes then
  begin
    { Default drawing }
    Flags := DFCS_SCROLLLEFT;

    if LeftBtnPressed then
      Flags := Flags or DFCS_PUSHED;

    DrawFrameControl(Canvas.Handle, TmpRect, DFC_SCROLL, Flags);
  end
  else
  begin
    { XP Style }
    Theme := OpenThemeData(0, 'ScrollBar');

    Part := integer(SBP_ARROWBTN);

    if not Enabled then
      tState := integer(ABS_LEFTDISABLED)
    else
      if LeftBtnPressed then
        tState := integer(ABS_LEFTPRESSED)
      else
        if MouseOnLeftBtn then
          tState := integer(ABS_LEFTHOT)
        else
          tState := integer(ABS_LEFTNORMAL);

    DrawThemeBackground(Theme, Canvas.Handle, Part, tState, TmpRect, nil);

    CloseThemeData(Theme);
  end;
end;

procedure TTeCustomTabControl.DrawRightScrlBtn;
var
  TmpRect: TRect;
  Flags: UINT;
  Theme: HTheme;
  Part, tState: integer;
begin
  TmpRect := GetRightScrlBtnRect;

  if not UseThemes then
  begin
    { Defautl drawing }
    Flags := DFCS_SCROLLRIGHT;

    if RightBtnPressed then
      Flags := Flags or DFCS_PUSHED;

    DrawFrameControl(Canvas.Handle, TmpRect, DFC_SCROLL, Flags);
  end
  else
  begin
    { XP Style }
    Theme := OpenThemeData(0, 'ScrollBar');

    Part := integer(SBP_ARROWBTN);

    if not Enabled then
      tState := integer(ABS_RIGHTDISABLED)
    else
      if RightBtnPressed then
        tState := integer(ABS_RIGHTPRESSED)
      else
        if MouseOnRightBtn then
          tState := integer(ABS_RIGHTHOT)
        else
          tState := integer(ABS_RIGHTNORMAL);

    DrawThemeBackground(Theme, Canvas.Handle, Part, tState, TmpRect, nil);

    CloseThemeData(Theme);
  end;
end;

function TTeCustomTabControl.GetScrlBtnsVisible: boolean;
begin
  if ((TabPosition = tpTop) or (TabPosition = tpBottom)) and (GetTabCount > 1) then
    Result := (not Multiline) and ((FFirstVisibleTab > 0) or (GetTabRect(GetTabCount - 1).Right > Width))
  else
    Result := false;
end;

function TTeCustomTabControl.GetLeftBtnPressed: boolean;
begin
  Result := FMDownOnLeftBtn and MouseOnLeftBtn;
end;

function TTeCustomTabControl.GetRightBtnPressed: boolean;
begin
  Result := FMDownOnRightBtn and MouseOnRightBtn;
end;

procedure TTeCustomTabControl.KeyDown(var Key: word; Shift: TShiftState);
begin
  inherited KeyDown(Key, Shift);

  case Key of
    VK_LEFT, VK_UP: TabIndex := TabIndex - 1;
    VK_RIGHT, VK_DOWN: TabIndex := TabIndex + 1;
  end;
end;

procedure TTeCustomTabControl.KeyUp(var Key: word; Shift: TShiftState);
begin
  inherited;

end;

procedure TTeCustomTabControl.MouseMove(Shift: TShiftState; x, y: integer);
var
  OldMouseOnLeftBtn,
    OldMouseOnRightBtn: boolean;
  OldMouseOnTabIndex: integer;
begin
  inherited;

  OldMouseOnLeftBtn := FMouseOnLeftBtn;
  FMouseOnLeftBtn := PtInLeftBtn(x, y) and GetScrlBtnsVisible;

  OldMouseOnRightBtn := FMouseOnRightBtn;
  FMouseOnRightBtn := PtInRightBtn(x, y) and GetScrlBtnsVisible;

  OldMouseOnTabIndex := MouseOnTabIndex;
  FMouseOnTabIndex := PtInTab(x, y);

  if (OldMouseOnLeftBtn <> FMouseOnLeftBtn) or
    (OldMouseOnRightBtn <> FMouseOnRightBtn) or
    (OldMouseOnTabIndex <> MouseOnTabIndex)
  then
    InvalidateTabs;
end;

procedure TTeCustomTabControl.MouseUp(Button: TMouseButton;
  Shift: TShiftState; x, y: integer);
begin
  inherited;

  if Button <> mbLeft then Exit;

  FMDownOnLeftBtn := false;
  FMDownOnRightBtn := false;

  if FRepeatTimer <> nil then
    FRepeatTimer.Enabled := False;

  InvalidateTabs;
end;

procedure TTeCustomTabControl.PartPress(FirstTime: boolean);
begin
  if FRepeatTimer = nil then
  begin
    FRepeatTimer := TTimer.Create(Self);
    FRepeatTimer.OnTimer := TimerExpired;
  end;
  if FirstTime then
  begin
    FRepeatTimer.OnTimer(FRepeatTimer);
    FRepeatTimer.Interval := CScrollDelayInterval;
  end
  else
    FRepeatTimer.Interval := CScrollSpeedInterval;

  FRepeatTimer.Enabled := true;
end;

function TTeCustomTabControl.PtInLeftBtn(x, y: integer): boolean;
begin
  Result := GetScrlBtnsVisible and PtInRect(GetLeftScrlBtnRect, Point(x, y));
end;

function TTeCustomTabControl.PtInRightBtn(x, y: integer): boolean;
begin
  Result := GetScrlBtnsVisible and PtInRect(GetRightScrlBtnRect, Point(x, y));
end;

procedure TTeCustomTabControl.TimerExpired(Sender: TObject);
begin
  FRepeatTimer.Interval := CScrollSpeedInterval;
  try
    if LeftBtnPressed then
    begin
      ScrollTabs(-1);
    end
    else
      if RightBtnPressed then
    begin
      ScrollTabs(1);
    end;
  except
    FRepeatTimer.Enabled := False;
  end;
end;

procedure TTeCustomTabControl.DoEnter;
begin
  inherited;
  InvalidateTabs;
end;

procedure TTeCustomTabControl.DoExit;
begin
  inherited;
  InvalidateTabs;
end;

procedure TTeCustomTabControl.UpdateTabRows;
var
  CurTab: integer;
  CurWidth: integer;
  LTabLineWidth: integer;
  CurLine: integer;
  RowBegTab: integer;
begin
  if GetTabCount <= 0 then
    Exit;

  if TabPosition in [tpTop, tpBottom] then
    LTabLineWidth := Width - GetLeftMargin - GetRightMargin
  else
    LTabLineWidth := Height - GetLeftMargin - GetRightMargin;

  FTabRowCount := 0;
  CurWidth := GetTabWidth(0);
  CurLine := 0;
  RowBegTab := 0;

  for CurTab := 1 to GetTabCount - 1 do
    if (CurWidth + GetTabWidth(CurTab) >= LTabLineWidth) then
    begin
      FTabRows[CurLine].LastTab := CurTab - 1;
      if CurTab - RowBegTab <> 0 then
        FTabRows[CurLine].ExternalTabWidth :=
          (LTabLineWidth - CurWidth) div (CurTab - RowBegTab)
      else
        FTabRows[CurLine].ExternalTabWidth := 0;
      FTabRows[CurLine].ExternalRest := LTabLineWidth -
        CurWidth - FTabRows[CurLine].ExternalTabWidth * (CurTab - RowBegTab);
      CurWidth := GetTabWidth(CurTab);
      CurLine := CurLine + 1;
      RowBegTab := CurTab;
    end
    else
      CurWidth := CurWidth + GetTabWidth(CurTab);

  if CurWidth > 0 then
  begin
    FTabRows[CurLine].LastTab := GetTabCount - 1;

    if GetTabCount - 1 - RowBegTab + 1 <> 0 then
      FTabRows[CurLine].ExternalTabWidth :=
        (LTabLineWidth - CurWidth) div (GetTabCount - 1 - RowBegTab + 1)
    else
      FTabRows[CurLine].ExternalTabWidth := 0;

    FTabRows[CurLine].ExternalRest := LTabLineWidth -
      CurWidth - FTabRows[CurLine].ExternalTabWidth * (GetTabCount - RowBegTab);
  end;
  FTabRowCount := CurLine + 1;
end;

function TTeCustomTabControl.GetTabRow(ATab: integer): integer;
var
  i: integer;
  LTabRowCount: integer;
begin
  LTabRowCount := GetTabRowCount;
  if LTabRowCount = 0 then
  begin
    Result := -1;
    Exit;
  end;

  Result := 0;
  for i := 0 to LTabRowCount - 2 do
    if (ATab > FTabRows[i].LastTab) and (ATab <= FTabRows[i + 1].LastTab) then
    begin
      Result := i + 1;
      Exit;
    end;
end;

function TTeCustomTabControl.GetTabRowHeight(ARow: integer): integer;
var
  LActiveRow: integer;
begin
  LActiveRow := GetTabRow(TabIndex);
  if not ScrollOpposite then
  begin

    if ARow >= LActiveRow then
      Result := ARow - LActiveRow + 1
    else
      Result := ARow + GetTabRowCount - LActiveRow + 1;
  end
  else
    if ARow >= LActiveRow then
    Result := ARow - LActiveRow + 1
  else
    Result := LActiveRow - ARow;

  Result := Result * GetTabHeight;
end;

function TTeCustomTabControl.GetTabExtendedWidth(ATabIndex: integer): integer;
var
  LRow: integer;
begin
  if RaggedRight or (FTabSize.x <> 0) or not MultiLine then
    Result := GetTabWidth(ATabIndex)
  else
  begin
    LRow := GetTabRow(ATabIndex);
    Result := GetTabWidth(ATabIndex) + FTabRows[LRow].ExternalTabWidth;
    if FTabRows[LRow].LastTab = ATabIndex then
      Result := Result + FTabRows[LRow].ExternalRest;
  end;
end;

function TTeCustomTabControl.IsTabLastInRow(ATabIndex: integer): boolean;
var
  CurRow: integer;
begin
  Result := false;
  for CurRow := 0 to GetTabRowCount - 1 do
    if FTabRows[CurRow].LastTab = ATabIndex then
    begin
      Result := true;
      Break;
    end;
end;

function TTeCustomTabControl.GetOppositeTabLineHeight: integer;
begin
  if ScrollOpposite then
    Result := GetTabRow(TabIndex) * GetTabHeight
  else
    Result := 0;
end;

function TTeCustomTabControl.IsTabOnOpositeSide(ATab: integer): boolean;
begin
  Result := Multiline and ScrollOpposite and (GetTabRow(ATab) < GetTabRow(TabIndex));
end;

procedure TTeCustomTabControl.Change;
begin
  if Assigned(FOnChange) then
    FOnChange(Self);
end;

function TTeCustomTabControl.CanChange: Boolean;
begin
  Result := True;
  if Assigned(FOnChanging) then
    FOnChanging(Self, Result);
end;

