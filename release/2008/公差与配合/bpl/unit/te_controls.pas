    Brush.Free;
  end;
end;

procedure TTeBitmap.FillHalftonePolygon(Points: array of TPoint; Color,
  HalfColor: TKColor);
var
  TopLeft, BottomRight: TPoint;
  i, j: integer;
  C: PKColor;
begin
  FillPolygon(Points, Color);
  { Calc Polygon Rect }
  TopLeft := Point(MaxInt, MaxInt);
  BottomRight := Point(0, 0);
  for i := Low(Points) to High(Points) do
  begin
    if Points[i].X < TopLeft.X then
      TopLeft.X := Points[i].X;
    if Points[i].Y < TopLeft.Y then
      TopLeft.Y := Points[i].Y;

    if Points[i].X > BottomRight.X then
      BottomRight.X := Points[i].X;
    if Points[i].Y > BottomRight.Y then
      BottomRight.Y := Points[i].Y;
  end;
  { Draw Halftone }
  for i := TopLeft.X to BottomRight.X-1 do
    for j := TopLeft.Y to BottomRight.Y-1 do
    begin
      if not PointInPolygon(Point(i, j), Points) then Continue;
      C := @FBits[i + j * FWidth];
      if Odd(i) and Odd(j) then
        C^ := HalfColor;
      if not Odd(i) and not Odd(j) then
        C^ := HalfColor;
    end;
end;

function TTeBitmap.TextHeight(AText: string): integer;
var
  R: TRect;
  SaveObject: integer;
begin
  Result := 0;

  if not Empty then
  begin
    SaveObject := SelectObject(FDC, FFont.Handle);
    R := Rect(0, 0, 0, 0);
    Windows.DrawText(FDC, PChar(AText), Length(AText), R, DT_CALCRECT);
    SelectObject(FDC, SaveObject);

    Result := R.Bottom;
  end;
end;

procedure TTeBitmap.DrawVerticalText(AText: string; Bounds: TRect;
  Flag: cardinal; FromTop: boolean);
var
  R, R1: TRect;
  TempBuf: TTeBitmap;
  BackColor: TKColor;
  i, j: integer;
  Pixel: TKColor;
begin
  R := Bounds;
  BackColor := KColor(255, 0, 255);

  TempBuf := TTeBitmap.Create;
  try
    TempBuf.SetSize(RectHeight(R), RectWidth(R));
    TempBuf.Clear(BackColor);
    TempBuf.Font.Assign(Self.Font);

    { Draw Horizontaly }
    R1 := Rect(0, 0, TempBuf.Width, TempBuf.Height);
    TempBuf.DrawText(AText, R1, Flag);

    { Rotate }
    for i := 0 to TempBuf.Width - 1 do
      for j := 0 to TempBuf.Height - 1 do
      begin
        if TempBuf.Pixels[i, j] = BackColor then Continue;

        if not FromTop then
          Pixels[Bounds.Left + j, Bounds.Bottom - i] := KColor(FFont.Color)
        else
          Pixels[Bounds.Right - j, Bounds.Top + i] := KColor(FFont.Color)
      end;
  finally
    TempBuf.Free;
  end;
end;

function TTeBitmap.TextWidth(AText: string; Flags: Integer = 0): integer;
var
  SaveObject: integer;
  R: TRect;
begin
  Result := 0;

  if not Empty then
  begin
    SaveObject := SelectObject(FDC, FFont.Handle);
    R := Rect(0, 0, 0, 0);
    Windows.DrawText(FDC, PChar(AText), Length(AText), R, DT_CALCRECT or Flags);
    SelectObject(FDC, SaveObject);

    Result := R.Right;
  end;
end;

function TTeBitmap.DrawText(AText: string; var Bounds: TRect; Flag: cardinal): integer;
var
  SaveFont: HFONT;
  SaveTextColor: TColorRef;
begin
  SaveFont := SelectObject(DC, FFont.Handle);
  try
    SetBkMode(DC, Transparent);
    SaveTextColor := SetTextColor(DC, ColorToRGB(FFont.Color));
    Result := Windows.DrawText(DC, PChar(AText), Length(AText), Bounds, Flag);
    SetTextColor (DC, SaveTextColor);
  finally
    SelectObject (DC, SaveFont);
  end;
end;

function TTeBitmap.DrawText(AText: string; X, Y: integer): integer;
var
  R: TRect;
begin
  R := Rect(X, Y, X + TextWidth(AText), Y + TextHeight(AText));
  DrawText(AText, R, 0);
end;

