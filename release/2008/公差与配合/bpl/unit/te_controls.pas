procedure TTeItemView.CalcSize;
var
  Size: TPoint;
  W, H: integer;
  i: integer;
  ViewCount: integer;
begin
  if FItems = nil then Exit;

  Size := Point(0, 0);
  W := 0;
  H := 0;

  if FItems.FScrolled and (FItems.FScrollCount > 0) then
  begin
    ViewCount := FItems.FScrollCount;
    if FOrientation = voVertical then
      Size.Y := Size.Y + ScrollButtonSize * 2;

    if FItems.TopItem + ViewCount > FItems.Count then
      ViewCount := FItems.Count - FItems.TopItem;
  end
  else
    ViewCount := FItems.Count;

  Canvas.Font.Assign(MenuFont);

  { Reset ItemRect }
  for i := 0 to FItems.Count - 1 do
    FItems[i].ItemRect := Rect(0, 0, 0, 0);

  { Calc all ItemRect }
  if FItems.Count - 1 >= 0 then
    GetItemRect(FItems[FItems.Count - 1]); // Set ItemRect property for all items

  { Calculation }
  for i := FItems.TopItem to FItems.TopItem + ViewCount - 1 do
  begin
    if not FItems[i].Visible then Continue;

    GetItemRect(FItems[i]); // Set ItemRect property
    W := RectWidth(FItems[i].ItemRect);
    H := RectHeight(FItems[i].ItemRect);

    case FOrientation of
      voVertical: begin
        if W > Size.X then Size.X := W;
        if (i >= FItems.FTopItem) and (i < FItems.FTopItem + ViewCount) then
          Inc(Size.Y, H);
      end;
      voHorizontal: begin
        if H > Size.Y then Size.Y := H;
        Inc(Size.X, W);
      end;
    end;
  end;

  { set size }
  SetSize(Size);

  FWidth := Size.X;
  FHeight := Size.Y;
end;

