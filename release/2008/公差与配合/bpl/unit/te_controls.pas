procedure TTeCustomSpeedButton.SetFlat(const Value: boolean);
begin
  if FFlat <> Value then
  begin
    FFlat := Value;
    if FFlat then Transparent := true;
    Invalidate;
  end;
end;

procedure TTeCustomSpeedButton.SetDown(const Value: boolean);
begin
  if FDown <> Value then
  begin
    FDown := Value;
    if not Value then
      FState := bsUp
    else
    begin
      if MouseInControl then
      begin
        if GroupIndex = 0 then
          FState := bsDown
        else
          FState := bsExclusive;
      end
      else
      begin
        if GroupIndex = 0 then
          FState := bsUp
        else
          FState := bsExclusive;
      end;
    end;

    if Value then
      UpdateExclusive;

    Invalidate;
  end;
end;

procedure TTeCustomSpeedButton.SetGroupIndex(const Value: Integer);
begin
  if FGroupIndex <> Value then
  begin
    FGroupIndex := Value;
    UpdateExclusive;
    if Down then
    begin
      if Value = 0 then
        FState := bsUp
      else
        FState := bsExclusive
    end;

    Invalidate;
  end;
end;

procedure TTeCustomSpeedButton.SetShowChevron(const Value: boolean);
begin
  if FShowChevron <> Value then
  begin
    FShowChevron := Value;
    if not (csLoading in ComponentState) then
    begin
      if Value then
        Width := Width + GetChevronWidth
      else
        Width := Width - GetChevronWidth;
    end;
    Invalidate;
  end;
end;

procedure TTeCustomSpeedButton.SetAllowAllUp(const Value: Boolean);
begin
  if FAllowAllUp <> Value then
  begin
    FAllowAllUp := Value;
    UpdateExclusive;
  end;
end;

procedure TTeCustomSpeedButton.SetShowCaption(const Value: boolean);
begin
  if FShowCaption <> Value then
  begin
    FShowCaption := Value;
    Invalidate;
  end;
end;

procedure TTeCustomSpeedButton.SetShowGlyph(const Value: boolean);
begin
  if FShowGlyph <> Value then
  begin
    FShowGlyph := Value;
    Invalidate;
  end;
end;

procedure TTeCustomSpeedButton.CMButtonPressed(var Message: TMessage);
var
  Sender: TControl;
begin
  if (Message.WParam = FGroupIndex) and Parent.HandleAllocated then
  begin
    Sender := TControl(Message.LParam);
    if (Sender <> nil) and (Sender is TTeCustomSpeedButton) then
      if Sender <> Self then
      begin
        if TTeCustomSpeedButton(Sender).Down and FDown then
        begin
          FDown := False;
          FState := bsUp;
          Invalidate;
        end;
        FAllowAllUp := TTeCustomSpeedButton(Sender).AllowAllUp;
      end;
  end;
end;

procedure TTeCustomSpeedButton.MouseEnter;
begin
  inherited;
  if FMouseDown then
    FState := bsDown;
  Invalidate;
end;

procedure TTeCustomSpeedButton.MouseLeave;
begin
  inherited;
  if Down and (GroupIndex <> 0) then
    FState := bsExclusive
  else
    if FState <> bsChevronDown then
      FState := bsUp;
  Invalidate;
end;

procedure TTeCustomSpeedButton.CMDialogChar(var Message: TCMDialogChar);
begin
  with Message do
    if IsAccel(CharCode, Caption) and Enabled and Visible and
      (Parent <> nil) and Parent.Showing then
    begin

      Click;
      Result := 1;
    end
    else
      inherited;
end;

procedure TTeCustomSpeedButton.CMEnabledChanged(var Message: TMessage);
begin
  if Enabled then
  begin
    if Down and (GroupIndex <> 0) then
      FState := bsExclusive
    else
      FState := bsUp;
  end;
  Invalidate;
end;

