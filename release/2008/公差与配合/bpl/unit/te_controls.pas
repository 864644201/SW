  Color := clBtnFace;

  FPerformance := kspNoBuffer;
  FScrollBars := ssNone;

  FBevelSides := [kbsLeft, kbsTop, kbsRight, kbsBottom];
  FBevelInner := kbvLowered;
  FBevelOuter := kbvLowered;
  FBevelWidth := 0;

  FBorderWidth := 0;

