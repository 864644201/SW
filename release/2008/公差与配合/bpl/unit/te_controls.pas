type

  TTeClickHandler = class(TForm)
  private
    procedure WMClickEvent(var Msg: TMessage); message WM_CLICKEVENT;
  public
    constructor CreateHandler;
  end;

{ TTeClickHandler }

constructor TTeClickHandler.CreateHandler;
begin
  inherited CreateNew(nil);
  SetBounds(10000, 10000, 0, 0);
end;

procedure TTeClickHandler.WMClickEvent(var Msg: TMessage);
var
  Item: TTeCustomItem;
begin
  if Msg.LParam = 0 then Exit;
  if Pointer(Msg.LParam) = nil then Exit;
  if not (TObject(Msg.LParam) is TTeCustomItem) then Exit;

  Application.ProcessMessages;

  Item := TTeCustomItem(Msg.LParam);

  with Item do
  begin
    if Assigned(OnClick) and (Action <> nil) and not (@FOnClick = @Action.OnExecute) then
      FOnClick(Item)
    else
      if not (csDesigning in ComponentState) and (ActionLink <> nil) then
        ActionLink.Execute
      else
        if Assigned(FOnClick) then
          FOnClick(Item);
  end;
end;

