  end;
end;

procedure TTeGraphicControl.Paint;
var
  SavedDC: HDC;
  DoubleBuffer: TTeBitmap;
  R: TRect;
  SaveIndex: integer;
begin
  if (Width <= 0) or (Height <= 0) then Exit;

  DoubleBuffer := nil;
  SavedDC := Canvas.Handle;
  Canvas.Lock;
  try
    { Change Canvas }
    case FPerformance of
      kspSharedBuffer:
        begin
          if SharedBuffer.Empty then InitSharedBuffer;
          Canvas.Handle := SharedBuffer.DC;
        end;
      kspDoubleBuffer:
        begin
          DoubleBuffer := TTeBitmap.Create;
          DoubleBuffer.SetSize(Width, Height);

          Canvas.Handle := DoubleBuffer.DC;
        end;
    end;

    { Assign props }
    FFont.Assign(Self.Font);

    { Paint }
    if FTransparent then
      PaintOwnerBackground(Canvas.Handle);
    PaintBuffer;

    { Blending }
    if FBlending.Enabled and (FPerformance <> kspNoBuffer) then
    begin
      { Paint to Back }
      FBack.SetSize(Width, Height);
      FBack.SetAlpha(255);
      { Paing owner }
      PaintOwnerBackground(FBack.DC);
      { Blending }
      case FPerformance of
        kspSharedBuffer:
          begin
            R := Rect(0, 0, Width, Height);
            SharedBuffer.SetAlpha(FBlending.Value, R);
            SharedBuffer.MergeDraw(FBack, 0, 0, R);
          end;
        kspDoubleBuffer:
          begin
            DoubleBuffer.SetAlpha(FBlending.Value);
            DoubleBuffer.MergeDraw(FBack, 0, 0, Rect(0, 0, Width, Height));
          end;
      end;
    end;

    { Paint from buffer }
    case FPerformance of
      kspSharedBuffer:
        begin
          SharedBuffer.Draw(SavedDC, 0, 0, Rect(0, 0, Width, Height));
        end;
      kspDoubleBuffer:
        begin
          DoubleBuffer.Draw(SavedDC, 0, 0);
        end;
    end;
  finally
    if Canvas.Handle <> SavedDC then
      Canvas.Handle := SavedDC;
    Canvas.UnLock;

    if FPerformance = kspDoubleBuffer then
      DoubleBuffer.Free;
  end;
end;

