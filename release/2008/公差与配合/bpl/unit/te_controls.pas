end;

procedure TTeCustomComboBox.CMMouseWheel(var Msg: TCMMouseWheel);
var
  Dy: integer;
  sl: integer;
begin
  if IsWinNT or IsWin98 then
    SystemParametersInfo(SPI_GETWHEELSCROLLLINES, 0, @sl, SPIF_SENDCHANGE)
  else
    sl := 3;

  if sl = 0 then
    sl := 1;

  Dy := Msg.WheelDelta div (MOUSE_WHEEL_DELTA div sl);

  ItemIndex := ItemIndex - Dy;
  if ItemIndex < 0 then ItemIndex := 0;
  if ComboStyle = kcsDropDownList then Change;
  Invalidate;
end;

procedure TTeCustomComboBox.WMMouseWheel(var Msg: TWMMouseWheel);
var
  Dy: integer;
begin
  Dy := Msg.WheelDelta div MOUSE_WHEEL_DELTA;

  ItemIndex := ItemIndex - Dy;
  if ItemIndex < 0 then ItemIndex := 0;  
  if ComboStyle = kcsDropDownList then Change;
  Invalidate;
end;

