const
  CResizeCatchAreaWidth = 10;
  CDragStartDelta = 5;

type

  TTeHeaderSectionsHack = class(TTeHeaderSections);

{ TEkCustomHeaderCtrl }

constructor TTeCustomHeaderControl.Create(AOwner: TComponent);
begin
  inherited;
  BevelSides := [kbsLeft, kbsTop, kbsRight, kbsBottom];
  BevelInner := kbvSpace;
  BevelOuter := kbvSpace;
  BevelWidth := 0;
  BorderWidth := 0;

  DrawXPBorder := false; // Disable drawing XP border 

  FSections := TTeHeaderSections.Create(Self);

  FMouseOnSectionIndex := -1;
  FMouseDownOnSectionIndex := -1;
  FMouseOnResizeArea := False;
  FResizingSectionIndex := -1;
  FDraggingSectionIndex := -1;
  FSectionUnderDragIndex := -1;
  FMDownX := -1;
  FResizeWidth := -1;
  FDraggingSectionLeft := -1;
  FImageList := nil;

  FDragReorder := false;
  FFullDrag := True;
  FHotTrack := False;

  if UseThemes then
    Height := 21
  else
    Height := 17;
end;

destructor TTeCustomHeaderControl.Destroy;
begin
  FSections.Free;
  inherited;
end;

function TTeCustomHeaderControl.GetDropPosition(x: integer): integer;
begin
  Result := GetSectionIndexAtPoint(x) + 1;
  if Result > Sections.Count then
    Result := Sections.Count
  else
    if Result > 0 then
      if x < Sections[Result-1].Left+Sections[Result-1].Width div 2 then
        Result := Result -1;
end;

procedure TTeCustomHeaderControl.GetPtInSection(Pt: TPoint; out SectionIndex: integer;
  out OnResizeArea: boolean);
var
  CurSectionRight, TmpRight: integer;
  TmpRect: TRect;
begin
  TmpRect := GetBorderRect;
  with Pt do
    if (y < TmpRect.Top) or (y > TmpRect.Bottom) or
      (x < TmpRect.Left) or (Sections.Count <= 0) then
    begin
      SectionIndex := -1;
      OnResizeArea := False;
    end
  else
  begin
    CurSectionRight := TmpRect.Left;
    SectionIndex := -1;

    repeat
      Inc(SectionIndex);
      Inc(CurSectionRight, Sections[SectionIndex].Width);
      if SectionIndex + 1 <= Sections.Count - 1 then
        TmpRight := CurSectionRight + Sections[SectionIndex +
          1].GetResizeCatchAreaWidth
      else
        TmpRight := CurSectionRight + Sections[SectionIndex].GetResizeCatchAreaWidth;
    until (TmpRight > x) or (SectionIndex + 1 > Sections.Count - 1);

    if (TmpRight > x) and
      (CurSectionRight - x < Sections[SectionIndex].GetResizeCatchAreaWidth) then
      OnResizeArea := True
    else 
    begin
      if x > CurSectionRight then
      begin
        if x - CurSectionRight <= CResizeCatchAreaWidth then
          OnResizeArea := True;
        SectionIndex := -1;
      end
      else 
      begin
        OnResizeArea := false;
        if CurSectionRight < x then
          SectionIndex := -1;
      end;
    end;
  end;
end;

function TTeCustomHeaderControl.GetSectionIndexAtPoint(x: integer): integer;
var
  CurSectRight: integer;
begin
  Result := -1;
  CurSectRight := GetBorderRect.Left;
  while (CurSectRight <= x) and (Result <= Sections.Count - 1) do
  begin
    Result := Result + 1;
    if Result <= Sections.Count - 1 then
      Inc(CurSectRight, Sections[Result].Width)
    else
      CurSectRight := Width;
  end;
end;

function TTeCustomHeaderControl.GetSectionRect(Index: integer): TRect;
var
  i: integer;
  TmpRect: TRect;
begin
  TmpRect := GetBorderRect;
  with Result do
  begin
    Left := TmpRect.Left;

    for i := 0 to Index - 1 do
      Inc(Left, Sections[i].Width);

    Right := Left + Sections[Index].Width;
    Top := TmpRect.Top;
    Bottom := TmpRect.Bottom;
  end;
end;

procedure TTeCustomHeaderControl.MouseDown(Button: TMouseButton;
  Shift: TShiftState; x, y: integer);
begin
  inherited;
  if (Button = mbLeft) and Enabled then begin
    FMDownX := x;
    if not MouseOnResizeArea then
      MouseDownOnSectionIndex := MouseOnSectionIndex;
    if (FMouseOnSectionIndex <> -1) and MouseOnResizeArea then
      BeginSectionResize;
  end;
end;

procedure TTeCustomHeaderControl.MouseMove(Shift: TShiftState; x,
  y: integer);
var
  LTmpMouseOnSectionIndex: integer;
  LTmpMouseOnResizeArea: boolean;
begin
  inherited;

  if FResizingSectionIndex = -1 then
  begin
    GetPtInSection(Point(x, y), LTmpMouseOnSectionIndex, LTmpMouseOnResizeArea);
    MouseOnSectionIndex := LTmpMouseOnSectionIndex;
    MouseOnResizeArea := LTmpMouseOnResizeArea;

    if (MouseDownOnSectionIndex <> -1) and (Abs(FMDownX - x) > CDragStartDelta) and
      (DraggingSectionIndex = -1)
    then
      BeginSectionDrag;

    if DraggingSectionIndex <> -1 then
      ContinueSectionDrag(x)
    else
      SectionUnderDragIndex := -1;
  end
  else
    ContinueSectionResize(x);

  if FMouseOnResizeArea then
    Cursor := crHSplit
  else
    Cursor := crDefault;
end;

procedure TTeCustomHeaderControl.MouseUp(Button: TMouseButton;
  Shift: TShiftState; x, y: integer);
var
  TmpIndex: integer;
begin
  inherited;
  if FMouseDownOnSectionIndex <> -1 then
  begin
    TmpIndex := PressedSection;
    MouseDownOnSectionIndex := -1;
    if (TmpIndex <> -1) and (DraggingSectionIndex = -1) then
      DoSectionClick(Sections[TmpIndex]);
  end;

  if DraggingSectionIndex <> -1 then
    EndSectionDrag;

  if FResizingSectionIndex <> -1 then
    EndSectionResize;
end;

procedure TTeCustomHeaderControl.PaintBuffer;
begin
  PaintBackGround;
  PaintSections;
  if DraggingSectionIndex <> -1 then
    PaintDraggingSection;
end;

procedure TTeCustomHeaderControl.PaintSection(Index: integer);
var
  TmpState: TTeSectionState;
  TmpRect: TRect;
  LDCState: integer;
begin
  if (Index >= 0) and (Index <= Sections.Count - 1) then
  begin
    LDCState := SaveDC(Canvas.Handle);
    TmpRect := GetSectionRect(Index);

    with TmpRect do
      IntersectClipRect(Canvas.Handle, Left, Top, Right, Bottom);
    if DraggingSectionIndex <> -1 then
      with GetDraggingSectionRect do
        ExcludeClipRect(Canvas.Handle, Left, Top, Right, Bottom);

    if Index = PressedSection then
      TmpState := ssPressed
    else if Index = DraggingSectionIndex then
      TmpState := ssDraggedOut
    else if Index = MouseOnSectionIndex then
      TmpState := ssHot
    else if Index = SectionUnderDragIndex then
      TmpState := ssUnderDrag
    else
      TmpState := ssNormal;

    DrawSection(Sections[Index], TmpRect, TmpState);
    RestoreDC(Canvas.Handle, LDCState);
  end;
end;

function TTeCustomHeaderControl.GetDraggingSectionRect: TRect;
begin
  with Result do
  begin
    Left := FDraggingSectionLeft;
    Right := Left + Sections[DraggingSectionIndex].Width;
    Top := GetBorderRect.Top;
    Bottom := GetBorderRect.Bottom;
  end;
end;

procedure TTeCustomHeaderControl.PaintDraggingSection;
begin
  DrawSection(Sections[DraggingSectionIndex], GetDraggingSectionRect, ssDraggin);
end;

procedure TTeCustomHeaderControl.PaintSections;
begin
  PaintSectionsFrom(0);
end;

procedure TTeCustomHeaderControl.PaintSectionsFrom(StartIndex: integer);
var
  i: integer;
begin
  for i := StartIndex to Sections.Count - 1 do
    PaintSection(i);
  PaintTailSection;
end;

function TTeCustomHeaderControl.GetImageSize(Section: TTeHeaderSection): TPoint;
begin
  with Result do
    if Assigned(Images) and (Section.ImageIndex >= 0) and
      (Section.ImageIndex <= Images.Count - 1) then
      Result := Point(Images.Width, Images.Height)
  else
    Result := Point(0,0);
end;

function TTeCustomHeaderControl.GetTextSize(Section: TTeHeaderSection): TPoint;
var
  TmpMaxHSize: integer;
begin
  with Result, Canvas, Section do
  begin
    Font := Self.Font;
    x := TextWidth(Text);

    if not AutoSize then
    begin
      if GetImageVisible(Section) then
        TmpMaxHSize := Section.Width - GetImageSize(Section).x - Spacing - Margin * 2
      else
        TmpMaxHSize := Section.Width - Margin * 2;

      if x > TmpMaxHSize then
        x := TmpMaxHSize;
    end;

    if Text <> '' then
      y := TextHeight('Pq')
    else
      y := 0;
  end;
end;

function TTeCustomHeaderControl.GetImageRect(Section: TTeHeaderSection): TRect;
var
  LGlyphSize, LCaptionSize, LSectionSize: TPoint;
begin
  with Section do
  begin
    LGlyphSize := GetImageSize(Section);
    LCaptionSize := GetTextSize(Section);
    with GetSectionRect(Index) do
      LSectionSize := Point(Right - Left, Bottom - Top);

    if Layout = hglGlyphLeft then
      case Alignment of
        taLeftJustify, taRightJustify:
          Result.Left := Margin;
        taCenter:
          Result.Left := (LSectionSize.X - (LGlyphSize.x + Spacing + LCaptionSize.x)) div 2;
      end
    else {Layout = hglGlyphRight}
      case Alignment of
        taLeftJustify, taRightJustify:
          Result.Left := LSectionSize.x - (Margin + LGlyphSize.x);
        taCenter:
          Result.Left := LSectionSize.X - (LSectionSize.X -
            (LGlyphSize.x + Spacing + LCaptionSize.x)) div 2 - LGlyphSize.x;
      end;

    Result.Right := Result.Left + LGlyphSize.x;
    Result.Top := (LSectionSize.y - LGlyphSize.y) div 2;
    Result.Bottom := Result.Top + LGlyphSize.y;
  end;
end;

function TTeCustomHeaderControl.GetTextRect(Section: TTeHeaderSection): TRect;
var
  LGlyphSize, LCaptionSize, LSectionSize: TPoint;
begin
  with Section do
  begin
    LGlyphSize := GetImageSize(Section);
    LCaptionSize := GetTextSize(Section);
    with GetSectionRect(Index) do
      LSectionSize := Point(Right - Left, Bottom - Top);
    if Layout = hglGlyphLeft then
      case Alignment of
        taLeftJustify, taRightJustify:
        begin
          if GetImageVisible(Section) then
            Result.Left := Margin + LGlyphSize.x + Spacing
          else
            Result.Left := Margin;
          Result.Right := LSectionSize.x - Margin;
        end;
        taCenter:
        begin
          if GetImageVisible(Section) then
            Result.Left := (LSectionSize.X - (LGlyphSize.x + Spacing + LCaptionSize.x)) div
              2 +
              LGlyphSize.x + Spacing
          else
            Result.Left := (LSectionSize.X - LCaptionSize.x) div 2;
          Result.Right := Result.Left + LCaptionSize.x;
        end;
      end
    else {Layout = hglGlyphRight}
      case Alignment of
        taLeftJustify, taRightJustify:
        begin
          Result.Left := Margin;
          if GetImageVisible(Section) then
            Result.Right := LSectionSize.x - (Margin + LGlyphSize.x + Spacing)
          else
            Result.Right := Margin;
        end;
        taCenter:
        begin
          if GetImageVisible(Section) then
            Result.Left := (LSectionSize.X - (LGlyphSize.x + Spacing + LCaptionSize.x)) div 2
          else
            Result.Left := (LSectionSize.X - LCaptionSize.x) div 2;
          Result.Right := Result.Left + LCaptionSize.x;
        end;
      end;

    Result.Top := (LSectionSize.y - LCaptionSize.y) div 2;
    Result.Bottom := Result.Top + LCaptionSize.y;
  end;
end;

function TTeCustomHeaderControl.GetImageVisible(Section: TTeHeaderSection): boolean;
begin
  Result := Section.ShowImage and Assigned(Images) and (Section.ImageIndex >= 0)
    and (Section.ImageIndex <= Images.Count - 1);
end;

procedure TTeCustomHeaderControl.DrawSectionImage(Section: TTeHeaderSection;
  ARect: TRect; Offset: TPoint; AState: TTeSectionState);
var
  LImageRect: TRect;
begin
  if not GetImageVisible(Section) then
    Exit;
  LImageRect := GetImageRect(Section);
  OffsetRect(LImageRect, Offset.x + ARect.Left, Offset.y + ARect.Top);
  with LImageRect do
    Images.Draw(Canvas, Left, Top, Section.ImageIndex);
end;

procedure TTeCustomHeaderControl.DrawSectionText(Section: TTeHeaderSection;
  ARect: TRect; Offset: TPoint; AState: TTeSectionState);
const
  AlignStyles: array [TAlignment] of integer = (DT_LEFT, DT_RIGHT, DT_CENTER);
var
  LTextRect: TRect;
  TmpText: WideString;
begin
  LTextRect := GetTextRect(Section);
  OffsetRect(LTextRect, Offset.x + ARect.Left, Offset.y + ARect.Top);
  IntersectRect(LTextRect, LTextRect, ARect);

  with Canvas, Section do
  begin
    Font := Self.Font;
    Brush.Style := bsClear;
    case AState of
      ssDraggedOut: Font.Color := cl3DLight;
      ssHot, ssPressed:
        if HotTrack then
          Font.Color := clBlue;
    end;
    with LTextRect do
      TmpText := FormatStr(Handle, Text, Right - Left);
    Brush.Color := clNone;
    Brush.Style := bsClear;
    DrawText(Canvas, TmpText, LTextRect, DrawTextBiDiModeFlags(AlignStyles[Alignment]));
  end;
end;

procedure TTeCustomHeaderControl.DrawSection(Section: TTeHeaderSection; ARect: TRect;
  AState: TTeSectionState);
var
  DrawFlags: integer;
  LOffset: TPoint;
  Theme: HTheme;
  Part, ThemeState: integer;
begin
  with ARect do
    if Right - Left <= 1 then
      Exit;

  LOffset := Point(0,0);
  DrawFlags := DFCS_BUTTONPUSH;
  if AState in [ssPressed, ssDraggedOut, ssUnderDrag] then
  begin
    DrawFlags := DrawFlags or DFCS_FLAT;
    LOffset := Point(1,1);
  end;

  if not UseThemes then
  begin
    { Default style }
    if AState = ssDraggedOut then
      with Canvas do
      begin
        Brush.Color := cl3DDkShadow;
        FillRect(ARect);
      end
    else
      DrawFrameControl(Canvas.Handle, ARect, DFC_BUTTON, DrawFlags);
  end
  else
  begin
    { XP Style }
    Theme := OpenThemeData(0, 'Header');
    Part := integer(HP_HEADERITEM);
    if AState in [ssDraggedOut, ssPressed] then
      ThemeState := Integer(HIS_PRESSED)
    else
      if AState in [ssHot, ssDraggin] then
        ThemeState := Integer(HIS_HOT)
      else
        ThemeState := Integer(HIS_NORMAL);

    DrawThemeBackground(Theme, Canvas.Handle, Part, ThemeState, ARect, nil);
    CloseThemeData(Theme);
  end;

  if Section.Style = hsOwnerDraw then
    DoDrawSection(Self, Section, ARect, AState)
  else
  begin
    DrawSectionText(Section, ARect, LOffset, AState);
    if Section.ShowImage then
      DrawSectionImage(Section, ARect, LOffset, AState);
  end;
end;

procedure TTeCustomHeaderControl.DrawTailSection(ARect: TRect);
var
  Theme: HTheme;
  Part, ThemeState: integer;
begin
  if not UseThemes then
  begin
    { Default drawing }
    DrawFrameControl(Canvas.Handle, ARect, DFC_BUTTON, DFCS_BUTTONPUSH);
  end
  else
  begin
    { XP Style }
    Theme := OpenThemeData(0, 'Header');
    Part := integer(HP_HEADERITEM);
    ThemeState := Integer(HIS_NORMAL);
    DrawThemeBackground(Theme, Canvas.Handle, Part, ThemeState, ARect, nil);
    CloseThemeData(Theme);
  end;
end;

procedure TTeCustomHeaderControl.DrawResizeLabel(x: integer);
begin
  with Canvas do
  begin
    Pen.Color := clBtnText;
    with GetBorderRect do
    begin
      MoveTo(x, Top);
      LineTo(x, Bottom);
    end;
  end;
end;

procedure TTeCustomHeaderControl.PaintTailSection;
var
  LTailRect: TRect;
  LDCState: integer;
begin
  if Sections.Count <= 0 then Exit;

  LDCState := SaveDC(Canvas.Handle);
  with GetBorderRect do
    IntersectClipRect(Canvas.Handle, Left, Top, Width, Bottom);

  with GetBorderRect do
  begin
    LTailRect.Top := Top;
    LTailRect.Bottom := Bottom;
    LTailRect.Left := Sections[Sections.Count - 1].Right;
    LTailRect.Right := Self.Width;
  end;

  DrawTailSection(LTailRect);

  RestoreDC(Canvas.Handle, LDCState);
end;

procedure TTeCustomHeaderControl.PaintBackGround;
var
  LDCState: integer;
  Theme: HTheme;
  Part, ThemeState: integer;
begin
  with Canvas do
  begin
    LDCState := SaveDC(Handle);
    if Sections.Count > 0 then
      with GetBorderRect do
        ExcludeClipRect(Handle, Left, Top, Right, Bottom);

    if not UseThemes then
    begin
      { Default drawing }
      Brush.Style := bsSolid;
      Brush.Color := clBtnFace;
      FillRect(GetClientRect);
    end
    else
    begin
      { XP Style }
      Theme := OpenThemeData(0, 'Header');
      Part := integer(0);
      ThemeState := Integer(0);
      DrawThemeBackground(Theme, Canvas.Handle, Part, ThemeState, GetClientRect, nil);
      CloseThemeData(Theme);
    end;

    RestoreDC(Handle, LDCState);
  end;
end;

procedure TTeCustomHeaderControl.SectionChanged(Index: integer; WidthChanged: boolean);
begin
  if not WidthChanged then
    PaintSection(Index)
  else
    PaintSectionsFrom(Index);
end;

procedure TTeCustomHeaderControl.BeginSectionDrag;
begin
  if DragReorder then
  begin
    DraggingSectionIndex := MouseDownOnSectionIndex;
    FCatchDelta := Sections[DraggingSectionIndex].Left - FMDownX;
    FDraggingSectionLeft := Sections[DraggingSectionIndex].Left;
  end;
end;

procedure TTeCustomHeaderControl.ContinueSectionDrag(x: integer);
var
  UpdBegX, UpdEndX: integer;
  UpdBegSectIndx, UpdEndSectIndx, UpdCurSectIndx: integer;
  LDCState: integer;
begin
  if FDraggingSectionLeft <= x + FCatchDelta then
  begin
    UpdBegX := FDraggingSectionLeft;
    UpdEndX := x + FCatchDelta;
  end
  else
  begin
    UpdBegX := x + FCatchDelta + Sections[FDraggingSectionIndex].Width;
    UpdEndX := FDraggingSectionLeft + Sections[FDraggingSectionIndex].Width;
  end;
  UpdBegSectIndx := GetSectionIndexAtPoint(UpdBegX);
  UpdEndSectIndx := GetSectionIndexAtPoint(UpdEndX);

  FDraggingSectionLeft := x + FCatchDelta;

  LDCState := SaveDC(Canvas.Handle);

  SectionUnderDragIndex := GetDropPosition(FDraggingSectionLeft);

  with GetBorderRect do
    IntersectClipRect(Canvas.Handle, UpdBegX, Top, UpdEndX, Bottom);

  if UpdBegSectIndx < 0 then
  begin
    UpdBegSectIndx := 0;
    PaintBackGround;
  end;
  if UpdEndSectIndx > Sections.Count - 1 then
  begin
    UpdEndSectIndx := Sections.Count - 1;
    PaintTailSection;
    PaintBackGround;
  end;

  for UpdCurSectIndx := UpdBegSectIndx to UpdEndSectIndx do
    PaintSection(UpdCurSectIndx);

  RestoreDC(Canvas.Handle, LDCState);
  PaintDraggingSection;
end;

procedure TTeCustomHeaderControl.EndSectionDrag;
var
  LTmpSectionIndex: integer;
  LUpdBegX, LUpdEndX,
  LUpdBegSectIndx, LUpdEndSectIndx, LUpdCurSectIndx : integer;
begin
  LTmpSectionIndex := SectionUnderDragIndex;
  if LTmpSectionIndex > DraggingSectionIndex then
    LTmpSectionIndex := LTmpSectionIndex - 1;

  with GetDraggingSectionRect do begin
    LUpdBegX := Left;
    LUpdEndX := Right;
  end;
  LUpdBegSectIndx := GetSectionIndexAtPoint(LUpdBegX);
  LUpdEndSectIndx := GetSectionIndexAtPoint(LUpdEndX);

  if (DraggingSectionIndex <> -1) and (LTmpSectionIndex <> -1) then
    if DoSectionDrag(Sections[DraggingSectionIndex], Sections[LTmpSectionIndex]) then
      with Sections do
      begin
        if LTmpSectionIndex <> DraggingSectionIndex then
          Sections[DraggingSectionIndex].Index := LTmpSectionIndex;
        DraggingSectionIndex := -1;
        SectionUnderDragIndex := -1;
        DoSectionEndDrag;
      end;

  DraggingSectionIndex := -1;
  SectionUnderDragIndex := -1;
  for LUpdCurSectIndx := LUpdBegSectIndx to LUpdEndSectIndx do
    if LUpdCurSectIndx <> SectionUnderDragIndex then
      PaintSection(LUpdCurSectIndx);
  if LUpdEndSectIndx >= Sections.Count-1 then begin
    PaintBackGround;
    PaintTailSection;
  end else
    if LUpdBegSectIndx <= 0 then
      PaintBackGround;
end;

procedure TTeCustomHeaderControl.BeginSectionResize;
begin
  FResizingSectionIndex := FMouseOnSectionIndex;
  FCatchDelta := GetSectionRect(FResizingSectionIndex).Right - FMDownX;
  FResizeWidth := Sections[FResizingSectionIndex].Width;
  DoSectionTrack(Sections[FResizingSectionIndex], FResizeWidth, tsTrackBegin);
end;

procedure TTeCustomHeaderControl.ContinueSectionResize(x: integer);
var
  LOldResizeWidth: integer;
  LOldLabelSectionIndex: integer;
begin
  LOldResizeWidth := FResizeWidth;
  FResizeWidth := (x + FCatchDelta) - Sections[FResizingSectionIndex].Left;

  if FResizeWidth < Sections[FResizingSectionIndex].MinWidth then
    FResizeWidth := Sections[FResizingSectionIndex].MinWidth;

  if FullDrag then
    ResizeSection(FResizingSectionIndex, FResizeWidth)
  else
  begin
    LOldLabelSectionIndex :=
      GetSectionIndexAtPoint(Sections[FResizingSectionIndex].Left + LOldResizeWidth);
    if LOldLabelSectionIndex > Sections.Count - 1 then
      PaintTailSection
    else if LOldLabelSectionIndex >= 0 then
      PaintSection(LOldLabelSectionIndex);
    PaintBackGround;
    DrawResizeLabel(Sections[FResizingSectionIndex].Left + FResizeWidth);
  end;
  DoSectionTrack(Sections[FResizingSectionIndex], FResizeWidth, tsTrackMove);
end;

procedure TTeCustomHeaderControl.EndSectionResize;
begin
  if not FullDrag then
    ResizeSection(FResizingSectionIndex, FResizeWidth);
  DoSectionTrack(Sections[FResizingSectionIndex], FResizeWidth, tsTrackEnd);
  FResizingSectionIndex := -1;
end;

procedure TTeCustomHeaderControl.ResizeSection(SectionIndex, NewWidth: integer);
var
  TmpWidth: integer;
begin
  with Sections[SectionIndex] do
  begin
    TmpWidth := Width;
    Width := NewWidth;
    if Width <> TmpWidth then
      DoSectionResize(Sections[SectionIndex]);
  end;
end;

