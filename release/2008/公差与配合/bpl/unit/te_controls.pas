procedure TTeCustomStatusBar.PaintPanel(Index: integer);
var
  TmpRect: TRect;
  LDCState: integer;
begin
  if (Index >= 0) and (Index <= Panels.Count - 1) then
  begin
    TmpRect := GetPanelRect(Index);
    if not IsRectEmpty(TmpRect) then begin
      LDCState := SaveDC(Canvas.Handle);
      try
        with TmpRect do
          IntersectClipRect(Canvas.Handle, Left, Top, Right, Bottom);
        DrawPanel(Panels[Index], TmpRect, Index = Panels.Count - 1);
      finally
        RestoreDC(Canvas.Handle, LDCState);
      end;
    end;
  end;
end;

procedure TTeCustomStatusBar.PaintPanels;
var
  i: integer;
begin
  for i := 0 to Panels.Count - 1 do
    PaintPanel(i);
end;

function TTeCustomStatusBar.GetImageSize(Panel: TTeStatusPanel): TPoint;
begin
  with Result do
    if Assigned(Images) and (Panel.ImageIndex >= 0) and
      (Panel.ImageIndex <= Images.Count - 1) then
      Result := Point(Images.Width, Images.Height)
  else
    Result := Point(0,0);
end;

function TTeCustomStatusBar.GetTextSize(Panel: TTeStatusPanel): TPoint;
var
  TmpMaxHSize: integer;
begin
  with Result, Canvas, Panel do
  begin
    Font := Self.Font;
    x := TextWidth(Text);

    if not AutoSize then
    begin
      if GetImageVisible(Panel) then
        TmpMaxHSize := Panel.CurrentWidth - GetImageSize(Panel).x - Spacing - Margin * 2
      else
        TmpMaxHSize := Panel.CurrentWidth - Margin * 2;

      if x > TmpMaxHSize then
        x := TmpMaxHSize;
    end;

    if Text <> '' then
      y := TextHeight('Pq')
    else
      y := 0;
  end;
end;

function TTeCustomStatusBar.GetImageRect(Panel: TTeStatusPanel): TRect;
var
  LGlyphSize, LCaptionSize, LPanelSize: TPoint;
begin
  with Panel do
  begin
    LGlyphSize := GetImageSize(Panel);
    LCaptionSize := GetTextSize(Panel);
    with GetPanelClientRect(Panel) do
      LPanelSize := Point(Right - Left, Bottom - Top);

    if Layout = sglGlyphLeft then
      case Alignment of
        taLeftJustify, taRightJustify:
          Result.Left := Margin;
        taCenter:
          Result.Left := (LPanelSize.X - (LGlyphSize.x + Spacing + LCaptionSize.x)) div 2;
      end
    else {Layout = sglGlyphRight}
      case Alignment of
        taLeftJustify, taRightJustify:
          Result.Left := LPanelSize.x - (Margin + LGlyphSize.x);
        taCenter:
          Result.Left := LPanelSize.X - (LPanelSize.X -
            (LGlyphSize.x + Spacing + LCaptionSize.x)) div 2 - LGlyphSize.x;
      end;

    Result.Right := Result.Left + LGlyphSize.x;
    Result.Top := (LPanelSize.y - LGlyphSize.y) div 2;
    Result.Bottom := Result.Top + LGlyphSize.y;
  end;
end;

function TTeCustomStatusBar.GetTextRect(Panel: TTeStatusPanel): TRect;
var
  LGlyphSize, LCaptionSize, LPanelSize: TPoint;
begin
  with Panel do
  begin
    LGlyphSize := GetImageSize(Panel);
    LCaptionSize := GetTextSize(Panel);
    with GetPanelClientRect(Panel) do
      LPanelSize := Point(Right - Left, Bottom - Top);
    if Layout = sglGlyphLeft then
      case Alignment of
        taLeftJustify, taRightJustify:
        begin
          if GetImageVisible(Panel) then
            Result.Left := Margin + LGlyphSize.x + Spacing
          else
            Result.Left := Margin;
          Result.Right := LPanelSize.x - Margin;
        end;
        taCenter:
        begin
          if GetImageVisible(Panel) then
            Result.Left := (LPanelSize.X - (LGlyphSize.x + Spacing + LCaptionSize.x)) div 2 +
              LGlyphSize.x + Spacing
          else
            Result.Left := (LPanelSize.X - LCaptionSize.x) div 2;
          Result.Right := Result.Left + LCaptionSize.x + 10;
        end;
      end
    else {Layout = sglGlyphRight}
      case Alignment of
        taLeftJustify, taRightJustify:
        begin
          Result.Left := Margin;
          if GetImageVisible(Panel) then
            Result.Right := LPanelSize.x - (Margin + LGlyphSize.x + Spacing)
          else
            Result.Right := Margin;
        end;
        taCenter:
        begin
          if GetImageVisible(Panel) then
            Result.Left := (LPanelSize.X - (LGlyphSize.x + Spacing + LCaptionSize.x)) div 2
          else
            Result.Left := (LPanelSize.X - LCaptionSize.x) div 2;
          Result.Right := Result.Left + LCaptionSize.x;
        end;
      end;

    Result.Top := (LPanelSize.y - LCaptionSize.y) div 2;
    Result.Bottom := Result.Top + LCaptionSize.y;
  end;
end;

function TTeCustomStatusBar.GetImageVisible(Panel: TTeStatusPanel): boolean;
begin
  Result := Panel.ShowImage and Assigned(Images) and (Panel.ImageIndex >= 0)
    and (Panel.ImageIndex <= Images.Count - 1);
end;

procedure TTeCustomStatusBar.DrawPanelImage(Panel: TTeStatusPanel;
  ARect: TRect);
var
  LImageRect: TRect;
begin
  if not GetImageVisible(Panel) then
    Exit;
  LImageRect := GetImageRect(Panel);
  with ARect do
    OffsetRect(LImageRect, Left, Top);
  with LImageRect do
    Images.Draw(Canvas, Left, Top, Panel.ImageIndex);
end;

procedure TTeCustomStatusBar.DrawPanelText(Panel: TTeStatusPanel;
  ARect: TRect);
const
  AlignStyles: array [TAlignment] of integer = (DT_LEFT, DT_RIGHT, DT_CENTER);
var
  LTextRect: TRect;
  TmpText: WideString;
begin
  LTextRect := GetTextRect(Panel);
  with ARect do
    OffsetRect(LTextRect, Left, Top);
  IntersectRect(LTextRect, LTextRect, ARect);

  with Canvas, Panel do
  begin
    Font := Self.Font;
    Brush.Style := bsClear;
    with LTextRect do
      TmpText := FormatStr(Handle, Text, Right - Left - 4);
    Brush.Color := clNone;
    Brush.Style := bsClear;
    DrawText(Canvas, TmpText, LTextRect, DrawTextBiDiModeFlags(AlignStyles[Alignment]));
  end;
end;

procedure TTeCustomStatusBar.DrawPanel(Panel: TTeStatusPanel; ARect: TRect; AGripper: boolean);
var
  TmpRect : TRect;
  Theme: HTheme;
  Part, ThemeState: integer;
begin
  SaveDC(Canvas.Handle);
  try
    if Panel.Control <> nil then
      with Panel.Control.BoundsRect do
        ExcludeClipRect(Canvas.Handle, Left, Top, Right, Bottom);

    TmpRect := ARect;

    if not UseThemes then
    begin
      { Default drwaing }
      with Canvas do
      begin
        Brush.Color := Self.Color;
        Brush.Style := bsSolid;
        FillRect(TmpRect);
      end;

      if Panel.Framed then
        DrawEdge(Canvas, TmpRect, clBtnShadow, clBtnHighlight);
    end
    else
    begin
      { XP Style }

      { Draw Background }
      Theme := OpenThemeData(0, 'Status');
      Part := integer(0);
      ThemeState := Integer(0);
      DrawThemeBackground(Theme, Canvas.Handle, Part, ThemeState, Rect(0, 0, Width, Height), nil);
      CloseThemeData(Theme);

      { Draw Panel }
      Theme := OpenThemeData(0, 'Status');
      if AGripper then
        Part := integer(SP_GRIPPERPANE)
      else
        Part := integer(SP_PANE);
      ThemeState := Integer(0);
      DrawThemeBackground(Theme, Canvas.Handle, Part, ThemeState, TmpRect, nil);
      CloseThemeData(Theme);
    end;

    if Panel.Style = psOwnerDraw then
      DoDrawPanel(Self, Panel, TmpRect)
    else
    begin
      DrawPanelText(Panel, TmpRect);
      if Panel.ShowImage then
        DrawPanelImage(Panel, TmpRect);
    end;
  finally
    RestoreDC(Canvas.Handle,-1);
  end;
end;

procedure TTeCustomStatusBar.PaintGripper;
var
  Theme: HTheme;
  Part, ThemeState: integer;
begin
  if not UseThemes then
  begin
    Canvas.Brush.Style := bsClear;
    DrawFrameControl(Canvas.Handle, GetGripperRect, DFC_SCROLL, DFCS_SCROLLSIZEGRIP);
//    FillRect(Canvas, GetGripperRect, clRed);
  end
  else
  begin
    { Draw Background }
    Theme := OpenThemeData(0, 'Status');
    Part := integer(SP_GRIPPER);
    ThemeState := Integer(0);
    DrawThemeBackground(Theme, Canvas.Handle, Part, ThemeState, GetGripperRect, nil);
    CloseThemeData(Theme);
  end;
end;

procedure TTeCustomStatusBar.PaintBackGround;
var
  LDCState: integer;
  Theme: HTheme;
  Part, ThemeState: integer;
begin
  LDCState := SaveDC(Canvas.Handle);
  try
    if Panels.Count > 0 then
      with GetPanelsRect do
        ExcludeClipRect(Canvas.Handle, Left, Top, Right, Bottom);

  if not UseThemes then
  begin
    { Default drawing }
    inherited PaintBuffer;
  end
  else
  begin
    { XP Style }
    Theme := OpenThemeData(0, 'Status');
    Part := integer(0);
    ThemeState := Integer(0);
    DrawThemeBackground(Theme, Canvas.Handle, Part, ThemeState, Rect(0, 0, Width, Height), nil);
    CloseThemeData(Theme);
  end;

  finally
    RestoreDC(Canvas.Handle, LDCState);
  end;
end;

