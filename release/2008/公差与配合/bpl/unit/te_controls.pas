procedure TTeCustomRangeBar.DrawTick(Value, Coord: integer;
  TopLeft: boolean);
var
  VCoord: integer;
  LThumbHeight: integer;
begin
  LThumbHeight := Round(GetThumbWidth * CStdRngThumbRatio);
  if TopLeft then
  begin
    VCoord := GetTopBottomMargin + 3;
    if Orientation = toHorizontal then
    begin
      MoveTo(Canvas, Coord, VCoord);
      if (Value = Min) or (Value = Max) then
        LineTo(Canvas, Coord, VCoord - 4, clBlack)
      else
        LineTo(Canvas, Coord, VCoord - 3, clBlack);
    end
    else
    begin
      MoveTo(Canvas, VCoord, Coord);
      if (Value = Min) or (Value = Max) then
        LineTo(Canvas, VCoord - 4, Coord, clBlack)
      else
        LineTo(Canvas, VCoord - 3, Coord, clBlack);
    end;
  end
  else
  begin
    if TickMarks = tmBoth then
      VCoord := GetTopBottomMargin + 4 + 1 +
        LThumbHeight
    else
      VCoord := GetTopBottomMargin + 1 +
        LThumbHeight;

    if Orientation = toHorizontal then
    begin
      MoveTo(Canvas, Coord, VCoord);
      if (Value = Min) or (Value = Max) then
        LineTo(Canvas, Coord, VCoord + 4, clBlack)
      else
        LineTo(Canvas, Coord, VCoord + 3, clBlack);
    end
    else
    begin
      MoveTo(Canvas, VCoord, Coord);
      if (Value = Min) or (Value = Max) then
        LineTo(Canvas, VCoord + 4, Coord, clBlack)
      else
        LineTo(Canvas, VCoord + 3, Coord, clBlack);
    end;
  end;
end;

function TTeCustomRangeBar.PtInHighThumb(x, y: integer): boolean;
var
  Bx, By: integer;
  LThumbWidth, LThumbHeight: integer;
begin
  LThumbWidth := GetThumbWidth;
  LThumbHeight := Round(LThumbWidth * CStdRngThumbRatio);
  if Orientation = toHorizontal then
  begin
    if not UseThemes then
      Bx := PositionCoordinate(HighPosition)
    else
      Bx := PositionCoordinate(HighPosition) - LThumbWidth div 2;
    By := GetTopBottomMargin;
    if ShowTicks and ((TickMarks = tmTopLeft) or (TickMarks = tmBoth)) then
      By := By + 4 + 1;
    case TickMarks of
      tmBottomRight:
        Result := PointInPolygon(Point(x, y), [Point(Bx, By),
          Point(Bx + LThumbWidth - 1, By),
            Point(Bx + LThumbWidth - 1, By + LThumbHeight - LThumbWidth),
            Point(Bx, By + LThumbHeight - 1)]);
      tmTopLeft:
        Result := PointInPolygon(Point(x, y),
          [Point(Bx, By), Point(Bx + LThumbWidth - 1, By + LThumbWidth - 1),
            Point(Bx + LThumbWidth - 1, By + LThumbHeight - 1),
              Point(Bx, By + LThumbHeight - 1)]);

      else { tmBoth }
        Result := PtInRect(Rect(Bx, By, Bx + LThumbWidth, By +
          LThumbHeight), Point(x, y));
    end;
  end
  else
  begin
    { Orientation = toVertical }
    Bx := GetTopBottomMargin;
    if not UseThemes then
      By := PositionCoordinate(HighPosition)
    else
      By := PositionCoordinate(HighPosition) - ThumbWidth div 2;
    if ShowTicks and ((TickMarks = tmTopLeft) or (TickMarks = tmBoth)) then
      Bx := Bx + 4 + 1;
    case TickMarks of
      tmBottomRight:
        Result := PointInPolygon(Point(x, y),
          [Point(Bx, By),
          Point(Bx + LThumbHeight - 1, By),
            Point(Bx + LThumbHeight - LThumbWidth, By + LThumbWidth - 1),
            Point(Bx, By + LThumbWidth - 1)]);

      tmTopLeft:
        Result := PointInPolygon(Point(x, y),
          [Point(Bx, By),
          Point(Bx + LThumbHeight - 1, By),
            Point(Bx + LThumbHeight - 1, By + LThumbWidth - 1),
            Point(Bx + LThumbWidth - 1, By + LThumbWidth - 1)]);

    else
      { tmBoth }
      Result := PtInRect(Rect(Bx, By, Bx + LThumbHeight, By +
        LThumbWidth), Point(x, y));
    end;
  end;
end;

function TTeCustomRangeBar.PtInLowThumb(x, y: integer): boolean;
var
  Bx, By: integer;
  LThumbWidth, LThumbHeight: integer;
begin
  LThumbWidth := GetThumbWidth;
  LThumbHeight := Round(LThumbWidth * CStdRngThumbRatio);

  if Orientation = toHorizontal then
  begin
    if not UseThemes then
      Bx := PositionCoordinate(LowPosition) - LThumbWidth + 1
    else
      Bx := PositionCoordinate(LowPosition) - LThumbWidth div 2;

    By := GetTopBottomMargin;
    if ShowTicks and ((TickMarks = tmTopLeft) or (TickMarks = tmBoth)) then
      By := By + 4 + 1;
    case TickMarks of
      tmBottomRight:
        Result := PointInPolygon(Point(x, y),
          [Point(Bx, By),
          Point(Bx + LThumbWidth - 1, By),
            Point(Bx + LThumbWidth - 1, By + LThumbHeight - 1),
            Point(Bx, By + LThumbHeight - LThumbWidth)]);

      tmTopLeft:
        Result := PointInPolygon(Point(x, y),
          [Point(Bx + LThumbWidth - 1, By),
          Point(Bx + LThumbWidth - 1, By + LThumbHeight - 1),
            Point(Bx, By + LThumbHeight - 1),
            Point(Bx, By + LThumbWidth - 1)]);

    else
      { tmBoth }
      Result := PtInRect(Rect(Bx, By, Bx + LThumbWidth, By +
        LThumbHeight), Point(x, y));
    end;
  end
  else
  begin
    { Orientation = toVertical }
    Bx := GetTopBottomMargin;
    if not UseThemes then
      By := PositionCoordinate(LowPosition) - LThumbWidth + 1
    else
      By := PositionCoordinate(LowPosition) - LThumbWidth div 2;
    if ShowTicks and ((TickMarks = tmTopLeft) or (TickMarks = tmBoth)) then
      Bx := Bx + 4 + 1;
    case TickMarks of
      tmBottomRight:
        Result := PointInPolygon(Point(x, y), [Point(Bx, By),
          Point(Bx + LThumbHeight - LThumbWidth, By),
            Point(Bx + LThumbHeight - 1, By + LThumbWidth - 1),
            Point(Bx, By + LThumbWidth - 1)]);

      tmTopLeft:
        Result := PointInPolygon(Point(x, y),
          [Point(Bx + LThumbWidth - 1, By),
           Point(Bx + LThumbHeight - 1, By),
            Point(Bx + LThumbHeight - 1, By + LThumbWidth - 1),
            Point(Bx, By + LThumbWidth - 1)]);
    else
      { tmBoth }
      Result := PtInRect(Rect(Bx, By, Bx + LThumbHeight, By +
        LThumbWidth), Point(x, y));
    end;
  end;
end;

procedure TTeCustomRangeBar.DrawTicks;
var
  CurPos: integer;
begin
  if ShowTicks then
  begin
    if (TickMarks = tmTopLeft) or (TickMarks = tmBoth) then
      for CurPos := Min to Max do
        if (CurPos mod Frequency = 0) or (CurPos = Min) or (CurPos = Max) then
          DrawTick(CurPos, PositionCoordinate(CurPos), true);
    if (TickMarks = tmBottomRight) or (TickMarks = tmBoth) then
      for CurPos := Min to Max do
        if (CurPos mod Frequency = 0) or (CurPos = Min) or (CurPos = Max) then
          DrawTick(CurPos, PositionCoordinate(CurPos), false);
  end;
end;

