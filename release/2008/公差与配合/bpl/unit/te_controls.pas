{ Alpha }

procedure TTeBitmap.MergeDraw(Bitmap: TTeBitmap; X, Y: integer; SrcRect: TRect);
var
  Index, i, j: integer;
  B, F: PKColor;
begin
  if SrcRect.Left < 0 then
  begin
    X := X + Abs(SrcRect.Left);
    SrcRect.Left := 0;
  end;
  if SrcRect.Top < 0 then
  begin
    Y := Y + Abs(SrcRect.Top);
    SrcRect.Top := 0;
  end;
  if SrcRect.Right > Bitmap.FWidth then SrcRect.Right := Bitmap.FWidth;
  if SrcRect.Bottom > Bitmap.FHeight then SrcRect.Bottom := Bitmap.FHeight;
  { Draw bitmap rect to another bitmap }
  for i := SrcRect.Left to SrcRect.Right-1 do
    for j := SrcRect.Top to SrcRect.Bottom-1 do
    begin
      { Get Back pixel from Bitmap }
      B := @Bitmap.FBits[i + j * Bitmap.FWidth];
      { Get fore pixel }
      Index := (X + i-SrcRect.Left) + (Y + j-SrcRect.Top) * FWidth;
      if Index >= FWidth * FHeight then Continue
      else F := @FBits[Index];
      
      { Blend }
      if TKColorRec(F^).A = 0 then
        F^ := B^
      else
        if (TKColorRec(F^).A <> $FF) then
        begin
          { Blend }
          F^ := BlendPixel(F^, B^);
        end;
    end;
end;

procedure TTeBitmap.SetAlpha(Alpha: byte);
begin
  if FWidth*FHeight > 0 then
    FillAlpha(FBits^, FWidth*FHeight-1, Alpha);
end;

procedure TTeBitmap.SetAlpha(Alpha: byte; Rect: TRect);
begin
  if RectWidth(Rect) = 0 then Exit;
  if RectHeight(Rect) = 0 then Exit;

  if Rect.Left < 0 then Rect.Left := 0;
  if Rect.Top < 0 then Rect.Top := 0;
  if Rect.Right > FWidth then Rect.Right := FWidth;
  if Rect.Bottom > FHeight then Rect.Bottom := FHeight;

  FillAlphaRect(FBits^, FWidth, FHeight, Rect.Left, Rect.Top, Rect.Right-1,
    Rect.Bottom-1, Alpha);
end;

