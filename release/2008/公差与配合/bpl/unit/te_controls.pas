begin
  Result := True;
end;

function TTeCustomItem.GetParentComponent: TComponent;
begin
  if (FParent <> nil) and (FParent.FParentComponent <> nil) then
    Result := FParent.FParentComponent
  else
    Result := FParent;
end;

procedure TTeCustomItem.SetParentComponent(Value: TComponent);
var
  i: integer;
begin
  if FParent <> nil then FParent.Remove(Self);

  if Value <> nil then
  begin
    if Value is TTeCustomItem then
      TTeCustomItem(Value).Add(Self)
    else
    begin
      if Assigned(ContainerClassList) then
        for i := ContainerClassList.Count-1 downto 0 do
          with PContainerClassData(ContainerClassList[I])^ do
            if Value is Cls then begin
              InsertItemProc(Value, Self);
              Break;
            end;
    end;
  end;
end;

procedure TTeCustomItem.Notification (AComponent: TComponent;
  Operation: TOperation);
begin
  inherited;
  if Operation = opRemove then
  begin
    if AComponent = Action then Action := nil;
    if AComponent = Images then Images := nil;
  end;
end;

procedure TTeCustomItem.Click;
begin
  if Assigned(FOnClick) then FOnClick(Self);
end;

procedure TTeCustomItem.Change;
var
  Item: TTeCustomItem;
begin
  if (csLoading in ComponentState) or (csDestroying in ComponentState) then Exit; 

  if Assigned(FOnInternalChange) then
    FOnInternalChange(Self);

  Item := Self;
  while Item.Parent <> nil do
    Item := Item.Parent;

  if Item <> nil then
    if Assigned(Item.FOnInternalChange) then
      Item.FOnInternalChange(Item);
end;

procedure TTeCustomItem.DoClick;
begin
  if Caption = '-' then Exit;
  if Count > 0 then Exit;
  if not Enabled then Exit;

  if ClickHandler <> nil then
  begin
    PostMessage(ClickHandler.Handle, WM_CLICKEVENT, 0, Integer(Self));
  end
  else
  begin
    if Assigned(FOnClick) and (Action <> nil) and not (@FOnClick = @Action.OnExecute) then
      FOnClick(Self)
    else
      if not (csDesigning in ComponentState) and (ActionLink <> nil) then
        ActionLink.Execute
      else
        if Assigned(FOnClick) then
          FOnClick(Self);
  end;
end;

