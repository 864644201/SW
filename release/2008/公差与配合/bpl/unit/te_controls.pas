function TTeCustomRangeBar.CoordinatePosition(ACoord: word): integer;
var
  LScaleWidth, LSideMargin, LThumbWidth: integer;
begin
  LSideMargin := GetSideMargin;
  LThumbWidth := GetThumbWidth;

  if Orientation = toHorizontal then
    LScaleWidth := ClientWidth
  else
    LScaleWidth := ClientHeight;
  LScaleWidth := LScaleWidth - LSideMargin * 2 - LThumbWidth * 2 + 1;

  Result := Round(((FMax - FMin) * (ACoord - LSideMargin - LThumbWidth - 1) /
    LScaleWidth + FMin));

  if Result < Min then
    Result := Min;
  if Result > Max then
    Result := Max;
end;

function TTeCustomRangeBar.PositionCoordinate(APos: integer): word;
var
  LScaleWidth, LSideMargin, LThumbWidth: integer;
begin
  LSideMargin := GetSideMargin;
  LThumbWidth := GetThumbWidth;

  if Orientation = toHorizontal then
    LScaleWidth := FWidth
  else
    LScaleWidth := FHeight;
    
  LScaleWidth := LScaleWidth - LSideMargin * 2 - LThumbWidth * 2 + 1;

  if FMax - FMin = 0 then
    Result := 0
  else
    Result := LSideMargin + LThumbWidth - 1 + Round(LScaleWidth * (APos - FMin) / (FMax - FMin));
end;

{ Drawing }

procedure TTeCustomRangeBar.PaintBuffer;
var
  R: TRect;
begin
  inherited ;

  if Orientation = toHorizontal then
    DrawTrack(GetSideMargin, FWidth - GetSideMargin,
      PositionCoordinate(LowPosition), PositionCoordinate(HighPosition))
  else
    DrawTrack(GetSideMargin, FHeight - GetSideMargin,
      PositionCoordinate(LowPosition), PositionCoordinate(HighPosition));

  if Focused then
  begin
    R := Rect(0, 0, FWidth, FHeight);
    DrawFocusRect(Canvas, R, ckBlack);
  end;

  DrawTicks;

  DrawLowThumb(PositionCoordinate(LowPosition));
  DrawHighThumb(PositionCoordinate(HighPosition));
end;

procedure TTeCustomRangeBar.DrawTrack(BegCoord, EndCoord, LowPosCoord,
  HighPosCoord: integer);
var
  LTrackRect, IntervalRect, TmpRect: TRect;
  LTopBottmMarign, LThumbWidth, LThumbHeight: integer;
  Theme: HTheme;
  Part, tState: integer;
begin
  LThumbWidth := GetThumbWidth;

  LTopBottmMarign := GetTopBottomMargin;
  LThumbHeight := Round(LThumbWidth * CStdRngThumbRatio);

  with LTrackRect do
  begin
    if FOrientation = toHorizontal then
    begin
      Top := LTopBottmMarign;
      if TickMarks = tmTopLeft then
        Top := Top + LThumbWidth div 2
      else
        Top := Top + LThumbWidth div 4;

      if ShowTicks and ((TickMarks = tmTopLeft) or (TickMarks = tmBoth)) then
        Top := Top + 4 + 1;

      if TickMarks = tmBoth then
        Bottom := Top + LThumbHeight - (LThumbWidth div 4) * 2
      else
        Bottom := Top + LThumbHeight - LThumbWidth div 2 - LThumbWidth div 4;

      Left := BegCoord;
      Right := EndCoord;

      IntervalRect.Top := Top;
      IntervalRect.Bottom := Bottom;
      IntervalRect.Left := LowPosCoord;
      IntervalRect.Right := HighPosCoord;
    end
    else
    begin
      Left := LTopBottmMarign;
      if TickMarks = tmTopLeft then
        Left := Left + LThumbWidth div 2
      else
        Left := Left + LThumbWidth div 4;

      if ShowTicks and ((TickMarks = tmTopLeft) or (TickMarks = tmBoth)) then
        Left := Left + 4 + 1;

      if TickMarks = tmBoth then
        Right := Left + LThumbHeight - (LThumbWidth div 4) * 2
      else
        Right := Left + LThumbHeight - LThumbWidth div 2 - LThumbWidth div 4;

      Top := BegCoord;
      Bottom := EndCoord;

      IntervalRect.Top := LowPosCoord;
      IntervalRect.Bottom := HighPosCoord;
      IntervalRect.Left := Left;
      IntervalRect.Right := Right;
    end;
  end;

  if not UseThemes then
  begin
    { Default drawing }
    if Enabled then
      FillRect(Canvas, LTrackRect, clBtnHighlight)
    else
      FillRect(Canvas, LTrackRect, clBtnFace);

    if Enabled and (HighlightInterval) then
      FillRect(Canvas, IntervalRect, clHighlight);

    TmpRect := RectOffset(LTrackRect, 0);
    DrawEdge(Canvas, TmpRect, clBtnShadow, clBtnHighlight);
    TmpRect := RectOffset(LTrackRect, -1);
    DrawEdge(Canvas, TmpRect, cl3DDkShadow, cl3DLight);
  end
  else
  begin
    { XP Style }
    Theme := OpenThemeData(0, 'TrackBar');

    if RectWidth(LTrackRect) > RectHeight(LTrackRect) then
    begin
      Part := integer(TKP_TRACK);
      InflateRect(LTrackRect, 0, -(ThumbWidth div 2 + 1));
    end
    else
    begin
      Part := integer(TKP_TRACKVERT);
      InflateRect(LTrackRect, -(ThumbWidth div 2 + 1), 0);
    end;

    tState := integer(TRS_NORMAL);

    DrawThemeBackground(Theme, Canvas.Handle, Part, tState, LTrackRect, nil);

    CloseThemeData(Theme);
  end;
end;

procedure TTeCustomRangeBar.DrawHighThumb(APosCoord: integer);
var
  Bx, By: integer;
  LThumbWidth, LThumbHeight: integer;
  Theme: HTheme;
  Part, tState: integer;
  R: TRect;
begin
  if not HighThumbVisible then Exit;

  LThumbWidth := GetThumbWidth;
  LThumbHeight := Round(LThumbWidth * CStdRngThumbRatio);

  if UseThemes then
  begin
    { XP Style }
    Theme := OpenThemeData(0, 'TrackBar');

    if FOrientation = toHorizontal then
    begin
      Bx := APosCoord - LThumbWidth div 2;
      By := GetTopBottomMargin;
      if ShowTicks and ((TickMarks = tmTopLeft) or (TickMarks = tmBoth)) then
        By := By + 4 + 1;

      R := Rect(Bx, By, Bx + LThumbWidth, By + LThumbHeight);

      case TickMarks of
        tmBoth: Part := integer(TKP_THUMB);
        tmBottomRight: Part := integer(TKP_THUMBBOTTOM);
        tmTopLeft: Part := integer(TKP_THUMBTOP);
      end;
    end
    else
    begin
      Bx := GetTopBottomMargin;
      By := APosCoord - LThumbWidth div 2;
      if ShowTicks and ((TickMarks = tmTopLeft) or (TickMarks = tmBoth)) then
        Bx := Bx + 4 + 1;

      R := Rect(Bx, By, Bx + LThumbHeight, By + LThumbWidth);

      case TickMarks of
        tmBoth: Part := integer(TKP_THUMBVERT);
        tmBottomRight: Part := integer(TKP_THUMBRIGHT);
        tmTopLeft: Part := integer(TKP_THUMBLEFT);
      end;
    end;

    if not Enabled then
      tState := integer(TUS_DISABLED)
    else
      if HighThumbPressed then
        tState := integer(TUS_PRESSED)
      else
        if MouseOnHighThumb then
          tState := integer(TUS_HOT)
        else
          tState := integer(TUS_NORMAL);

    InflateRect(R, 1, 1);
    DrawThemeBackground(Theme, Canvas.Handle, Part, tState, R, nil);

    CloseThemeData(Theme);
  end
  else
  begin
    { Deafult drawing }
    if Orientation = toHorizontal then
    begin
      Bx := APosCoord;
      By := GetTopBottomMargin;
      if ShowTicks and ((TickMarks = tmTopLeft) or (TickMarks = tmBoth)) then
        By := By + 4 + 1;
      case TickMarks of
        tmBottomRight:
          begin
            if HighThumbPressed then
              FillHalftonePolygon(Canvas, [Point(Bx, By),
                Point(Bx + LThumbWidth - 1, By),
                  Point(Bx + LThumbWidth - 1, By + LThumbHeight - LThumbWidth),
                  Point(Bx, By + LThumbHeight - 1)], clBtnFace, clBtnhighlight)
            else
              FillPolygon(Canvas, [Point(Bx, By),
                Point(Bx + LThumbWidth - 1, By),
                  Point(Bx + LThumbWidth - 1, By + LThumbHeight - LThumbWidth),
                  Point(Bx, By + LThumbHeight - 1)], clBtnFace);

            MoveTo(Canvas, Bx + LThumbWidth - 2, By);
            LineTo(Canvas, Bx, By, clBtnHighlight);
            LineTo(Canvas, Bx, By + LThumbHeight - 2, clBtnHighlight);

            MoveTo(Canvas, Bx + LThumbWidth - 2, By + 1);
            LineTo(Canvas, Bx + LThumbWidth - 2, By + LThumbHeight - LThumbWidth, clBtnShadow);
            LineTo(Canvas, Bx - 1, By + LThumbHeight - 1, clBtnShadow);

            MoveTo(Canvas, Bx + LThumbWidth - 1, By);
            LineTo(Canvas, Bx + LThumbWidth - 1, By + LThumbHeight - LThumbWidth, cl3DDkShadow);
            LineTo(Canvas, Bx - 1, By + LThumbHeight, cl3DDkShadow)
          end;
        tmTopLeft:
          begin
            if HighThumbPressed then
              FillHalftonePolygon(Canvas, [Point(Bx, By),
                Point(Bx + LThumbWidth - 1, By + LThumbWidth - 1),
                  Point(Bx + LThumbWidth - 1, By + LThumbHeight - 1),
                  Point(Bx, By + LThumbHeight - 1)], clBtnFace, clBtnHighlight)
            else
              FillPolygon(Canvas,[Point(Bx, By),
                Point(Bx + LThumbWidth - 1, By + LThumbWidth - 1),
                  Point(Bx + LThumbWidth - 1, By + LThumbHeight - 1),
                  Point(Bx, By + LThumbHeight - 1)], clBtnFace);

            MoveTo(Canvas, Bx, By + 2);
            LineTo(Canvas, Bx, By + LThumbHeight - 1, clBtnHighlight);

            MoveTo(Canvas, Bx, By + 1);
            LineTo(Canvas, Bx + LThumbWidth - 2, By + LThumbWidth - 1, clBtnShadow);
            LineTo(Canvas, Bx + LThumbWidth - 2, By + LThumbHeight - 2, clBtnShadow);
            LineTo(Canvas, Bx, By + LThumbHeight - 2, clBtnShadow);

            MoveTo(Canvas, Bx, By);
            LineTo(Canvas, Bx + LThumbWidth - 1, By + LThumbWidth - 1, cl3DDkShadow);
            LineTo(Canvas, Bx + LThumbWidth - 1, By + LThumbHeight - 1, cl3DDkShadow);
            LineTo(Canvas, Bx - 1, By + LThumbHeight - 1, cl3DDkShadow);
          end;
        tmBoth: begin
          if HighThumbPressed then
            FillHalftoneRect(Canvas, Rect(Bx, By, Bx + LThumbWidth, By + LThumbHeight), clBtnFace, clBtnHighlight)
          else
            FillRect(Canvas, Rect(Bx, By, Bx + LThumbWidth, By + LThumbHeight), clBtnFace);
          DrawEdge(Canvas, Rect(Bx, By, Bx + LThumbWidth, By + LThumbHeight),
            clBtnHighlight, clBlack);
          DrawEdge(Canvas, Rect(Bx + 1, By + 1, Bx + LThumbWidth - 1, By + LThumbHeight - 1),
            clBtnFace, clBtnShadow);
        end;
      end;
    end
    else
    begin
      { Orientation = toVertical }

      Bx := GetTopBottomMargin;
      By := APosCoord;
      if ShowTicks and ((TickMarks = tmTopLeft) or (TickMarks = tmBoth)) then
        Bx := Bx + 4 + 1;
      case TickMarks of
        tmBottomRight:
          begin
            if HighThumbPressed then
              FillHalftonePolygon(Canvas, [Point(Bx, By),
                Point(Bx + LThumbHeight - 1, By),
                Point(Bx + LThumbHeight - LThumbWidth, By + LThumbWidth - 1),
                Point(Bx, By + LThumbWidth - 1)], clBtnFace, clBtnHighlight)
            else
              FillPolygon(Canvas,[Point(Bx, By),
                Point(Bx + LThumbHeight - 1, By),
                Point(Bx + LThumbHeight - LThumbWidth, By + LThumbWidth - 1),
                Point(Bx, By + LThumbWidth - 1)], clBtnFace);

            MoveTo(Canvas, Bx, By + LThumbWidth - 2);
            LineTo(Canvas, Bx, By, clBtnHighlight);
            LineTo(Canvas, Bx + LThumbHeight - 2, By, clBtnHighlight);

            MoveTo(Canvas, Bx + LThumbHeight - 2, By);
            LineTo(Canvas, Bx + LThumbHeight - LThumbWidth, By + LThumbWidth - 2, clBtnShadow);
            LineTo(Canvas, Bx, By + LThumbWidth - 2, clBtnShadow);

            MoveTo(Canvas, Bx + LThumbHeight - 1, By);
            LineTo(Canvas, Bx + LThumbHeight - LThumbWidth, By + LThumbWidth - 1, cl3DDkShadow);
            LineTo(Canvas, Bx - 1, By + LThumbWidth - 1, cl3DDkShadow);
          end;
        tmTopLeft:
          begin
            if HighThumbPressed then
              FillHalftonePolygon(Canvas, [Point(Bx, By),
                Point(Bx + LThumbHeight - 1, By),
                Point(Bx + LThumbHeight - 1, By + LThumbWidth - 1),
                Point(Bx + LThumbWidth - 1, By + LThumbWidth - 1)],
                clBtnFace, clBtnHighlight)
            else
              FillPolygon(Canvas,[Point(Bx, By),
                Point(Bx + LThumbHeight - 1, By),
                Point(Bx + LThumbHeight - 1, By + LThumbWidth - 1),
                Point(Bx + LThumbWidth - 1, By + LThumbWidth - 1)],
                clBtnFace);

            MoveTo(Canvas, Bx + LThumbHeight - 2, By);
            LineTo(Canvas, Bx, By, clBtnHighlight);

            MoveTo(Canvas, Bx + LThumbHeight - 2, By + 1);
            LineTo(Canvas, Bx + LThumbHeight - 2, By + LThumbWidth - 2, clBtnShadow);
            LineTo(Canvas, Bx + LThumbWidth - 1, By + LThumbWidth - 2, clBtnShadow);
            LineTo(Canvas, Bx, By - 1, clBtnShadow);

            MoveTo(Canvas, Bx + LThumbHeight - 1, By);
            LineTo(Canvas, Bx + LThumbHeight - 1, By + LThumbWidth - 1, cl3DDkShadow);
            LineTo(Canvas, Bx + LThumbWidth - 1, By + LThumbWidth - 1, cl3DDkShadow);
            LineTo(Canvas, Bx - 1, By - 1, cl3DDkShadow);
          end;
        tmBoth: begin
          if HighThumbPressed then
            FillHalftoneRect(Canvas, Rect(Bx, By, Bx + LThumbHeight, By + LThumbWidth), clBtnFace, clBtnHighlight)
          else
            FillRect(Canvas, Rect(Bx, By, Bx + LThumbHeight, By + LThumbWidth), clBtnFace);
          DrawEdge(Canvas, Rect(Bx, By, Bx + LThumbHeight, By + LThumbWidth),
            clBtnHighlight, clBlack);
          DrawEdge(Canvas, Rect(Bx + 1, By + 1, Bx + LThumbHeight - 1, By + LThumbWidth - 1),
            clBtnFace, clBtnShadow);
        end;
      end;
    end;
  end;
end;

