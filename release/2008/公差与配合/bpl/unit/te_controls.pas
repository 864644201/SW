procedure TTeCustomForm.WMPaint(var Msg: TMessage);
var
  DC: HDC;
  PS: TPaintStruct;
begin
  if Form = nil then Exit;

  DC := TWMPaint(Msg).DC;
  if DC = 0 then TWMPaint(Msg).DC := BeginPaint(Handle, PS);
  try
    THackForm(Form).PaintHandler(TWMPaint(Msg));
  finally
    if DC = 0 then EndPaint(Handle, PS);
  end;

  Msg.Result := 0;
  MessageHandled;
end;

procedure TTeCustomForm.WMEraseBkgnd(var Msg: TWMEraseBkgnd);
var
  R: TRect;
  SaveIndex: integer;
  SavedDC, PaintDC: HDC;
  DoubleBuffer: TTeBitmap;
begin
  if (Form <> nil) and (THackForm(Form).FormStyle = fsMDIForm) and (Pointer(Msg.Unused) <> nil) then
  begin
    Msg.Result := 1;
    MessageHandled;
    Exit;
  end;

  if FAllowDraw then
  begin
    { Paint to buffer (copy form's background) }
    if (Pointer(Msg.Unused) <> nil) and (PEraseBackgroundInfo(Msg.Unused)^.Action = keaPaintBackground) then
    begin
      { Copy Background }
      Msg.Unused := 0;
      WMEraseBkgnd(Msg);

      Msg.Result := 1;
      MessageHandled;
      Exit;
    end
    else
    begin
      { Save Canvas }
      Canvas.Lock;
      try
        SavedDC := Canvas.Handle;

        { Set PaintDC }
        if (Msg.DC <> 0) {and not FStretchBackground } then
          PaintDC := Msg.DC
        else
          PaintDC := GetDC(Handle);

        { Paint client area }
        with GetClientBounds do
        begin
          if FAnimating then
          begin
            { Change Canvas }
            Canvas.Handle := FAniBuffer.DC;
            { Set clipping region }
            SaveIndex := SaveDC(Canvas.Handle);
            IntersectClipRect(Canvas.Handle, 0, 0, Right, Bottom);
            MoveWindowOrg(Canvas.Handle, Left, Top);
            { Paint client area }
            if Assigned(FOnPaint) and not (csLoading in ComponentState) then
              FOnPaint(Self) { Call OnPaint event }
            else
              PaintClientArea;

            { Restore clipping region }
            RestoreDC(Canvas.Handle, SaveIndex);
            { Blenging }
            if FBlending.Enabled then
            begin
              FAniBuffer.SetAlpha(FBlending.Value, GetClientBounds);
              FAniBuffer.MergeDraw(FScreen, Left, Top, Rect(Left, Top, Right, Bottom));
            end;
          end
          else
            case FPerformance of
              ksfpSharedBuffer:
                begin
                  { Change Canvas }
                  Canvas.Handle := SharedBuffer.DC;
                  { Paint client area }
                  if Assigned(FOnPaint) and not (csLoading in ComponentState) then
                    FOnPaint(Self) { Call OnPaint event }
                  else
                    PaintClientArea;
                  { Select clip rect }
                  if (Pointer(Msg.Unused) <> nil) and
                     (PEraseBackgroundInfo(Msg.Unused)^.Action = keaInvalidateRect)
                  then
                    with PEraseBackgroundInfo(Msg.Unused)^ do
                    begin
                      { Blenging rect }
                      if FBlending.Enabled then
                      begin
                        SharedBuffer.SetAlpha(FBlending.Value, Rect);
                        R := Rect;
                        OffsetRect(R, Left, Top);
                        SharedBuffer.MergeDraw(FScreen, Rect.Left, Rect.Top, R);
                      end;
                      { Draw rect }
                      SharedBuffer.Draw(PaintDC, Rect.Left, Rect.Top, Rect);
                    end
                  else
                    begin
                      { Blenging }
                      if FBlending.Enabled then
                      begin
                        SharedBuffer.SetAlpha(FBlending.Value, GetClientRect);
                        SharedBuffer.MergeDraw(FScreen, 0, 0, Rect(Left, Top, Right, Bottom));
                      end;
                      { Draw buffer }
                      SharedBuffer.Draw(PaintDC, 0, 0);
                    end;
                end;
              ksfpPersistentBuffer:
                begin
                  { Change Canvas }
                  Canvas.Handle := FPersistentBuffer.DC;
                  { Paint client area }
                  if Assigned(FOnPaint) and not (csLoading in ComponentState) then
                    FOnPaint(Self) { Call OnPaint event }
                  else
                    PaintClientArea;
                  { Select clip rect }
                  if (Pointer(Msg.Unused) <> nil) and
                     (PEraseBackgroundInfo(Msg.Unused)^.Action = keaInvalidateRect)
                  then
                    with PEraseBackgroundInfo(Msg.Unused)^ do
                    begin
                      { Blenging rect }
                      if FBlending.Enabled then
                      begin
                        FPersistentBuffer.SetAlpha(FBlending.Value, Rect);
                        R := Rect;
                        OffsetRect(R, Left, Top);
                        FPersistentBuffer.MergeDraw(FScreen, Rect.Left, Rect.Top, R);
                      end;
                      { Draw rect }
                      FPersistentBuffer.Draw(PaintDC, Rect.Left, Rect.Top, Rect);
                    end
                  else
                    begin
                      { Blenging }
                      if FBlending.Enabled then
                      begin
                        FPersistentBuffer.SetAlpha(FBlending.Value, GetClientRect);
                        FPersistentBuffer.MergeDraw(FScreen, 0, 0, Rect(Left, Top, Right, Bottom));
                      end;
                      { Draw buffer }
                      FPersistentBuffer.Draw(PaintDC, 0, 0);
                    end;
                end;
              ksfpDoubleBuffer:
                begin
                  { Create Buffer }
                  DoubleBuffer := TTeBitmap.Create;
                  DoubleBuffer.SetSize(FWidth, FHeight);
                  { Change Canvas }
                  Canvas.Handle := DoubleBuffer.DC;
                  { Paint client area }
                  if Assigned(FOnPaint) and not (csLoading in ComponentState) then
                    FOnPaint(Self) { Call OnPaint event }
                  else
                    PaintClientArea;
                  { Select clip rect }
                  if (Pointer(Msg.Unused) <> nil) and
                     (PEraseBackgroundInfo(Msg.Unused)^.Action = keaInvalidateRect)
                  then
                    with PEraseBackgroundInfo(Msg.Unused)^ do
                    begin
                      { Blenging rect }
                      if FBlending.Enabled then
                      begin
                        DoubleBuffer.SetAlpha(FBlending.Value, Rect);
                        R := Rect;
                        OffsetRect(R, Left, Top);
                        DoubleBuffer.MergeDraw(FScreen, Rect.Left, Rect.Top, R);
                      end;
                      { Draw rect }
                      DoubleBuffer.Draw(PaintDC, Rect.Left, Rect.Top, Rect);
                    end
                  else
                    begin
                      { Blenging }
                      if FBlending.Enabled then
                      begin
                        DoubleBuffer.SetAlpha(FBlending.Value, GetClientRect);
                        DoubleBuffer.MergeDraw(FScreen, 0, 0, Rect(Left, Top, Right, Bottom));
                      end;
                      { Draw buffer }
                      DoubleBuffer.Draw(PaintDC, 0, 0);
                    end;
                  { Free buffer }
                  DoubleBuffer.Free;
                end;
              ksfpNoBuffer:
                begin
                  if FBlending.Enabled then
                  begin
                    { Create Buffer }
                    DoubleBuffer := TTeBitmap.Create;
                    DoubleBuffer.SetSize(FWidth, FHeight);
                    { Change Canvas }
                    Canvas.Handle := DoubleBuffer.DC;
                  end
                  else
                    Canvas.Handle := PaintDC;

                  { Paint client area (normal mode) }
                  if Assigned(FOnPaint) and not (csLoading in ComponentState) then
                    FOnPaint(Self) { Call OnPaint event }
                  else
                    PaintClientArea;

                  { Blending }
                  if FBlending.Enabled then
                  begin
                    { Select clip rect }
                    if (Pointer(Msg.Unused) <> nil) and
                       (PEraseBackgroundInfo(Msg.Unused)^.Action = keaInvalidateRect)
                    then
                      with PEraseBackgroundInfo(Msg.Unused)^ do
                      begin
                        { Blenging rect }
                        if FBlending.Enabled then
                        begin
                          DoubleBuffer.SetAlpha(FBlending.Value, Rect);
                          R := Rect;
                          OffsetRect(R, Left, Top);
                          DoubleBuffer.MergeDraw(FScreen, Rect.Left, Rect.Top, R);
                        end;
                        { Draw rect }
                        DoubleBuffer.Draw(PaintDC, Rect.Left, Rect.Top, Rect);
                      end
                    else
                      begin
                        { Blenging }
                        if FBlending.Enabled then
                        begin
                          DoubleBuffer.SetAlpha(FBlending.Value, GetClientRect);
                          DoubleBuffer.MergeDraw(FScreen, 0, 0, Rect(Left, Top, Right, Bottom));
                        end;
                        { Draw buffer }
                        DoubleBuffer.Draw(PaintDC, 0, 0);
                      end;
                    { Free buffer }
                    DoubleBuffer.Free;
                  end;
                end;
            end;
        end;

        if SavedDC <> 0 then
          Canvas.Handle := SavedDC;

        { Restore DC }
        if Msg.DC <> PaintDC then
          ReleaseDC(Handle, PaintDC);
      finally
        Canvas.UnLock;
      end;
    end;
  end;

  { Set handled flag }
  Msg.Result := 1;
  MessageHandled;
end;

procedure TTeCustomForm.WMWindowPosChanging(var Msg: TWMWindowPosChanging);
var
  OldRgn, Rgn: HRgn;
  NewRect: TRect;
  Changed: boolean;
begin
  { Set internal properties }
  if (Msg.WindowPos^.flags and SWP_NOSIZE = 0) or
     (Msg.WindowPos^.flags and SWP_NOMOVE = 0) then
  begin
    with GetMaxTrackSize do
    begin
      if Msg.WindowPos^.cx > X then Msg.WindowPos^.cx := X;
      if Msg.WindowPos^.cy > Y then Msg.WindowPos^.cy := Y;
    end;

    if (FWindowState <> kwsRollup) and (FWindowState <> kwsMinimized) then
      with GetMinTrackSize do
      begin
        if Msg.WindowPos^.cx < X then Msg.WindowPos^.cx := X;
        if Msg.WindowPos^.cy < Y then Msg.WindowPos^.cy := Y;
      end;

    { Change Size }
    if ((Msg.WindowPos^.cx <> FWidth) or (Msg.WindowPos^.cy <> FHeight)) and
       (Msg.WindowPos^.flags and SWP_NOSIZE = 0) and
       (Msg.WindowPos^.flags and SWP_FRAMECHANGED = 0) then
    begin
      FRealWidth := Msg.WindowPos^.cx;
      FRealHeight := Msg.WindowPos^.cy;
      FWidth := FRealWidth;
      FHeight := FRealHeight;

      if FShadow.Enabled and (FWindowState <> kwsMaximized) then
      begin
        Dec(FWidth, FShadow.Size);
        Dec(FHeight, FShadow.Size);
      end;

      Changed := true;
    end
    else
      Changed := false;

    if (Msg.WindowPos^.flags and SWP_FRAMECHANGED <> 0) then
      UpdateNonClientArea(0);

    { Copy screen image }
    if FBlending.Enabled or FShadow.Enabled then
    begin
      with Msg.WindowPos^ do
        if flags and SWP_NOMOVE <> 0 then
        begin
          GetWindowRect(Handle, NewRect);
          NewRect := Rect(NewRect.Left, NewRect.Top, NewRect.Left + cx, NewRect.Top + cy) // no move
        end
        else
          NewRect := Rect(x, y, x + cx, y + cy); // moving

      CopyScreen(NewRect);
    end;

    if Changed then
      ChangeSize;
  end;

  if (Msg.WindowPos^.flags and SWP_SHOWWINDOW <> 0) then
  begin
    if FLoadedState = kwsNormal then
    begin
      if FBlending.Enabled or FShadow.Enabled then
      begin
        { Change ZOrder }
        FOldRect := Rect(0, 0, 0, 0);
        GetWindowRect(Handle, NewRect);
        CopyScreen(NewRect);
      end;
      { Animation }
      AnimationShow;
    end;
  end;

  if FBlending.Enabled or FShadow.Enabled then
    Msg.WindowPos^.flags := Msg.WindowPos^.flags or SWP_NOCOPYBITS;

  { Set handled flag }
  Msg.Result := 0;
  MessageHandled;
end;

procedure TTeCustomForm.WMSysCommand(var Msg: TWMSysCommand);
begin
  with Msg do
  begin
    { MainMenu }
    if (CmdType and $FFF0 = SC_KEYMENU) and (Key <> VK_SPACE) and
       (Key <> Ord('-')) and (GetCapture = 0) and (FMenuBar <> nil) then
    begin
      PostMessage(Handle, WM_CHAR, Key, 0);
      FMenuBar.EnterLoop;
      Result := 1;
    end;
    { System Menu }
    if ((CmdType and $FFF0 = SC_KEYMENU) and (Key = VK_SPACE)) or
        (CmdType and $FFF0 = SC_MOUSEMENU) then
    begin
      SysMenu;
    end;
    { Close }
{    if (CmdType and $FFF0 = SC_CLOSE) then }

    { Minimize }
    if (CmdType and $FFF0 = SC_RESTORE) then
      Restore;

    { Restore }
    if (CmdType and $FFF0 = SC_MINIMIZE) then
      Minimize;
  end;
end;

procedure TTeCustomForm.WMMDIActivate(var Message: TWMMDIActivate);
var
  ParentForm: TCustomForm;
begin
  { Update WindowMenu }
  if (GetMDIParentKsForm <> nil) then
    GetMDIParentKsForm.UpdateWindowMenu;
  { MDI Child }
  ParentForm := GetMDIParentForm;
  if ParentForm <> nil then
  begin
    if IsMDIChildMaximized then
    begin
      { Change Caption }
      ChangeMDIParentCaption;
      { Maximize if need }
      if (Message.ChildWnd <> Handle) then
      begin
        if FWindowState <> kwsMaximized then
          PostMessage(Handle, WM_MAXIMIZE, 0, 0);
      end
      else
        if (GetMDIParentKsForm <> nil) and (GetMDIParentKsForm.MenuBar <> nil) then
          GetMDIParentKsForm.MenuBar.ShowMDIItems(Self);
    end;
  end;
end;

procedure TTeCustomForm.WMThemeChanged(var Msg: TMessage);
begin
  SmCaptionFont.Free;
  SmCaptionFont := nil;
  CaptionFont.Free;
  CaptionFont := nil;

  InitCaptionFont;
  InitSysMetrics;

  Msg.Result := 0;
  MessageHandled;
end;

{ Internal Tray Event =========================================================}

procedure TTeCustomForm.DoApplicationMinimize(Sender: TObject);
begin
  Application.OnMinimize := nil;
  try
    if FWindowState <> kwsMinimized then
      if FMinimizeApplication then
        if FWindowState <> kwsTray then
        begin
          Minimize;
          if Assigned(FOldApplicationMinimize) then
            FOldApplicationMinimize(Sender);
        end;
  finally
    Application.OnMinimize := DoApplicationMinimize;
  end;
end;

procedure TTeCustomForm.DoApplicationRestore;
begin
  Application.OnRestore := nil;
  try
    if FWindowState = kwsMinimized then
      if FMinimizeApplication then
      begin
        Restore;
        UpdateNonClientArea(0);
        if Assigned(FOldApplicationRestore) then
          FOldApplicationRestore(Sender);
      end;
  finally
    Application.OnRestore := DoApplicationRestore;
  end;
end;

procedure TTeCustomForm.EndSession;
begin
  Shell_NotifyIcon(nim_Delete, @FIconData);
end;

procedure TTeCustomForm.MsgTrayWndProc(var Msg: TMessage);
begin
  with Msg do
  begin
    case Msg of
      WM_QUERYENDSESSION:
        Result := 1;     // Allow Windows to shut down
      WM_ENDSESSION:
        EndSession;      // Be sure to clean up tray icon
      WM_TRAYICONMESSAGE:
      begin
        case LParam of
          WM_LBUTTONDOWN: ;
          WM_LBUTTONUP: ;
          WM_LBUTTONDBLCLK:
          begin
            Restore;
          end;
          WM_RBUTTONDOWN: ;
          WM_RBUTTONUP: 
          begin
            SysMenu;
          end;
          WM_RBUTTONDBLCLK: ;
        end;
      end;
    end;
  end;
  Dispatch(Msg);
end;

