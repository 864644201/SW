function TTeCustomStatusBar.GetPanelClientRect(
  Panel: TTeStatusPanel): TRect;
begin
  Result := GetPanelRect(Panel.Index);
  if Panel.Framed then begin
    InflateRect(Result,-1,-1);
    with Result do
      Right := Right - 2
  end;
end;

procedure TTeCustomStatusBar.CMControlChange(var Message: TCMControlChange);
var
  Panel: TTeStatusPanel;
begin
  if not (csLoading in ComponentState) then begin
    if Message.Inserting and (Message.Control is TControl) then
      with Panels.Add do
        SetControl(Message.Control)
      else
      begin
        Panel := Panels.FindPanel(Message.Control);
        if Panel <> nil then Panel.Free;
      end;
  end;
end;

procedure TTeCustomStatusBar.AlignControls(AControl: TControl;
  var Rect: TRect);
begin
  if not (csDestroying in ComponentState) and
    ((AControl = nil) and (Panels.Count > 0) or (AControl is TControl)) then
  begin
    UpdatePanels;
  end;
end;

function TTeCustomStatusBar.GetPanelsRect: TRect;
begin
  Result := GetBorderRect;
  with Result do
    if Panels.Count > 0 then
    begin
      Left := Panels[0].Left;
      Right := Panels[Panels.Count-1].Right;
    end
    else
      Right := Left;

  IntersectRect(Result, Result, GetBorderRect);
end;

function TTeCustomStatusBar.GetGripperRect: TRect;
begin
  Result := GetBorderRect;

  if Panels.Count > 0 then
    if Panels[Panels.Count - 1].Framed then
      InflateRect(Result, -1, -1);
  
  Result.Left := Result.Right - GetSystemMetrics(SM_CXVSCROLL);
  Result.Top := Result.Bottom - GetSystemMetrics(SM_CYVSCROLL);
end;

function TTeCustomStatusBar.IsSizeGripVisible: Boolean;
var
  ParentForm: TCustomForm;
  ParentKsForm: TTeCustomForm;
  ParentBottomRight, SelfBottomRight: TPoint;
begin
  Result := false;

  if SizeGrip then
  begin
    { Standard form checking }
    ParentForm := GetParentForm(Self);
    if (ParentForm <> nil) and (ParentForm.WindowState = wsNormal) then
    begin
      ParentBottomRight := ParentForm.ClientToScreen(ParentForm.ClientRect.BottomRight);
      SelfBottomRight := ClientToScreen(Point(Width, Height));
      Result := (ParentBottomRight.X = SelfBottomRight.X) and
        (ParentBottomRight.Y = SelfBottomRight.Y);
    end;

    { KSDev's form cheking }
    if Result then
    begin
      ParentKsForm := GetParentKsForm(Self);
      if ParentKsForm <> nil then
      begin
        Result := ParentKsForm.Dragging.Sizeable and (ParentKsForm.WindowState = kwsNormal); 
      end;
    end;
  end;
end;

procedure TTeCustomStatusBar.SetSizeGrip(const Value: boolean);
begin
  if FSizeGrip <> Value then begin
    FSizeGrip := Value;
    Invalidate;
  end;
end;

{ TTeStatusPanel }

constructor TTeStatusPanel.Create(Collection: TCollection);
begin
  FWidth := 50;
  FMaxWidth := 10000;
  FImageIndex := -1;
  FAlignment := taLeftJustify;
  FAutoSize := False;
  FLayout := sglGlyphLeft;
  FMargin := 2;
  FSpacing := 4;
  FStyle := psText;
  FShowImage := True;
  FStretchPriority := 0;
  FViewPriority := 100;
  FFramed := true;
  inherited Create(Collection);
end;

destructor TTeStatusPanel.Destroy;
var
  AControl: TControl;
begin
  AControl := Control;
  FControl := nil;
  inherited Destroy;
  if (AControl <> nil) and not (csDestroying in AControl.ComponentState) and
    ((AControl is TWinControl) and TWinControl(AControl).HandleAllocated) then
  begin
    AControl.BringToFront;
    AControl.Perform(CM_SHOWINGCHANGED, 0, 0);
  end;
end;

procedure TTeStatusPanel.Assign(Source: TPersistent);

  function FindControl(AControl: TControl): TControl;
  begin
    if AControl <> nil then
      Result := StatusBar.Owner.FindComponent(AControl.Name) as TControl
    else
      Result := nil;
  end;

begin
  if Source is TStatusPanel then
  begin
    Alignment := (Source as TStatusPanel).Alignment;
    Text := (Source as TStatusPanel).Text;
    Width := (Source as TStatusPanel).Width;
  end
    else
    if Source is TTeStatusPanel then
    begin
