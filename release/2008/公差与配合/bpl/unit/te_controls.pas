type
  THackControl_Spin = class(TControl);

{ TTeCustomSpinButton }

constructor TTeCustomSpinButton.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);
  Transparent := true;

  FUpButton := CreateButton;
  FUpButton.ShowCaption := false;
  FUpButton.Flat := true;
  FUpButton.OnClick := BtnClick;
  FUpButton.OnMouseDown := BtnMouseDown;
  FUpButton.Enabled := true;
  FUpButton.AllowTimer := true;
  FUpButton.Parent := Self;
  FUpButton.Caption := 'up'; 

  FDownButton := CreateButton;
  FDownButton.Flat := true;
  FDownButton.ShowCaption := false;
  FDownButton.OnClick := BtnClick;
  FDownButton.OnMouseDown := BtnMouseDown;
  FDownButton.Enabled := true;
  FDownButton.AllowTimer := true;
  FDownButton.Parent := Self;
  FDownButton.Caption := 'down';

  FEnabledSlider := true;
  FMax := 100;
  FMin := 0;
  FPosition := 0;
  FIncrement := 1;
  FSpinAlign := saRight;

  UpGlyph := nil;
  DownGlyph := nil;

  Width := DefaultWidth;
  Height := 21;

  FFocusedButton := FUpButton;

  FCheckTimer := TTimer.Create(Self);
  FCheckTimer.OnTimer := CheckAssosiate;
  FCheckTimer.Interval := 400;

  FUpButton.Visible := true;
  FDownButton.Visible := true;
end;

destructor TTeCustomSpinButton.Destroy;
begin
  FCheckTimer.Free;
  inherited Destroy;
end;

procedure TTeCustomSpinButton.Loaded;
var
  W, H: Integer;
begin
  inherited Loaded;
  UpdateAssociatePosition;

  W := Width;
  H := Height;
  AdjustSize(W, H);
  if (W <> Width) or (H <> Height) then
    inherited SetBounds (Left, Top, W, H);

  if FAssociate <> nil then
    FCheckTimer.Enabled  := True;

  Invalidate;
end;

procedure TTeCustomSpinButton.Invalidate;
begin
  inherited;
  if FDownButton <> nil then FDownButton.Invalidate;
  if FUpButton <> nil then FUpButton.Invalidate;
end;

function TTeCustomSpinButton.CreateButton: TTeCustomSpeedButton;
begin
  Result := TTeCustomSpeedButton.Create(Self);
end;

{ Position Routines }

procedure TTeCustomSpinButton.CheckAssosiate(Sender: TObject);
var
  S: string;
  Val: integer;
begin
  if FChanging then Exit;

  S := THackControl_Spin(FAssociate).Caption;
  Val := StrToIntDef(S, FPosition);
  if Val <> FPosition then
    Position := Val;
end;

procedure TTeCustomSpinButton.UpdateAssociate;
var
  S: string;
  Val: integer;
begin
  if FAssociate <> nil then
  begin
    FChanging := true;
    try
      S := THackControl_Spin(FAssociate).Caption;
      Val := StrToIntDef(S, MaxInt);
      if (Val <> FPosition) then
        THackControl_Spin(FAssociate).Caption := IntToStr(FPosition);
    finally
      FChanging := false;
    end;
  end;
end;

procedure TTeCustomSpinButton.UpdateAssociatePosition;
var
  R: TRect;
begin
  if FAssociate <> nil then
  begin
    R := Rect(0, 0, DefaultWidth, FAssociate.Height);
    if SpinAlign = saLeft then
      OffsetRect(R, FAssociate.Left - DefaultWidth, FAssociate.Top)
    else
      OffsetRect(R, FAssociate.Left + FAssociate.Width, FAssociate.Top);

    BoundsRect := R;
  end;
end;

procedure TTeCustomSpinButton.AdjustSize(var W, H: Integer);
var
  Mid: Integer;
begin
  if (FUpButton = nil) or (csLoading in ComponentState) then Exit;

  Mid := H div 2;
  if FEnabledSlider then
    Mid := Mid - 1;

  FUpButton.SetBounds(0, 0, W, Mid);
  FDownButton.SetBounds(0, Mid + 1, W, Mid);
  FDownButton.Top := Height - FDownButton.Height;
end;

procedure TTeCustomSpinButton.SetBounds(ALeft, ATop, AWidth, AHeight: Integer);
var
  W, H: Integer;
begin
  W := AWidth;
  H := AHeight;
  AdjustSize(W, H);
  inherited SetBounds (ALeft, ATop, W, H);
end;

procedure TTeCustomSpinButton.WMSize(var Message: TWMSize);
var
  W, H: Integer;
begin
  inherited;

  { check for minimum size }
  W := Width;
  H := Height;
  AdjustSize (W, H);
  if (W <> Width) or (H <> Height) then
    inherited SetBounds(Left, Top, W, H);
  Message.Result := 0;
end;

procedure TTeCustomSpinButton.KeyDown(var Key: Word; Shift: TShiftState);
begin
  case Key of
    VK_UP:
      begin
        SetFocusBtn(FUpButton);
        FUpButton.Click;
      end;
    VK_DOWN:
      begin
        SetFocusBtn(FDownButton);
        FDownButton.Click;
      end;
    VK_SPACE:
      FFocusedButton.Click;
  end;
end;

procedure TTeCustomSpinButton.BtnMouseDown(Sender: TObject; Button: TMouseButton;
  Shift: TShiftState; X, Y: Integer);
begin
  if Button = mbLeft then
  begin
    SetFocusBtn(TTeCustomSpeedButton (Sender));
    if (FAssociate <> nil) and FAssociate.TabStop and
        FAssociate.CanFocus and (GetFocus <> FAssociate.Handle) then
      FAssociate.SetFocus
    else if TabStop and (GetFocus <> Handle) and CanFocus then
      SetFocus;
  end;
