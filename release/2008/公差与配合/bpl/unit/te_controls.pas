procedure TTeCustomPanel.MouseLeave;
begin
  inherited MouseLeave;

  if FMouseOnButton then
  begin
    FMouseOnButton := false;
    InvalidateRect(GetButtonRect);
  end;
end;

procedure TTeCustomPanel.MouseDown(Button: TMouseButton;
  Shift: TShiftState; X, Y: Integer);
begin
  inherited;
  if (Button = mbLeft) and PtInRect(GetButtonRect, Point(X, Y)) then
  begin
    FButtonPressed := true;
    InvalidateRect(GetButtonRect);
  end;
end;

procedure TTeCustomPanel.MouseMove(Shift: TShiftState; X, Y: Integer);
begin
  inherited;

  Cursor := Cursor;
  
  if PtInRect(GetCaptionRect, Point(X, Y)) then
    Cursor := CaptionCursor;

  { Check MouseOnButton }
  if PtInRect(GetButtonRect, Point(X, Y)) then
  begin
    if not FMouseOnButton then
    begin
      FMouseOnButton := true;
      InvalidateRect(GetButtonRect);
    end;

    Cursor := ButtonCursor;
  end
  else
    if FMouseOnButton then
    begin
      FMouseOnButton := false;
      InvalidateRect(GetButtonRect);
    end;

  { Check ButtonPressed }
  if (ssLeft in Shift) then
    if MouseOnButton then
    begin
      if FButtonPressed then Exit;

      FButtonPressed := true;
      InvalidateRect(GetButtonRect);
    end
    else
    begin
      if not FButtonPressed then Exit;

      FButtonPressed := false;
      InvalidateRect(GetButtonRect);
    end;
end;

procedure TTeCustomPanel.MouseUp(Button: TMouseButton; Shift: TShiftState;
  X, Y: Integer);
begin
  inherited;
  if (Button = mbLeft) and PtInRect(GetButtonRect, Point(X, Y)) then
  begin
    FButtonPressed := false;
    InvalidateRect(GetButtonRect);

    DoButtonClick;
  end;
end;

