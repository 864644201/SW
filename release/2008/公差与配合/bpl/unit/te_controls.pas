procedure TTeBitmap.FillHalftoneRect(R: TRect; Color, HalfColor: TKColor);
var
  i, j: integer;
  C: PKColor;
begin
  if R.Left < 0 then R.Left := 0;
  if R.Top < 0 then R.Top := 0;
  if R.Right > Width then R.Right := Width;
  if R.Bottom > Height then R.Bottom := Height;
  if RectWidth(R) <= 0 then Exit;
  if RectHeight(R) <= 0 then Exit;

  FillRect(R, Color);
  { Add Halftone }
  for i := R.Left to R.Right-1 do
    for j := R.Top to R.Bottom-1 do
    begin
      C := @FBits[i + j * FWidth];
      if Odd(i) and Odd(j) then
        C^ := HalfColor;
      if not Odd(i) and not Odd(j) then
        C^ := HalfColor;
    end;
end;

procedure TTeBitmap.FillGradientRect(Rect: TRect; BeginColor,
  EndColor: TKColor; Vertical: boolean);
var
  RGBFrom: array[0..3] of integer;
  RGBDiff: array[0..4] of integer;
  ColorBand : TRect;
  Colors: integer;

  I: Integer;
  R,G,B,A: Byte;
begin
  if Rect.Left < 0 then Rect.Left := 0;
  if Rect.Top < 0 then Rect.Top := 0;
  if Rect.Right > Width then Rect.Right := Width;
  if Rect.Bottom > Height then Rect.Bottom := Height;
  if RectWidth(Rect) <= 0 then Exit;
  if RectHeight(Rect) <= 0 then Exit;

  Colors := 255;
  if not Vertical and (Colors > RectWidth(Rect)) then
    Colors := RectWidth(Rect);
  if Vertical and (Colors > RectHeight(Rect)) then
    Colors := RectHeight(Rect);

  { extract from RGB values }
  RGBFrom[0] := TKColorRec(BeginColor).R * $FF;
  RGBFrom[1] := TKColorRec(BeginColor).G * $FF;
  RGBFrom[2] := TKColorRec(BeginColor).B * $FF;
  RGBFrom[3] := TKColorRec(BeginColor).A * $FF;
  { calculate difference of from and to RGB values }
  RGBDiff[0] := TKColorRec(EndColor).R * $FF - RGBFrom[0];
  RGBDiff[1] := TKColorRec(EndColor).G * $FF - RGBFrom[1];
  RGBDiff[2] := TKColorRec(EndColor).B * $FF - RGBFrom[2];
  RGBDiff[3] := TKColorRec(EndColor).A * $FF - RGBFrom[3];

  ColorBand := Rect;
  for I := 0 to Colors do
  begin
    { calculate color band's top and bottom coordinates }
    if not Vertical then
    begin
      ColorBand.Left := MulDiv(I, RectWidth(Rect), Colors);
      ColorBand.Right := MulDiv(Succ(I), RectWidth(Rect), Colors);

      ColorBand.Left := ColorBand.Left + Rect.Left;
      ColorBand.Right := ColorBand.Right + Rect.Left;
    end else
    begin
      ColorBand.Top := MulDiv (I, RectHeight(Rect), Colors);
      ColorBand.Bottom := MulDiv (Succ(I), RectHeight(Rect), Colors);

      ColorBand.Top := ColorBand.Top + Rect.Top;
      ColorBand.Bottom := ColorBand.Bottom + Rect.Top;
    end;

    { calculate color band color }
    R := Round((RGBFrom[0] + ((I * RGBDiff[0]) /  Colors)) / $FF);
    G := Round((RGBFrom[1] + ((I * RGBDiff[1]) /  Colors)) / $FF);
    B := Round((RGBFrom[2] + ((I * RGBDiff[2]) /  Colors)) / $FF);
    A := Round((RGBFrom[3] + ((I * RGBDiff[3]) /  Colors)) / $FF);

    if (i = 0) or (i = Colors) then
      IntersectRect(ColorBand, Rect, ColorBand);

    FillRect(ColorBand, KColor(R, G, B, A));
  end;
end;

procedure TTeBitmap.FillRadialGradientRect(Rect: TRect; BeginColor,
  EndColor: TKColor; Pos: TPoint);
var
  RGBFrom: array[0..3] of integer;
  RGBDiff: array[0..4] of integer;
  Colors: integer;

  ColorBand: TRect;
  Len: integer;
  I: Integer;
  R,G,B,A: Byte;
  ClipRgn: HRgn;
begin
  if Rect.Left < 0 then Rect.Left := 0;
  if Rect.Top < 0 then Rect.Top := 0;
  if Rect.Right > Width then Rect.Right := Width;
  if Rect.Bottom > Height then Rect.Bottom := Height;
  if RectWidth(Rect) <= 0 then Exit;
  if RectHeight(Rect) <= 0 then Exit;

  Colors := 50;

  { extract from RGB values }
  RGBFrom[0] := TKColorRec(BeginColor).R * $FF;
  RGBFrom[1] := TKColorRec(BeginColor).G * $FF;
  RGBFrom[2] := TKColorRec(BeginColor).B * $FF;
  RGBFrom[3] := TKColorRec(BeginColor).A * $FF;
  { calculate difference of from and to RGB values }
  RGBDiff[0] := TKColorRec(EndColor).R * $FF - RGBFrom[0];
  RGBDiff[1] := TKColorRec(EndColor).G * $FF - RGBFrom[1];
  RGBDiff[2] := TKColorRec(EndColor).B * $FF - RGBFrom[2];
  RGBDiff[3] := TKColorRec(EndColor).A * $FF - RGBFrom[3];

  { set clip region }
  ClipRgn := CreateRectRgn(Rect.Left, Rect.Top, Rect.Right, Rect.Bottom);
  SelectClipRgn(FDC, ClipRgn);

  try
    { calc length }
    if RectWidth(Rect) > RectHeight(Rect) then
      Len := RectWidth(Rect)
    else
      Len := RectHeight(Rect);

    for I := Colors downto 0 do
    begin
      { calculate color band color }
      R := Round((RGBFrom[0] + ((I * RGBDiff[0]) /  Colors)) / $FF);
      G := Round((RGBFrom[1] + ((I * RGBDiff[1]) /  Colors)) / $FF);
      B := Round((RGBFrom[2] + ((I * RGBDiff[2]) /  Colors)) / $FF);
      A := Round((RGBFrom[3] + ((I * RGBDiff[3]) /  Colors)) / $FF);

      ColorBand.TopLeft := Rect.TopLeft;
      ColorBand.Right := ColorBand.Left + MulDiv(Succ(I), Len, Colors) * 2;
      ColorBand.Bottom := ColorBand.Top + MulDiv(Succ(I), Len, Colors) * 2;

      OffsetRect(ColorBand, -RectWidth(ColorBand) div 2, -RectHeight(ColorBand) div 2);

      OffsetRect(ColorBand, Round((Pos.X / 100) * RectWidth(Rect)),
        Round((Pos.X / 100) * RectHeight(Rect)));

      { paint circle  }
      FillEllipse(ColorBand, KColor(R, G, B, A));
    end;
  finally
    SelectClipRgn(DC, 0);
    DeleteObject(ClipRgn);
  end;
end;

