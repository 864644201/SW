procedure TTeCustomStatusBar.UpdatePanels;
var
  LSortList : TList;
  i : integer;
  TotalWidth : integer;
  WholeWidth : integer;
  Delta : integer;
  LPanel : TTeStatusPanel;
  LCurPanelLeft : integer;
begin
  TotalWidth := 0;
  with GetBorderRect do
    WholeWidth := Right - Left;
  LSortList := TList.Create;
  try
    for i := 0 to Panels.Count - 1 do
      with Panels[i] do
      begin
        if ViewPriority > 0 then
        begin
          FCurrentWidth := FWidth;
          FVisible := True;
          TotalWidth :=  TotalWidth + FWidth;
          LSortList.Add(Panels[i])
        end
        else
          FVisible := False;
      end;

    LSortList.Sort(CompareViewPriorities);

    if TotalWidth > WholeWidth then
    begin
      while (TotalWidth > WholeWidth) and (LSortList.Count > 1) and
        (TTeStatusPanel(LSortList.Last).ViewPriority < 100) do
      begin
        TTeStatusPanel(LSortList.Last).FVisible := False;
        TotalWidth := TotalWidth - TTeStatusPanel(LSortList.Last).CurrentWidth;
        LSortList.Count := LSortList.Count - 1;
      end;
    end;

    Delta := WholeWidth - TotalWidth;
    if Delta > 0 then
    begin
      for i := LSortList.Count - 1 downto 0 do
        if TTeStatusPanel(LSortList[i]).StretchPriority = 0 then
          LSortList.Delete(i);

      while (LSortList.Count > 0) and (Delta > 0) do
      begin
        LSortList.Sort(CompareStretchPriorities);

        LPanel := TTeStatusPanel(LSortList.Last);
        with LPanel do
          FCurrentWidth := FCurrentWidth + Delta;
        Delta := LPanel.FCurrentWidth-LPanel.CurrentWidth;
        LSortList.Count := LSortList.Count - 1;
      end;
    end;

    LCurPanelLeft := 0;
    for i := 0 to Panels.Count - 1 do
      with Panels[i] do
      begin
        if LCurPanelLeft >= WholeWidth then
          FVisible := False;
        FLeft := LCurPanelLeft+GetBorderRect.Left;
        if FVisible then
          FRight := FLeft + CurrentWidth
        else
          FRight := FLeft;

        LCurPanelLeft := LCurPanelLeft + CurrentWidth;
        if ((FVisible and (LCurPanelLeft >= WholeWidth))
            or (i = Panels.Count - 1)) and (FStretchPriority > 0) then
          FRight := GetBorderRect.Right;

        UpdateControlBounds;
      end;
  finally
    LSortList.Free;
  end;
end;

