procedure TTeCustomScrollBar.DrawBackground;
var
  R: TRect;
  Theme: HTheme;
  Part, tState: integer;
begin
  R := GetBackgroundRect;

  if not UseThemes then
  begin
    { Default drawing }
    FillHalftoneRect(Canvas, R, clScrollBar, clBtnHighlight)
  end
  else
  begin
    { XP style }
    Theme := OpenThemeData(0, 'ScrollBar');

    if Kind = sbHorizontal then
      Part := integer(SBP_LOWERTRACKHORZ)
    else
      Part := integer(SBP_LOWERTRACKVERT);

    DrawThemeBackground(Theme, Canvas.Handle, Part, tState, R, nil);

    CloseThemeData(Theme);
  end;
end;

