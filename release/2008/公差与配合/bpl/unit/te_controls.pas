    FMouseOnHighThumb := false;
    Invalidate;
  end;
end;

procedure TTeCustomRangeBar.KeyDown(var Key: word; Shift: TShiftState);
begin
  inherited KeyDown(Key, Shift);

  if (ssShift in Shift) or (ssCtrl in Shift) then
    case Key of
      VK_PRIOR: HighPosition := HighPosition - PageSize;
      VK_NEXT: HighPosition := HighPosition + PageSize;
      VK_END: HighPosition := Max;
      VK_HOME: HighPosition := Min;
      VK_LEFT: HighPosition := HighPosition - LineSize;
      VK_RIGHT: HighPosition := HighPosition + LineSize;
      VK_UP: HighPosition := HighPosition - LineSize;
      VK_DOWN: HighPosition := HighPosition + LineSize;
    end
  else
    case Key of
      VK_PRIOR: LowPosition := LowPosition - PageSize;
      VK_NEXT: LowPosition := LowPosition + PageSize;
      VK_END: LowPosition := Max;
      VK_HOME: LowPosition := Min;
      VK_LEFT: LowPosition := LowPosition - LineSize;
      VK_RIGHT: LowPosition := LowPosition + LineSize;
      VK_UP: LowPosition := LowPosition - LineSize;
      VK_DOWN: LowPosition := LowPosition + LineSize;
    end;
end;

