procedure TTeCustomGroupBox.ModifyChecked(const Value: boolean);
begin
  FChecked:=Value;

  if UseCheckBox then
  begin
    FCheckBox.Checked := Value;
    Enabled := FChecked;
  end;
end;

{ Drawing }

function TTeCustomGroupBox.GetBoxRect: TRect;
begin
  with Canvas do
  begin
    if ControlFont <> nil then
      Font.Assign(ControlFont)
    else
      Font.Assign(Self.Font);

    if UseCheckBox then
      Result := Rect(3, FCheckBox.Height div 2 + 1, Self.Width - 2, Self.Height - 2)
    else
      Result := Rect(3, TextHeight(Caption) div 2 + 1, Self.Width - 2, Self.Height - 2);
  end;
end;

procedure TTeCustomGroupBox.PaintBuffer;
var
  R, CaptionRect: TRect;
  Theme: HTheme;
  Part, ThemeState: integer;
begin
  inherited ;

  Canvas.Font.Assign(Self.Font);

  R := GetBoxRect;
  if UseCheckBox then
    CaptionRect := Rect(FCaptionMargin, 0, FCaptionMargin + FCheckBox.Width, FCheckBox.Height)
  else
    CaptionRect := Rect(FCaptionMargin, 0, FCaptionMargin + Canvas.TextWidth(Caption), Canvas.TextHeight(Caption));

  if not (Caption = '') then
    InflateRect(CaptionRect, 3, 0);

  if not UseThemes then
  begin
    { Deafult drawing }
    { Draw Frame }
    MoveTo(Canvas, R.Left, R.Top);
    LineTo(Canvas, CaptionRect.Left, R.Top, clBtnHighlight);
    MoveTo(Canvas, CaptionRect.Right, R.Top);
    LineTo(Canvas, R.Right, R.Top, clBtnHighlight);
    LineTo(Canvas, R.Right, R.Bottom, clBtnHighlight);
    LineTo(Canvas, R.Left, R.Bottom, clBtnHighlight);
    LineTo(Canvas, R.Left, R.Top, clBtnHighlight);

    OffsetRect(R, -1, -1);

    MoveTo(Canvas, R.Left, R.Top);
    LineTo(Canvas, CaptionRect.Left, R.Top, clBtnShadow);
    MoveTo(Canvas, CaptionRect.Right, R.Top);
    LineTo(Canvas, R.Right, R.Top, clBtnShadow);
    LineTo(Canvas, R.Right, R.Bottom, clBtnShadow);
    LineTo(Canvas, R.Left, R.Bottom, clBtnShadow);
    LineTo(Canvas, R.Left, R.Top, clBtnShadow);

    { Draw Caption }
    if not UseCheckBox then
      if not Enabled then
      begin
        OffsetRect(CaptionRect, 1, 1);
        Canvas.Font.Color := clBtnHighlight;
        DrawText(Canvas, Caption, CaptionRect, DT_CENTER or DT_VCENTER or DT_SINGLELINE);
        OffsetRect(CaptionRect, -1, -1);
        Canvas.Font.Color := clBtnShadow;
        DrawText(Canvas, Caption, CaptionRect, DT_CENTER or DT_VCENTER or DT_SINGLELINE);
      end
      else
        DrawText(Canvas, Caption, CaptionRect, DT_CENTER or DT_VCENTER or DT_SINGLELINE);
  end
  else
  begin
    { XP Style }
    Theme := OpenThemeData(0, 'Button');

    Part := integer(BP_GROUPBOX);
    ThemeState := integer(GBS_NORMAL);

    with CaptionRect do
      ExcludeClipRect(Canvas.Handle, Left, Top, Right, Bottom);
    DrawThemeBackground(Theme, Canvas.Handle, Part, ThemeState, R, nil);
    SelectClipRgn(Canvas.Handle, 0);

    { Draw Text }
    if not UseCheckBox then
      if Caption <> '' then
      begin
        Canvas.Font.Color := clHighlight;
        DrawThemeText(Theme, Canvas.Handle, Part, ThemeState, PWideChar(Caption), Length(Caption), DrawTextBiDiModeFlags(DT_VCenter or DT_SINGLELINE or DT_Center), 0, CaptionRect);
      end;
    CloseThemeData(Theme);
  end;
end;

