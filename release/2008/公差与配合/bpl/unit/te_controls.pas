destructor TTeCustomItem.Destroy;
var
  I: Integer;
begin
  for I := Count-1 downto 0 do 
    Items[I].Free;
  if Assigned(FParent) then
    FParent.Remove(Self);

  FItems.Free;

  FActionLink.Free;
  FActionLink := nil;

  inherited;
end;

