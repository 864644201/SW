constructor TTePopupWindow.CreatePopupWindow(AOwner: TComponent;
  AItems: TTeCustomItem; AParentView: TTeItemView);
begin
  inherited CreateNew(AOwner);
  FForm := GetFormClass.Create(Self);
  FForm.Loaded;
  FForm.FPopupWindow := Self;
  FForm.StayOnTop := true;
  if AItems.PopupMenuOptions <> nil then
  begin
    FForm.Blending := AItems.PopupMenuOptions.Blending;
    FForm.Shadow := AItems.PopupMenuOptions.Shadow;
  end;

  if (AOwner.Owner <> nil) and (AOwner.Owner is TWinControl) then
    FForm.FOwnerForm := TWinControl(AOwner.Owner)
  else
    if AOwner is TWinControl then
      FForm.FOwnerForm := TWinControl(AOwner);

  if (not AItems.OnlyFirst) or ((AItems.OnlyFirst) and (AItems.First)) and (AItems.PopupMenuOptions <> nil) then
  begin
    FForm.Animation := AItems.PopupMenuOptions.Animation;
    if AItems.Parent <> nil then
      AItems.Parent.First := false
    else
      AItems.First := false;
  end;

  FView := TTePopupView.CreateView(Self, 0, 0);
  FView.Canvas := FForm.Canvas;
  FView.ParentComponent := Self;
  FView.Items := AItems;
  FView.ParentView := AParentView;
  FView.Window := Self;

  Cursor := crDefault;

  DefaultMonitor := dmDesktop;
end;

