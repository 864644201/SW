procedure TTeCustomHint.SetActive(const Value: Boolean);
var
  i: Integer;
begin
  FActive := Value;
  
  if (csDesigning in ComponentState) then Exit;

  if FActive then
  begin
    FOldHintWindowClass := HintWindowClass;
    HintWindowClass := TTeHintWindow;
    with Application do
    begin
      ShowHint := false;
      FOldShowHint := OnShowHint;
      OnShowHint := DoShowHint;
      ShowHint := true;
    end;
  end;

  if FActive and (Application.MainForm <> nil) then
    with Application.MainForm do
      for i := 0 to ComponentCount-1 do
        if (Components[i] is TTeCustomHint) and (Components[i] <> Self) then
          if TTeCustomHint(Components[i]).Active then
            TTeCustomHint(Components[i]).Active := false;

  if FActive then
    Application.OnShowHint := DoShowHint;
end;

