procedure FillAlpha(var X; Count: Integer; Alpha: byte); assembler;
asm
  PUSH    EDI
 
  MOV     EDI,EAX  // Point EDI to destination
  MOV     AL, CL
  MOV     ECX,EDX
  TEST    ECX,ECX
  JS      @exit
 
@1:
  INC     EDI
  INC     EDI
  INC     EDI
  MOV     [EDI], AL
  INC     EDI
  LOOP    @1
 
@exit:
  POP     EDI
end;

