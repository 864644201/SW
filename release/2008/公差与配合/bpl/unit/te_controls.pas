const
  Time: integer = 400;
  Resolution: integer = 2;
  TileCount: integer = 1;
  Direction: TTeDirection = kdNone;
  SourceImage: TTeBitmap = nil;
  DestImage: TTeBitmap = nil;

var
  MatrixWidth, MatrixHeight, RepeatWidth, RepeatHeight: integer;
  MatrixLen: integer;
  Matrix: PksEffectMatrix;

procedure CalcFrame(Result: TTeBitmap; AProc: TTeEffectProc; Percent: byte);
var
  ResultColor, SourceColor, DestColor: PKColor;
  MatrixValue: byte;
  RotateValue: byte;
  x, y, MatrixX, MatrixY, TileX, TileY, ResX, ResY: integer; { loop variables }
begin
  { FadeMatrix's Animation }
  FillChar(Matrix^, MatrixLen, 0);

  { Choise animation }
  if @AProc = nil then Exit;

  if Direction in [kdRotate90, kdRotate270] then
    AProc(Matrix^, MatrixHeight, MatrixWidth, Percent)
  else
    AProc(Matrix^, MatrixWidth, MatrixHeight, Percent);

  { Calc animation frame }
  for TileX := 0 to TileCount-1 do
    for TileY := 0 to TileCount-1 do
      for MatrixX := 0 to MatrixWidth - 1 do
        for MatrixY := 0 to MatrixHeight - 1 do
        begin
          for ResX := MatrixX * Resolution to (MatrixX + 1) * Resolution do
            for ResY := MatrixY * Resolution to (MatrixY + 1) * Resolution do
            begin
              x := (TileX * RepeatWidth) + ResX;
              y := (TileY * RepeatHeight) + ResY;
              if x >= Result.Width then Continue;
              if y >= Result.Height then Continue;

              ResultColor := Result.PixelPtr[x, y];
              SourceColor := SourceImage.PixelPtr[x, y];
              DestColor := DestImage.PixelPtr[x, y];

              { Get matrix value}
              case Direction of
                kdNoRotate: MatrixValue := Matrix[MatrixX + MatrixWidth * MatrixY];
                kdRotate90: MatrixValue := Matrix[MatrixY + MatrixHeight * (MatrixWidth - MatrixX - 1)];
                kdRotate180: MatrixValue := Matrix[(MatrixWidth - MatrixX - 1) + MatrixWidth * (MatrixHeight - MatrixY - 1)];
                kdRotate270: MatrixValue := Matrix[(MatrixHeight - MatrixY - 1) + MatrixHeight * MatrixX];
              else
                MatrixValue := Matrix[MatrixX + MatrixWidth * MatrixY];
              end;

              { Transparent color }
              if (TKColorRec(DestColor^).R = TKColorRec(ckTransparent).R) and
                 (TKColorRec(DestColor^).G = TKColorRec(ckTransparent).G) and
                 (TKColorRec(DestColor^).B = TKColorRec(ckTransparent).B)
              then
              begin
                ResultColor^ := SourceColor^;
                Continue;
              end;

              { Apply matrix value }
              if MatrixValue = 0 then
                ResultColor^ := SourceColor^
              else
                if MatrixValue = $FF then
                  ResultColor^ := DestColor^
                else
                begin
                  TKColorRec(DestColor^).A := MatrixValue;
                  ResultColor^ := BlendPixel(DestColor^, SourceColor^);
                end;
            end;
        end;
end;

procedure ExecuteAnimation(Canvas: TCanvas; X, Y: integer; ASourceImage, ADestImage: TTeBitmap; Animation: TTeAnimation);
var
  Proc: TTeEffectProc;
  Timer: TTeTimer;
  CurTime: single;
  Percent: integer;
  Result: TTeBitmap;
  MyEffect: TKeEffect;
begin
  SourceImage := ASourceImage;
  DestImage := ADestImage;

  if SourceImage = nil then Exit;
  if SourceImage.Width * SourceImage.Height = 0 then Exit;

  { Check }
  if DestImage = nil then Exit;
  if DestImage.Width * DestImage.Height = 0 then Exit;

  { Set property }
  Time := Animation.Time;
  Direction := Animation.Direction;
  Resolution := Animation.Resolution;
  TileCount := Animation.TileCount;

  { Select Animation }
  if Animation.Effect = keRandomSelect then
    MyEffect := TKeEffect(1 + Random(Integer(keSmoothRectOut)))
  else
    MyEffect := Animation.Effect;
    
  case MyEffect of
    keFade: Proc := @ProcFade;
    keDiagonal: Proc := @ProcDiagonal;
    keDown: Proc := @ProcDown;
    keIn: Proc := @ProcIn;
    keOut: Proc := @ProcOut;
    keRectIn: Proc := @ProcRectIn;
    keRectOut: Proc := @ProcRectOut;
    kePixel: Proc := @ProcPixel;
    kePixelLine: Proc := @ProcPixelLine;
    keDiamondIn: Proc := @ProcDiamondSmoothIn;
    keDiamondOut: Proc := @ProcDiamondSmoothOut;
    keSmoothDiagonal: Proc := @ProcSmoothDiagonal;
    keSmoothRectIn: Proc := @ProcSmoothRectIn;
    keSmoothRectOut: Proc := @ProcSmoothRectOut;
  else
    Proc := nil
  end;

  if @Proc = nil then Exit;

  CurTime := 0.0;

  Result := TTeBitmap.Create;
  try
    Result.SetSize(SourceImage.Width, SourceImage.Height);

    { Calc and GetMem for Matrix }
    MatrixWidth := SourceImage.Width div Resolution div TileCount + 1;
    MatrixHeight := SourceImage.Height div Resolution div TileCount + 1;
    RepeatWidth := SourceImage.Width div TileCount + 1;
    RepeatHeight := SourceImage.Height div TileCount + 1;

    MatrixLen := MatrixWidth * MatrixHeight;

    GetMem(Matrix, MatrixLen);

    { Main animation loop }
    Timer := TTeTimer.Create;
    try

      while CurTime < Time do
      begin
        StartTimer(Timer);

        Percent := Round((CurTime / Time) * 100);
        if Percent > 100 then Percent := 100;

        { Calc animation frame }
        CalcFrame(Result, Proc, Percent);

        { Paint current animation frame }
        Result.Draw(Canvas, X, Y);

        CurTime := CurTime + StopTimer(Timer)*1000;
      end;

    finally
      Timer.Free;
    end;

    { Draw dest image }
    DestImage.Draw(Canvas, X, Y, true);
  finally
    FreeMem(Matrix, MatrixLen);
    Result.Free;
  end;
end;



{ Proc routines }

{$WARNINGS OFF}

procedure ProcLine(var Matrix: TTeEffectMatrix; Width, Height: integer; x1, y1, x2, y2: integer; Alpha: byte);
var
  i, dx, dy, Plotx, Ploty, ix, iy, max, x, y: integer;
  dm, m: real;
  Plot: boolean;
begin
  dx := x2 - x1;
  dy := y2 - y1;
  ix := abs (dx);
  iy := abs (dy);
  if ix > iy then
    max := ix
  else
    max := iy;
  Plotx := x1;
  Ploty := y1;
  x := 0;
  y := 0;
  if (Plotx >= 0) and (Ploty >= 0) and (Plotx < Width) and (Ploty < Height) then
    Matrix [Plotx + Width*Ploty] := Alpha;
  for i := 0 to max do
  begin
    x := x + ix;
    y := y + iy;
    Plot := false;
    if x > max then
    begin
       Plot := true;
       x := x - max;
       if dx > 0 then
         inc (Plotx)
       else
         dec (Plotx);
    end;
    if y > max then
    begin
       Plot := true;
       y := y - max;
       if dy > 0 then
         inc (Ploty)
       else
         dec (Ploty);
     end;
     if (Plot) and (Plotx >= 0) and (Ploty >= 0) and (Plotx < Width) and (Ploty < Height) then
       Matrix[Plotx + Width*Ploty] := Alpha;
   end;
end;

{ Proc's Effects ========================================================}

procedure ProcFade(var Matrix: TTeEffectMatrix; Width, Height: integer; Percent: byte);
var
  Value: Byte;
begin
  if Percent = 0 then Exit;

  Value := Round($FF * (Percent / 100));

  FillChar(Matrix, Width * Height, Value);
end;

procedure ProcDiagonal(var Matrix: TTeEffectMatrix; Width, Height: integer; Percent: byte);
var
  DeltaX, DeltaY: integer;
  x, y: integer;
begin

  if percent = 0 then
    exit;

  DeltaX := MulDiv ((Width-1), Percent, 100) * 2;
  DeltaY := MulDiv ((Height-1), Percent, 100) * 2;

  if DeltaX > DeltaY then
  begin
    y := 0;
    for x := 0 to DeltaX do
    begin
      ProcLine(Matrix, Width, Height, 0, y, x, 0, MulDiv(Percent,$FF,100));
      if y < DeltaY then
        Inc (y);
    end;
  end
  else
  begin
    x := 0;
    for y := 0 to DeltaY do
    begin
      ProcLine(Matrix, Width, Height, 0, y, x, 0, MulDiv(Percent,$FF,100));
      if x < DeltaX then
        Inc(x);
    end;
  end;
end;

procedure ProcDown(var Matrix: TTeEffectMatrix; Width, Height: integer; Percent: byte);
var
  j: integer;
begin
  if percent = 0 then
    exit;
  for j := 0 to MulDiv(Percent,Height-1,100) do
    ProcLine (Matrix, Width, Height, 0, j, Width-1, j, MulDiv(Percent,$FF,100));
end;

procedure ProcIn(var Matrix: TTeEffectMatrix; Width, Height: integer; Percent: byte);
var
  j: integer;
begin
  if percent = 0 then
    exit;
  for j := Height-1 downto Height - 1 - MulDiv(Percent,Height div 2,100) do
    ProcLine (Matrix, Width, Height, 0, j, Width-1, j, MulDiv(Percent,$FF,100));
  for j := 0 to MulDiv(Percent,Height div 2,100) do
    ProcLine (Matrix, Width, Height, 0, j, Width-1, j, MulDiv(Percent,$FF,100));
end;

procedure ProcOut(var Matrix: TTeEffectMatrix; Width, Height: integer; Percent: byte);
var
  j: integer;
begin
  if percent = 0 then
    exit;
  for j := 0 to MulDiv(Percent,Height div 2,100) do
  begin
    ProcLine (Matrix, Width, Height, 0, Height div 2 - j, Width-1, Height div 2 - j, MulDiv(Percent,$FF,100));
    ProcLine (Matrix, Width, Height, 0, Height div 2 + j, Width-1, Height div 2 + j, MulDiv(Percent,$FF,100));
  end;
end;

procedure ProcRectOut(var Matrix: TTeEffectMatrix; Width, Height: integer; Percent: byte);
var
  Delta: integer;
  Center: TPoint;
  i: integer;
  Alpha: integer;
  RealX,RealY: Real;
  x,y: integer;
begin
  if Percent = 0 then
    exit;
  if Width > Height then
  begin
    RealX := 1;
    Delta := MulDiv (Percent, Round (Width*1), 100);
    RealY := Height/Width;
  end
  else
  begin
    RealY := 1;
    Delta := MulDiv (Percent, Round (Height*1), 100);
    RealX:= Width/Height;
  end;
  Center.X := Width div 2;
  Center.Y := Height div 2;
  X := 0;
  Y := 0;
  for i := 0 to Delta div 2 do
  begin
    Alpha := MulDiv ($FF, Percent, 100);
    X := Round (RealX*i);
    Y := Round (RealY * i);
    ProcLine (Matrix, Width, Height, Center.X-x, Center.Y+y,Center.X-x, Center.Y-y, Alpha);
    ProcLine (Matrix, Width, Height, Center.X-x, Center.Y-y,Center.X+x, Center.Y-y, Alpha);
    ProcLine (Matrix, Width, Height, Center.X+x, Center.Y-y,Center.X+x, Center.Y+y, Alpha);
    ProcLine (Matrix, Width, Height, Center.X+x, Center.Y+y,Center.X-x, Center.Y+y, Alpha);
  end;
end;

procedure ProcRectIn(var Matrix: TTeEffectMatrix; Width, Height: integer; Percent: byte);
var
  i,j: integer;
begin
  if Percent = 0 then
    exit;
  ProcRectOut (Matrix, Width, Height, 100-Percent);
  for i := 0 to Width-1 do
    for j := 0 to Height-1 do
      if Matrix[i+j*Width] = 0
      then
        Matrix[i+j*Width] := MulDiv (Percent, $FF,100)
      else
        Matrix[i+j*Width] := 0;
end;

{ Pixel Effects ==============================================================}

procedure ProcPixel(var Matrix: TTeEffectMatrix; Width, Height: integer; Percent: byte);
var
  MatrixSize: Cardinal;
  i, j: cardinal;
  PixelisZero: boolean;
  RandomPosition: Cardinal;
begin
  if percent = 0 then Exit;

  MatrixSize := Width * Height;
  RandSeed := MatrixSize;
  j := Round(MatrixSize * (Percent / 100));
  for i := 1 to j do
  begin
    PixelisZero := false;
    while not PixelisZero do
    begin
      RandomPosition := Random(MatrixSize);
      if Matrix [RandomPosition] = 0 then
      begin
        PixelisZero := true;
        Matrix[RandomPosition] := $FF;
      end;
    end;
  end;
end;

procedure ProcPixelLine(var Matrix: TTeEffectMatrix; Width, Height: integer; Percent: byte);
var
  D: PksEffectMatrix;
  MatrixSize: Cardinal;
  i, j: cardinal;
  PixelisZero: boolean;
  RandomPosition: Cardinal;
  DeltaX, Delta: Integer;
  DeltaP: Real;
begin
  if percent = 0 then
    exit;

  GetMem(D, Width * Height);
  FillChar(D^, Width*Height, 0);

  MatrixSize := Width*Height;
  RandSeed := (MatrixSize);
  j := Round (MatrixSize * Percent/100);

  for i := 1 to j do
  begin
    PixelisZero := false;
    while not PixelisZero do
    begin
      RandomPosition := random (MatrixSize);
      if D^ [RandomPosition] = 0 then
      begin
        PixelisZero := true;
        D^ [RandomPosition] := $FF;
      end;
    end;
  end;

  DeltaX := Round ((Percent/100)*(Width*2-1));
  DeltaP := (0.1*Width) / Percent;
  for i := 0 to DeltaX do
    for j := 0 to Height - 1 do
      begin
        if i < Width then
          begin
            Delta := Round (Percent*2-DeltaP*i);
            if Delta < 0 then
              Delta := 0;
            Delta := Round((Delta/100)*$FF);
            if Delta > $FF then
              Delta := $FF;
            if D^ [i + j*Width] <> $0 then
              Matrix [i + j*Width] :=  Delta;
          end;
    end;

  FreeMem(D, MatrixSize);
end;

{ Smooth Effects ==============================================================}

procedure ProcDiamondSmoothOut(var Matrix: TTeEffectMatrix; Width, Height: integer; Percent: byte);
var
  Delta: integer;
  Center: TPoint;
  i: integer;
  DeltaP: real;
  Alpha: integer;
  RealX,RealY: Real;
  x,y: integer;
begin
  if Percent = 0 then
    exit;
  if Width > Height then
  begin
    RealX := 1;
    Delta := MulDiv (Percent, Round (Width*2.5), 100);
    RealY := Height/Width;
  end
  else
  begin
    RealY := 1;
    Delta := MulDiv (Percent, Round (Height*2.5), 100);
    RealX:= Width/Height;
  end;
  Center.X := Width div 2;
  Center.Y := Height div 2;
  if (Delta div 2) = 0 then
    DeltaP := (Percent*2)
  else
    DeltaP := (Percent*2)  / (Delta div 2);
  X := 0;
  Y := 0;
  for i := 0 to Delta div 2 do
  begin
    Alpha := MulDiv (Round(Percent*2-i*DeltaP), $FF, 100);
    if Alpha > $FF then
      Alpha := $FF;
    if Percent = 100 then
      Alpha := $FF;
    X := Round (RealX*i);
    Y := Round (RealY * i);
    ProcLine (Matrix, Width, Height, Center.X, Center.Y+y, Center.X-x, Center.Y, Alpha);
    ProcLine (Matrix, Width, Height, Center.X-x, Center.Y, Center.X, Center.Y-y, Alpha);
    ProcLine (Matrix, Width, Height, Center.X, Center.Y-y, Center.X+x, Center.Y, Alpha);
    ProcLine (Matrix, Width, Height, Center.X+x, Center.Y, Center.X, Center.Y+y, Alpha);
  end;
end;

procedure ProcDiamondSmoothIn(var Matrix: TTeEffectMatrix; Width, Height: integer; Percent: byte);
var
  i,j: integer;
begin
  if Percent = 0 then
    exit;
  ProcDiamondSmoothOut (Matrix, Width, Height, 100-Percent);
  for i := 0 to Width-1 do
    for j := 0 to Height-1 do
      Matrix[i+j*Width] := $FF - Matrix[i+j*Width];
end;

{ Smooth Effects ==============================================================}

procedure ProcSmoothDiagonal(var Matrix: TTeEffectMatrix; Width, Height: integer; Percent: byte);
var
  DeltaX, DeltaY, Delta: integer;
  DeltaP: Real;
  x, y, i: integer;
  RealX,RealY: Real;
  Alpha: integer;
begin

  if Percent = 0 then
    exit;

  if Width > Height then
  begin
    RealX := 1;
    Delta := MulDiv (Percent, Round(Sqrt(Sqr(Height)+Sqr(Width))*2.5), 100);
    RealY := Height/Width;
  end
  else
  begin
    RealY := 1;
    Delta := MulDiv (Percent, Round(Sqrt(Sqr(Height)+Sqr(Width))*2.5), 100);
    RealX:= Width/Height;
  end;
  if Delta = 0 then
    DeltaP := (Percent*2)
  else
    DeltaP := (Percent*2)  / Delta;

  for i := 0 to Delta do
  begin
    Alpha := MulDiv (Round(Percent*2-i*DeltaP), $FF, 100);
    if Alpha > $FF then
      Alpha := $FF;
    if Percent = 100 then
      Alpha := $FF;
    x := Round (RealX*i);
    y := Round (RealY * i);
    ProcLine (Matrix, Width, Height, 0, y, x, 0, Alpha);
  end;
end;

procedure ProcSmoothRectOut(var Matrix: TTeEffectMatrix; Width, Height: integer; Percent: byte);
var
  Delta: integer;
  Center: TPoint;
  i: integer;
  DeltaP: real;
  Alpha: integer;
  RealX,RealY: Real;
  x,y: integer;
begin
  if Percent = 0 then
    exit;
  if Width > Height then
  begin
    RealX := 1;
    Delta := MulDiv (Percent, Round (Width*1.6), 100);
    RealY := Height/Width;
  end
  else
  begin
    RealY := 1;
    Delta := MulDiv (Percent, Round (Height*1.6), 100);
    RealX:= Width/Height;
  end;
  Center.X := Width div 2;
  Center.Y := Height div 2;
  if (Delta div 2) = 0 then
    DeltaP := (Percent*2)
  else
    DeltaP := (Percent*2)  / (Delta div 2);
  X := 0;
  Y := 0;
  for i := 0 to Delta div 2 do
  begin
    Alpha := MulDiv (Round(Percent*2-i*DeltaP), $FF, 100);
    if Alpha > $FF then
      Alpha := $FF;
    if Percent = 100 then
      Alpha := $FF;
    X := Round (RealX*i);
    Y := Round (RealY * i);
    ProcLine (Matrix, Width, Height, Center.X-x, Center.Y+y,Center.X-x, Center.Y-y, Alpha);
    ProcLine (Matrix, Width, Height, Center.X-x, Center.Y-y,Center.X+x, Center.Y-y, Alpha);
    ProcLine (Matrix, Width, Height, Center.X+x, Center.Y-y,Center.X+x, Center.Y+y, Alpha);
    ProcLine (Matrix, Width, Height, Center.X+x, Center.Y+y,Center.X-x, Center.Y+y, Alpha);
  end;
end;

procedure ProcSmoothRectIn(var Matrix: TTeEffectMatrix; Width, Height: integer; Percent: byte);
var
  i,j: integer;
begin
  if Percent = 0 then
    exit;
  ProcSmoothRectOut (Matrix, Width, Height, 100-Percent);
  for i := 0 to Width-1 do
    for j := 0 to Height-1 do
      Matrix[i+j*Width] := $FF - Matrix[i+j*Width];
end;




