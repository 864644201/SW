procedure InitWindowsBlend;
var
  VI: TOSVersionInfo;
begin
  if not EnableWindowsBlend then Exit;

  VI.dwOSVersionInfoSize := SizeOf(VI);
  GetVersionEx(VI);
  if VI.dwPlatformId <> VER_PLATFORM_WIN32_NT then Exit;
  if VI.dwMajorVersion < 5 then Exit;

  MSImg32Lib := LoadLibrary('msimg32.dll');
  if MSImg32Lib <> 0 then
  begin
    TransparentBltFunc := GetProcAddress(MSImg32Lib, 'TransparentBlt');
  end;
end;




