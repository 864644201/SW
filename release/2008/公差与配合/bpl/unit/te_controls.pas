constructor TTeHeaderSection.Create(Collection: TCollection);
begin
  FWidth := 50;
  FMaxWidth := 10000;
  FMinWidth := 0;
  FAllowClick := True;
  FImageIndex := -1;
  FAlignment := taLeftJustify;
  FAutoSize := False;
  FLayout := hglGlyphLeft;
  FMargin := 7;
  FSpacing := 4;
  FStyle := hsText;
  FShowImage := True;
  inherited Create(Collection);
end;

procedure TTeHeaderSection.Assign(Source: TPersistent);
begin
  if Source is THeaderSection then
  begin
    Alignment := (Source as THeaderSection).Alignment;
    AllowClick := (Source as THeaderSection).AllowClick;
    AutoSize := (Source as THeaderSection).AutoSize;
    {$IFDEF KS_COMPILER5_UP}
    ImageIndex := (Source as THeaderSection).ImageIndex;
    {$ENDIF}
    MaxWidth := (Source as THeaderSection).MaxWidth;
    MinWidth := (Source as THeaderSection).MinWidth;
    Text := (Source as THeaderSection).Text;
    Width := (Source as THeaderSection).Width;
  end
  else
    if Source is TTeHeaderSection then
    begin
      Alignment := (Source as TTeHeaderSection).Alignment;
      AllowClick := (Source as TTeHeaderSection).AllowClick;
      AutoSize := (Source as TTeHeaderSection).AutoSize;
      ImageIndex := (Source as TTeHeaderSection).ImageIndex;
      Layout := (Source as TTeHeaderSection).Layout;
      Margin := (Source as TTeHeaderSection).Margin;
      MaxWidth := (Source as TTeHeaderSection).MaxWidth;
      MinWidth := (Source as TTeHeaderSection).MinWidth;
      Spacing := (Source as TTeHeaderSection).Spacing;
      Style := (Source as TTeHeaderSection).Style;
      ShowImage := (Source as TTeHeaderSection).ShowImage;
      Text := (Source as TTeHeaderSection).Text;
      Width := (Source as TTeHeaderSection).Width;
    end
    else
      inherited;
end;

function TTeHeaderSection.GetDisplayName: string;
begin
  Result := Text;
  if Result = '' then
    Result := inherited GetDisplayName;
end;

function TTeHeaderSection.GetHeaderControl: TTeCustomHeaderControl;
begin
  Result := TTeHeaderSectionsHack(Collection).GetOwner as TTeCustomHeaderControl
end;

function TTeHeaderSection.GetLeft: integer;
begin
  Result := HeaderControl.GetSectionRect(Index).Left;
end;

function TTeHeaderSection.GetResizeCatchAreaWidth: integer;
begin
  Result := CResizeCatchAreaWidth;
  if Result > Width div 3 then
    Result := Width div 3;
end;

function TTeHeaderSection.GetRight: integer;
begin
  Result := GetLeft + Width;
end;

function TTeHeaderSection.GetWidth: integer;
begin
  if not AutoSize then
    Result := FWidth
  else
    with HeaderControl do
      if GetImageVisible(Self) then
        Result := Margin + GetImageSize(Self).x + Spacing + GetTextSize(Self).x + Margin
    else
      Result := Margin + GetTextSize(Self).x + Margin;
end;

procedure TTeHeaderSection.SetAlignment(const Value: TAlignment);
begin
  if FAlignment <> Value then
  begin
    FAlignment := Value;
    HeaderControl.SectionChanged(Index, False);
  end;
end;

procedure TTeHeaderSection.SetAutoSize(const Value: boolean);
begin
  if FAutoSize <> Value then
  begin
    if Value = False then
      FWidth := Width;
    FAutoSize := Value;
    HeaderControl.SectionChanged(Index, True);
  end;
end;

procedure TTeHeaderSection.Seinteger(const Value: integer);
begin
  if FImageIndex <> Value then
  begin
    FImageIndex := Value;
    HeaderControl.SectionChanged(Index, AutoSize);
  end;
