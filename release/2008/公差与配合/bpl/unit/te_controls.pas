type

  THackControl_Combo = class(TWinControl);
  THackListBox = class(TTeCustomListBox);
  THackForm_Combo = class(TCustomForm);

{ TTeComboWindow class }

  TTeComboWindow = class(TForm)
  private
    procedure CMShowingChanged(var Message: TMessage); message CM_SHOWINGCHANGED;
    procedure WMClose(var Message: TWMClose); message WM_CLOSE;
    procedure WMActivate(var Msg: TWMActivate); message WM_ACTIVATE;
    procedure WMMouseActivate(var Msg: TWMMouseActivate); message WM_MOUSEACTIVATE;
    procedure WMEraseBkGnd(var Message: TMessage); message WM_ERASEBKGND;
  protected
    function GetForm: TWinControl;
    function GetKsForm: TTeCustomForm;
    procedure KeyDown(var Key: word; Shift: TShiftState); override;
  protected
    function CloseQuery: Boolean; override;
  public
    constructor Create(AOwner: TComponent); override;
    destructor Destroy; override;
    procedure CreateParams(var Params: TCreateParams); override;
  end;

{ TTeComboWindow ===============================================================}

constructor TTeComboWindow.Create(AOwner: TComponent);
begin
  inherited CreateNew(AOwner);
  BorderStyle := bsNone;
  KeyPreview := true;
end;

destructor TTeComboWindow.Destroy;
begin
  inherited Destroy;
end;

procedure TTeComboWindow.KeyDown(var Key: word; Shift: TShiftState);
begin
  inherited;
  if Key = VK_ESCAPE then
  begin
    (Owner as TTeCustomComboBox).AfterDropDown;
    Hide;
  end;

  if (Key = VK_RETURN) or (Key = VK_SPACE) then
  begin
    if Owner is TTeCustomComboBox then
      (Owner as TTeCustomComboBox).ItemIndex := (Owner as TTeCustomComboBox).FListBox.ItemIndex;
    (Owner as TTeCustomComboBox).AfterDropDown;
    Hide;
  end;
end;

procedure TTeComboWindow.CreateParams(var Params: TCreateParams);
begin
  inherited;
  with Params do
  begin
    Style := (Style and not (WS_CHILD or WS_GROUP or WS_TABSTOP)) or WS_POPUP;
    ExStyle := ExStyle or WS_EX_TOPMOST or WS_EX_TOOLWINDOW;
    WindowClass.Style := WindowClass.Style or CS_SAVEBITS;
  end;
end;

function TTeComboWindow.GetForm: TWinControl;
begin
  if (Owner <> nil) and (Owner.Owner <> nil) and (Owner.Owner is TWinControl) then
    Result := Owner.Owner as TWinControl
  else
    Result := nil;
end;

function TTeComboWindow.GetKsForm: TTeCustomForm;
var
  Form: TWinControl;
  i: integer;
begin
  Result := nil;

  Form := GetForm;
  if Form <> nil then
  begin
    for i := 0 to Form.ComponentCount - 1 do
      if Form.Components[i] is TTeCustomForm then
      begin
        Result := Form.Components[i] as TTeCustomForm;
        Exit;
      end;
  end
  else
    Result := nil;
end;

function TTeComboWindow.CloseQuery: Boolean;
begin
  Result := inherited CloseQuery;
end;

procedure TTeComboWindow.CMShowingChanged(var Message: TMessage);
const
  ShowFlags: array[Boolean] of UINT = (
    SWP_NOSIZE or SWP_NOMOVE or SWP_NOZORDER or SWP_NOACTIVATE or SWP_HIDEWINDOW,
    SWP_NOSIZE or SWP_NOMOVE or SWP_NOZORDER or SWP_NOACTIVATE or SWP_SHOWWINDOW);
begin
  { Must override TCustomForm/TForm's CM_SHOWINGCHANGED handler so that the
    form doesn't get activated when Visible is set to True. }
  SetWindowPos(WindowHandle, 0, 0, 0, 0, 0, ShowFlags[Showing]);
end;

procedure TTeComboWindow.WMEraseBkGnd(var Message: TMessage);
begin
  Message.Result := 1;
end;

procedure TTeCustomComboBox.WMContexMenu(var Message: TMessage);
begin
  if ComboStyle <> kcsDropDownList then
    inherited ;
end;

procedure TTeComboWindow.WMActivate(var Msg: TWMActivate);
var
  OwnerForm: TWinControl;
  MDIOwner: TCustomForm;
begin
  inherited ;

  OwnerForm := GetForm;

  if (Msg.Active = WA_ACTIVE) and (OwnerForm <> nil) then
  begin
    SendMessage(OwnerForm.Handle, WM_NCACTIVATE, 1, 0);

    if (OwnerForm is TCustomForm) and (TForm(OwnerForm).FormStyle = fsMDIChild) then
    begin
      MDIOwner := Application.MainForm;
      if MDIOwner <> nil then
      begin
        SendMessage(MDIOwner.Handle, WM_NCACTIVATE, 1, 0);
      end;
    end;
  end;

  if (Msg.Active = WA_INACTIVE) then
  begin
    (Owner as TTeCustomComboBox).AfterDropDown;
    Hide;
  end;
end;

procedure TTeComboWindow.WMMouseActivate(var Msg: TWMMouseActivate);
begin
  inherited ;
end;

{ TTeCustomComboBox ===========================================================}

constructor TTeCustomComboBox.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);
  FItemIndex := -1;
  FListBox := CreateListBox(Self);
  FListBox.KeyboardClick := false;
  FListBox.Parent := Self;
  FListBox.Visible := false;
  FListBox.TabStop := false;
  FListBox.OnClick := DoListBoxClick;

  if csDesigning in ComponentState then
    FListBox.Align := alNone
  else
    FListBox.Align := alClient;

  FButtonAlign := cbaRight;
  FItemHeight := 15;
  FDropDownCount := 8;

  FWork := false;
  FTimer := TTimer.Create(Self);
  FTimer.Interval := 100;
  FTimer.OnTimer := DoTimer;
  FTimer.Enabled := false;
end;

destructor TTeCustomComboBox.Destroy;
begin
  if FListBox <> nil then
    AfterDropDown;

  if FComboWindow <> nil then FComboWindow.Free;
  inherited Destroy;
end;

procedure TTeCustomComboBox.Loaded;
begin
  FWork := true;
  inherited Loaded;
  FWork := false;
  FOldText := '';

  Realign;
end;

procedure TTeCustomComboBox.SetParent(AParent: TWinControl);
begin
  inherited SetParent(AParent);

  if (csDesigning in ComponentState) and (AParent <> nil) then
    FListBox.SetBounds(0, 1000, 10, 50);
end;

procedure TTeCustomComboBox.Clear;
begin
  inherited Clear;

  FListBox.Clear;
end;

procedure TTeCustomComboBox.Change;
begin
  inherited;
  if not (csLoading in ComponentState) and not (csDesigning in ComponentState) then
    if FAutoComplete then
      if not FWork then
        FTimer.Enabled := true;
end;

procedure TTeCustomComboBox.DoTimer(Sender: TObject);
var
  i: integer;
  S1, S2: string;
begin
  FTimer.Enabled := false;
  if Length(Text) < Length(FOldText) then
  begin
    FOldText := Text;
    Exit;
  end;
  if (FOldText <> Text) and (not FWork) then
  begin
    FOldText := Text;
    FWork := true;
    for i := 0 to Items.Count-1 do
    begin
      S1 := Items[i];
      S2 := Text;
      S1 := LowerCase(S1);
      S2 := LowerCase(S2);
      if S2 = Copy(S1, 1, Length(S2)) then
      begin
        Text := Items[i];
        SelStart := Length(S2);
        SelLength := Length(S1);
        FWork := false;
        Exit;
      end;
    end;
    FWork := false;
  end;
end;

{ Combo }

procedure TTeCustomComboBox.DoCloseComboBox(Sender: TObject);
begin
  if FComboWindow <> nil then
  begin
    AfterDropDown;
    FComboWindow.Hide;
  end;
end;

procedure TTeCustomComboBox.DoListBoxClick(Sender: TObject);
var
  Allow: boolean;
begin
  if FComboWindow <> nil then
  begin
    if Assigned(FOnListBoxClick) then FOnListBoxClick(Self);
    Allow := True;
    if Assigned(FOnAllowChange) then FOnAllowChange(Self, FListBox.ItemIndex, Items[FListBox.ItemIndex], Allow);
    if Allow then
      ItemIndex := FListBox.ItemIndex;
    AfterDropDown;
    FComboWindow.Close;
  end;
end;

function TTeCustomComboBox.CreateListBox(AOwner: TComponent): TTeCustomListBox;
begin
  Result := TTeCustomListBox.Create(Self);
end;

procedure TTeCustomComboBox.AfterDropDown;
var
  SaveOnActivate: TNotifyEvent;
begin
  if (FListBox.Visible) or (FListBox.Parent <> Self) and (Handle <> 0) then
  begin
    ButtonPressed := false;

    FListBox.Visible := false;
    THackControl_Combo(FListBox).SetParent(Self);
    Windows.SetParent(FListBox.Handle, Handle);

//    if ComboStyle = kcsDropDownList then Change;
    Invalidate;

    if Enabled then
    begin
      if Owner is TCustomForm then
      begin
        SaveOnActivate := THackForm_Combo(Owner).OnActivate;
        THackForm_Combo(Owner).OnActivate := nil;
      end
      else
        SaveOnActivate := nil;

      SetFocus;

      if Owner is TCustomForm then
        THackForm_Combo(Owner).OnActivate := SaveOnActivate;
    end;

    if Assigned(FOnCloseUp) then FOnCloseUp(Self);
  end;

  DoCloseActiveComboBox := nil;
  ActiveComboBox := nil;
end;

procedure TTeCustomComboBox.BeforeDropDown;
begin
  if not FListBox.Visible then
  begin
    FListBox.Show;
    THackControl_Combo(FListBox).SetParent(FComboWindow);
    Windows.SetParent(FListBox.Handle, FComboWindow.Handle);
    FListBox.Realign;

    FListBox.Font.Assign(Self.Font);

    ActiveComboBox := Self;
    DoCloseActiveComboBox := DoCloseComboBox;
  end;

  if Assigned(FOnDropDown) then FOnDropDown(Self);
end;

procedure TTeCustomComboBox.ButtonClick;
var
  P: TPoint;
  R, ScreenR: TRect;
  Form: TTeCustomForm;
  i: integer;
begin
  if FComboWindow <> nil then
  begin
    AfterDropDown;

    FComboWindow.Free;
    FComboWindow := nil;
  end;

  FComboWindow := TTeComboWindow.Create(Self);
  { Set bounds }
  P := ClientToScreen(Point(0, FHeight));
  FComboWindow.Left := P.X;
  FComboWindow.Top := P.Y;
  FComboWindow.Width := Width;
  R := THackListBox(FListBox).GetBorderRect;
  FComboWindow.Height := FDropDownCount * FItemHeight + R.Top + (THackListBox(FListBox).FHeight - R.Bottom);

  { Check screen rect }
  ScreenR := GetRectOfMonitorContainingPoint(P, true); 
  if P.Y + FDropDownCount * FItemHeight > ScreenR.Bottom then
    FComboWindow.Top := P.Y - Height - FDropDownCount * FItemHeight;
  if P.X + Width > ScreenR.Right then
    FComboWindow.Left := ScreenR.Right - Width;

  { Clear selections }
  if Items.Count > 0 then
    for i := 0 to Items.Count - 1 do
      FListBox.Selected[i] := false;

  { Set selection }
  if FItemIndex >= 0 then
    FListBox.Selected[FItemIndex] := true
  else
    if Items.Count > 0 then
      FListBox.Selected[0] := true;

  FListBox.ItemHeight := FItemHeight;
  FListBox.Color := Color;
  { Show }
  Form := (FComboWindow as TTeComboWindow).GetKsForm;
  if Form <> nil then
  begin
    Form.DisableDrawing;
    try
      FComboWindow.Show;
      { Place ListBox }
      BeforeDropDown;

      FListBox.SetFocus;
      FListBox.Invalidate;
    finally
      Form.EnableDrawing;
    end;
  end
  else
  begin
    { With out KsForm }
    FComboWindow.Show;
    BeforeDropDown;
    FListBox.SetFocus;
    FListBox.Invalidate;
  end;
end;

function TTeCustomComboBox.GetButtonRect: TRect;
begin
  Result := GetEditRect;

  if not AutoSize then
    Result.Bottom := FHeight - Result.Top;

  if not UseThemes then
    InflateRect(Result, 2, 2)
  else
    InflateRect(Result, 3, 3);

  if FButtonAlign = cbaLeft then
  begin
    Result.Right := Result.Left + GetButtonHeight;
    OffsetRect(Result, -GetButtonHeight, 0);
  end
  else
  begin
    Result.Left := Result.Right - GetButtonHeight;
    OffsetRect(Result, GetButtonHeight, 0);
  end;
end;

function TTeCustomComboBox.GetButtonHeight: integer;
var
  Theme: HTheme;
  Sz: SIZE;
begin
  if UseThemes then
  begin
    Theme := OpenThemeData(0, 'ComboBox');
    GetThemePartSize(Theme, 0, 1, 1, nil, TS_TRUE, Sz);
    Result := Sz.cx;
  end
  else
    Result := 15;
end;

{ Edits }

procedure TTeCustomComboBox.PaintListItem(Rect: TRect; Canvas: TCanvas);
var
  SaveSelected: boolean;
  SaveDC: HDC;
begin
  if FComboStyle = kcsDropDownList then
  begin
    if (High(THackListBox(FListBox).FSelected) > 0) and (FItemIndex >= 0) then
    begin
      SaveSelected := THackListBox(FListBox).FSelected[FItemIndex];
      THackListBox(FListBox).FSelected[FItemIndex] := Focused;
      SaveDC := THackListBox(FListBox).Canvas.Handle;
      try
        THackListBox(FListBox).Canvas.Handle := Canvas.Handle;
        THackListBox(FListBox).DrawItem(Canvas, FItemIndex, Rect);
      finally
        THackListBox(FListBox).Canvas.Handle := SaveDC;
      end;
      THackListBox(FListBox).FSelected[FItemIndex] := SaveSelected;
    end
    else
      if (FItemIndex >= 0) and (Items.Count > 0) then
        THackListBox(FListBox).DrawItem(Canvas, FItemIndex, Rect);

    if Focused then
      DrawFocusRect(Canvas, Rect, ckWhite);
  end;
end;

procedure TTeCustomComboBox.PaintBackground(Rect: TRect; Canvas: TCanvas);
var
  R: TRect;
  B: TTeBitmap;
  Flags: Integer;
  Theme: HTheme;
  Part, tState: integer;
begin
  R := Rect;
  if FButtonAlign = cbaLeft then
    R.Left := R.Left - BorderWidth - 1
  else
    R.Right := R.Right + BorderWidth + 1;

  inherited PaintBackground(R, Canvas);

  { Draw Button }
  R := GetButtonRect;

  if not UseThemes then
  begin
    { Default drawing }
    Flags := DFCS_SCROLLCOMBOBOX;
    if ButtonPressed then
      Flags := Flags or DFCS_PUSHED;

    DrawFrameControl(Canvas.Handle, R, DFC_SCROLL, Flags);
  end
  else
  begin
    { XP Style }
    Theme := OpenThemeData(0, 'ComboBox');

    Part := integer(CP_DROPDOWNBUTTON);

    if not Enabled then
      tState := integer(CBXS_DISABLED)
    else
      if ButtonPressed then
        tState := integer(CBXS_PRESSED)
      else
        if MouseOnButton then
          tState := integer(CBXS_HOT)
        else
          tState := integer(CBXS_NORMAL);

    DrawThemeBackground(Theme, Canvas.Handle, Part, tState, R, nil);

    CloseThemeData(Theme);
  end;

  { Draw Item }
  InflateRect(Rect, 1, 1);
  PaintListItem(Rect, Canvas);
end;

function TTeCustomComboBox.GetEditRect: TRect;
begin
  Result := inherited GetEditRect;

  if FButtonAlign = cbaRight then
    Dec(Result.Right, GetButtonHeight)
  else
    Inc(Result.Left, GetButtonHeight);

  Canvas.Font.Assign(Font);
  Result.Bottom := Result.Top + TextHeight(Canvas, 'Pq');
end;

procedure TTeCustomComboBox.KeyDown(var Key: word; Shift: TShiftState);
begin
  inherited;

  if (ssAlt in Shift) and (Key = VK_DOWN) then
  begin
    ButtonClick;
    Exit;
  end;

  case Key of
    VK_UP: ItemIndex := ItemIndex - 1;
    VK_DOWN: ItemIndex := ItemIndex + 1;
    VK_PRIOR: if not (FComboStyle = kcsDropDown) then ItemIndex := ItemIndex - 3;
    VK_NEXT: if not (FComboStyle = kcsDropDown) then ItemIndex := ItemIndex + 3;
    VK_END: if not (FComboStyle = kcsDropDown) then ItemIndex := Items.Count - 1;
    VK_HOME: if not (FComboStyle = kcsDropDown) then ItemIndex := 0;
  else
    Exit;
  end;

  if ItemIndex < 0 then ItemIndex := 0;  
end;

procedure TTeCustomComboBox.KeyUp(var Key: word; Shift: TShiftState);
begin
  inherited;

end;

procedure TTeCustomComboBox.MouseDown(Button: TMouseButton;
  Shift: TShiftState; x, y: integer);
begin
  inherited;

  if csDesigning in ComponentState then Exit;
  if Button = mbRight then Exit;

  if FComboStyle = kcsDropDownList then
    ButtonClick;
end;

{ Windows Messages }

procedure TTeCustomComboBox.WMNCLButtonDown(var Msg: TWMNCHitMessage);
var
  P: TPoint;
begin
  inherited ;
  if csDesigning in ComponentState then Exit;
  
  P := Point(Msg.XCursor, Msg.YCursor);
  P := ScreenToClient(P);

  if not Focused and CanFocus then
    SetFocus;

  if PtInRect(GetButtonRect, P) then
  begin
    { Down }
    FButtonPressed := true;
    Invalidate;
    { ButtonClick }
    ButtonClick;
  end;
end;

procedure TTeCustomComboBox.WMMouseMove(var Msg: TWMMouse);
begin
  inherited ;

  if csDesigning in ComponentState then Exit;
  
  if FMouseOnButton then
  begin
    FMouseOnButton := false;
    Invalidate;
  end;
end;

procedure TTeCustomComboBox.WMNCMouseMove(var Msg: TWMNCHitMessage);
var
  P: TPoint;
begin
  inherited ;

  if csDesigning in ComponentState then Exit;
  
  P := Point(Msg.XCursor, Msg.YCursor);
  P := ScreenToClient(P);

  if not FMouseOnButton then
  begin
    if PtInRect(GetButtonRect, P) then
    begin
      FMouseOnButton := true;
      Invalidate;
    end
  end
  else
    if not PtInRect(GetButtonRect, P) then
    begin
      FMouseOnButton := false;
      Invalidate;
    end;
end;

{ Properties }

procedure TTeCustomComboBox.SetButtonAlign(const Value: TTeComboButtonAlign);
begin
  if FButtonAlign <> Value then
  begin
    FButtonAlign := Value;
    Invalidate;
  end;
end;

procedure TTeCustomComboBox.WMNCHitTest(var Msg: TWMNCHitTest);
var
  P: TPoint;
begin
  P := Point(Msg.XPos, Msg.YPos);
  P := ScreenToClient(P);

  if PtInRect(GetEditRect, P) then
    Msg.Result := HTCLIENT
  else
    Msg.Result := HTREDUCE;
end;

procedure TTeCustomComboBox.CMMouseLeave(var Message: TMessage);
