{ Buffered Paint }

procedure TTeCustomControl.PaintOwnerBackground(DC: HDC);
var
  P: TPoint;
  i, SaveIndex, SaveIndex2: Integer;
  EBInfo: TEraseBackgroundInfo;
  Buffer: TTeBitmap;
  TempCanvas: TCanvas;
  M: TMessage;
  F: TTeCustomForm;
begin
  if Parent = nil then Exit;
  if (Width <= 0) or (Height <= 0) then Exit;

  { Paint Owner Background }
  SaveIndex := SaveDC(DC);
  try
    P := ClientOrigin;
    if csDesigning in ComponentState then
    begin
      { DesignTime }
      Windows.ScreenToClient(Parent.Handle, P);
      MoveWindowOrg(DC, -P.X, -P.Y);

      if Parent is TCustomForm then
      begin
        TempCanvas := TCanvas.Create;
        TempCanvas.Handle := DC;
        FillRect(TempCanvas, Rect(0, 0, TCustomForm(Parent).Width, TCustomForm(Parent).Height), TForm(Parent).Color);
        TempCanvas.Handle := 0;
        TempCanvas.Free;
      end
      else
      begin
        EBInfo.Action := keaPaintBackground;
        EBInfo.Rect := BoundsRect;
        Parent.Perform(WM_ERASEBKGND, DC, Integer(@EBInfo));
      end;

      { Blending - draw graphic controls }
      if FBlending.Enabled then
      begin
        if Parent is TWinControl then
          for i := 0 to TWinControl(Parent).ControlCount - 1 do
            if TWinControl(Parent).Controls[i] is TGraphicControl then
            begin
              SaveIndex2 := SaveDC(DC);
              MoveWindowOrg(DC, TWinControl(Parent).Controls[i].Left, TWinControl(Parent).Controls[i].Top);
              with TWinControl(Parent).Controls[i].ClientRect do
                IntersectClipRect(DC, Left, Top, Right, Bottom);
              TControlAccess(TWinControl(Parent).Controls[i]).Perform(WM_PAINT, DC, 0);
              MoveWindowOrg(DC, -TWinControl(Parent).Controls[i].Left, -TWinControl(Parent).Controls[i].Top);
              RestoreDC(DC, SaveIndex2);
            end;

      end;

      MoveWindowOrg(DC, P.X, P.Y);
    end
    else
    begin
      { RunTime }
      if FPerformance = kspNoBuffer then
      begin
        { No Buffer }
        Buffer := TTeBitmap.Create;
        Buffer.SetSize(FWidth, FHeight);

        Windows.ScreenToClient(Parent.Handle, P);
        MoveWindowOrg(Buffer.DC, -P.X, -P.Y);

        EBInfo.Action := keaPaintBackground;
        EBInfo.Rect := BoundsRect;
        if (Parent is TCustomForm) then
        begin
          F := GetParentKsForm(Self);
          if F <> nil then
          begin
            M.Msg := WM_ERASEBKGND;
            M.wParam := Buffer.DC;

            IntersectClipRect(Buffer.DC, Left, Top, Left + Width, Top + Height);

            M.lParam := Integer(@EBInfo);
            F.Dispatch(M);
          end
          else
            SendMessage(Parent.Handle, WM_ERASEBKGND, Buffer.DC, Integer(@EBInfo))
        end
        else
          Parent.Perform(WM_ERASEBKGND, Buffer.DC, Integer(@EBInfo));

        MoveWindowOrg(Buffer.DC, P.X, P.Y);

        Buffer.Draw(DC, 0, 0);
        Buffer.Free;
      end
      else
      begin
        { Buffering }
        Windows.ScreenToClient(Parent.Handle, P);
        MoveWindowOrg(DC, -P.X, -P.Y);

        EBInfo.Action := keaPaintBackground;
        EBInfo.Rect := BoundsRect;
        EBInfo.PaintChildren := true;
        if Parent is TCustomForm then
          SendMessage(Parent.Handle, WM_ERASEBKGND, DC, Integer(@EBInfo))
        else
          Parent.Perform(WM_ERASEBKGND, DC, Integer(@EBInfo));

        { Blending - draw graphic controls }
        if FBlending.Enabled then
        begin
          if Parent is TWinControl then
            for i := 0 to TWinControl(Parent).ControlCount - 1 do
              if TWinControl(Parent).Controls[i] is TGraphicControl then
              begin
                SaveIndex2 := SaveDC(DC);
                MoveWindowOrg(DC, TWinControl(Parent).Controls[i].Left, TWinControl(Parent).Controls[i].Top);
                with TWinControl(Parent).Controls[i].ClientRect do
                  IntersectClipRect(DC, Left, Top, Right, Bottom);
                TControlAccess(TWinControl(Parent).Controls[i]).Perform(WM_PAINT, DC, 0);
                MoveWindowOrg(DC, -TWinControl(Parent).Controls[i].Left, -TWinControl(Parent).Controls[i].Top);
                RestoreDC(DC, SaveIndex2);
              end;

        end;

        MoveWindowOrg(DC, P.X, P.Y);
      end;
    end;
  finally
    RestoreDC(DC, SaveIndex);
  end;
end;

