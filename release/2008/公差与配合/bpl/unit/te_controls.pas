  Active: Boolean);
begin
  if Assigned(FOnDrawTab) then
    FOnDrawTab(Self, TabIndex, Rect, Active);
end;

function TTeCustomTabControl.IndexOfTabAt(X, Y: Integer): Integer;
begin
  Result := PtInTab(x, y);
end;

function TTeCustomTabControl.RowCount: Integer;
begin
  if GetTabCount = 0 then
    Result := 0
  else
    Result := GetTabRowCount;
end;

function TTeCustomTabControl.TabRect(Index: Integer): TRect;
begin
  GetTabRect(Index);
end;

procedure TTeCustomTabControl.Notification(AComponent: TComponent;
  Operation: TOperation);
begin
  inherited;
  if (Operation = opRemove) and (AComponent = Images) then
    Images := nil;
end;

procedure TTeCustomTabControl.WMGetDlgCode(var Msg: TWMGetDlgCode);
begin
  inherited;
  Msg.Result := dlgc_WantArrows;
end;

procedure TTeCustomTabControl.CMDesignHitTest(var Msg: TCMDesignHitTest);
var
  Shift: TShiftState;
begin
  Shift := KeysToShiftState(Msg.Keys);

  if ssLeft in Shift then
  begin
    MouseDown(mbLeft, Shift, Msg.XPos, Msg.YPos);
    Msg.Result := 0;
  end;
end;

procedure TTeCustomTabControl.CMEnabledChanged(var Msg: TMessage);
begin
  inherited;
  Invalidate;
end;

procedure TTeCustomTabControl.CMMouseLeave(var Msg: TMessage);
begin
  if FMouseOnLeftBtn or
    FMouseOnRightBtn or
    (FMouseOnTabIndex > -1)
    then
  begin
    FMouseOnLeftBtn := false;
    FMouseOnRightBtn := false;
    FMouseOnTabIndex := -1;
    InvalidateTabs;
  end;
end;

procedure TTeCustomTabControl.SetTabPosition(const Value: TTabPosition);
var
  R: TRect;
begin
  if FTabPosition <> Value then
  begin
    FTabPosition := Value;
    if (TabPosition in [tpLeft, tpRight]) and not MultiLine then
      MultiLine := true;

    Invalidate;

    if FUsePages and (FActivePage <> nil) then
    begin
      DisableAlign;
      try
        UpdateTabRows;
        AdjustClientRect(R);
        FActivePage.BoundsRect := R;

      finally
        EnableAlign;
      end;

      FActivePage.Perform(WM_ERASEBKGND, FActivePage.Canvas.Handle, 0);
      FActivePage.Invalidate;

      if csDesigning in ComponentState then
        Realign;
    end;
  end;
end;

procedure TTeCustomTabControl.SetTabs(const Value: TStrings);
begin
  FTabs.Assign(Value);
end;

procedure TTeCustomTabControl.SetTabIndex(const Value: integer);
var
  TmpRect: TRect;
  OldIndex: integer;
begin
  if csLoading in ComponentState then
    FStoredTabIndex := Value;
    
  if (FTabIndex <> Value) and (Value >= 0) and (Value <= GetTabCount - 1) then
  begin
    OldIndex := FTabIndex;
    FTabIndex := Value;

    if not CanChange then
    begin
      FTabIndex := OldIndex;
      Exit;
    end;

    while GetScrlBtnsVisible and
      (IntersectRect(TmpRect, GetTabRect(FTabIndex), GetLeftScrlBtnRect) or
      IntersectRect(TmpRect, GetTabRect(FTabIndex), GetRightScrlBtnRect)) do
      FFirstVisibleTab := FFirstVisibleTab + 1;
    while FFirstVisibleTab > FTabIndex do
      FFirstVisibleTab := FFirstVisibleTab - 1;

    if not FMultiline then
    begin
      if GetLastVisibleTab(true) <> 0 then
        if GetLastVisibleTab(true) < FTabIndex then
        begin
          while GetLastVisibleTab(true) < FTabIndex do
            FFirstVisibleTab := FFirstVisibleTab + 1;
        end;
    end;

    InvalidateTabs;

    if FUsePages then
    begin
      SetActivePageIndex(GetPageIndexFromTabIndex(TabIndex));
      Realign;
    end
    else
      Change;

  end;
end;

procedure TTeCustomTabControl.SetRaggedRight(const Value: Boolean);
begin
  if FRaggedRight <> Value then
  begin
    FRaggedRight := Value;
    Invalidate;
  end;
end;

procedure TTeCustomTabControl.SetScrollOpposite(const Value: Boolean);
begin
  if FScrollOpposite <> Value then
  begin
    FScrollOpposite := Value;
    if Value then
      FMultiLine := Value;

    Realign;
    Invalidate;
  end;
end;

procedure TTeCustomTabControl.SetHotTrack(const Value: Boolean);
begin
  if FHotTrack <> Value then
  begin
    FHotTrack := Value;
    Invalidate;
  end;
end;

procedure TTeCustomTabControl.SetTabHeight(const Value: integer);
begin
  if FTabSize.y <> Value then
  begin
    FTabSize.y := Value;
    Invalidate;
    Realign;
  end;
end;

procedure TTeCustomTabControl.SetTabWidth(const Value: integer);
begin
  if FTabSize.x <> Value then
  begin
    FTabSize.x := Value;
    Invalidate;
    Realign;
  end;
end;

procedure TTeCustomTabControl.SetOwnerDraw(const Value: Boolean);
begin
  if FOwnerDraw <> Value then
  begin
    FOwnerDraw := Value;
    Invalidate;
  end;
end;

procedure TTeCustomTabControl.SetMultiLine(const Value: Boolean);
begin
  if (TabPosition in [tpLeft, tpRight]) and (Value = false) then
    raise Exception.Create('MultiLine must be True when TabPosition is tpLeft or tpRight')
  else
    if FMultiLine <> Value then
    begin
      FMultiLine := Value;
      UpdateTabRows;
      Realign;
      Invalidate;
    end;
end;

function TTeCustomTabControl.GetPage(Index: Integer): TTeCustomTabSheet;
begin
  if (Index >= 0) and (Index < FPages.Count) then
    Result := FPages[Index]
  else
    Result := nil;
end;

function TTeCustomTabControl.GetPageCount: Integer;
begin
  Result := FPages.Count;
end;

procedure TTeCustomTabControl.SetUsePages(const Value: boolean);
begin
  if FUsePages <> Value then
  begin
    FUsePages := Value;

    if not (csLoading in ComponentState) then
    begin
      if FUsePages then
      begin
        { Remove all controls }
        while ControlCount > 0 do
          Controls[0].Free;
      end;

      TabsChanged;
    end;
  end;
end;

function TTeCustomTabControl.GetActivePageIndex: integer;
begin
  if FUsePages and (FActivePage <> nil) then
    Result := FActivePage.PageIndex
  else
    Result := -1;
end;

function TTeCustomTabControl.GetTabSizeX: integer;
begin
  Result := FTabSize.x;
end;

function TTeCustomTabControl.GetTabSizeY: integer;
begin
  Result := FTabSize.y;
end;

procedure TTeCustomTabControl.Resize;
begin
  inherited;
  if FUsePages and (FActivePage <> nil) then
    FActivePage.Invalidate;
end;

function TTeCustomTabControl.GetActivePage: TTeCustomTabSheet;
begin
  if FUsePages and (ActivePageIndex >= 0) and (ActivePageIndex < FPages.Count) then
    Result := FPages[ActivePageIndex]
  else
    Result := nil;
end;

procedure TTeCustomTabControl.SetTransparent(const Value: boolean);
begin
  if FTransparent <> Value then
  begin
    FTransparent := Value;
    Invalidate;
  end;
end;

procedure TTeCustomTabControl.SetImageList(const Value: TImageList);
begin
  if FImageList <> Value then
  begin
    FImageList := Value;
    Invalidate;
  end;
end;

procedure TTeCustomTabControl.CMDialogChar(var Message: TCMDialogChar);
var
  i: integer;
begin
  with Message do
    for i := 0 to FTabs.Count - 1 do
      if IsAccel(CharCode, FTabs[i]) and CanFocus then
      begin
        TabIndex := i;
        Result := 1;
        Exit;
      end;

  inherited;
end;

procedure TTeCustomTabControl.SetBounds(ALeft, ATop, AWidth,
  AHeight: Integer);
var
  OldTabRow: integer;
begin
  inherited;

  if FMultiline then
  begin
    OldTabRow := FTabRowCount;
    UpdateTabRows;
    if OldTabRow <> FTabRowCount then
    begin
      Realign;
      Invalidate;
    end;
  end;
end;



{ TTeTimer ====================================================================}

function RDTSC: Int64;
asm
  dw 310Fh
end;

{ TTeTimer }

constructor TTeTimer.Create;
begin
  inherited Create;
  {$IFDEF KS_LINUX}
  CalibrateLinux;
  {$ENDIF}
  {$IFDEF KS_WIN}
  CalibrateWindows;
  {$ENDIF}
  GetFrequency;
end;

function TTeTimer.GetElapsed: Extended;
begin
  Result := (StopValue - StartValue - FCalibrate) / FFrequency;
end;

function TTeTimer.GetFrequency: Int64;
begin
{$IFDEF KS_LINUX}
  MeasureFrequency;
{$ENDIF}
{$IFDEF KS_WIN}
  QueryPerformanceFrequency(FFrequency);
{$ENDIF}
  Result:= FFrequency;
  {on KS_LINUX this is the real Frequency, but not on Windows}
end;

{$IFDEF KS_LINUX}
procedure TTeTimer.CalibrateLinux;
var
  Val1, Val2, Val3, Val4, Val5: Int64;
begin
  USleep(1);

  StartValue:= RDTSC;
  StopValue:=  RDTSC;
  Val1:= (StopValue - StartValue);

  StartValue:= RDTSC;
  StopValue:=  RDTSC;
  Val2:= (StopValue - StartValue);

  StartValue:= RDTSC;
  StopValue:=  RDTSC;
  Val3:= (StopValue - StartValue);

  StartValue:= RDTSC;
  StopValue:=  RDTSC;
  Val4:= (StopValue - StartValue);

  StartValue:= RDTSC;
  StopValue:=  RDTSC;
  Val5:= (StopValue - StartValue);

  FCalibrate:=  (Val1 + Val2 + Val3 + Val4 + Val5) div 5;
end;

procedure TTeTimer.CalibrateUSleep;
var
  Val1, Val2, Val3, Val4, Val5: Int64;
begin
  USleep(1);

  StartValue:= RDTSC;
  USleep(0);
  StopValue:=  RDTSC;
  Val1:= (StopValue - StartValue);

  StartValue:= RDTSC;
  USleep(0);
  StopValue:=  RDTSC;
  Val2:= (StopValue - StartValue);

  StartValue:= RDTSC;
  USleep(0);
  StopValue:=  RDTSC;
  Val3:= (StopValue - StartValue);

  StartValue:= RDTSC;
  USleep(0);
  StopValue:=  RDTSC;
  Val4:= (StopValue - StartValue);

  StartValue:= RDTSC;
  USleep(0);
  StopValue:=  RDTSC;
  Val5:= (StopValue - StartValue);

  FCalibrateUSleep := (Val1 + Val2 + Val3 + Val4 + Val5)div 5;
end;

procedure  TTeTimer.MeasureFrequency;
var
  Val1, Val2, Val3, Val4, Val5: Int64;
begin
  CalibrateUSleep;

  StartValue:= RDTSC;
  USleep(1);
  StopValue:=  RDTSC;
  Val1:= (StopValue - StartValue -FCalibrateUSleep);

  StartValue:= RDTSC;
  USleep(1);
  StopValue:=  RDTSC;
  Val2:= (StopValue - StartValue -FCalibrateUSleep);

  StartValue:= RDTSC;
  USleep(1);
  StopValue:=  RDTSC;
  Val3:= (StopValue - StartValue -FCalibrateUSleep);

  StartValue:= RDTSC;
  USleep(1);
  StopValue:=  RDTSC;
  Val4:= (StopValue - StartValue -FCalibrateUSleep);

  StartValue:= RDTSC;
  USleep(1);
  StopValue:=  RDTSC;
  Val5:= (StopValue - StartValue -FCalibrateUSleep);

  FFrequency := (Val1 + Val2 + Val3 + Val4 + Val5) div 5 * 100;
end;
{$ENDIF}

{$IFDEF KS_WIN}
procedure TTeTimer.CalibrateWindows;
begin
  QueryPerformanceCounter(StartValue);
  QueryPerformanceCounter(StopValue);
  FCalibrate:= StopValue - StartValue;
end;
{$ENDIF}

procedure TTeTimer.Start;
begin
{$IFDEF KS_LINUX}
  StartValue:= RDTSC;
{$ENDIF}
{$IFDEF KS_WIN}
  QueryPerformanceCounter(StartValue);
{$ENDIF}
end;

procedure TTeTimer.Stop;
begin
{$IFDEF KS_LINUX}
  StopValue:= RDTSC;
{$ENDIF}
{$IFDEF KS_WIN}
  QueryPerformanceCounter(StopValue);
{$ENDIF}
end;

{ Timer Routines ==============================================================}

procedure StartTimer(var Timer: TTeTimer);
begin
  if Timer = nil then
    Timer := TTeTimer.Create;

  Timer.Start;
end;

function StopTimer(var Timer: TTeTimer): Single;
begin
  Result := 0.0;
  if Timer <> nil then
  begin
    Timer.Stop;
    Result := Timer.Elapsed;
  end;
end;

function StopAndFreeTimer(var Timer: TTeTimer): Single;
begin
  Result := 0.0;
  if Timer <> nil then
  begin
    Timer.Stop;
    Result := Timer.Elapsed;
    Timer.Free;
    Timer := nil;
  end;
end;



