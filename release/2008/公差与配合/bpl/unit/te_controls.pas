procedure InitSubMenuBitmap;
var
  i, j: integer;
begin
  SubMenuBitmap := TBitmap.Create;
  SubMenuBitmap.HandleType := bmDIB;
  SubMenuBitmap.PixelFormat := pf32bit;
  SubMenuBitmap.Width := 20;
  SubMenuBitmap.Height := 20;

  DrawFrameControl(SubMenuBitmap.Canvas.Handle, Rect(0, 0, SubMenuBitmap.Width, SubMenuBitmap.Height), DFC_MENU, DFCS_MENUARROW);

  for i := 0 to SubMenuBitmap.Width - 1 do
    for j := 0 to SubMenuBitmap.Height - 1 do
      if SubMenuBitmap.Canvas.Pixels[i, j] = RGB(255, 255, 255) then
        SubMenuBitmap.Canvas.Pixels[i, j] := RGB(255, 0, 255);

  SubMenuBitmap.Transparent := true;
end;

procedure DrawSubMenuBitmap(Canvas: TCanvas; X, Y: integer; Color: TColor);
var
  i, j: integer;
  Pixels: PKColorArray;
begin
  for j := 0 to SubMenuBitmap.Height - 1 do
  begin
    Pixels := SubMenuBitmap.ScanLine[j];
    for i := 0 to SubMenuBitmap.Width - 1 do
      if Pixels^[i] <> RGB(255, 0, 255) then
        Pixels^[i] := ColorToRGB(Color);
  end;

  Canvas.Draw(X, Y, SubMenuBitmap);
end;

procedure InitMenuFont;
var
  NonClientMetrics: TNonClientMetrics;
begin
  MenuFont := TFont.Create;
