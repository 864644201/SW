{ Scrolling }

procedure TTeItemView.StartScroll;
begin
  if FDropDown and (FChildView <> nil) then
    PostMessage(FChildView.Window.Handle, WM_KEYDOWN, VK_ESCAPE, 0);

  if FScrollTimer = nil then
  begin
    FScrollTimer := TTimer.Create(nil);
    FScrollTimer.Interval := ScrollTimerInterval;
    FScrollTimer.Enabled := true;
    FScrollTimer.OnTimer := DoScrollTimer;
  end;
end;

procedure TTeItemView.StopScroll;
begin
  if FScrollTimer <> nil then
  begin
    FScrollTimer.Enabled := false;
    FScrollTimer.Free;
    FScrollTimer := nil;
  end;

  FActiveScrollButton := ksbNone;
end;

procedure TTeItemView.DoScrollTimer(Sender: TObject);
begin
  if FActiveScrollButton = ksbUp then
    if FItems.TopItem > 0 then SelectPrev;
  if FActiveScrollButton = ksbDown then
    if FItems.TopItem + FItems.ScrollCount < FItems.Count then SelectNext;
end;

{ Drawing }

procedure TTeItemView.Paint(Canvas: TCanvas);
var
  i: integer;
  ViewCount: integer;
begin
  if FItems = nil then Exit;

  if FItems.FScrolled and (FItems.FScrollCount > 0) then
  begin
    ViewCount := FItems.FScrollCount;

    if FItems.TopItem + ViewCount > FItems.Count then
      ViewCount := FItems.Count - FItems.TopItem;
  end
  else
    ViewCount := FItems.Count;

  Canvas.Font.Assign(MenuFont);

  { Draw ScrollButtons }
  if FItems.FScrolled and (FItems.FScrollCount > 0) and (FOrientation = voVertical)then
  begin
    { UpButton }
    FItems.DrawScrollButton(Canvas, Self, GetScrollButtonRect(ksbUp), ksbUp, FActiveScrollButton = ksbUp);
    { Down Button }
    FItems.DrawScrollButton(Canvas, Self, GetScrollButtonRect(ksbDown), ksbDown, FActiveScrollButton = ksbDown);
  end;

  { Draw Items }
  for i := FItems.FTopItem to FItems.FTopItem + ViewCount - 1 do
  begin
    if not FItems[i].Visible then Continue;
    if FItems[i].DrawingDisabled then Continue;
    Items[i].DrawItem(Canvas, Self, FItems[i].ItemRect, Items[i] = FSelItem, not FLoop);
  end;
end;

