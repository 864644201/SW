{ Mouse }

procedure TTeItemView.UpdateHover(P: TPoint);
var
  i: integer;
  ViewCount: integer;
  OldItem: TTeCustomItem;
  R: TRect;
begin
  if (FWindow <> nil) and (FItems <> nil) then
  begin
    OldItem := FSelItem;
    
    P := FWindow.ScreenToClient(P);

    if not FLoop then
    begin
      FSelItem := nil;
      Application.Hint := '';
    end;

    if FItems.FScrolled and (FItems.FScrollCount > 0) then
      ViewCount := FItems.FScrollCount
    else
      ViewCount := FItems.Count;

    { Update ScrollButton }
    if FItems.FScrolled and (FItems.FScrollCount > 0) and (FOrientation = voVertical) then
    begin
      { Up }
      R := GetScrollButtonRect(ksbUp);
      if PtInRect(R, P) then
      begin
        FActiveScrollButton := ksbUp;
        InvalidateScrollButton(ksbUp);
        StartScroll;
      end
      else
      begin
        { Down }
        R := GetScrollButtonRect(ksbDown);
        if PtInRect(R, P) then
        begin
          FActiveScrollButton := ksbDown;
          InvalidateScrollButton(ksbDown);
          StartScroll;
        end
        else
        begin
          InvalidateScrollButton(ksbUp);
          InvalidateScrollButton(ksbDown);
          StopScroll;
       end;
     end;
    end;

    { Update items }
    for i := 0 to FItems.Count-1 do
      if (FItems[i].Visible and PtInRect(FItems[i].ItemRect, P)) and
         ((i >= FItems.FTopItem) and (i < FItems.FTopItem + ViewCount)) then
      begin
        FSelItem := FItems[i];
        Application.Hint := FSelItem.Hint;
        Break;
      end;

    if OldItem <> FSelItem then
    begin
      if OldItem <> nil then InvalidateItem(OldItem);
      if FSelItem <> nil then InvalidateItem(FSelItem);
    end;
  end;
end;

{ Routines }

function TTeItemView.GetScrollButtonRect(Button: TTeMenuScrollButton): TRect;
begin
  Result := Rect(0, 0, 0, 0);

  if FItems.FScrolled and (FItems.FScrollCount > 0) and (FOrientation = voVertical) then
  begin
    if Button = ksbUp then
      Result := Rect(FLeft, FTop, FLeft + FWidth, FTop + ScrollButtonSize);
    if Button = ksbDown then
      Result := Rect(FLeft, FTop + FHeight - ScrollButtonSize, FLeft + FWidth, FTop + FHeight)
  end;
end;

function TTeItemView.GetItemRect(Item: TTeCustomItem): TRect;
var
  i: integer;
  W, H: integer;
  MaxWidth: integer;
  Size: TPoint;
  ViewCount: integer;
begin
  if not IsRectEmpty(Item.ItemRect) then
  begin
    Result := Item.ItemRect;
    Exit;
  end;

  Result := Rect(0, 0, 0, 0);
  Size := Point(0, 0);

  if Item = nil then Exit;
  if not Item.Visible then Exit;

  MaxWidth := 0;

  FCanvas.Font.Assign(MenuFont);
  
  if Item.MDIItemKind <> mikNone then
  begin
    Item.CalcSize(FCanvas, Self, W, H);
    case Item.MDIItemKind of
      mikSysMenu: begin
        Result := Rect(0, 0, W, H);
      end;
      mikMinimize: begin
        Result := Rect(TWinControl(FParentComponent).Width - W * 3,
          0,
          TWinControl(FParentComponent).Width - W * 2,
          H);
      end;
      mikRestore: begin
        Result := Rect(TWinControl(FParentComponent).Width - W * 2,
          0,
          TWinControl(FParentComponent).Width - W,
          H);
      end;
      mikClose: begin
        Result := Rect(TWinControl(FParentComponent).Width - W,
          0,
          TWinControl(FParentComponent).Width,
          H);
      end;
    end;
    OffsetRect(Result, FLeft, FTop);
    { Save to ItemRect }
    Item.ItemRect := Result;

    Exit;
  end;

  if FItems.FScrolled and (FItems.FScrollCount > 0) then
    ViewCount := FItems.FScrollCount
  else
    ViewCount := FItems.Count;

  { Calc max width or height }
  for i := 0 to FItems.Count - 1 do
  begin
    if not FItems[i].Visible then Continue;

    FItems[i].CalcSize(FCanvas, Self, W, H);
    if W > MaxWidth then MaxWidth := W;

    case FOrientation of
      voVertical: begin
        if W > Size.X then Size.X := W;
        if (i >= FItems.FTopItem) and (i <= FItems.FTopItem + ViewCount) then
          Inc(Size.Y, H);

        if FItems.FScrolled and (FItems.FScrollCount > 0) then
          FItems[i].ItemRect := Rect(FLeft, FTop + ScrollButtonSize + Size.Y - H, FLeft + Size.X, FTop + ScrollButtonSize + Size.Y)
        else
          FItems[i].ItemRect := Rect(FLeft, FTop + Size.Y - H, FLeft + Size.X, FTop + Size.Y);
      end;
      voHorizontal: begin
        if H > Size.Y then Size.Y := H;
        Inc(Size.X, W);

        if Item = FItems[i] then
        begin
          FItems[i].FItemRect.TopLeft := Point(FLeft + Size.X - W, FTop);
          FItems[i].FItemRect.BottomRight := Point(FLeft + Size.X, FTop + H);
        end;
      end;
    end;
  end;

  { Set width for popup (all item) }
  if FOrientation = voVertical then
    for i := 0 to FItems.Count - 1 do
      FItems[i].FItemRect.Right := MaxWidth;

  { Save to ItemRect }
  Result := Item.ItemRect;
end;

function TTeItemView.Popup: Boolean;

  function GetPopupPos: TPoint;
  begin
    with FSelItem.ItemRect do
      if FIsMenuBar then
        Result := Point(Left, Bottom)
      else
        Result := Point(Right, Top);

    if FWindow <> nil then
      Result := FWindow.ClientToScreen(Result);
  end;

var
  R: TRect;
begin
  Result := false;
  if FSelItem = nil then Exit;
  if not FSelItem.Enabled then Exit;

  Result := CheckDropDown and (FActiveScrollButton = ksbNone);
  if Result then
    with GetPopupPos do
    begin
      R := FSelItem.ItemRect;
      R.TopLeft := Window.ClientToScreen(R.TopLeft);
      R.BottomRight := Window.ClientToScreen(R.BottomRight);
      FDropDown := true;
      FSelItem.Popup(Self, X, Y, R);
    end;
end;

procedure TTeItemView.SelectNext;
var
  i: integer;
  OldItem: TTeCustomItem;
begin
  OldItem := FSelItem;

  i := FItems.IndexOf(FSelItem);
  if i < FItems.Count - 1 then FSelItem := FItems[i + 1]
  else FSelItem := FItems[0];

  if not FSelItem.Visible or (FSelItem.Caption = '-') then
  begin
    if OldItem <> nil then InvalidateItem(OldItem);
    if (FSelItem <> OldItem) then SelectNext;
    Exit;
  end;

  if FItems.Scrolled and (FItems.ScrollCount > 0) then
  begin
    { Scroll down }
    i := FItems.IndexOf(FSelItem);
    if i = 0 then
    begin
      FItems.TopItem := 0;
      CalcSize;
      InvalidateView;
    end;
    if i >= FItems.TopItem + FItems.ScrollCount then
    begin
      FItems.TopItem := i - FItems.ScrollCount + 1;
      CalcSize;
      InvalidateView;
    end;
  end;

  if OldItem <> FSelItem then
  begin
    if OldItem <> nil then InvalidateItem(OldItem);
    if FSelItem <> nil then InvalidateItem(FSelItem);
    Application.Hint := FSelItem.Hint;
  end;

  if FDropDown then Popup;
end;

procedure TTeItemView.SelectPrev;
var
  i: integer;
  OldItem: TTeCustomItem;
begin
  OldItem := FSelItem;

  i := FItems.IndexOf(FSelItem);
  if i > 0 then FSelItem := FItems[i - 1]
  else FSelItem := FItems[FItems.Count-1];

  if not FSelItem.Visible or (FSelItem.Caption = '-') then
  begin
    if OldItem <> nil then InvalidateItem(OldItem);
    if (FSelItem <> OldItem) then SelectPrev;
    Exit;
  end;

  if FItems.Scrolled and (FItems.ScrollCount > 0) then
  begin
    { Scroll up }
    i := FItems.IndexOf(FSelItem);
    if i < FItems.TopItem then
    begin
      FItems.TopItem := i;
      CalcSize;
      InvalidateView;
    end;
    if i = FItems.Count - 1 then
    begin
      FItems.TopItem := FItems.Count - FItems.ScrollCount;
      CalcSize;
      InvalidateView;
    end;
  end;

  if OldItem <> FSelItem then
  begin
    if OldItem <> nil then InvalidateItem(OldItem);
    if FSelItem <> nil then InvalidateItem(FSelItem);
    Application.Hint := FSelItem.Hint;
  end;

  if FDropDown then Popup;
end;

{ Messages Loop }

const
  CM_POPUP = WM_USER + 111;

function TTeItemView.MessageLoop: Boolean;

 procedure EndLoop;
 var
   View: TTeItemView;
 begin
   View := Self;
   while View <> nil do
   begin
     View.FLoop := false;
     View.FSelItem := nil;
     View.FDropDown:= false;
     View.InvalidateView;
     View := View.FParentView;
   end;
 end;

 function ContinueLoop: boolean;
 begin
   Result := FLoop and (GetCapture = CaptureHandle);
 end;

var
  FirstLoop: Boolean;
  Msg: TMsg;
  P, P2: TPoint;
  Item: TTeCustomItem;
  View: TTeItemView;
  View1: TTeItemView;
  F: Boolean;
begin
  Result := True;
  try
    FLoop := true;

    Windows.SetCursor(Screen.Cursors[crDefault]);

    if FItems.Count > 0 then
    begin
      FSelItem := FItems[FItems.Count - 1];
      if (FItems.TopItem >= 0) and (FItems.TopItem < FItems.Count) then
      begin
        FSelItem := FItems[FItems.TopItem];
        { Skip MDI system menu}
        if (FSelItem.MDIItemKind <> mikNone) and (FItems.TopItem + 1 < FItems.Count) then
          FSelItem := FItems[FItems.TopItem + 1];
        { Invaldiate Item }
        if FSelItem <> nil then
          InvalidateItem(FSelItem);
      end;

      GetCursorPos(P);
      UpdateHover(P);
    end;

    if Window <> nil then
      CaptureMouse(Window.Handle);

    FirstLoop := True;
    while ContinueLoop do
    begin
      if not FirstLoop then
        WaitMessage;
      FirstLoop := False;
      while ContinueLoop and PeekMessage(Msg, 0, 0, 0, PM_NOREMOVE) do
      begin
        case Msg.message of
          WM_WINDOWPOSCHANGING: begin
            EndLoop;
            Exit;
          end;
          WM_LBUTTONDOWN: begin
            P := SmallPointToPoint(TSmallPoint(Msg.lParam));
            ClientToScreen(Msg.hwnd, P);
            P2 := P;
            P:= FWindow.ScreenToClient(P);

            if (FSelItem <> nil) and PtInRect(FSelItem.ItemRect, P) then
              PostMessage(Window.Handle, WM_KEYDOWN, VK_RETURN, 0)
            else
            begin
              View := Self;
              F := false;
              while (View <> nil) and not f do
              begin
                P := View.Window.ScreenToClient(P2);
                if PtInRect(View.FSelItem.ItemRect, P) then
                  f := true;
                View := View.FParentView;
              end;
              if not f then
              begin
                EndLoop;
                Exit;
              end;
            end;
          end;
          WM_QUIT, WM_NCLBUTTONDOWN..WM_NCMBUTTONDBLCLK:
            begin
              EndLoop;
              Continue;
            end;
        end;
        if PeekMessage(Msg, 0, 0, 0, PM_REMOVE or PM_NOYIELD) then
        begin
          case Msg.message of
            CM_POPUP: Popup;
            WM_CONTEXTMENU: ;
            WM_KEYFIRST..WM_KEYLAST:
              if (GetKeyState(VK_LBUTTON) >= 0) then
                case Msg.message of
                  WM_KEYDOWN, WM_SYSKEYDOWN:
                    case Msg.wParam of
                      VK_TAB: begin
                      end;
                      VK_RETURN: begin
                        if (FSelItem <> nil) then
                          FSelItem.DoClick;
                        if not Popup and (FSelItem <> nil) and
                          (FSelItem.Caption <> '-') and (FSelItem.Enabled) then
                            EndLoop;
                      end;
                      VK_SPACE: begin
                      end;
                      VK_ESCAPE: begin
                        if FParentView <> nil then
                          FParentView.FDropDown := false;
                        FSelItem := nil;
                        InvalidateView;
                        Exit;
                      end;
                      VK_LEFT: begin
                        if FIsMenuBar then
                        begin
                          SelectPrev;
                        end
                        else
                          if (FParentView <> nil) then
                            if (FParentView.FIsMenuBar) then
                            begin
                              PostMessage(FParentView.Window.Handle, WM_KEYDOWN, VK_LEFT, 0);
                              Exit;
                            end
                            else
                            begin
                              PostMessage(Window.Handle, WM_KEYDOWN, VK_ESCAPE, 0);
                            end;
                      end;
                      VK_RIGHT: begin
                        if FIsMenuBar then
                        begin
                          SelectNext;
                        end
                        else
                        begin
                          if (FParentView <> nil) then
                            if not Popup then
                              if (FParentView.FIsMenuBar) then
                              begin
                                PostMessage(FParentView.Window.Handle, WM_KEYDOWN, VK_RIGHT, 0);
                                Exit;
                              end
                              else
                              begin
                                PostMessage(Window.Handle, WM_KEYDOWN, VK_ESCAPE, 0);
                              end;
                        end;
                      end;
                      VK_UP:
                        if not FIsMenuBar then
                          SelectPrev;
                      VK_DOWN:
                        if not FIsMenuBar then
                          SelectNext
                        else
                          Popup;
                      VK_MENU, VK_F10:
                        EndLoop;
                    else
                      TranslateMessage(Msg);
                    end;
                  WM_CHAR, WM_SYSCHAR: begin
                    if FItems.FindItemByChar(Char(Msg.wParam)) <> nil then
                    begin
                      FSelItem := FItems.FindItemByChar(Char(Msg.wParam));
                      if FSelItem <> nil then InvalidateItem(FSelItem);
                      PostMessage(Window.Handle, WM_KEYDOWN, VK_RETURN, 0)
                    end;
                  end;
                end;
            WM_MOUSEFIRST..WM_MOUSELAST:
              case Msg.message of
                WM_MOUSEMOVE: begin
                  P := SmallPointToPoint(TSmallPoint(Msg.lParam));
                  ClientToScreen(Msg.hwnd, P);
                  if (P.X <> LastPos.X) or (P.Y <> LastPos.Y) then
                  begin
                    // Find top level menu
                    View := Self;
                    while View.FParentView <> nil do
                      View := View.FParentView;
                    // check all items
                    while View <> nil do
                    begin
                      Item := View.FSelItem;
                      View.UpdateHover(P);
                      if (Item <> View.FSelItem) and
                         (View <> Self) then
                        begin
                          View1:= Self;
                          while View1 <> View do
                          begin
                            PostMessage(View1.Window.Handle, WM_KEYDOWN, VK_ESCAPE, 0);
                            View1 := View1.FParentView;
                          end;
                          PostMessage(View.Window.Handle, CM_POPUP, 0, 0);
                          Exit;
                        end;
                      View:= View.FChildView;
                    end;
                    LastPos := P;
                  end;
                end;
                WM_LBUTTONDOWN: begin
                end;
                WM_LBUTTONUP: begin
                  P := SmallPointToPoint(TSmallPoint(Msg.lParam));
                  ClientToScreen(Msg.hwnd, P);
                  P2:= P;
                  P := FWindow.ScreenToClient(P);

                  if (FSelItem <> nil) and PtInRect(FSelItem.ItemRect, P) then
                    PostMessage(Window.Handle, WM_KEYDOWN, VK_RETURN, 0)
                  else
                  begin
                    View:= Self;
                    F:= false;
                    while (View <> nil) and not f do
                    begin
                      P:= View.Window.ScreenToClient(P2);
                      if PtInRect(View.FSelItem.ItemRect, P) then
                        f:= true;
                      View:= View.FParentView;
                    end;
                    if not f then
                      EndLoop;
                  end;
//                      TranslateMessage(Msg);
                end;
              end;
          else
            DispatchMessage(Msg);
          end;
        end;
      end;
    end;
  finally
    if FParentView <> nil then
      FParentView.InvalidateView;
      
    FLoop := false;
    EndCapture;
  end;
end;

