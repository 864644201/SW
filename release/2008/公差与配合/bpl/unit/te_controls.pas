    UpdateScrlBar;
    Invalidate;
  end;
end;

procedure TTeCustomListBox.SetItemIndex(const Value: integer);
begin
  if FItemIndex <> Value then
  begin
    if Value > Items.Count - 1 then
      FItemIndex := Items.Count - 1
    else
      if Value < -1 then
        FItemIndex := 0
      else
        FItemIndex := Value;

    UpdateVisibleRange;

    if FItemIndex <> - 1 then
    begin
      while FItemIndex > FLastVisibleItem do
      begin
        FScrlBar.Position := FScrlBar.Position + 1;
        UpdateVisibleRange;
      end;
      while FItemIndex < FFirstVisibleItem do
      begin
        FScrlBar.Position := FScrlBar.Position - 1;
        UpdateVisibleRange;
      end;

      if FSelRangeBeg = -1 then
        FSelRangeBeg := ItemIndex;
    end;

    UpdateSelRange;
    UpdateScrlBar;

    Invalidate;
  end
  else
  begin
    if FSelRangeBeg = -1 then
      FSelRangeBeg := ItemIndex;

    UpdateSelRange;
  end;
end;

