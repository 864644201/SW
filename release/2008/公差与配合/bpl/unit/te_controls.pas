var
  L: Integer;
begin
  L := Length(Value);
  S.Write(L, SizeOf(L));
  S.Write(Pointer(Value)^, L);
end;

{ Region routines =============================================================}

var
  Rts: array [0..2000] of TRect;

function CreateRegionDataFromBitmap(Bitmap: TTeBitmap; var RgnData: PRgnData;
  Left, Top: integer): HRgn;
var
  j, i, i1: integer;
  C: TKColor;
  Count: integer;
  TrR, TrG, TrB: byte; 
begin
  Result := 0;
  TrR := TKColorRec(ckTransparent).R;
  TrG := TKColorRec(ckTransparent).G;
  TrB := TKColorRec(ckTransparent).B;

  if Bitmap.Empty then Exit;
  if Bitmap.Width * Bitmap.Height = 0 then Exit;

  Count := 0;
  for j := 0 to Bitmap.Height-1 do
  begin
    i := -1;
    while i < Bitmap.Width do
    begin
      repeat
        Inc(i);
        C := Bitmap.Pixels[i, j];
        if i >= Bitmap.Width then Break;
      until not ((TKColorRec(C).R = TrR) and (TKColorRec(C).G = TrG) and (TKColorRec(C).B = TrB));

      if i >= Bitmap.Width then Break;

      i1 := i;
      repeat
        Inc(i1);
        If (i1 >= Bitmap.Width) Then Break;
        C := Bitmap.Pixels[i1, j];
      until ((TKColorRec(C).R = TrR) and (TKColorRec(C).G = TrG) and (TKColorRec(C).B = TrB));

      if i <> i1 then
      begin
        Rts[Count] := Rect(Left+i, Top+j, Left+i1, Top+j+1);
        Inc(Count);
      end;
      i := i1;
    end;
  end;
  { Make Region data }
  Result := Count*SizeOf(TRect);
  GetMem(Rgndata, SizeOf(TRgnDataHeader)+Result);
  FillChar(Rgndata^, SizeOf(TRgnDataHeader)+Result, 0);
  RgnData^.rdh.dwSize := SizeOf(TRgnDataHeader);
  RgnData^.rdh.iType := RDH_RECTANGLES;
  RgnData^.rdh.nCount := Count;
  RgnData^.rdh.nRgnSize := 0;
  RgnData^.rdh.rcBound := Rect(0, 0, Bitmap.Width, Bitmap.Height);
  { Update New Region }
  Move(Rts, RgnData^.Buffer, Result);
  Result := SizeOf(TRgnDataHeader)+Count*SizeOf(TRect);
end;

function CreateRegionFromBitmap(Bitmap: TTeBitmap; Left, Top: integer): HRgn;
var
  RgnData: PRgnData;
  Size: integer;
begin
  RgnData := nil;
  Size := CreateRegionDataFromBitmap(Bitmap, RgnData, Left, Top);
  Result := ExtCreateRegion(nil, Size, RgnData^);
  if RgnData <> nil then FreeMem(RgnData, Size);
end;

{ Graphics }

function GetPlasma(const Color, PlasmaColor: TKColor): TTeBitmap;
var
  ImData: array [0..150, 0..150] of byte;
  x, y: integer;
  Colors: array [0..255] of TKColorRec;
  C: PKColor;

 procedure CalcColors;
 var
   x: integer;
   A, B, C: TKColorRec;
 begin
   A := TKColorRec(Color);
   B := TKColorRec(PlasmaColor);
   for x := 0 to 236 do
   begin
     if A.R < B.R then
       C.R := A.R + round(((B.R - A.R) / 236)*x)
     else
       C.R := A.R - round(((A.R - B.R) / 236)*x);

     if A.G < B.G then
       C.G := A.G + round(((B.G - A.G) / 236)*x)
     else
       C.G := A.G - round(((A.G - B.G) / 236)*x);

     if A.B < B.B then
       C.B := A.B + round(((B.B - A.B) / 236)*x)
     else
       C.B := A.B - round(((A.B - B.B) / 236)*x);

     Colors[x] := C;
   end;
 end;

 procedure SubDivide(x1, y1, x2, y2: integer);
  procedure Adjust(xa, ya, x, y, xb, yb: integer);
  var
    d: integer;
    v: double;
  begin
    if ImData[x,y] <> 0 then Exit;

    D := Abs(xa-xb) + Abs(ya-yb);
    v := (ImData[xa,ya] + ImData[xb,yb])/2 + (random-0.5)*d*8;
    if v < 1 then v := 1;
    if v >= 236 then v := 236;
    imdata[x,y] := Trunc(v);
  end;

 var
   x,y: integer;
   v: double;
 begin
   if (x2-x1<2) and (y2-y1<2) then Exit;

   x:=(x1+x2) div 2;
   y:=(y1+y2) div 2;
   adjust(x1,y1,x,y1,x2,y1);
   adjust(x2,y1,x2,y,x2,y2);
   adjust(x1,y2,x,y2,x2,y2);
   adjust(x1,y1,x1,y,x1,y2);
   if imdata[x,y] = 0 then
   begin
     v := (imdata[x1,y1] + imdata[x2,y1] + imdata[x2,y2] + imdata[x1,y2])/4;
     imdata[x,y] := Trunc(v);
   end;
   subDivide(x1,y1,x,y);
   subDivide(x,y1,x2,y);
   subDivide(x,y,x2,y2);
   subDivide(x1,y,x,y2);
 end;

begin
  CalcColors;

  FillChar(ImData, SizeOf(ImData), 0);

  ImData[0, 150] := random(236);
  ImData[150, 150] := random(236);
  ImData[150, 150] := random(236);
  ImData[0, 0] := random(236);

  SubDivide(0, 0, 150, 150);

  { Copy to Buffer }
  Result := TTeBitmap.Create;
  try
    Result.SetSize(150, 150);

    for x := 0 to Result.Width - 1 do
      for y := 0 to Result.Height - 1 do
      begin
        C := @Result.Bits[x + y * Result.Width];
        C^ := TKColor(Colors[ImData[x, y]]);
      end;
  except
    Result.Free;
    raise;
  end;
end;

{ System Routines }

function GetKeyBoardDelayInterval: integer;
var
  A: DWORD;
begin
  SystemParametersInfo(SPI_GETKEYBOARDDELAY, 0, @A, 0);
  Result := (A + 1) * 200;
end;

function GetKeyBoardSpeedInterval: integer;
var
  A: DWORD;
begin
  SystemParametersInfo(SPI_GETKEYBOARDSPEED, 0, @A, 0);
  Result := Round(1000 / ((A + 1) * 2.3));
end;

{ Multi-monitor routines ======================================================}

type

  PMonitorInfo = ^TMonitorInfo;
  TMonitorInfo = record
    cbSize: DWORD;
    rcMonitor: TRect;
    rcWork: TRect;
    dwFlags: DWORD;
  end;

const
  MONITOR_DEFAULTTONEAREST = $2;
  SM_CMONITORS             = 80;

var
  MonitorFromRectFunc: function(lprcScreenCoords: PRect; dwFlags: DWORD): THandle; stdcall;
  MonitorFromPointFunc: function(ptScreenCoords: TPoint; dwFlags: DWORD): THandle; stdcall;
  MonitorFromWindowFunc: function(hWnd: HWND; dwFlags: DWORD): THandle; stdcall;
  GetMonitorInfoFunc: function(hMonitor: THandle; lpMonitorInfo: PMonitorInfo): BOOL; stdcall;

function IsMultiMonitors: Boolean;
var
  NumMonitors: Integer;
begin
  NumMonitors := GetSystemMetrics(SM_CMONITORS);
  Result := (NumMonitors <> 0) and (NumMonitors <> 1) and
    Assigned(MonitorFromRectFunc) and Assigned(MonitorFromPointFunc) and
    Assigned(GetMonitorInfoFunc);
end;

function GetRectOfPrimaryMonitor(const WorkArea: Boolean): TRect;
begin
  if not WorkArea or not SystemParametersInfo(SPI_GETWORKAREA, 0, @Result, 0) then
    Result := Rect(0, 0, Screen.Width, Screen.Height);
end;

function GetRectOfMonitorContainingRect(const R: TRect;
  const WorkArea: Boolean): TRect;
var
  M: THandle;
  MonitorInfo: TMonitorInfo;
begin
  if IsMultiMonitors then
  begin
    M := MonitorFromRectFunc(@R, MONITOR_DEFAULTTONEAREST);
    MonitorInfo.cbSize := SizeOf(MonitorInfo);
    if GetMonitorInfoFunc(M, @MonitorInfo) then
    begin
      if not WorkArea then
        Result := MonitorInfo.rcMonitor
      else
        Result := MonitorInfo.rcWork;
      Exit;
    end;
  end;
  Result := GetRectOfPrimaryMonitor(WorkArea);
end;

function GetRectOfMonitorContainingPoint(const P: TPoint;
  const WorkArea: Boolean): TRect;
var
  M: THandle;
  MonitorInfo: TMonitorInfo;
begin
  if IsMultiMonitors then
  begin
    M := MonitorFromPointFunc(P, MONITOR_DEFAULTTONEAREST);
    MonitorInfo.cbSize := SizeOf(MonitorInfo);
    if GetMonitorInfoFunc(M, @MonitorInfo) then
    begin
      if not WorkArea then
        Result := MonitorInfo.rcMonitor
      else
        Result := MonitorInfo.rcWork;
      Exit;
    end;
  end;
  Result := GetRectOfPrimaryMonitor(WorkArea);
end;

function GetRectOfMonitorContainingWindow(const W: HWND;
  const WorkArea: Boolean): TRect;
var
  M: THandle;
  MonitorInfo: TMonitorInfo;
begin
  if IsMultiMonitors then
  begin
    M := MonitorFromWindowFunc(W, MONITOR_DEFAULTTONEAREST);
    MonitorInfo.cbSize := SizeOf(MonitorInfo);
    if GetMonitorInfoFunc(M, @MonitorInfo) then
    begin
      if not WorkArea then
        Result := MonitorInfo.rcMonitor
      else
        Result := MonitorInfo.rcWork;
      Exit;
    end;
  end;
  Result := GetRectOfPrimaryMonitor(WorkArea);
end;

