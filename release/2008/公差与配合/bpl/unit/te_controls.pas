procedure TTeHeaderSection.SetMargin(const Value: integer);
begin
  if FMargin <> Value then
  begin
    FMargin := Value;
    HeaderControl.SectionChanged(Index, AutoSize);
  end;
end;

procedure TTeHeaderSection.SetMaxWidth(const Value: integer);
begin
  if FMaxWidth <> Value then
  begin
    FMaxWidth := Value;
    if Width > MaxWidth then
      Width := MaxWidth;

    if AutoSize then
      HeaderControl.SectionChanged(Index, True);
  end;
end;

procedure TTeHeaderSection.SetMinWidth(const Value: integer);
begin
  if FMinWidth <> Value then
  begin
    if Value >= 0 then
      FMinWidth := Value
    else
      FMinWidth := 0;

    if Width < MinWidth then
      Width := MinWidth;

    if AutoSize then
      HeaderControl.SectionChanged(Index, True);
  end;
end;

procedure TTeHeaderSection.SetShowImage(const Value: boolean);
begin
  if FShowImage <> Value then
  begin
    FShowImage := Value;
    HeaderControl.SectionChanged(Index, AutoSize);
