procedure TTeCustomSpeedButton.GlyphChangedHandler(Sender: TObject);
var
  N: integer;
begin
  if (FGlyph.Height <> 0) and (FGlyph.Width mod FGlyph.Height = 0) then
  begin
    N := FGlyph.Width div FGlyph.Height;
    if N > 4 then
      N := 1;
    SetNumGlyphs(N);
  end;
  Invalidate;
end;

