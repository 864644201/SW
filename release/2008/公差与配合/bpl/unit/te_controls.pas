{ TTeInplaceScrollBar =========================================================}

constructor TTeInplaceScrollBar.Create(AOwner: TComponent; AOnCreateScrollBar: TCreateScrollBarEvent);
begin
  inherited Create(AOwner);
  FOnCreateScrollBar := AOnCreateScrollBar;

  if Assigned(OnCreateScrollBar) then
    OnCreateScrollBar(FScrollBar, Self)
  else
    FScrollBar := TTeCustomScrollBar.Create(Self);

  FScrollBar.BorderWidth := 0;
  FScrollBar.Align := alClient;
  FScrollBar.Performance := kspDoubleBuffer;
  FScrollBar.Kind := sbVertical;
  FScrollBar.Parent := Self;
  FScrollBar.Transparent := false;
  FScrollBar.Visible := true;
  FScrollBar.OnScroll := DoScroll;
end;

destructor TTeInplaceScrollBar.Destroy;
begin
  inherited Destroy;
end;

procedure TTeInplaceScrollBar.ScrollBarWndProc(var Message: TMessage);
begin
  if FControl = nil then Exit;
  if not FControl.HandleAllocated then Exit;
  if csDestroying in FControl.ComponentState then Exit;

  if not HandleAllocated then Exit;

  case Message.Msg of
    WM_ERASEBKGND:
      begin
        ScrollBarUpdate;
      end;
    WM_PAINT:
      begin
        ScrollBarUpdate;
      end;
    CM_VISIBLECHANGED:
      begin
        Visible := FControl.Visible;

        if FControl.Visible then
          ShowWindow(Handle, SW_SHOW)
        else
          ShowWindow(Handle, SW_HIDE);
      end;
    WM_VSCROLL, WM_HSCROLL:
      begin
        ScrollBarUpdate;
      end;
  end;
end;

procedure TTeInplaceScrollBar.ScrollBarUpdate;
var
  Info: TScrollInfo;
  BarInfo: TScrollBarInfo;
  ObjId, SbKind: integer;
  R: TRect;
begin
  { Update BoundsRect }
  if Kind = sbVertical then
    ObjId := OBJID_VSCROLL
  else
    ObjId := OBJID_HSCROLL;

  BarInfo.cbSize := SizeOf(BarInfo);
  GetScrollBarInfo(FControl.Handle, ObjId, BarInfo);


  if STATE_SYSTEM_INVISIBLE and BarInfo.rgstate[0] <> 0 then
  begin
    Visible := false;
    Exit;
  end
  else
  begin
    Visible := true;

    R.TopLeft := Parent.ScreenToClient(BarInfo.rcScrollBar.TopLeft);
    R.BottomRight := Parent.ScreenToClient(BarInfo.rcScrollBar.BottomRight);

    BoundsRect := R;
  end;

  { Update psotion, min, max ... }
  if Kind = sbVertical then
    SbKind := SB_VERT
  else
    SbKind := SB_HORZ;

  Info.cbSize := SizeOf(Info);
  Info.fMask := SIF_ALL;
  GetScrollInfo(FControl.Handle, SbKind, Info);

  FScrollBar.Enabled := FControl.Enabled;

  FScrollBar.Min := Info.nMin;
  FScrollBar.Max := Info.nMax;
  FScrollBar.PageSize := Info.nPage;
  FScrollBar.Position := Info.nPos;
  FScrollBar.Invalidate;
end;

procedure TTeInplaceScrollBar.DoScroll(Sender: TObject; ScrollCode: TTeScrollCode;
  var ScrollPos: Integer);
var
  Code: integer;
  Dx, Dy: integer;
  Info: TScrollInfo;
begin
  if FControl = nil then Exit;

  case ScrollCode of
    kscLineUp: Code := SB_LINEUP;
    kscLineDown: Code := SB_LINEDOWN;
    kscPageUp: Code := SB_PAGEUP;
    kscPageDown: Code := SB_PAGEDOWN;
    kscPosition: Code := SB_THUMBPOSITION;
    kscTrack: Code := SB_THUMBTRACK;
    kscTop: Code := SB_TOP;
    kscBottom: Code := SB_BOTTOM;
    kscEndScroll: Code := SB_ENDSCROLL;
  else
    Exit;
  end;

  if ScrollCode in [kscLineUp, kscLineDown] then
  begin
    if Kind = sbVertical then
      SendMessage(FControl.Handle, WM_VSCROLL, Code, 0)
    else
      SendMessage(FControl.Handle, WM_HSCROLL, Code, 0);

    ScrollBarUpdate;

    ScrollPos := FScrollBar.Position;
  end
  else
  begin
    if FControl is TCustomListView then
    begin
      { ListView }
      Dx := 0;
      Dy := 0;
      Info.cbSize := SizeOf(Info);
      Info.fMask := SIF_ALL;
      if Kind = sbVertical then
        GetScrollInfo(FControl.Handle, SB_VERT, Info)
      else
        GetScrollInfo(FControl.Handle, SB_HORZ, Info);

      if Kind = sbVertical then
        Dy := FScrollBar.Position - Info.nPos
      else
        Dx := FScrollBar.Position - Info.nPos;
      TCustomListView(FControl).Scroll(DX, DY);
    end
    else
    begin
      { Standard }
      if Kind = sbVertical then
        SendMessage(FControl.Handle, WM_VSCROLL, Integer(SmallPoint(Code, FScrollBar.Position)), 0)
      else
        SendMessage(FControl.Handle, WM_HSCROLL, Integer(SmallPoint(Code, FScrollBar.Position)), 0);
    end;

    ScrollBarUpdate;
  end;
end;

