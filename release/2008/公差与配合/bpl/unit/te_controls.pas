{ TTeCustomTrackBar }

constructor TTeCustomTrackBar.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);
  Width := 150;
  Height := 45;
  TabStop := true;
  Performance := kspDoubleBuffer;

  FMax := 10;
  FMin := 0;
  FPosition := 3;
  FOrientation := toHorizontal;
  FThumbHalfWidth := 4;

  FLineSize := 1;
  FPageSize := 2;
  FFrequency := 1;

  FThumbVisible := true;
  FShowTicks := true;
  FIntervalHighlightType := htNone;
  FTickMarks := tmBottomRight;

  FSliding := false;
  FMouseOnThumb := false;

  ControlStyle := ControlStyle + [csCaptureMouse];
end;

destructor TTeCustomTrackBar.Destroy;
begin
  inherited Destroy;
end;

procedure TTeCustomTrackBar.Loaded;
begin
  inherited;
  Invalidate;
end;

{ Track Bar }

function TTeCustomTrackBar.CoordinatePosition(ACoord: word): integer;
var
  LScaleWidth, LSideMargin, LThumbWidth: integer;
begin
  LSideMargin := GetSideMargin;
  LThumbWidth := GetThumbWidth;
  if Orientation = toHorizontal then
    LScaleWidth := FWidth
  else
    LScaleWidth := FHeight;
  LScaleWidth := LScaleWidth - LSideMargin * 2 - LThumbWidth;

  Result := Round(((FMax - FMin) * (ACoord - LSideMargin - LThumbWidth div 2)) /
    LScaleWidth + FMin);

  { Round }
  if Result mod FFrequency > FFrequency div 2 then
    Result := Result - (Result mod FFrequency) + FFrequency
  else
    Result := Result - (Result mod FFrequency);

  if Result < Min then
    Result := Min;
  if Result > Max then
    Result := Max;
end;

function TTeCustomTrackBar.PositionCoordinate(APos: integer): word;
var
  LScaleWidth, LSideMargin, LThumbWidth: integer;
begin
  LSideMargin := GetSideMargin;
  LThumbWidth := GetThumbWidth;
  if Orientation = toHorizontal then
    LScaleWidth := FWidth
  else
    LScaleWidth := FHeight;
  LScaleWidth := LScaleWidth - LSideMargin * 2 - LThumbWidth;
  if FMax - FMin = 0 then
    Result := 0
  else
    Result := LSideMargin + LThumbWidth div 2 + Round(LScaleWidth * (APos - FMin) / (FMax - FMin));
end;

procedure TTeCustomTrackBar.DrawTrack(BegCoord, EndCoord, PosCooord: integer);
var
  LTrackRect, LowIntervalRect, TmpRect: TRect;
  LSideMarign, LTopBottmMarign, LThumbWidth, LThumbHeight: integer;
  Theme: HTheme;
  Part, tState: integer;
begin
  LThumbWidth := GetThumbWidth;
  LTopBottmMarign := GetTopBottomMargin;
  LSideMarign := GetSideMargin;
  LThumbHeight := Round(LThumbWidth * CStdThumbRatio);

  with LTrackRect do
  begin
    if FOrientation = toHorizontal then
    begin
      Top := LTopBottmMarign;
      if TickMarks = tmTopLeft then
        Top := Top + LThumbWidth div 2
      else
        Top := Top + LThumbWidth div 4;

      if ShowTicks and ((TickMarks = tmTopLeft) or (TickMarks = tmBoth)) then
        Top := Top + 4 + 1;

      if TickMarks = tmBoth then
      begin
        Bottom := Top + LThumbHeight - (LThumbWidth div 4) * 2;
        InflateRect(LTrackRect, 0, -1);
      end
      else
        Bottom := Top + LThumbHeight - LThumbWidth div 2 - LThumbWidth div 4;

      Left := BegCoord;
      Right := EndCoord;

      LowIntervalRect.Top := Top;
      LowIntervalRect.Bottom := Bottom;
      if IntervalHighlightType = htLowInterval then
      begin
        LowIntervalRect.Left := Left;
        LowIntervalRect.Right := PosCooord;
      end
      else
      begin
        LowIntervalRect.Left := PosCooord;
        LowIntervalRect.Right := Right;
      end;
    end
    else
    begin
      Left := LTopBottmMarign;
      if TickMarks = tmTopLeft then
        Left := Left + LThumbWidth div 2
      else
        Left := Left + LThumbWidth div 4;

      if ShowTicks and ((TickMarks = tmTopLeft) or (TickMarks = tmBoth)) then
        Left := Left + 4 + 1;

      if TickMarks = tmBoth then
      begin
        Right := Left + LThumbHeight - (LThumbWidth div 4) * 2;
        InflateRect(LTrackRect, -1, 0);
      end
      else
        Right := Left + LThumbHeight - LThumbWidth div 2 - LThumbWidth div 4;

      Top := BegCoord;
      Bottom := EndCoord;

      LowIntervalRect.Left := Left;
      LowIntervalRect.Right := Right;
      if IntervalHighlightType = htLowInterval then
      begin
        LowIntervalRect.Top := Top;
        LowIntervalRect.Bottom := PosCooord;
      end
      else
      begin
        LowIntervalRect.Top := PosCooord;
        LowIntervalRect.Bottom := Bottom;
      end;
    end;
  end;

  if not UseThemes then
  begin
    { Default drawing }
    if Enabled then
      FillRect(Canvas, LTrackRect, clBtnHighlight)
    else
      FillRect(Canvas, LTrackRect, clBtnFace);

    if Enabled and (IntervalHighlightType <> htNone) then
      FillRect(Canvas, LowIntervalRect, clHighlight);

    TmpRect := RectOffset(LTrackRect, 0);
    DrawEdge(Canvas, TmpRect, clBtnShadow, clBtnHighlight);
    TmpRect := RectOffset(LTrackRect, -1);
    DrawEdge(Canvas, TmpRect, cl3DDkShadow, cl3DLight);
  end
  else
  begin
    { XP Style }
    Theme := OpenThemeData(0, 'TrackBar');

    if RectWidth(LTrackRect) > RectHeight(LTrackRect) then
    begin
      Part := integer(TKP_TRACK);
      InflateRect(LTrackRect, 0, -(ThumbHalfWidth + 1));
    end
    else
    begin
      Part := integer(TKP_TRACKVERT);
      InflateRect(LTrackRect, -(ThumbHalfWidth + 1), 0);
    end;

    tState := integer(TRS_NORMAL);

    DrawThemeBackground(Theme, Canvas.Handle, Part, tState, LTrackRect, nil);

    CloseThemeData(Theme);
  end;
end;

procedure TTeCustomTrackBar.DrawThumb(APosCoord: integer);
var
  R: TRect;
  Bx, By: integer;
  LThumbWidth, LThumbHeight: integer;
  Theme: HTheme;
  Part, tState: integer;
begin
  if not ThumbVisible then Exit;

  LThumbWidth := GetThumbWidth;
  LThumbHeight := Round(LThumbWidth * CStdThumbRatio);

  if UseThemes then
  begin
    { XP Style }
    Theme := OpenThemeData(0, 'TrackBar');

    if FOrientation = toHorizontal then
    begin
      Bx := APosCoord - LThumbWidth div 2;
      By := GetTopBottomMargin;
      if ShowTicks and ((TickMarks = tmTopLeft) or (TickMarks = tmBoth)) then
        By := By + 4 + 1;

      R := Rect(Bx, By, Bx + LThumbWidth, By + LThumbHeight);

      case TickMarks of
        tmBoth: Part := integer(TKP_THUMB);
        tmBottomRight: Part := integer(TKP_THUMBBOTTOM);
        tmTopLeft: Part := integer(TKP_THUMBTOP);
      end;
    end
    else
    begin
      Bx := GetTopBottomMargin;
      By := APosCoord - LThumbWidth div 2;
      if ShowTicks and ((TickMarks = tmTopLeft) or (TickMarks = tmBoth)) then
        Bx := Bx + 4 + 1;

      R := Rect(Bx, By, Bx + LThumbHeight, By + LThumbWidth);
      
      case TickMarks of
        tmBoth: Part := integer(TKP_THUMBVERT);
        tmBottomRight: Part := integer(TKP_THUMBRIGHT);
        tmTopLeft: Part := integer(TKP_THUMBLEFT);
      end;
    end;

    if not Enabled then
      tState := integer(TUS_DISABLED)
    else
      if ThumbPressed then
        tState := integer(TUS_PRESSED)
      else
        if MouseOnThumb then
          tState := integer(TUS_HOT)
        else
          tState := integer(TUS_NORMAL);

    InflateRect(R, 1, 1);
    DrawThemeBackground(Theme, Canvas.Handle, Part, tState, R, nil);

    CloseThemeData(Theme);
  end
  else
  begin
    { Default drawing }
    if Orientation = toHorizontal then
    begin
      Bx := APosCoord - LThumbWidth div 2;
      By := GetTopBottomMargin;
      if ShowTicks and ((TickMarks = tmTopLeft) or (TickMarks = tmBoth)) then
        By := By + 4 + 1;

      case TickMarks of
        tmBottomRight: begin

          if ThumbPressed then
            FillHalftonePolygon(Canvas, [Point(Bx, By),
              Point(Bx + LThumbWidth - 1, By),
              Point(Bx + LThumbWidth - 1, By + LThumbHeight - LThumbWidth div 2 - 1),
              Point(Bx + LThumbWidth div 2, By + LThumbHeight - 1),
              Point(Bx, By + LThumbHeight - LThumbWidth div 2 - 1)],
              clBtnFace, clBtnHighlight)
          else
            FillPolygon(Canvas, [Point(Bx, By),
              Point(Bx + LThumbWidth - 1, By),
              Point(Bx + LThumbWidth - 1, By + LThumbHeight - LThumbWidth div 2 - 1),
              Point(Bx + LThumbWidth div 2, By + LThumbHeight - 1),
              Point(Bx, By + LThumbHeight - LThumbWidth div 2 - 1)],
              clBtnFace);

          MoveTo(Canvas, Bx + LThumbWidth - 2, By);
          LineTo(Canvas, Bx, By, clBtnHighlight);
          LineTo(Canvas, Bx, By + LThumbHeight - LThumbWidth div 2 - 1, clBtnHighlight);
          LineTo(Canvas, Bx + LThumbWidth div 2, By + LThumbHeight - 1, clBtnHighlight);

          MoveTo(Canvas, Bx + LThumbWidth - 2, By + 1);
          LineTo(Canvas, Bx + LThumbWidth - 2, By + LThumbHeight - LThumbWidth div 2 - 1, clBtnShadow);
          LineTo(Canvas, Bx + LThumbWidth div 2 - 1, By + LThumbHeight - 1, clBtnShadow);

          MoveTo(Canvas, Bx + LThumbWidth - 1, By);
          LineTo(Canvas, Bx + LThumbWidth - 1, By + LThumbHeight - LThumbWidth div 2 - 1, cl3DDkShadow);
          LineTo(Canvas, Bx + LThumbWidth div 2 - 1, By + LThumbHeight, cl3DDkShadow);
        end;
        tmTopLeft: begin

          if ThumbPressed then
            FillHalftonePolygon(Canvas, [Point(Bx + LThumbWidth div 2, By),
              Point(Bx + LThumbWidth - 1, By + LThumbWidth div 2),
              Point(Bx + LThumbWidth - 1, By + LThumbHeight - 1),
              Point(Bx, By + LThumbHeight - 1),
              Point(Bx, By + LThumbWidth div 2)],
              clBtnFace, clBtnHighlight)
          else
            FillPolygon(Canvas, [Point(Bx + LThumbWidth div 2, By),
              Point(Bx + LThumbWidth - 1, By + LThumbWidth div 2),
              Point(Bx + LThumbWidth - 1, By + LThumbHeight - 1),
              Point(Bx, By + LThumbHeight - 1),
              Point(Bx, By + LThumbWidth div 2)],
              clBtnFace);

          MoveTo(Canvas, Bx, By + LThumbHeight - 2);
          LineTo(Canvas, Bx, By + LThumbWidth div 2, clBtnHighlight);
          LineTo(Canvas, Bx + LThumbWidth div 2, By, clBtnHighlight);

          MoveTo(Canvas, Bx + LThumbWidth div 2, By + 1);
          LineTo(Canvas, Bx + LThumbWidth - 2, By + LThumbWidth div 2, clBtnShadow);
          LineTo(Canvas, Bx + LThumbWidth - 2, By + LThumbHeight - 2, clBtnShadow);
          LineTo(Canvas, Bx, By + LThumbHeight - 2, clBtnShadow);

          MoveTo(Canvas, Bx + LThumbWidth div 2, By);
          LineTo(Canvas, Bx + LThumbWidth - 1, By + LThumbWidth div 2, cl3DDkShadow);
          LineTo(Canvas, Bx + LThumbWidth - 1, By + LThumbHeight - 1, cl3DDkShadow);
          LineTo(Canvas, Bx - 1, By + LThumbHeight - 1, cl3DDkShadow);
        end;
        tmBoth: begin
          if ThumbPressed then
            FillHalftoneRect(Canvas, Rect(Bx, By, Bx + LThumbWidth, By + LThumbHeight), clBtnFace, clBtnHighlight)
          else
            FillRect(Canvas, Rect(Bx, By, Bx + LThumbWidth, By + LThumbHeight), clBtnFace);
          DrawEdge(Canvas, Rect(Bx, By, Bx + LThumbWidth, By + LThumbHeight),
            clBtnHighlight, clBlack);
          DrawEdge(Canvas, Rect(Bx + 1, By + 1, Bx + LThumbWidth - 1, By + LThumbHeight - 1),
            clBtnFace, clBtnShadow);
        end;
      end;
    end
    else
    begin
      { Orientation = toVertical }

      Bx := GetTopBottomMargin;
      By := APosCoord - LThumbWidth div 2;
      if ShowTicks and ((TickMarks = tmTopLeft) or (TickMarks = tmBoth)) then
        Bx := Bx + 4 + 1;
      case TickMarks of
        tmBottomRight: begin

          if ThumbPressed then
            FillHalftonePolygon(Canvas, [Point(Bx, By),
              Point(Bx + LThumbHeight - LThumbWidth div 2 - 1, By),
              Point(Bx + LThumbHeight - 1, By + LThumbWidth div 2),
              Point(Bx + LThumbHeight - LThumbWidth div 2 - 1, By + LThumbWidth - 1),
              Point(Bx, By + LThumbWidth - 1)],
              clBtnFace, clBtnHighlight)
          else
            FillPolygon(Canvas, [Point(Bx, By),
              Point(Bx + LThumbHeight - LThumbWidth div 2 - 1, By),
              Point(Bx + LThumbHeight - 1, By + LThumbWidth div 2),
              Point(Bx + LThumbHeight - LThumbWidth div 2 - 1, By + LThumbWidth - 1),
              Point(Bx, By + LThumbWidth - 1)],
              clBtnFace);

          MoveTo(Canvas, Bx, By + LThumbWidth - 2);
          LineTo(Canvas, Bx, By, clBtnHighlight);
          LineTo(Canvas, Bx + LThumbHeight - LThumbWidth div 2 - 1, By, clBtnHighlight);
          LineTo(Canvas, Bx + LThumbHeight - 1, By + LThumbWidth div 2, clBtnHighlight);

          MoveTo(Canvas, Bx + LThumbHeight - 2, By + LThumbWidth div 2);
          LineTo(Canvas, Bx + LThumbHeight - LThumbWidth div 2 - 1, By + LThumbWidth - 2, clBtnShadow);
          LineTo(Canvas, Bx, By + LThumbWidth - 2, clBtnShadow);

          MoveTo(Canvas, Bx + LThumbHeight - 1, By + LThumbWidth div 2);
          LineTo(Canvas, Bx + LThumbHeight - LThumbWidth div 2 - 1, By + LThumbWidth - 1, cl3DDkShadow);
          LineTo(Canvas, Bx - 1, By + LThumbWidth - 1, cl3DDkShadow);
        end;
        tmTopLeft: begin

          if ThumbPressed then
            FillHalftonePolygon(Canvas, [Point(Bx + LThumbWidth div 2, By),
              Point(Bx + LThumbHeight - 1, By),
              Point(Bx + LThumbHeight - 1, By + LThumbWidth - 1),
              Point(Bx + LThumbWidth div 2, By + LThumbWidth - 1),
              Point(Bx, By + LThumbWidth div 2)],
              clBtnFace, clBtnHighlight)
          else
            FillPolygon(Canvas, [Point(Bx + LThumbWidth div 2, By),
              Point(Bx + LThumbHeight - 1, By),
              Point(Bx + LThumbHeight - 1, By + LThumbWidth - 1),
              Point(Bx + LThumbWidth div 2, By + LThumbWidth - 1),
              Point(Bx, By + LThumbWidth div 2)],
              clBtnFace);

          MoveTo(Canvas, Bx + 1, By + LThumbWidth div 2 - 1);
          LineTo(Canvas, Bx + LThumbWidth div 2, By, clBtnHighlight);
          LineTo(Canvas, Bx + LThumbHeight - 1, By, clBtnHighlight);

          MoveTo(Canvas, Bx + LThumbHeight - 2, By + 1);
          LineTo(Canvas, Bx + LThumbHeight - 2, By + LThumbWidth - 2, clBtnShadow);
          LineTo(Canvas, Bx + LThumbWidth div 2, By + LThumbWidth - 2, clBtnShadow);
          LineTo(Canvas, Bx, By + LThumbWidth div 2 - 1, clBtnShadow);

          MoveTo(Canvas, Bx + LThumbHeight - 1, By);
          LineTo(Canvas, Bx + LThumbHeight - 1, By + LThumbWidth - 1, cl3DDkShadow);
          LineTo(Canvas, Bx + LThumbWidth div 2, By + LThumbWidth - 1, cl3DDkShadow);
          LineTo(Canvas, Bx - 1, By + LThumbWidth div 2 - 1, cl3DDkShadow);

        end;
        tmBoth: begin
          if ThumbPressed then
            FillHalftoneRect(Canvas, Rect(Bx, By, Bx + LThumbHeight, By + LThumbWidth), clBtnFace, clBtnHighlight)
          else
            FillRect(Canvas, Rect(Bx, By, Bx + LThumbHeight, By + LThumbWidth), clBtnFace);
          DrawEdge(Canvas, Rect(Bx, By, Bx + LThumbHeight, By + LThumbWidth),
            clBtnHighlight, clBlack);
          DrawEdge(Canvas, Rect(Bx + 1, By + 1, Bx + LThumbHeight - 1, By + LThumbWidth - 1),
            clBtnFace, clBtnShadow);
        end;
      end;
    end;
  end;
end;

procedure TTeCustomTrackBar.DrawTick(Value, Coord: integer;
  TopLeft: boolean);
var
  VCoord: integer;
  LThumbHeight: integer;
begin
  LThumbHeight := Round(GetThumbWidth * CStdThumbRatio);
  if TopLeft then
  begin
    VCoord := GetTopBottomMargin + 3;
    if Orientation = toHorizontal then
    begin
      MoveTo(Canvas, Coord, VCoord);
      if (Value = Min) or (Value = Max) then
        LineTo(Canvas, Coord, VCoord - 4, clBlack)
      else
        LineTo(Canvas, Coord, VCoord - 3, clBlack);
    end
    else
    begin
      MoveTo(Canvas, VCoord, Coord);
      if (Value = Min) or (Value = Max) then
        LineTo(Canvas, VCoord - 4, Coord, clBlack)
      else
        LineTo(Canvas, VCoord - 3, Coord, clBlack);
    end;
  end
  else
  begin
    if TickMarks = tmBoth then
      VCoord := GetTopBottomMargin + 4 + 1 +
        LThumbHeight + 1
    else
      VCoord := GetTopBottomMargin + 1 +
        LThumbHeight + 1;
    if Orientation = toHorizontal then
    begin
      MoveTo(Canvas, Coord, VCoord);
      if (Value = Min) or (Value = Max) then
        LineTo(Canvas, Coord, VCoord + 4, clBlack)
      else
        LineTo(Canvas, Coord, VCoord + 3, clBlack);
    end
    else
    begin
      MoveTo(Canvas, VCoord, Coord);
      if (Value = Min) or (Value = Max) then
        LineTo(Canvas, VCoord + 4, Coord, clBlack)
      else
        LineTo(Canvas, VCoord + 3, Coord, clBlack);
    end;
  end;
end;

function TTeCustomTrackBar.PtInThumb(x, y: integer): boolean;
var
  Bx, By: integer;
  LThumbWidth, LThumbHeight: integer;
begin
  LThumbWidth := GetThumbWidth;
  LThumbHeight := Round(LThumbWidth * CStdThumbRatio);

  if Orientation = toHorizontal then
  begin
    Bx := PositionCoordinate(Position) - LThumbWidth div 2;
    By := GetTopBottomMargin;
    if ShowTicks and ((TickMarks = tmTopLeft) or (TickMarks = tmBoth)) then
      By := By + 4 + 1;
    case TickMarks of
      tmBottomRight:
        Result :=
          PointInPolygon(Point(x, y),
            [Point(Bx, By),
            Point(Bx + LThumbWidth - 1, By),
            Point(Bx + LThumbWidth - 1, By + LThumbHeight - LThumbWidth div 2
            -
            1),
            Point(Bx + LThumbWidth div 2, By + LThumbHeight - 1),
            Point(Bx, By + LThumbHeight - LThumbWidth div 2 - 1)]);

      tmTopLeft:
        Result :=
          PointInPolygon(Point(x, y), [Point(Bx + LThumbWidth div 2, By),
            Point(Bx + LThumbWidth - 1, By + LThumbWidth div 2),
            Point(Bx + LThumbWidth - 1, By + LThumbHeight - 1),
            Point(Bx, By + LThumbHeight - 1),
            Point(Bx, By + LThumbWidth div 2)]);

    else  { tmBoth }
      Result :=
        PtInRect(Rect(Bx, By, Bx + LThumbWidth, By + LThumbHeight), Point(X, Y));
    end;
  end
  else
  begin
    { Orientation = toVertical }
    Bx := GetTopBottomMargin;
    By := PositionCoordinate(Position) - LThumbWidth div 2;
    if ShowTicks and ((TickMarks = tmTopLeft) or (TickMarks = tmBoth)) then
      Bx := Bx + 4 + 1;
    case TickMarks of
      tmBottomRight:
        Result :=
          PointInPolygon(Point(x, y), [Point(Bx, By),
            Point(Bx + LThumbHeight - LThumbWidth div 2 - 1, By),
            Point(Bx + LThumbHeight - 1, By + LThumbWidth div 2),
            Point(Bx + LThumbHeight - LThumbWidth div 2 - 1, By + LThumbWidth
            -
            1),
            Point(Bx, By + LThumbWidth - 1)]);
      tmTopLeft:
         Result :=
          PointInPolygon(Point(x, y), [Point(Bx + LThumbWidth div 2, By),
            Point(Bx + LThumbHeight - 1, By),
            Point(Bx + LThumbHeight - 1, By + LThumbWidth - 1),
            Point(Bx + LThumbWidth div 2, By + LThumbWidth - 1),
            Point(Bx, By + LThumbWidth div 2)]);
   else { tmBoth }
      Result := PtInRect(Rect(Bx, By, Bx + LThumbHeight, By + LThumbWidth), Point(X, Y));
    end;
  end;
end;

procedure TTeCustomTrackBar.DrawTicks;
var
  CurPos: integer;
begin
  if ShowTicks then
  begin
    if (TickMarks = tmTopLeft) or (TickMarks = tmBoth) then
      for CurPos := Min to Max do
        if (CurPos mod Frequency = 0) or (CurPos = Min) or (CurPos = Max) then
          DrawTick(CurPos, PositionCoordinate(CurPos), true);
    if (TickMarks = tmBottomRight) or (TickMarks = tmBoth) then
      for CurPos := Min to Max do
        if (CurPos mod Frequency = 0) or (CurPos = Min) or (CurPos = Max) then
          DrawTick(CurPos, PositionCoordinate(CurPos), false);
  end;
end;

function TTeCustomTrackBar.GetSideMargin: integer;
begin
  Result := 9;
end;

function TTeCustomTrackBar.GetThumbWidth: integer;
begin
  Result := FThumbHalfWidth * 2 + 1
end;

function TTeCustomTrackBar.GetTopBottomMargin: integer;
begin
  Result := 7
end;

{ Painting }

procedure TTeCustomTrackBar.PaintBuffer;
var
  R: TRect;
begin
  inherited ;
  
  if Orientation = toHorizontal then
    DrawTrack(GetSideMargin, FWidth - GetSideMargin, PositionCoordinate(Position))
  else
    DrawTrack(GetSideMargin, FHeight - GetSideMargin, PositionCoordinate(Position));

  DrawTicks;

  DrawThumb(PositionCoordinate(Position));

  if Focused then
  begin
    R := Rect(0, 0, FWidth, FHeight);
    DrawFocusRect(Canvas, R, ckBlack);
  end;
end;

procedure TTeCustomTrackBar.Change;
begin
  if Assigned(FOnChange) then
    FOnChange(Self);
end;

{ Events }

procedure TTeCustomTrackBar.HasFocus;
begin
  inherited;
  Invalidate;
end;

procedure TTeCustomTrackBar.KillFocus;
begin
  inherited;
  Invalidate;
end;

procedure TTeCustomTrackBar.MouseLeave;
begin
  inherited;
  if FMouseOnThumb then
  begin
    FMouseOnThumb := false;
    Invalidate;
  end;
end;

procedure TTeCustomTrackBar.MouseDown(Button: TMouseButton; Shift: TShiftState;
  x, y: integer);
var
  PointPosition: integer;
begin
  inherited MouseDown(Button, Shift, x, y);

  SetFocus;

  if PtInThumb(x, y) and (Button = mbLeft) then
  begin
    FSliding := true;
    Invalidate;
  end;

  if (not (FSliding)) and (Button = mbLeft) then
  begin
    if Orientation = toHorizontal then
      PointPosition := CoordinatePosition(x)
    else
      PointPosition := CoordinatePosition(y);

    if PointPosition > Position then
      Position := Position + PageSize
    else
      if PointPosition < Position then
      Position := Position - PageSize;
  end;
end;

procedure TTeCustomTrackBar.MouseMove(Shift: TShiftState; x, y: integer);
var
  TmpCoord: integer;
  Old: boolean;
begin
  inherited MouseMove(Shift, x, y);

  if Orientation = toHorizontal then
  begin
    TmpCoord := x;
    if (x < 0) then
      TmpCoord := 0
    else
      if x > FWidth then
      TmpCoord := FWidth
  end
  else
  begin
    TmpCoord := y;
    if (y < 0) then
      TmpCoord := 0
    else
      if y > FHeight then
      TmpCoord := FHeight
  end;

  if FSliding then
    Position := CoordinatePosition(TmpCoord);

  Old := FMouseOnThumb;
  if PtInThumb(x, y) then
    FMouseOnThumb := true
  else
    FMouseOnThumb := false;

  if FMouseOnThumb <> Old then
    Invalidate;
end;

procedure TTeCustomTrackBar.MouseUp(Button: TMouseButton; Shift: TShiftState; x,
  y: integer);
begin
  inherited MouseUp(Button, Shift, x, y);
  if Button = mbLeft then
  begin
    FSliding := false;
    Invalidate;
  end;
end;

procedure TTeCustomTrackBar.KeyDown(var Key: word; Shift: TShiftState);
begin
  inherited KeyDown(Key, Shift);

  case Key of
    VK_PRIOR: Position := Position - PageSize;
    VK_NEXT: Position := Position + PageSize;
    VK_END: Position := Max;
    VK_HOME: Position := Min;
    VK_LEFT: Position := Position - LineSize;
    VK_RIGHT: Position := Position + LineSize;
    VK_UP: Position := Position - LineSize;
    VK_DOWN: Position := Position + LineSize;
  end;
end;

