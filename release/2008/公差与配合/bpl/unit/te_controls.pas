function KsInputQuery(AOwner: TTeCustomMessage; const ACaption, APrompt: WideString;
  var Value: WideString): Boolean;
var
  Form: TTeMessageForm;
  Prompt: TTeCustomLabel;
  Edit: TTeCustomEdit;
  DialogUnits: TPoint;
  ButtonTop, ButtonWidth, ButtonHeight: Integer;
begin
  Result := False;

  Form := TTeMessageForm.CreateForm(Application, AOwner);
  with AOwner, Form do
    try
      { Standard }
      Canvas.Font := Font;
      DialogUnits := GetAveCharSize(Canvas);
      FForm.Caption := ACaption;
      ClientWidth := MulDiv(180, DialogUnits.X, 4)+30;
      ClientHeight := MulDiv(63, DialogUnits.Y, 8)+20;
      Position := AOwner.FPosition;

      Prompt:= CreateLabel(Form);
      with Prompt do
      begin
        Name := 'Prompt';
        Transparent := true;
        Parent := Form;
        Font := FMessageFont;
        AutoSize := True;
        Left := MulDiv(8, DialogUnits.X, 4) + 15;
        Top := MulDiv(8, DialogUnits.Y, 8) + 10;
        Caption := APrompt;
      end;
      Edit := CreateEdit(Form);
      with Edit do
      begin
        Anchors := [akLeft, akRight];
        Name := 'Edit';
        Parent := Form;
        Left := Prompt.Left;
        MaxLength := 255;
        Text := Value;
        Font := FMessageFont;
        Top := MulDiv(19, DialogUnits.Y, 8) + 10;
        Width := 6;
        Width := MulDiv(164, DialogUnits.X, 4);
        SelectAll;
      end;
      ButtonTop := MulDiv(41, DialogUnits.Y, 8);
      ButtonWidth := MulDiv(50, DialogUnits.X, 4);
      ButtonHeight := MulDiv(14, DialogUnits.Y, 8);
      with CreateButton(Form) do
      begin
        Parent := Form;
        Kind := bkOK;
        Caption := SMsgDlgOK;
        if not FShowButtonGlyph then
          Glyph := nil;
        Default := True;
        Font := FButtonFont;
        Transparent := true;
        SetBounds(MulDiv(38, DialogUnits.X, 4)+15, ButtonTop+10, ButtonWidth,
          ButtonHeight);
      end;
      with CreateButton(Form) do
      begin
        Parent := Form;
        Kind := bkCancel;
        Caption := SMsgDlgCancel;
        Transparent := true;
        if not FShowButtonGlyph then
          Glyph := nil;
        Font := FButtonFont;
        SetBounds(MulDiv(92, DialogUnits.X, 4)+15, ButtonTop+10, ButtonWidth,
          ButtonHeight);
        Left := Left + 15;
      end;

      Application.ProcessMessages;
      Form.Update;

      if ShowModal = mrOk then
      begin
        Value := Edit.Text;
        Result := True;
      end;
    finally
      Form.Free;
    end;
end;

