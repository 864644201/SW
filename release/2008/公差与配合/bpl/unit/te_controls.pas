procedure RemoveMDIClientEdge(ClientHandle: THandle);
var
  Style: Longint;
begin
  if ClientHandle <> 0 then
  begin
    Style := GetWindowLong(ClientHandle, GWL_EXSTYLE);
    Style := Style and not WS_EX_CLIENTEDGE;
     
    SetWindowLong(ClientHandle, GWL_EXSTYLE, Style);
    SetWindowPos(ClientHandle, 0, 0,0,0,0, SWP_FRAMECHANGED or SWP_NOACTIVATE or
      SWP_NOMOVE or SWP_NOSIZE or SWP_NOZORDER);
  end;
end;

function GetParentKsForm(Control: TControl): TTeCustomForm;
var
  i: integer;
begin
  while Control.Parent <> nil do
    Control := Control.Parent;

  if Control is TCustomForm then
  begin
    for i := 0 to (Control as TCustomForm).ComponentCount - 1 do
      if ((Control as TCustomForm).Components[i] is TTeCustomForm) and
         (((Control as TCustomForm).Components[i] as TTeCustomForm).Active) then
      begin
        Result := (Control as TCustomForm).Components[i] as TTeCustomForm;
        Exit;
      end;
  end;
  Result := nil;
end;

function GetStatusBar(AForm: TTeCustomForm): TTeCustomStatusBar;
var
  Form: TCustomForm;
  i: integer;
begin
  Form := AForm.Form;

  if Form <> nil then
  begin
    for i := 0 to Form.ControlCount - 1 do
      if Form.Controls[i] is TTeCustomStatusBar then
        if TTeCustomStatusBarHack(Form.Controls[i]).IsSizeGripVisible then
        begin
          Result := Form.Controls[i] as TTeCustomStatusBar;
          Exit;
        end;
  end;

  Result := nil;
end;

{ TTeCustomForm ===============================================================}

constructor TTeCustomForm.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);
  FBlending := TTeBlending.Create;
  FBlending.OnChange := DoBlendingChanged;

  FShadow := TTeShadow.Create;
  FShadow.OnChange := DoShadowChanged;

  FGravitation := TTeGravitation.Create;
  FDragging := TTeDragging.Create;
  FAnimation := TTeAnimation.Create;

  FCanvas := TCanvas.Create;
  FScreen := TTeBitmap.Create;

  FMinimizeApplication := true;
  FBorderStyle := kbsStandard;
  FBorderIcons := [kbiClose, kbiSystemMenu, kbiMinimize, kbiMaximize,
    kbiRollup, kbiTray];
  FConstraints := TSizeConstraints.Create(nil);

  FPerformance := ksfpNoBuffer;

  FSystemMenuOptions := TTePopupMenuOptions.Create;
  FTrayMenuOptions := TTePopupMenuOptions.Create;

  if Owner is TCustomForm then
  begin
    Caption := THackForm(Owner).Caption;

    THackForm(Owner).BorderStyle := bsSizeable;
    THackForm(Owner).BorderIcons := [biMinimize];
    THackForm(Owner).AutoScroll := false;

    if Application.MainForm = TCustomForm(Owner) then
      FMinimizeApplication := true;

    if THackForm(Owner).FormStyle = fsMDIChild then
    begin
      FMinimizeApplication := false;
      FGravitation.Size := 9;
      FBorderIcons := [kbiClose, kbiSystemMenu, kbiMinimize, kbiMaximize, kbiRollup];
    end;

    Constraints := THackForm(Owner).Constraints;
  end;

  if Owner is TWinControl then
    FCanvas.Handle := GetDC(THackControl(Owner).Handle);

  FTrayMsgWindow := AllocateHWnd(MsgTrayWndProc);

  if not (csDesigning in ComponentState) then
  begin
    FillChar(FIConData, 0, SizeOf(TNotifyIconData));
    with FIconData do
    begin
      cbSize := SizeOf(TNotifyIconData);
      Wnd := FTrayMsgWindow;
      uID := Integer(Self);
      uFlags := nif_Message or nif_Icon or nif_Tip;
      uCallBackMessage := wm_TrayIconMessage;
      szTip := '';
    end;
  end;

  FAllowDraw := true;
end;

destructor TTeCustomForm.Destroy;
begin
  WinControl := nil;

  FConstraints.Free;

  if Assigned(FOldApplicationRestore) then
  begin
    Application.OnRestore := FOldApplicationRestore;
    Application.OnMinimize := FOldApplicationMinimize;
  end;

  if not (csDesigning in ComponentState) then
    Shell_NotifyIcon(nim_Delete, @FIconData);

  DeallocateHWnd(FTrayMsgWindow);

  FScreen.Free;
  FCanvas.Free;

  FAnimation.Free;
  FDragging.Free;
  FGravitation.Free;
  FShadow.Free;
  FBlending.Free;
  if FIcon <> nil then FIcon.Free;

  FSystemMenuOptions.Free;
  FTrayMenuOptions.Free;
  
  inherited Destroy;
end;

procedure TTeCustomForm.Loaded;
var
  ExStyle: longint;
  SaveOnResize: TNotifyEvent;
begin
  inherited Loaded;

  if csDesigning in ComponentState then Exit;

  if (Owner is TWinControl) then
    WinControl := TWinControl(Owner);

  if (FBlending.Enabled) or (FShadow.Enabled) then
    FScreen.SetSize(FRealWidth, FRealHeight);

  if Owner is TCustomForm then
  begin
    if not (csDesigning in ComponentState) and (Form <> nil) and (THackForm(Form).FormStyle = fsMDIForm) and (THackForm(Form).ClientHandle <> 0) then
    begin
      FClientInstance := MakeObjectInstance(ClientWndProc);
      FOldClientProc := Pointer(GetWindowLong(THackForm(Form).ClientHandle, GWL_WNDPROC));
      SetWindowLong(THackForm(Form).ClientHandle, GWL_WNDPROC, Longint(FClientInstance));
    end;

    if not (csDesigning in ComponentState) and (Form <> nil) then
    begin
      FSavedOnShortCut := THackForm(Owner).OnShortCut;
      THackForm(Owner).OnShortCut := DoFormShortCut;
    end;
  end;

  UpdateTrayIcon;

  if FLoadedState <> kwsNormal then
  begin
    if FLoadedState <> kwsRollup then
    begin
      FRestoreRect := Form.BoundsRect;
      SetWindowPos(Handle, 0, 0, Screen.Height, RectWidth(FRestoreRect), RectHeight(FRestoreRect), SWP_SHOWWINDOW);
    end;

    PostMessage(Handle, WM_STARTACTION, Longint(FLoadedState), 0);
  end;

  if Owner is TCustomForm then
  begin
    SaveOnResize := THackForm(Owner).OnResize;
    try
      THackForm(Owner).OnResize := nil;

      if FLoadedState = kwsNormal then Update;
    finally
      THackForm(Owner).OnResize := SaveOnResize;
    end;
  end;

  if Assigned(FOnCreate) then FOnCreate(Self);

  { Set StayOnTop }
  if StayOnTop and (Form <> nil) then
  begin
    SetWindowPos(Handle, HWND_TOPMOST, THackForm(Form).Left, THackForm(Form).Top, FWidth, FHeight,
      SWP_NOACTIVATE or SWP_NOCOPYBITS or SWP_NOMOVE or SWP_NOSIZE);
  end;
end;

{ System menu }

function TTeCustomForm.CreateMenuItem(AOwner: TComponent): TTeCustomItem;
begin
  Result := TTeCustomItem.Create(AOwner);
end;

procedure TTeCustomForm.CreateSysMenu;
  function AddItem(ACaption: string; AShortCut: TShortCut): TTeCustomItem;
  begin
    Result := CreateMenuItem(Self);
    with Result do
    begin
      Caption := ACaption;
      ShortCut := AShortCut;
      Images := SysMenuImages;
      OnClick := DoSysMenu;
    end;
    FSysMenu.Add(Result);
  end;

var
  Item: TTeCustomItem;
begin
  if FSysMenu <> nil then
    FSysMenu.Free;

  FSysMenu := CreateMenuItem(Self);

  { Add items }
  if (FWindowState = kwsMaximized) or (FWindowState = kwsMinimized) or
     (FWindowState = kwsRollup) or (FWindowState = kwsTray) then
  begin
    Item := AddItem(SKsRestore, 0);
    Item.ImageIndex := 3;
  end;

  if (kbiMinimize in FBorderIcons) and ((FWindowState = kwsNormal) or
     (FWindowState = kwsMaximized) or (FWindowState = kwsRollup)) then
  begin
    Item := AddItem(SKsMinimize, 0);
    Item.ImageIndex := 1;
  end;

  if (kbiMaximize in FBorderIcons) and ((FWindowState = kwsNormal)
     or (FWindowState = kwsRollup)) then
  begin
    Item := AddItem(SKsMaximize, 0);
    Item.ImageIndex := 2;
  end;

  if (kbiRollup in FBorderIcons) and ((FWindowState = kwsNormal) or
     (FWindowState = kwsMaximized)) then
  begin
    Item := AddItem(SKsRollup, 0);
    Item.ImageIndex := 4;
  end;

  if (kbiTray in FBorderIcons) and ((FWindowState = kwsNormal) or
     (FWindowState = kwsMaximized) or (FWindowState = kwsRollup)) then
  begin
    Item := AddItem(SKsMinToTray, 0);
    Item.ImageIndex := 5;
  end;

  if kbiClose in FBorderIcons then
  begin
    if FSysMenu.Count > 0 then AddItem('-', 0);

    Item := AddItem(SKsClose, TextToShortCut('Alt+F4'));
    Item.ImageIndex := 0;
  end;

  { Set Properties }
  FSysMenu.PopupMenuOptions := FSystemMenuOptions;
end;

procedure TTeCustomForm.DoSysMenu(Sender: TObject);
var
  Item: TTeCustomItem;
begin
  Item := TTeCustomItem(Sender);
  if Item.Caption = SKsClose then
    Close;
  if Item.Caption = SKsMaximize then
    Maximize;
  if Item.Caption = SKsMinimize then
    Minimize;
  if Item.Caption = SKsRollup then
    Rollup;
  if Item.Caption = SKsMinToTray then
    MinToTray;
  if Item.Caption = SKsRestore then
    Restore;
end;

procedure TTeCustomForm.DoFormShortCut(var Msg: TWMKey; var Handled: Boolean);
begin
  if FMenuBar <> nil then
    Handled := FMenuBar.IsShortCut(Msg);

  if not Handled and Assigned(FSavedOnShortCut) then
    FSavedOnShortCut(Msg, Handled);
end;

procedure TTeCustomForm.DoBlendingChanged(Sender: TObject);
begin
  if not (csLoading in ComponentState) then Update;
end;

procedure TTeCustomForm.DoShadowChanged(Sender: TObject);
begin
  if not (csLoading in ComponentState) then Update;
end;

{ Internal Routines }

procedure TTeCustomForm.UpdateNonClientArea(ClipRgn: HRgn);
var
  R, R1: TRect;
  Canvas: TCanvas;
  CurrentBuffer, DoubleBuffer: TTeBitmap;
  DC, SaveIndex: integer;
  Rgn: HRgn;
begin
  if (Form <> nil) and (THackForm(Form).FormStyle = fsMDIChild) and (FWindowState = kwsMaximized) then Exit;
  if CompareRect(GetClientBounds, GetClientRect) and not FShadow.Enabled then Exit;
  if FRealWidth * FRealHeight <= 0 then Exit;

  if FAllowDraw then
  begin
    { Paint NC area }
    Canvas := TCanvas.Create;
    Canvas.Lock;
    try
      if FAnimating then
      begin
        Canvas.Handle := FAniBuffer.DC;
        CurrentBuffer := FAniBuffer;
      end
      else
        case FPerformance of
          ksfpSharedBuffer:
            begin
              if SharedBuffer.Empty then InitSharedBuffer;
              Canvas.Handle := SharedBuffer.DC;

              CurrentBuffer := SharedBuffer;
            end;
          ksfpPersistentBuffer:
            begin
              if FPersistentBuffer = nil then
                FPersistentBuffer := TTeBitmap.Create;
              Canvas.Handle := FPersistentBuffer.DC;

              CurrentBuffer := FPersistentBuffer;
            end;
          ksfpDoubleBuffer:
            begin
              DoubleBuffer := TTeBitmap.Create;
              DoubleBuffer.SetSize(FRealWidth, FRealHeight);
              Canvas.Handle := DoubleBuffer.DC;

              CurrentBuffer := DoubleBuffer;
            end;
        else
          if (FShadow.Enabled or FBlending.Enabled) then
          begin
            CurrentBuffer := TTeBitmap.Create;
            CurrentBuffer.SetSize(FRealWidth, FRealHeight);

            Canvas.Handle := CurrentBuffer.DC;
          end
          else
            Canvas.Handle := GetWindowDC(Handle);
        end;

      if Canvas.Handle = 0 then Exit;
      SaveIndex := SaveDC(Canvas.Handle);

      { Draw Shadow }
      if FShadow.Enabled and (CurrentBuffer <> nil) then
        with GetClientBounds do
        begin
          GetWindowRgn(Handle, Rgn);
          if Rgn <> 0 then
          begin
            { Drop top shadow }
            CurrentBuffer.FillRect(Rect(FShadow.Size, FShadow.Size, FWidth, Top), ShadowColor);
            CurrentBuffer.MergeDraw(FScreen, FShadow.Size, FShadow.Size, Rect(FShadow.Size, FShadow.Size, FWidth, Top));
            { Drop left shadow }
            CurrentBuffer.FillRect(Rect(FShadow.Size, FShadow.Size, Left, FHeight), ShadowColor);
            CurrentBuffer.MergeDraw(FScreen, FShadow.Size, FShadow.Size, Rect(FShadow.Size, FShadow.Size, Left, FHeight));
          end;

          { Drop right shadow }
          CurrentBuffer.FillRect(Rect(Right, 0, FRealWidth, FShadow.Size), ckTransparent);

          R := Rect(Right, FShadow.Size, FRealWidth, Bottom);
          CurrentBuffer.FillRect(R, SunkenColor(ShadowColor, 0, 0, 0, ShadowAlphaStep[3]));
          CurrentBuffer.FillRect(Rect(R.Right - 1, R.Top, R.Right, R.Top + 1), SunkenColor(ShadowColor, 0, 0, 0, ShadowAlphaStep[4]));
          Dec(R.Right); Inc(R.Top);
          CurrentBuffer.FillRect(R, SunkenColor(ShadowColor, 0, 0, 0, ShadowAlphaStep[2]));
          CurrentBuffer.FillRect(Rect(R.Right - 1, R.Top, R.Right, R.Top + 1), SunkenColor(ShadowColor, 0, 0, 0, ShadowAlphaStep[3]));
          Dec(R.Right); Inc(R.Top);
          CurrentBuffer.FillRect(R, SunkenColor(ShadowColor, 0, 0, 0, ShadowAlphaStep[1]));
          CurrentBuffer.FillRect(Rect(R.Right - 1, R.Top, R.Right, R.Top + 1), SunkenColor(ShadowColor, 0, 0, 0, ShadowAlphaStep[2]));
          Dec(R.Right); Inc(R.Top);
          CurrentBuffer.FillRect(R, ShadowColor);

          CurrentBuffer.MergeDraw(FScreen, Right, 0, Rect(Right, 0, FRealWidth, FRealHeight));

          { Drop bottom shadow }
          CurrentBuffer.FillRect(Rect(0, Bottom, FShadow.Size, FRealHeight), ckTransparent);

          R := Rect(FShadow.Size, Bottom, FWidth, FRealHeight);
          CurrentBuffer.FillRect(R, SunkenColor(ShadowColor, 0, 0, 0, ShadowAlphaStep[3]));
          CurrentBuffer.FillRect(Rect(R.Left, R.Bottom - 1, R.Left + 1, R.Bottom), SunkenColor(ShadowColor, 0, 0, 0, ShadowAlphaStep[4]));
          Inc(R.Left); Dec(R.Bottom);
          CurrentBuffer.FillRect(R, SunkenColor(ShadowColor, 0, 0, 0, ShadowAlphaStep[2]));
          CurrentBuffer.FillRect(Rect(R.Left, R.Bottom - 1, R.Left + 1, R.Bottom), SunkenColor(ShadowColor, 0, 0, 0, ShadowAlphaStep[3]));
          Inc(R.Left); Dec(R.Bottom);
          CurrentBuffer.FillRect(R, SunkenColor(ShadowColor, 0, 0, 0, ShadowAlphaStep[1]));
          CurrentBuffer.FillRect(Rect(R.Left, R.Bottom - 1, R.Left + 1, R.Bottom), SunkenColor(ShadowColor, 0, 0, 0, ShadowAlphaStep[2]));
          Inc(R.Left); Dec(R.Bottom);
          CurrentBuffer.FillRect(R, ShadowColor);

          CurrentBuffer.MergeDraw(FScreen, 0, Bottom, Rect(0, Bottom, Right, FRealHeight));

          { Drop bottomright shadow }
          R := Rect(Right, Bottom, FRealWidth, FRealHeight);
          CurrentBuffer.FillRect(R, SunkenColor(ShadowColor, 0, 0, 0, ShadowAlphaStep[3]));
          CurrentBuffer.FillRect(Rect(R.Right - 1, R.Bottom - 1, R.Right, R.Bottom), SunkenColor(ShadowColor, 0, 0, 0, ShadowAlphaStep[4]));
          Dec(R.Right); Dec(R.Bottom);
          CurrentBuffer.FillRect(R, SunkenColor(ShadowColor, 0, 0, 0, ShadowAlphaStep[2]));
          CurrentBuffer.FillRect(Rect(R.Right - 1, R.Bottom - 1, R.Right, R.Bottom), SunkenColor(ShadowColor, 0, 0, 0, ShadowAlphaStep[3]));
          Dec(R.Right); Dec(R.Bottom);
          CurrentBuffer.FillRect(R, SunkenColor(ShadowColor, 0, 0, 0, ShadowAlphaStep[1]));
          CurrentBuffer.FillRect(Rect(R.Right - 1, R.Bottom - 1, R.Right, R.Bottom), SunkenColor(ShadowColor, 0, 0, 0, ShadowAlphaStep[2]));
          Dec(R.Right); Dec(R.Bottom);
          CurrentBuffer.FillRect(R, ShadowColor);

          CurrentBuffer.MergeDraw(FScreen, Right, Bottom, Rect(Right, Bottom, FRealWidth, FRealHeight));
        end;

      { Select clip region }
      with GetClientBounds do
        ExcludeClipRect(Canvas.Handle, Left, Top, Right, Bottom);

      { Paint NC Area to Buffer }
      if FBlending.Enabled and (CurrentBuffer <> nil) then
      begin
        { Blending }
        CurrentBuffer.Blend := true;
        { Paint To Buffer }
        PaintNonClientArea(Canvas);
        { Blend }
        with GetClientBounds do
        begin
          { Blend }
          CurrentBuffer.SetAlpha(FBlending.Value, Rect(0, 0, FWidth, Top));
          CurrentBuffer.SetAlpha(FBlending.Value, Rect(0, Bottom, FWidth, FHeight));
          CurrentBuffer.SetAlpha(FBlending.Value, Rect(0, Top, Left, FHeight));
          CurrentBuffer.SetAlpha(FBlending.Value, Rect(Right, Top, FWidth, FHeight));

          R := Rect(0, 0, FWidth, FHeight);
          { Top }
          R1 := R;
          R1.Bottom := R1.Top + Top;
          CurrentBuffer.MergeDraw(FScreen, 0, 0, R1);
          { Bottom }
          R1 := R;
          R1.Top := R1.Bottom - (FHeight - Bottom);
          CurrentBuffer.MergeDraw(FScreen, 0, Bottom, R1);
          { Left }
          R1 := R;
          R1.Right := R1.Left + Left;
          R1.Top := R1.Top + Top;
          R1.Bottom := R1.Bottom - (FHeight - Bottom);
          CurrentBuffer.MergeDraw(FScreen, 0, Top, R1);
          { Right }
          R1 := R;
          R1.Left := R1.Right - (FWidth - Right);
          R1.Top := R1.Top + Top;
          R1.Bottom := R1.Bottom - (FHeight - Bottom);
          CurrentBuffer.MergeDraw(FScreen, Right, Top, R1);
        end;
        { Restore Blend }
        CurrentBuffer.Blend := false;
      end
      else
      begin
        { Paint non client area }
        PaintNonClientArea(Canvas);
      end;

      { Paint buffer }
      if not FAnimating then
      begin
        case FPerformance of
          ksfpSharedBuffer:
            begin
              DC := GetWindowDC(Handle);
              { Paint shared buffer }
              with GetClientBounds do
              begin
                { Top corner }
                R := Rect(0, 0, FRealWidth, Top);
                SharedBuffer.Draw(DC, 0, 0, R);
                { Bottom corner }
                R := Rect(Left, Bottom, Right, FRealHeight);
                SharedBuffer.Draw(DC, Left, Bottom, R);
                { Left corner }
                R := Rect(0, Top, Left, FRealHeight);
                SharedBuffer.Draw(DC, 0, Top, R);
                { Right corner }
                R := Rect(Right, Top, FRealWidth, FRealHeight);
                SharedBuffer.Draw(DC, Right, Top, R);
              end;
              ReleaseDC(Handle, DC);
            end;
          ksfpPersistentBuffer:
            begin
              DC := GetWindowDC(Handle);
              { Paint persistent buffer }
              with GetClientBounds do
              begin
                { Top corner }
                R := Rect(0, 0, FRealWidth, Top);
                FPersistentBuffer.Draw(DC, 0, 0, R);
                { Bottom corner }
                R := Rect(Left, Bottom, Right, FRealHeight);
                FPersistentBuffer.Draw(DC, Left, Bottom, R);
                { Left corner }
                R := Rect(0, Top, Left, FRealHeight);
                FPersistentBuffer.Draw(DC, 0, Top, R);
                { Right corner }
                R := Rect(Right, Top, FRealWidth, FRealHeight);
                FPersistentBuffer.Draw(DC, Right, Top, R);
              end;
              ReleaseDC(Handle, DC);
            end;
          ksfpDoubleBuffer:
            begin
              DC := GetWindowDC(Handle);
              { Paint double buffer }
              with GetClientBounds do
              begin
                { Top corner }
                R := Rect(0, 0, FRealWidth, Top);
                DoubleBuffer.Draw(DC, 0, 0, R);
                { Bottom corner }
                R := Rect(Left, Bottom, Right, FRealHeight);
                DoubleBuffer.Draw(DC, Left, Bottom, R);
                { Left corner }
                R := Rect(0, Top, Left, FRealHeight);
                DoubleBuffer.Draw(DC, 0, Top, R);
                { Right corner }
                R := Rect(Right, Top, FRealWidth, FRealHeight);
                DoubleBuffer.Draw(DC, Right, Top, R);
              end;
              ReleaseDC(Handle, DC);
            end;
          ksfpNoBuffer:
            if FShadow.Enabled or FBlending.Enabled then
            begin
              DC := GetWindowDC(Handle);
              { Paint double buffer }
              with GetClientBounds do
              begin
                { Top corner }
                R := Rect(0, 0, FRealWidth, Top);
                CurrentBuffer.Draw(DC, 0, 0, R);
                { Bottom corner }
                R := Rect(Left, Bottom, Right, FRealHeight);
                CurrentBuffer.Draw(DC, Left, Bottom, R);
                { Left corner }
                R := Rect(0, Top, Left, FRealHeight);
                CurrentBuffer.Draw(DC, 0, Top, R);
                { Right corner }
                R := Rect(Right, Top, FRealWidth, FRealHeight);
                CurrentBuffer.Draw(DC, Right, Top, R);
              end;
              ReleaseDC(Handle, DC);
            end;
        end;
      end;

      RestoreDC(Canvas.Handle, SaveIndex);
      
      if not FAnimating then
      begin
        case FPerformance of
          ksfpDoubleBuffer:
            begin
              Canvas.Handle := 0;
              DoubleBuffer.Free;
            end;
          ksfpSharedBuffer, ksfpPersistentBuffer:
            begin
              Canvas.Handle := 0;
            end;
          ksfpNoBuffer:
            begin
              if FShadow.Enabled or FBlending.Enabled then
              begin
                Canvas.Handle := 0;
                CurrentBuffer.Free;
              end
              else
                ReleaseDC(Handle, Canvas.Handle);
            end;
        end;
      end
      else
      begin
        Canvas.Handle := 0;
      end;
    finally
      Canvas.Unlock;
      Canvas.Free;
    end;
  end;
end;

function TTeCustomForm.GetIcon: TIcon;
var
  IHandle : HICON;
  IconX, IconY : integer;
  ID: boolean;
begin
  if FIcon = nil then
  begin
    FIcon := TIcon.Create;

    ID := false;
    if THackForm(Form).Icon.Handle <> 0 then
       IHandle := THackForm(Form).Icon.Handle
     else
       if Application.Icon.Handle <> 0 then
         IHandle := Application.Icon.Handle
       else
       begin
         IHandle := LoadIcon(0, IDI_APPLICATION);
         ID := true;
       end;
     IconX := GetSystemMetrics(SM_CXSMICON);
     if IconX = 0 then IconX := GetSystemMetrics(SM_CXSIZE);
     IconY := GetSystemMetrics(SM_CYSMICON);
     if IconY = 0 then IconY := GetSystemMetrics(SM_CYSIZE);

     FIcon.Handle := CopyImage(IHandle, IMAGE_ICON, IconX, IconY, LR_COPYFROMRESOURCE);
     if ID then DestroyIcon(IHandle);
  end;

  Result := FIcon;
end;

function TTeCustomForm.GetRegion: HRgn;
var
  Theme: HTheme;
  Part, State: integer;
begin
  if UseThemes and (FBorderStyle <> kbsNone) then
  begin
    Theme := OpenThemeData(0, 'Window');

    if FBorderStyle = kbsStandard then
      Part := integer(WP_CAPTION)
    else
      Part := integer(WP_SMALLCAPTION);
      
    GetThemeBackgroundRegion(Theme, Canvas.Handle, Part, State, Rect(0, 0, FWidth, FHeight), Result);

    CloseThemeData(Theme);
  end
  else
    Result := CreateRectRgn(0, 0, FWidth, FHeight);
end;

procedure TTeCustomForm.ChangeSize;
var
  OldRgn, Rgn, ShadowRgn: HRgn;
  Msg: TWMSize;
  i: integer;
begin
  { Resize Persistent buffer }
  if (FPerformance = ksfpPersistentBuffer) then
  begin
    if FPersistentBuffer = nil then
      FPersistentBuffer := TTeBitmap.Create;

    FPersistentBuffer.SetSize(FRealWidth, FRealHeight);
  end;

  { Set Region }
  FAllowDraw := false;
  try
    OldRgn := 0;
    GetWindowRgn(Handle, OldRgn);
    Rgn := GetRegion;

    if FShadow.Enabled and (FWindowState <> kwsMaximized) then
    begin
      ShadowRgn := GetRegion;
      OffsetRgn(ShadowRgn, FShadow.Size, FShadow.Size);
      CombineRgn(Rgn, Rgn, ShadowRgn, RGN_OR);
      DeleteObject(ShadowRgn);
    end;

    SetWindowRgn(Handle, Rgn, true);
  finally
    DeleteObject(OldRgn);
    FAllowDraw := true;
  end;

  if Assigned(FOnResize) then FOnResize(Self);
end;

function TTeCustomForm.GetParentRect: TRect;
var
  Parent: HWnd;
begin
  Parent := GetParent(Handle);
  if Parent <> 0 then
    Windows.GetClientRect(Parent, Result)
  else
    Result := GetRectOfMonitorContainingWindow(Handle, not FStayOnTop);
end;

function TTeCustomForm.NormalizePoint(P: TPoint): TPoint;
var
  WindowPos, ClientPos: TPoint;
  HandleParent: HWnd;
begin
  HandleParent := GetParent(Handle);
  { Calc windowpos - screen }
  WindowPos := Point(WinControl.Left, WinControl.Top);
  if HandleParent <> 0 then
    ClientToScreen(HandleParent, WindowPos);
  { Calc clientpos - screen }
  ClientPos := Point(0, 0);
  ClientToScreen(Handle, ClientPos);
  { Calc local pos }
  Result := P;
  ScreenToClient(Handle, Result);
  { Offset to client offset }
  Inc(Result.X, ClientPos.X-WindowPos.X);
  Inc(Result.Y, ClientPos.Y-WindowPos.Y);
end;

function TTeCustomForm.ApplyGravitation(R: TRect): TRect;
var
  ParentR: TRect;
begin
  Result := R;

  if FGravitation.Enabled then
  begin
    if FShadow.Enabled then
    begin
      Dec(R.Right, FShadow.Size); 
      Dec(R.Bottom, FShadow.Size);
    end;

    { Screen (Parent) graviataion }
    ParentR := GetParentRect;
    with ParentR do
    begin
      if Abs(R.Left - Left) < FGravitation.Size then
        OffsetRect(Result, - (R.Left - Left), 0)
      else
        if Abs(R.Right - Right) < FGravitation.Size then
          OffsetRect(Result, -(R.Right - Right), 0);

      if Abs(R.Top - Top) < FGravitation.Size then
        OffsetRect(Result, 0, - (R.Top - Top))
      else
        if Abs(R.Bottom - Bottom) < FGravitation.Size then
          OffsetRect(Result, 0, -(R.Bottom - Bottom));
    end;

    { Dock gravitation }
    if FGravitation.Kind = kgkDock then
    begin
      { Move all sticked sites }
      
    end;

    { Site gravitation }
    if FGravitation.Kind = kgkSite then
    begin
    end;
  end;
end;

procedure TTeCustomForm.CopyScreen(NewRect: TRect);
var
  DesktopDC: HDC;
  OldScreen: TTeBitmap;
  IntRect: TRect;
  OldCopyRect, NewCopyRect: TRect;
begin
  if WinControl = nil then Exit;
  if CompareRect(NewRect, FOldRect) then Exit;
  if FNoCopyScreen then Exit;
  if not FBlending.Enabled and ((FWindowState = kwsMaximized) or (FOldState = kwsMaximized)) then
  begin
    if FOldState = kwsMaximized then FOldState := kwsNormal;
    Exit;
  end;

  { Copy Screen Rect }
  DesktopDC := GetDC(0);
  if (DesktopDC <> 0) then
  begin
    { Set old states }
    OldScreen := FScreen;
    { Set new screen }
    FScreen := TTeBitmap.Create;
    FScreen.SetSize(RectWidth(NewRect), RectHeight(NewRect));
    { Calc intersection }
    IntersectRect(IntRect, FOldRect, NewRect);
    OldCopyRect := IntRect;
    OffsetRect(OldCopyRect, -FOldRect.Left, -FOldRect.Top);
    NewCopyRect := IntRect;
    OffsetRect(NewCopyRect, -NewRect.Left, -NewRect.Top);
    { Copy from screen }
    if IsRectEmpty(IntRect) then
      { Full Size Copy }
      BitBlt(FScreen.DC, 0, 0, FScreen.Width, FScreen.Height, DesktopDC,
        NewRect.Left, NewRect.Top, SRCCOPY)
    else
    begin
      { Left Part Copy }
      if NewCopyRect.Left > 0 then
        BitBlt(FScreen.DC, 0, 0, NewCopyRect.Left, FScreen.Height, DesktopDC,
          NewRect.Left, NewRect.Top, SRCCOPY);
      { Top Part Copy }
      if NewCopyRect.Top > 0 then
        BitBlt(FScreen.DC, 0, 0, FScreen.Width, NewCopyRect.Top, DesktopDC,
          NewRect.Left, NewRect.Top, SRCCOPY);
      { Right Part Copy }
      if NewCopyRect.Right < FScreen.Width then
        BitBlt(FScreen.DC, NewCopyRect.Right, 0, FScreen.Width - NewCopyRect.Right,
          FScreen.Height, DesktopDC, NewRect.Left + NewCopyRect.Right, NewRect.Top, SRCCOPY);
      { Bottom Part Copy }
      if NewCopyRect.Bottom < FScreen.Height then
        BitBlt(FScreen.DC, 0, NewCopyRect.Bottom, FScreen.Width,
        FScreen.Height - NewCopyRect.Bottom, DesktopDC, NewRect.Left, NewRect.Top + NewCopyRect.Bottom, SRCCOPY);
    end;
    { Copy part from Old to New }
    if not IsRectEmpty(FOldRect) then
      OldScreen.Draw(FScreen, NewCopyRect, OldCopyRect);

    { Delete old screen image }
    OldScreen.Free;
  end;
  ReleaseDC(0, DesktopDC);

  FOldRect := NewRect;
end;

procedure TTeCustomForm.AnimationShow;
var
  DesktopCanvas: TCanvas;
  R: TRect;
  OldActive: boolean;
  i, j: integer;
  Animation: TTeAnimation;
  RectRgn, ShadowRgn, Rgn: HRgn;
begin
  if not FAnimation.Enabled then Exit;
  if WinControl = nil then Exit;
  Application.ProcessMessages;

  { Show Animation }
  FAnimating := true;
  FAniBuffer := TTeBitmap.Create;
  try
    FAniBuffer.SetSize(FRealWidth, FRealHeight);

    { CopyScreen }
    GetWindowRect(Handle, R);
    FOldRect := Rect(0, 0, 0, 0);
    CopyScreen(R);

    { Make form image }
    OldActive := FFormActive;
    FFormActive := true;

    UpdateNonClientArea(0);
    SendMessage(Handle, WM_ERASEBKGND, 0, 0);
    FFormActive := OldActive;

    { Make transparent region }
    Rgn := GetRegion;
    if FShadow.Enabled and (FWindowState <> kwsMaximized) then
    begin
      ShadowRgn := GetRegion;
      OffsetRgn(ShadowRgn, FShadow.Size, FShadow.Size);
      CombineRgn(Rgn, Rgn, ShadowRgn, RGN_OR);
      DeleteObject(ShadowRgn);
    end;
    RectRgn := CreateRectRgn(0, 0, FRealWidth, FRealHeight);
    try
      CombineRgn(Rgn, RectRgn, Rgn, RGN_DIFF);
      SelectClipRgn(FAniBuffer.Handle, Rgn);

      FAniBuffer.SetAlpha(255);
      FAniBuffer.PerformTransparent(ckTransparent);

      { Remove shadow bugs }
      for i := 0 to FRealWidth - 1 do
        for j := 0 to FRealHeight - 1 do
        begin
          if (i > FShadow.Size) and (i < FWidth) and (j > FShadow.Size) and (j < FWidth) then
            Continue;

          If PtInRegion(Rgn, i, j) then
            FAniBuffer.Bits[i + j * FAniBuffer.Width] := ckTransparent;
        end;

      SelectClipRgn(FAniBuffer.Handle, 0);
    finally
      DeleteObject(RectRgn);
      DeleteObject(Rgn);
    end;

    R := GetClientBounds;
    { Paint children }
    if Form <> nil then
    begin
      MoveWindowOrg(FAniBuffer.DC, R.Left, R.Top);
      { Paint Graph Controls }
      THackControl(Form).PaintControls(FAniBuffer.DC, nil);
      { Paint Win controls }
      for i := 0 to WinControl.ControlCount - 1 do
        if (WinControl.Controls[i] <> WinControl) and
           (WinControl.Controls[i] is TWinControl) then
        with TWinControl(WinControl.Controls[i]) do
          if Visible then PaintTo(FAniBuffer.DC, Left, Top);
      { Restore }
      MoveWindowOrg(FAniBuffer.DC, -R.Left, -R.Top);
    end;

    { Animation }
    DesktopCanvas := TCanvas.Create;
    try
      DesktopCanvas.Handle := GetDC(0);

      R := Rect(0, 0, FRealWidth, FRealHeight);

      with GetClientBounds do
      begin
        R.TopLeft := WinControl.ClientToScreen(Point(-Left, -Top));
        R.BottomRight := WinControl.ClientToScreen(Point(FRealWidth - Left, FRealHeight - Top));
      end;

      { Execute }
      ExecuteAnimation(DesktopCanvas, R.Left, R.Top, FScreen, FAniBuffer, FAnimation);
    finally
      ReleaseDC(0, DesktopCanvas.Handle);
      DesktopCanvas.Handle := 0;
      DesktopCanvas.Free;
    end;
  finally
    FAnimating := false;
    FAniBuffer.Free;
  end;
end;

