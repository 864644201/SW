procedure InitCaptionFont;
var
  FontLog: LogFont;
  NonClientMetrics: TNonClientMetrics;
  Theme: HTheme;
begin
  CaptionFont := TFont.Create;
  SmCaptionFont := TFont.Create;

  if true {not UseThemes }then
  begin
    NonClientMetrics.cbSize := SizeOf(NonClientMetrics);
    if SystemParametersInfo(SPI_GETNONCLIENTMETRICS, 0, @NonClientMetrics, 0) then
      CaptionFont.Handle := CreateFontIndirect(NonClientMetrics.lfCaptionFont);

    NonClientMetrics.cbSize := SizeOf(NonClientMetrics);
    if SystemParametersInfo(SPI_GETNONCLIENTMETRICS, 0, @NonClientMetrics, 0) then
      SmCaptionFont.Handle := CreateFontIndirect(NonClientMetrics.lfSmCaptionFont);
  end
  else
  begin
    Theme := OpenThemeData(0, 'Window');

    GetThemeSysFont(Theme, TMT_CAPTIONFONT, FontLog);
    CaptionFont.Handle := CreateFontIndirect(FontLog);

    GetThemeSysFont(Theme, TMT_SMALLCAPTIONFONT, FontLog);
    SmCaptionFont.Handle := CreateFontIndirect(FontLog);

    CloseThemeData(Theme);
  end;
end;

