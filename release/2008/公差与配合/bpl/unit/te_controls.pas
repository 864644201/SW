procedure TTeCustomInplaceControlEdit.UpdateButtonBounds;
var
  R: TRect;
begin
  if not HandleAllocated then Exit;
  if FButton = nil then Exit;
//  if not Button.HandleAllocated then Exit;
  
  with GetBorderRect do
  begin
    if FButtonAlign = baLeft then
      R := Rect(Top, Left, Top + ButtonWidth, Bottom)
    else
      R := Rect(Right-ButtonWidth, Top, Right, Bottom);

    InflateRect(R, BorderWidth, BorderWidth);

    if FButtonAlign = baLeft then
      R.Right := R.Left + ButtonWidth
    else
      R.Left := R.Right - ButtonWidth;

    FButton.BoundsRect := R;
  end;

  Invalidate;
end;

