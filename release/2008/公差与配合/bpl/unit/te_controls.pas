implementation {===============================================================}

{$R *.res}

type
  TGraphicAccess = class(TGraphic);

  PPoints = ^TPoints;
  TPoints = array[0..0] of TPoint;

  TRGB = packed record
   R, G, B: Byte;
  end;

  TPCXHeader = record
    FileID: Byte;                      // $0A for PCX files, $CD for SCR files
    Version: Byte;                     // 0: version 2.5; 2: 2.8 with palette; 3: 2.8 w/o palette; 5: version 3
    Encoding: Byte;                    // 0: uncompressed; 1: RLE encoded
    BitsPerPixel: Byte;
    XMin,
    YMin,
    XMax,
    YMax,                              // coordinates of the corners of the image
    HRes,                              // horizontal resolution in dpi
    VRes: Word;                        // vertical resolution in dpi
    ColorMap: array[0..15] of TRGB;    // color table
    Reserved,
    ColorPlanes: Byte;                 // color planes (at most 4)
    BytesPerLine,                      // number of bytes of one line of one plane
    PaletteType: Word;                 // 1: color or b&w; 2: gray scale
    Fill: array[0..57] of Byte;
  end;

const
  MSImg32Lib: THandle = 0;

{ Color function }

function KColor(Color: TColor; A: Byte = $FF): TKColor;
var
  C: TColor;
begin
  if Color < 0 then
    Color := ColorToRGB(Color);
    
  Result := ColorSwap(Color) or (A shl 24);
end;

function KColor(R, G, B: SmallInt; A: Byte = $FF): TKColor;
begin
  if R > $FF then R := $FF;
  if G > $FF then G := $FF;
  if B > $FF then B := $FF;
  if R < 0 then R := 0;
  if G < 0 then G := 0;
  if B < 0 then B := 0;

  Result := (A shl 24) or (R shl 16) or (G shl 8) or B;
end;

function KColor(ColorRec: TKColorRec): TKColor;
begin
  Result := TKColor(ColorRec);
end;

function KColorToColor(Color: TKColor): TColor;
begin
  with TKColorRec(Color) do
    Result := RGB(R, G, B);
end;

function RaisedColor(Color: TKColor; DR, DG, DB: byte; DA: byte = 0): TKColor;
begin
  with TKColorRec(Color) do
    Result := KColor(R + DR, G + DG, B + DB, A + DA);
end;

function SunkenColor(Color: TKColor; DR, DG, DB: byte; DA: byte = 0): TKColor;
begin
  with TKColorRec(Color) do
    Result := KColor(R - DR, G - DG, B - DB, A - DA);
end;

function RaisedColor(Color: TKColor; Dx: byte): TKColor;
begin
  Result := RaisedColor(Color, Dx, Dx, Dx);
end;

function SunkenColor(Color: TKColor; Dx: byte): TKColor;
begin
  Result := SunkenColor(Color, Dx, Dx, Dx);
end;

{ Color space conversions }

function HSLtoRGB(H, S, L: Single): TKColor;
var
  M1, M2: Single;
  R, G, B: Byte;

  function HueToColor(Hue: Single): Byte;
  var
    V: Double;
  begin
    Hue := Hue - Floor(Hue);

    if 6 * Hue < 1 then V := M1 + (M2 - M1) * Hue * 6
    else if 2 * Hue < 1 then V := M2
    else if 3 * Hue < 2 then V := M1 + (M2 - M1) * (2 / 3 - Hue) * 6
    else V := M1;
    Result := Round(255 * V);
  end;
begin
  if S = 0 then
  begin
    R := Round(255 * L);
    G := R;
    B := R;
  end
  else
  begin
    if L <= 0.5 then M2 := L * (1 + S)
    else M2 := L + S - L * S;
    M1 := 2 * L - M2;
    R := HueToColor(H + 1 / 3);
    G := HueToColor(H);
    B := HueToColor(H - 1 / 3)
  end;
  Result := KColor(R, G, B);
end;

procedure RGBtoHSL(RGB: TKColor; out H, S, L: single);
var
  R, G, B, D, Cmax, Cmin: Single;
begin
  R := TKColorRec(RGB).R / 255;
  G := TKColorRec(RGB).G / 255;
  B := TKColorRec(RGB).B / 255;
  Cmax := Max(R, Max(G, B));
  Cmin := Min(R, Min(G, B));
  L := (Cmax + Cmin) / 2;

  if Cmax = Cmin then
  begin
    H := 0;
    S := 0
  end
  else
  begin
    D := Cmax - Cmin;
    if L < 0.5 then S := D / (Cmax + Cmin)
    else S := D / (2 - Cmax - Cmin);
    if R = Cmax then H := (G - B) / D
    else
      if G = Cmax then H  := 2 + (B - R) /D
      else H := 4 + (R - G) / D;
    H := H / 6;
    if H < 0 then H := H + 1
  end;
end;

function ChangeHue(Color: TKColor; DeltaHue: integer): TKColor;
var
  H, S, L: single;
  HValue: integer;
begin
  RGBtoHSL(Result, H, S, L);

  HValue := Round(H * 255);
  Inc(HValue, DeltaHue);

  if HValue > 255 then HValue := HValue - 255;
  if HValue < 0 then HValue := 255 + HValue;

  Result := HSLtoRGB(HValue / 255, S, L);
end;

function ChangeBrightness(Color: TKColor; DeltaBrightness: integer): TKColor;
var
  R, G, B: integer;
begin
  R := TKColorRec(Color).R;
  G := TKColorRec(Color).G;
  B := TKColorRec(Color).B;

  Inc(R, DeltaBrightness);
  Inc(G, DeltaBrightness);
  Inc(B, DeltaBrightness);

  Result := KColor(R, G, B);
end;

procedure _AlphaBlendFunc(DstDC: HDC; DstX, DstY, DstW, DstH: Integer;
  SrcBmp: TTeBitmap; SrcX, SrcY, SrcW, SrcH: Integer);
var
  SrcRect, DstRect: TRect;
  R: TRect;
  SFX, SFY: integer;
  SX, SY: integer;
  DX, DY: integer;
  FP, F, B: PKColor;
  ResBmp: TTeBitmap;
  Alpha: byte;
begin
  { Stretch }
  SrcRect := Rect(SrcX, SrcY, SrcX + SrcW, SrcY + SrcH);
  DstRect := Rect(DstX, DstY, DstX + DstW, DstY + DstH);

  IntersectRect(R, SrcRect, Rect(0, 0, SrcBmp.FWidth, SrcBmp.FHeight));
  if (RectWidth(R) <= 0) or (RectHeight(R) <= 0) then Exit;
  if (RectWidth(DstRect) <= 0) or (RectHeight(DstRect) <= 0) then Exit;
  IntersectRect(R, DstRect, DstRect);
  if (RectWidth(R) <= 0) or (RectHeight(R) <= 0) then Exit;

  if (SrcW = DstW) and (SrcH = DstH) then
  begin
    { No stretch }
    ResBmp := TTeBitmap.Create;
    ResBmp.SetSize(DstW, DstH);

    { Copy from DstDC  }
    StretchBlt(ResBmp.DC, 0, 0, DstW, DstH, DstDC, DstX, DstY, DstW, DstH, SRCCOPY);

    { Draw transparent }
    F := @SrcBmp.Bits[SrcRect.Left + SrcRect.Top * SrcBmp.Width];
    B := @ResBmp.Bits[0];
    for DstY := 0 to ResBmp.Height - 1 do
    begin
      BlendLine(F, B, ResBmp.Width);
      Inc(F, SrcBmp.Width);
      Inc(B, ResBmp.Width);
    end;

    BitBlt(DstDC, DstRect.Left, DstRect.Top, DstW, DstH, ResBmp.DC, 0, 0, SRCCOPY);

    ResBmp.Free;
    Exit;
  end;

  { Stretch }
  ResBmp := TTeBitmap.Create;
  ResBmp.SetSize(DstW, DstH);

  { Copy from DstDC  }
  StretchBlt(ResBmp.DC, 0, 0, DstW, DstH, DstDC, DstX, DstY, DstW, DstH, SRCCOPY);

  { Draw bitmap transparent to ResBmp }
  SFX := MulDiv((R.Left - DstRect.Left) * SrcW, 65535, DstW);
  SFY := MulDiv((R.Top - DstRect.Top) * SrcH, 65535, DstH);

  DX := (SrcW shl 16) div DstW;
  DY := (SrcH shl 16) div DstH;
  SY := SFY;

  for DstY := R.Top to R.Bottom - 1 do
  begin
    F := @SrcBmp.Bits[SrcRect.Left + (SY shr 16 + SrcRect.Top) * SrcBmp.FWidth];
    B := @ResBmp.Bits[((DstY - R.Top) * ResBmp.FWidth)];
    SX := SFX;
    for DstX := R.Left to R.Right - 1 do
    begin
      SrcX := SX shr 14 and $FFFFFFFC;
      Inc(SX, DX);
      { Get fore pixel }
      FP := PKColor(Integer(F) + SrcX);
      { Blending }
      Alpha := FP^ shr 24;
      if Alpha = 0 then
        // Skip
      else
        if Alpha = $FF then
          B^ := FP^
        else
          B^ := BlendPixel(FP^, B^);

      Inc(B);
    end;
    Inc(SY, DY);
  end;

  { Draw ResBmp }
  StretchBlt(DstDC, DstRect.Left, DstRect.Top, DstW, DstH, ResBmp.DC, 0, 0, DstW, DstH, SRCCOPY);

  ResBmp.Free;
end;

procedure _TransparentBltFunc(DstDC: HDC; DstX, DstY, DstW, DstH: Integer;
  SrcBmp: TTeBitmap; SrcX, SrcY, SrcW, SrcH: Integer; TransparentColor: TKColor);
var
  SrcRect, DstRect: TRect;
  R: TRect;
  SFX, SFY: integer;
  SX, SY: integer;
  DX, DY: integer;
  FP, F, B: PKColor;
  ResBmp: TTeBitmap;
begin
  { Stretch }
  SrcRect := Rect(SrcX, SrcY, SrcX + SrcW, SrcY + SrcH);
  DstRect := Rect(DstX, DstY, DstX + DstW, DstY + DstH);

  IntersectRect(R, SrcRect, Rect(0, 0, SrcBmp.FWidth, SrcBmp.FHeight));
  if (RectWidth(R) <= 0) or (RectHeight(R) <= 0) then Exit;
  if (RectWidth(DstRect) <= 0) or (RectHeight(DstRect) <= 0) then Exit;
  IntersectRect(R, DstRect, DstRect);
  if (RectWidth(R) <= 0) or (RectHeight(R) <= 0) then Exit;

  if (SrcW = DstW) and (SrcH = DstH) then
  begin
    { No stretch }
    ResBmp := TTeBitmap.Create;
    ResBmp.SetSize(DstW, DstH);

    { Copy DstDC  }
    StretchBlt(ResBmp.DC, 0, 0, DstW, DstH, DstDC, DstX, DstY, DstW, DstH, SRCCOPY);

    { Draw transparent }
    B := @ResBmp.Bits[0];

    for DstY := 0 to ResBmp.Height - 1 do
    begin
      F := @SrcBmp.Bits[SrcRect.Left + (SrcRect.Top + DstY) * SrcBmp.Width];
      for DstX := 0 to ResBmp.Width - 1 do
      begin
        if (F^ and not $FF000000) <> TransparentColor then
          B^ := F^;

        Inc(F);
        Inc(B);
      end;
    end;

    ResBmp.Draw(DstDC, DstRect.Left, DstRect.Top, false);

    ResBmp.Free;
    Exit;
  end;

  { Stretch }
  ResBmp := TTeBitmap.Create;
  ResBmp.SetSize(DstW, DstH);

  { Copy DstDC  }
  StretchBlt(ResBmp.DC, 0, 0, DstW, DstH, DstDC, DstX, DstY, DstW, DstH, SRCCOPY);

  { Draw bitmap transparent to ResBmp }
  SFX := MulDiv((R.Left - DstRect.Left) * SrcW, 65535, DstW);
  SFY := MulDiv((R.Top - DstRect.Top) * SrcH, 65535, DstH);

  DX := (SrcW shl 16) div DstW;
  DY := (SrcH shl 16) div DstH;
  SY := SFY;

  for DstY := R.Top to R.Bottom - 1 do
  begin
    F := @SrcBmp.Bits[SrcRect.Left + (SY shr 16 + SrcRect.Top) * SrcBmp.FWidth];
    B := @ResBmp.Bits[((DstY - R.Top) * ResBmp.FWidth)];
    SX := SFX;
    for DstX := R.Left to R.Right - 1 do
    begin
      SrcX := SX shr 14 and $FFFFFFFC;
      Inc(SX, DX);
      { Get fore pixel }
      FP := PKColor(Integer(F) + SrcX);
      { Set }
      if (FP^ and not $FF000000) <> TransparentColor then
        B^ := FP^;

      Inc(B);
    end;
    Inc(SY, DY);
  end;

  { Draw ResBmp }
  ResBmp.Draw(DstDC, DstRect.Left, DstRect.Top, false);

  ResBmp.Free;
end;

function GetBitmapBitsFromDeviceContext(DC: HDC; var Width, Height, BitCount: Integer): Pointer;
var
  Bitmap: HBITMAP;
  DIB: TDIBSection;
begin
  Result := nil;
  Width := 0;
  Height := 0;
  BitCount := 0;

  Bitmap := GetCurrentObject(DC, OBJ_BITMAP);
  if Bitmap <> 0 then
  begin
    if GetObject(Bitmap, SizeOf(DIB), @DIB) = SizeOf(DIB) then
    begin
      Result := DIB.dsBm.bmBits;
      Width := DIB.dsBmih.biWidth;
      Height := Abs(DIB.dsBmih.biHeight);
      BitCount := DIB.dsBmih.biBitCount;
    end;
  end;
end;

