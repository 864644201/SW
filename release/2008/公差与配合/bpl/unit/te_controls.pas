procedure TTeHintWindow.CMTextChanged(var Message: TMessage);
begin
  inherited;
  { Avoid flicker when calling ActivateHint }
  if FActivating then Exit;
  Width := Canvas.TextWidth(Caption) + 30;
  Height := Canvas.TextHeight(Caption) + 20;
end;

procedure TTeHintWindow.ActivateHint(Rect: TRect; const AHint: string);
var
  Rgn: HRgn;
begin
  if (csDesigning in ComponentState) then Exit;
  
  FActivating := True;
  try
    Caption := AHint;
    UpdateBoundsRect(Rect);

    if Rect.Top + Height > Screen.DesktopHeight then
      Rect.Top := Screen.DesktopHeight - Height;
    if Rect.Left + Width > Screen.DesktopWidth then
      Rect.Left := Screen.DesktopWidth - Width;
    if Rect.Left < Screen.DesktopLeft then Rect.Left := Screen.DesktopLeft;
    if Rect.Bottom < Screen.DesktopTop then Rect.Bottom := Screen.DesktopTop;

    { Set KsForm Property }
    if FHint <> nil then
    begin
      FForm.Blending := FHint.Blending;
      FForm.Shadow := FHint.Shadow;
      FForm.Animation := FHint.Animation;
      FForm.Loaded;
    end;

    { Show }
    SetWindowPos(Handle, HWND_TOPMOST, Rect.Left, Rect.Top, Width, Height,
      SWP_NOACTIVATE);
    SetWindowPos(Handle, HWND_TOPMOST, Rect.Left, Rect.Top, Width, Height,
      SWP_SHOWWINDOW or SWP_NOACTIVATE);
  finally
    FActivating := False;
  end;
end;

procedure TTeHintWindow.ActivateHintData(Rect: TRect; const AHint: string; AData: Pointer);
begin
  if (csDesigning in ComponentState) then Exit;
  
  ActivateHint(Rect, AHint);
  if (AData <> nil) and (TObject(AData) is TTeCustomHint) then
    FHint := TTeCustomHint(AData)
  else
    FHint := nil;
end;

function TTeHintWindow.CalcHintRect(MaxWidth: Integer; const AHint: string; AData: Pointer): TRect;
begin
  if (csDesigning in ComponentState) then Exit;
  
  if (FHint = nil) and (VarHint <> nil) then
    FHint := VarHint;

  if (AData <> nil) and (TObject(AData) is TTeCustomHint) then
    FHint := TTeCustomHint(AData)
  else
    FHint := nil;

  if FHint <> nil then
  begin
    Canvas.Font.Assign(HintFont);
    Result := FHint.GetHintBounds(Canvas, AHint);
  end;
end;

