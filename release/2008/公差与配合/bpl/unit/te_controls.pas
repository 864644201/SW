    if (Sender is TTeCustomButton) or (Sender is TButton) then
    begin
      if FActiveDefault then
      begin
        FActiveDefault := false;
        Invalidate;
      end;
    end
    else
    begin
      if FActiveDefault <> FDefault then
      begin
        FActiveDefault := FDefault;
        Invalidate;
      end;
    end
  end;

