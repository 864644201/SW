procedure TTeCustomControl.WMEraseBkgnd(var Msg: TWmEraseBkgnd);
var
  SavedDC, PaintDC: HDC;
  DoubleBuffer: TTeBitmap;
  R: TRect;
  SaveIndex: integer;
begin
  if (Msg.DC <> 0) then
  begin
    PaintDC := Msg.DC;
    if (Pointer(Msg.Unused) <> nil) then
    begin
      { Paint background for children }
      Canvas.Lock;
      try
        SavedDC := Canvas.Handle;
        Canvas.Handle := Msg.DC;

        { Draw parent background }
        if FTransparent then PaintOwnerBackground(Canvas.Handle);

        PaintBorder;
        if ScrollBars = ssBoth then
          with GetClientRect do
            IntersectClipRect(Canvas.Handle, Left, Top, Right, Bottom);
        PaintBuffer;

        Canvas.Handle := SavedDC;
      finally
        Canvas.Unlock;
      end;
    end
    else
    begin
      { No action }
      if csDesigning in ComponentState then
        if FTransparent then PaintOwnerBackground(Msg.DC);
    end;
  end;

  Msg.Result := 1;
end;

procedure TTeCustomControl.Paint;
var
  SavedDC: HDC;
  DoubleBuffer: TTeBitmap;
  R: TRect;
  SaveIndex: integer;
begin
  if (Width <= 0) or (Height <= 0) then Exit;
  { Normal paint }
  DoubleBuffer := nil;
  SavedDC := Canvas.Handle;
  try
    { Change Canvas }
    case FPerformance of
      kspSharedBuffer:
        begin
          if SharedBuffer.Empty then InitSharedBuffer;
          SharedBuffer.FillRect(Rect(0, 0, FWidth, FHeight), ckTransparent);
          Canvas.Handle := SharedBuffer.DC;
        end;
      kspDoubleBuffer:
        begin
          DoubleBuffer := TTeBitmap.Create;
          DoubleBuffer.SetSize(FWidth, FHeight);
          DoubleBuffer.Clear(ckTransparent);

          Canvas.Handle := DoubleBuffer.DC;
        end;
    end;

    { Assign props }
    FFont.Assign(Self.Font);

    { Paint background }
    if FTransparent then PaintOwnerBackground(Canvas.Handle);

    { Paint border }
    R := GetBorderRect;
    if ScrollBars = ssBoth then
    begin
      R.Right := GetClientRect.Right;
      R.Bottom := GetClientRect.Bottom;
    end;

    with R do
    begin
      SaveIndex := SaveDC(Canvas.Handle);
      ExcludeClipRect(Canvas.Handle, Left, Top, Right, Bottom);
      PaintBorder;
      RestoreDC(Canvas.Handle, SaveIndex);
    end;

    if ScrollBars = ssBoth then
      with GetClientRect do
        IntersectClipRect(Canvas.Handle, Left, Top, Right, Bottom);
    PaintBuffer;

    { Blending }
    if FBlending.Enabled and (FPerformance <> kspNoBuffer) then
    begin
      { Paint to Back }
      FBack.SetSize(FWidth, FHeight);
      FBack.SetAlpha(255);
      { Paing owner }
      PaintOwnerBackground(FBack.DC);
      { Blending }
      case FPerformance of
        kspSharedBuffer:
          begin
            R := Rect(0, 0, FWidth, FHeight);
            SharedBuffer.SetAlpha(FBlending.Value, R);
            SharedBuffer.MergeDraw(FBack, 0, 0, R);
          end;
        kspDoubleBuffer:
          begin
            DoubleBuffer.SetAlpha(FBlending.Value);
            DoubleBuffer.MergeDraw(FBack, 0, 0, Rect(0, 0, FWidth, FHeight));
          end;
      end;
    end;

    { Paint from buffer }
    case FPerformance of
      kspSharedBuffer:
        begin
          SharedBuffer.Draw(SavedDC, 0, 0, Rect(0, 0, FWidth, FHeight));
        end;
      kspDoubleBuffer:
        begin
          DoubleBuffer.Draw(SavedDC, 0, 0);
        end;
    end;
  finally
    Canvas.Handle := SavedDC;

    if Performance = kspDoubleBuffer then
      DoubleBuffer.Free;
  end;
end;

