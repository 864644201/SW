{$IFDEF KS_COMPILER5_UP}

procedure TTeFrame.PaintOwnerBackground(DC: HDC);
var
  P: TPoint;
  i, SaveIndex: Integer;
  EBInfo: TEraseBackgroundInfo;
  TempCanvas: TCanvas;
begin
  if Parent = nil then Exit;

  { Paint Owner Background }
  SaveIndex := SaveDC(DC);
  try
    P := ClientOrigin;
    if csDesigning in ComponentState then
    begin
      { DesignTime }
      Windows.ScreenToClient(Parent.Handle, P);
      MoveWindowOrg(DC, -P.X, -P.Y);

      if Parent is TCustomForm then
      begin
        TempCanvas := TCanvas.Create;
        TempCanvas.Handle := DC;
        FillRect(TempCanvas, Rect(0, 0, TCustomForm(Parent).Width,
          TCustomForm(Parent).Height), TForm(Parent).Color);
        TempCanvas.Handle := 0;
        TempCanvas.Free;
      end
      else
      begin
        EBInfo.Action := keaPaintBackground;
        EBInfo.Rect := BoundsRect;
        Parent.Perform(WM_ERASEBKGND, DC, Integer(@EBInfo));
      end;
      MoveWindowOrg(DC, P.X, P.Y);
    end
    else
    begin
      { RunTime }
        Windows.ScreenToClient(Parent.Handle, P);
        MoveWindowOrg(DC, -P.X, -P.Y);

        EBInfo.Action := keaPaintBackground;
        EBInfo.Rect := BoundsRect;
        if Parent is TCustomForm then
          SendMessage(Parent.Handle, WM_ERASEBKGND, DC, Integer(@EBInfo))
        else
          Parent.Perform(WM_ERASEBKGND, DC, Integer(@EBInfo));

        MoveWindowOrg(DC, P.X, P.Y);
    end;
  finally
    RestoreDC(DC, SaveIndex);
  end;
end;

procedure TTeFrame.PerformEraseBackground(Control: TControl; DC: HDC);
var
  LastOrigin: TPoint;
begin
  GetWindowOrgEx(DC, LastOrigin);
  SetWindowOrgEx(DC, LastOrigin.X + Control.Left, LastOrigin.Y + Control.Top, nil);
  Control.Parent.Perform(WM_ERASEBKGND, Integer(DC), Integer(DC));
  SetWindowOrgEx(DC, LastOrigin.X, LastOrigin.Y, nil);
end;

procedure TTeFrame.WMEraseBkgnd(var Msg: TWmEraseBkgnd);
begin
  with TWMEraseBkGnd(Msg) do
  begin
    if (Parent <> nil) and Parent.DoubleBuffered then
      PerformEraseBackground(Self, DC)
    else
    begin
      PaintOwnerBackground(DC);
    end;
    Result := 1;
  end;
end;

procedure TTeFrame.WMPaint(var Msg: TMessage);
var
  PS: TPaintStruct;
begin
  BeginPaint(Handle, PS);
  PaintControls(PS.hdc, nil);
  EndPaint(Handle, PS);
  Msg.Result := 0;
end;
