procedure TTeCustomRangeBar.SetMax(const Value: integer);
begin
  if FMax <> Value then
  begin
    FMax := Value;
    if HighPosition > FMax then
      HighPosition := FMax;
    Invalidate;
  end;
end;

procedure TTeCustomRangeBar.SetMin(const Value: integer);
begin
  if FMin <> Value then
  begin
    FMin := Value;
    if LowPosition < FMin then
      LowPosition := FMin;
    Invalidate;
  end;
end;

procedure TTeCustomRangeBar.SetOrientation(const Value: TTrackOrientation);
var
  TmpValue: integer;
begin
  if FOrientation <> Value then
  begin
    FOrientation := Value;
    if (csDesigning in ComponentState)
      and (((FOrientation = toHorizontal) and (Height > Width))
      or ((FOrientation = toVertical) and (Height < Width))) then
    begin
      TmpValue := Width;
      Width := Height;
      Height := TmpValue;
    end;
    Invalidate;
  end;
end;

procedure TTeCustomRangeBar.SetShowTicks(const Value: boolean);
begin
  if FShowTicks <> Value then
  begin
    FShowTicks := Value;
    Invalidate;
  end;
end;

procedure TTeCustomRangeBar.SetTickMarks(const Value: TTickMark);
begin
  if Value <> FTickMarks then
  begin
    FTickMarks := Value;
    Invalidate;
  end;
end;

procedure TTeCustomRangeBar.SetLineSize(const Value: Integer);
begin
  if FLineSize <> Value then
    FLineSize := Value;
end;

procedure TTeCustomRangeBar.SetPageSize(const Value: Integer);
begin
  FPageSize := Value;
end;

procedure TTeCustomRangeBar.SetFrequency(const Value: Integer);
begin
  if FFrequency <> Value then
  begin
    FFrequency := Value;
    Invalidate;
  end;
end;

procedure TTeCustomRangeBar.SetHighPosition(const Value: integer);
begin
  if FHighPosition <> Value then
  begin
    if Value > FMax then
      FHighPosition := FMax
    else
      if Value < FMin then
      FHighPosition := FMin
    else
      FHighPosition := Value;
    if FHighPosition < FLowPosition then
      LowPosition := FHighPosition;
    Invalidate;
    HighChange;
  end;
end;

procedure TTeCustomRangeBar.SetLowPosition(const Value: integer);
begin
  if FLowPosition <> Value then
  begin
    if Value > FMax then
      FLowPosition := FMax
    else
      if Value < FMin then
      FLowPosition := FMin
    else
      FLowPosition := Value;
    if FLowPosition > FHighPosition then
      HighPosition := FLowPosition;
    Invalidate;
    LowChange;
  end;
end;

