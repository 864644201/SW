begin

end;

procedure TTeCustomControl.InvalidateRect(ARect: TRect);
var
  R: TRect;
begin
  R := ARect;
  Windows.InvalidateRect(Handle, @R, false);
end;

procedure TTeCustomControl.InvalidateBorder;
var
  BorderRect, R: TRect;
begin
  BorderRect := GetBorderRect;
  if CompareRect(BorderRect, Rect(0, 0, FWidth, FHeight)) then Exit;

  with BorderRect do
  begin
    { Left }
    R := Rect(0, 0, Left, FHeight);
    Windows.InvalidateRect(Handle, @R, false);
    { Top }
    R := Rect(Left, 0, Right, Top);
    Windows.InvalidateRect(Handle, @R, false);
    { Right }
    R := Rect(Right, 0, FWidth, FHeight);
    Windows.InvalidateRect(Handle, @R, false);
    { Right }
    R := Rect(Left, Bottom, Right, FHeight);
    Windows.InvalidateRect(Handle, @R, false);

    if ScrollBars = ssBoth then
    begin
      { Right }
      R := Rect(Right - 20, Bottom - 20, Right, Bottom);
      Windows.InvalidateRect(Handle, @R, false);
    end;
  end;
end;

procedure TTeCustomControl.PaintBorder;
var
  R: TRect;
  RColor, SColor: TColor;
  i: integer;
  Theme: HTheme;
  Part, ThemeState: integer;
  SaveIndex: integer;
begin
  R := Rect(0, 0, FWidth, FHeight);
  if ScrollBars = ssBoth then
  begin
    if not UseThemes or not DrawXPBorder then
    begin
      { Default }
      FillRect(Canvas, Rect(Width - 20, Height - 20, Width, Height), Color);
    end
    else
    begin
      { XP }
      Theme := OpenThemeData(0, 'Edit');
      Part := integer(EP_EDITText);
      DrawThemeBackground(Theme, Canvas.Handle, Part, 0, Rect(Width - 20, Height - 20, Width, Height), nil);
      CloseThemeData(Theme);
    end;
  end;
  if CompareRect(GetBorderRect, R) then Exit;

  if not UseThemes or not DrawXPBorder then
  begin
    { Draw bevel }
    if FBevelWidth > 0 then
    begin
      { Outer bevel }
      if FBevelOuter <> kbvNone then
      begin
        RColor := OuterBevelRaisedColor[FBevelOuter];
        SColor := OuterBevelSunkenColor[FBevelOuter];
        DrawBevel(Canvas, R, FBevelSides, FBevelWidth, RColor, SColor);
      end;
      { Inner Bevel }
      if FBevelInner <> kbvNone then
      begin
        RColor := InnerBevelRaisedColor[FBevelInner];
        SColor := InnerBevelSunkenColor[FBevelInner];
        DrawBevel(Canvas, R, FBevelSides, FBevelWidth, RColor, SColor);
      end;
    end;

    { Draw border area }
    for i := 0 to FBorderWidth - 1 do
    begin
      DrawRect(Canvas, R, Color);
      InflateRect(R, -1, -1);
    end;
  end
  else
  begin
    { XP Style }
    Theme := OpenThemeData(0, 'Edit');
    Part := integer(EP_EDITText);

    if not Enabled then
      ThemeState := integer(ETS_DISABLED)
    else
      if Focused then
        ThemeState := integer(ETS_SELECTED)
      else
        if FMouseInControl then
          ThemeState := integer(ETS_HOT)
        else
          ThemeState := integer(ETS_NORMAL);

    SaveIndex := SaveDC(Canvas.Handle);
    with GetBorderRect do
      ExcludeClipRect(Canvas.Handle, Left, Top, Right, Bottom);
    DrawThemeBackground(Theme, Canvas.Handle, Part, ThemeState, R, nil);
    RestoreDC(Canvas.Handle, SaveIndex);

    CloseThemeData(Theme);
  end;
end;

