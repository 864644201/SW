procedure TTeCustomEdit.PaintBuffer;
var
  R: TRect;
begin
  R := GetEditRect;
  R.Bottom := FHeight - R.Top;

  PaintBackground(R, Canvas);

  if (Self is TTeCustomComboBox) and (TTeCustomComboBox(Self).ComboStyle = kcsDropDownList) then Exit;
  
  if Focused or not HideSelection then
    FillRect(Canvas, GetSelRect, clHighlight);

  PaintText;

  if Focused or not HideSelection then
    PaintSelectedText;
