function TTeCustomPanel.GetCaptionRect: TRect;
begin
  Result := Rect(0, 0, FWidth, FHeight);

  if FShowBevel and not UseThemes then
    InflateRect(Result, -FBevelWidth, -FBevelWidth);

  Result.Bottom := Result.Top + FCaptionHeight;
end;

function TTeCustomPanel.GetButtonRect: TRect;
begin
  if FShowCaption and FShowButton then
  begin
    Result := GetCaptionRect;
    Result.Left := Result.Right - RectHeight(Result);
    InflateRect(Result, -2, -2);
  end
  else
    Result := Rect(0, 0, 0, 0);
end;

procedure TTeCustomPanel.DrawCaption;
var
  R: TRect;
  KindFlags, Flags: integer;
  Theme: HTheme;
  Part, tState: integer;
begin
  if not FShowCaption then Exit;

  R := GetCaptionRect;

  if not UseThemes then
  begin
    { Draw Caption }
    FillRect(Canvas, R, clBtnFace);
    DrawEdge(Canvas, R, clBtnHighlight, clBtnShadow);

    { Draw Text }
    InflateRect(R, -5, 0);
    Canvas.Font.Assign(Font);
    DrawText(Canvas, Caption, R, DrawTextBiDiModeFlags(DT_LEFT or DT_SINGLELINE or DT_VCENTER));
  end
  else
  begin
    { XP Style }
    Theme := OpenThemeData(0, 'ExplorerBar');

    Part := integer(EBP_NORMALGROUPHEAD);
    tState := 1;

    DrawThemeBackground(Theme, Canvas.Handle, Part, tState, R, nil);

    { Draw Text }
    InflateRect(R, -5, 0);
    DrawThemeText(Theme, Canvas.Handle, Part, tState, PWideChar(Caption), Length(Caption), DrawTextBiDiModeFlags(DT_LEFT or DT_SINGLELINE or DT_VCENTER), 0, R);

    CloseThemeData(Theme);
  end;

  { Draw Button }
  if not FShowButton then Exit;

  R := GetButtonRect;

  if not UseThemes then
  begin
    if FButtonKind = pbkHide then
    begin
      KindFlags := DFC_CAPTION;
      Flags := DFCS_CAPTIONCLOSE
    end
    else
    begin
      KindFlags := DFC_SCROLL;
      if FRolled then
        Flags := DFCS_SCROLLDOWN
      else
        Flags := DFCS_SCROLLUP;
    end;

    if ButtonPressed then
      DrawFrameControl(Canvas.Handle, R, KindFlags, Flags or DFCS_PUSHED)
    else
      DrawFrameControl(Canvas.Handle, R, KindFlags, Flags);

    { Draw Button Bevel }
    if ButtonPressed then
    begin
      { Pressed }
      DrawEdge(Canvas, R, clBtnShadow, clBtnHighlight);
      InflateRect(R, -1, -1);
      DrawRect(Canvas, R, clBtnFace);
    end
    else
      if MouseOnButton then
      begin
        { Rollover }
        DrawEdge(Canvas, R, clBtnHighlight, clBtnShadow);
        InflateRect(R, -1, -1);
        DrawRect(Canvas, R, clBtnFace);
      end
      else
      begin
        { Normal }
        DrawRect(Canvas, R, clBtnFace);
        InflateRect(R, -1, -1);
        DrawRect(Canvas, R, clBtnFace);
      end;
  end
  else
  begin
    { XP Style }
    Theme := OpenThemeData(0, 'ExplorerBar');

    if FButtonKind = pbkHide then
      Part := integer(EBP_HEADERCLOSE)
    else
      if FRolled then
        Part := integer(EBP_NORMALGROUPEXPAND)
      else
        Part := integer(EBP_NORMALGROUPCOLLAPSE);

    if ButtonPressed then
      tState := integer(EBHP_PRESSED)
    else
      if MouseOnButton then
        tState := integer(EBHP_HOT)
      else
        tState := integer(EBHP_NORMAL);

    DrawThemeBackground(Theme, Canvas.Handle, Part, tState, R, nil);

    CloseThemeData(Theme);
  end;
end;

procedure TTeCustomPanel.DrawFace;
var
  R: TRect;
  Theme: HTheme;
  Part, tState: integer;
begin
  R := Rect(0, 0, FWidth, FHeight);

  if not UseThemes then
  begin
    { Fill Back  }
    FillRect(Canvas, R, Color);

    { Draw Bevel }
    if FShowBevel then
    begin
      DrawEdge(Canvas, R, clBtnShadow, clBtnHighlight);
      InflateRect(R, -1, -1);
      DrawEdge(Canvas, R, clBtnHighlight, clBtnShadow);
    end;
  end
  else
  begin
    Theme := OpenThemeData(0, 'ExplorerBar');

    Part := integer(EBP_NORMALGROUPBACKGROUND);
    tState := 0;

    if FShowCaption then
      Inc(R.Top, CaptionHeight);
    DrawThemeBackground(Theme, Canvas.Handle, Part, tState, R, nil);

    CloseThemeData(Theme);
  end;
end;

procedure TTeCustomPanel.PaintBuffer;
var
  R: TRect;
  SaveIndex: integer;
begin
  if FShowCaption then
  begin
    R := GetCaptionRect;
    SaveIndex := SaveDC(Canvas.Handle);
    ExcludeClipRect(Canvas.Handle, R.Left, R.Top, R.Right, R.Bottom);
    DrawFace;
    RestoreDC(Canvas.Handle, SaveIndex);

    if not Transparent and UseThemes then
    begin
      SaveIndex := SaveDC(Canvas.Handle);
      IntersectClipRect(Canvas.Handle, R.Left, R.Top, R.Right, R.Bottom);
      PaintOwnerBackground(Canvas.Handle);
      RestoreDC(Canvas.Handle, SaveIndex);

      DrawCaption;
    end
    else
      DrawCaption;
  end
  else
    DrawFace;
end;

procedure TTeCustomPanel.DoButtonClick;
begin
  case FButtonKind of
    pbkHide: begin
      if Assigned(FOnHide) then
        FOnHide(Self);
      Hide;
    end;
    pbkRoll: Rolled := not Rolled;
  end;

  if Assigned(FOnButtonClick) then FOnButtonClick(Self);
end;

procedure TTeCustomPanel.RollDown;
var
  I: integer;
begin
  if Assigned(FOnBeforeRoll) then
    FOnBeforeRoll(Self);

  FRolled := false;

  if FAnimateRoll then
  begin
    for i := Height to FOldHeight do //Simple logic for Scrolling effect
    begin
      if (I mod 4) = 0 then Height:=I;
      if FParentRoll then
        Parent.Height:=Height;
    end;
  end;
  Height := FOldHeight;
  if FParentRoll then //just for safe
     Parent.Height := Height;

  if Assigned(FOnRollup) then
    FOnRollup(Self);
end;

procedure TTeCustomPanel.RollUp;
var
  I: integer;
begin
  if Assigned(FOnBeforeRoll) then
    FOnBeforeRoll(Self);

  FOldHeight := FHeight;

  if FAnimateRoll then
    for i := FOldHeight downto RectHeight(GetCaptionRect) + (FBevelWidth) * 2 do   // Simple Scrolling effect
    begin
      if(I mod 4) = 0 then Height := I;
      if FParentRoll then
        Parent.Height:=Height;
    end;

  Height := RectHeight(GetCaptionRect) + (FBevelWidth) * 2;

  if FParentRoll then
    Parent.Height := Height;

  FRolled := true;
  Invalidate;

  if Assigned(FOnRollup) then
    FOnRollup(Self);
end;

