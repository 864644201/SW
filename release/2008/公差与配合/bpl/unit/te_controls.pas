{ TTeCustomButton Methods =====================================================}

constructor TTeCustomButton.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);
  ControlStyle := [csCaptureMouse, csSetCaption, csDoubleClicks, csActionClient];
  Color := KColorToColor(ckBtnFace);
  Performance := kspDoubleBuffer;
  Transparent := false;
  TabStop := true;

  SetBounds(0, 0, 75, 25);

  FGlyph := TBitmap.Create;
  FGlyph.OnChange := GlyphChangedHandler;

  FNumGlyphs := 1;
  FKind := bkCustom;
  FLayout := blGlyphLeft;
  FSpacing := 4;
end;

destructor TTeCustomButton.Destroy;
begin
  FGlyph.Free;
  inherited Destroy;
end;

procedure TTeCustomButton.Loaded;
begin
  inherited Loaded;
  if not (csDesigning in ComponentState) then ActionChange(Action, True);
  Invalidate;
end;

function TTeCustomButton.IsGlyphStored: Boolean;
begin
   //Saves system resources!!!
   //We only storing Glyph bitmap, if it isn't come from an Action
   with TCustomAction(Action) do
   Result := not((Action <> nil) and (ActionList <> nil)
             and (ActionList.Images <> nil) and
             (ImageIndex >= 0) and (ImageIndex < ActionList.Images.Count));
end;

procedure TTeCustomButton.ActionChange(Sender: TObject; CheckDefaults: Boolean);

  procedure CopyImage(ImageList: TCustomImageList; Index: Integer);
  begin
    with Glyph do
    begin
      Width := ImageList.Width;
      Height := ImageList.Height;
      Canvas.Brush.Color := clFuchsia;
      Canvas.FillRect(Rect(0,0, Width, Height));
      ImageList.Draw(Canvas, 0, 0, Index);
    end;
  end;

begin
  inherited ActionChange(Sender, CheckDefaults);
  
  if Sender is TCustomAction then
  begin
    with TCustomAction(Sender) do
    begin
      { Copy image from action's imagelist }
      if (ActionList <> nil) and
         (ActionList.Images <> nil) and
         (ImageIndex >= 0) and
         (ImageIndex < ActionList.Images.Count) then
      begin
        CopyImage(ActionList.Images, ImageIndex);
      end;
      Self.Caption := Caption;
      Self.OnClick := OnExecute;
    end;
  end;
end;

procedure TTeCustomButton.GlyphChangedHandler(Sender: TObject);
var
  N: integer;
begin
  if (FGlyph.Height <> 0) and (FGlyph.Width mod FGlyph.Height = 0) then
  begin
    N := FGlyph.Width div FGlyph.Height;
    if N > 4 then
      N := 1;
    SetNumGlyphs(N);
  end;
  Invalidate;
end;

procedure TTeCustomButton.Click;
var
  Form: TCustomForm;
begin
  Form := GetParentForm(Self);
  if Form <> nil then
    Form.ModalResult := ModalResult;

  inherited Click;
end;

{ Button }

function TTeCustomButton.GetLayoutRect: TRect;
var
  B: TBitmap;
begin
  { Calc Rect }
  B := TBitmap.Create;
  try
    B.Canvas.Font.Assign(ControlFont);

    if FWordWrap then
      Result := Rect(0, 0, Width - 10 - FSpacing - GetGlyphSize.X, Height - 10 - FSpacing - GetGlyphSize.Y)
    else
      Result := Rect(0, 0, B.Canvas.TextWidth(Caption), B.Canvas.TextHeight(Caption));
      
    if (FGlyph <> nil) and not (FGlyph.Empty) then
    begin
      if FLayout in [blGlyphLeft, blGlyphRight] then
        Inc(Result.Right, FSpacing + GetGlyphSize.X)
      else
        Inc(Result.Bottom, FSpacing + GetGlyphSize.Y);

      If Result.Right < GetGlyphSize.X then
        Result.Right := GetGlyphSize.X;
      If Result.Bottom < GetGlyphSize.Y then
        Result.Bottom := GetGlyphSize.Y;
    end;

    { Centered }
    OffsetRect(Result, (FWidth - Result.Right) div 2, (FHeight - Result.Bottom) div 2);

    if FState = kbsPressed then
      OffsetRect(Result, 1, 1);
  finally
    B.Free;
  end;
end;

function TTeCustomButton.GetCaptionRect: TRect;
var
  GlyphSize: TPoint;
begin
  Result := GetLayoutRect;

  if FGlyph = nil then Exit;
  if FGlyph.Empty then
    Exit;

  GlyphSize := GetGlyphSize;
  case FLayout of
    blGlyphLeft: Inc(Result.Left, GlyphSize.X + FSpacing);
    blGlyphRight: Dec(Result.Right, GlyphSize.X + FSpacing);
    blGlyphTop: Inc(Result.Top, GlyphSize.Y + FSpacing);
    blGlyphBottom: Dec(Result.Bottom, GlyphSize.Y + FSpacing);
  end;
end;

function TTeCustomButton.GetGlyphSize: TPoint;
begin
  if FGlyph <> nil then
    Result := Point(FGlyph.Width div FNumGlyphs, FGlyph.Height)
  else
    Result := Point(0, 0);
end;

function TTeCustomButton.GetGlyphRect: TRect;
var
  GlyphSize: TPoint;
begin
  Result := GetLayoutRect;

  if FGlyph = nil then Exit;
  if FGlyph.Empty then
    Exit;

  GlyphSize := GetGlyphSize;
  case FLayout of
    blGlyphLeft: Result.Right := Result.Left + GlyphSize.X + FSpacing;
    blGlyphRight: Result.Left := Result.Right - GlyphSize.X - FSpacing;
    blGlyphTop: Result.Bottom := Result.Top + GlyphSize.Y + FSpacing;
    blGlyphBottom: Result.Top := Result.Bottom - GlyphSize.Y - FSpacing;
  end;
end;

{ Painting }

procedure TTeCustomButton.PaintFace;
var
  R: TRect;
  BackColor: TKColor;
  Theme: HTheme;
  Part, ThemeState: integer;
begin
  R := GetBorderRect;

  if not UseThemes then
  begin
    { Focused }
    if Focused or FActiveDefault then
    begin
      DrawEdge(Canvas, R, clBlack, clBlack);
      InflateRect(R, -1, -1);
    end;

    BackColor := Color;
    { Draw State }
    case FState of
      kbsNormal:
        begin
          FillRect(Canvas, R, BackColor);
          DrawEdge(Canvas, R, clBtnHighlight, clBlack);
          InflateRect(R, -1, -1);
          DrawEdge(Canvas, R, BackColor, clBtnShadow);
        end;
      kbsPressed:
        begin
          FillRect(Canvas, R, BackColor);
          DrawEdge(Canvas, R, clBtnShadow, clBtnShadow);
        end;
    end;
    { Draw Focus Rect }
    if Focused then
    begin
      R := GetBorderRect;
      InflateRect(R, -4, -4);
      DrawFocusRect(Canvas, R, clBtnShadow);
    end;
  end
  else
  begin
    { XP Style }
    Theme := OpenThemeData(0, 'Button');
    if Theme <> 0 then
    try
      Part := integer(BP_PUSHBUTTON);

    if not Enabled then
      ThemeState := integer(PBS_DISABLED)
    else
      if State = kbsPressed then
        ThemeState := integer(PBS_PRESSED)
      else
        if MouseInControl then
          ThemeState := integer(PBS_HOT)
        else
          if Focused then
            ThemeState := integer(PBS_DEFAULTED)
          else
            if ActiveDefault then
              ThemeState := integer(PBS_DEFAULTED)
            else
              ThemeState := integer(PBS_NORMAL);

      if not Transparent then
        PaintOwnerBackground(Canvas.Handle);
        
      DrawThemeBackground(Theme, Canvas.Handle, Part, ThemeState, R, nil);
    finally
      CloseThemeData(Theme);
    end;
  end;
end;

procedure TTeCustomButton.PaintGlyph;
var
  R: TRect;
  SrcRect: TRect;
  i, j, W, H: Integer;
  NewColor, TransparentColor: TColor;
  cH, cS, cL: single;
begin
  if FGlyph = nil then Exit;
  if FGlyph.Empty then Exit;

  R := Rect(0, 0, GetGlyphSize.X, GetGlyphSize.Y);
  OffsetRect(R, (RectWidth(GetGlyphRect) - R.Right) div 2, (RectHeight(GetGlyphRect) - R.Bottom) div 2);
  OffsetRect(R, GetGlyphRect.Left, GetGlyphRect.Top);

  W := FGlyph.Width div FNumGlyphs;
  H := FGlyph.Height;

  SrcRect := Rect(0, 0, W, H);

  if (FNumGlyphs > 1) and (not Enabled) then
    OffsetRect(SrcRect, W, 0);

  if (FNumGlyphs > 2) and (State = kbsPressed) then
    OffsetRect(SrcRect, W * 2, 0);

  TransparentColor := FGlyph.Canvas.Pixels[0, H - 1];

  { Copy to Buffer }
  for i := 0 to W-1 do
    for j := 0 to H-1 do
    begin
      NewColor := FGlyph.Canvas.Pixels[SrcRect.Left + i, SrcRect.Top + j];
      if (FBlackAndWhiteGlyph) and (not MouseInControl) and (NewColor <> TransparentColor) then
      begin
        RGBtoHSL(KColor(NewColor), cH, cS, cL);
        NewColor := RGB(Round(cL * $FF), Round(cL * $FF), Round(cL * $FF));
      end;
      if NumGlyphs = 1 then
      begin
        if (not Enabled) and (NewColor <> TransparentColor) then
        begin
          RGBtoHSL(KColor(NewColor), cH, cS, cL);
          NewColor := RGB(160+Round(cL * 50), 160+Round(cL * 50), 160+Round(cL * 50));
        end;
      end;
      if NewColor <> TransparentColor then
        Canvas.Pixels[R.Left + i, R.Top + j] := NewColor;
    end; 
end;

procedure TTeCustomButton.PaintText;
var
  R: TRect;
begin
  Canvas.Font := ControlFont;

  if FWordWrap then
    R := Rect(0, 0, RectWidth(GetCaptionRect), Canvas.TextHeight(Caption))
  else
    R := Rect(0, 0, Canvas.TextWidth(Caption), Canvas.TextHeight(Caption));
  DrawText(Canvas, Caption, R, DrawTextBiDiModeFlags(DT_CALCRECT or WordWraps[FWordWrap]));

  OffsetRect(R, (RectWidth(GetCaptionRect) - R.Right) div 2, (RectHeight(GetCaptionRect) - R.Bottom) div 2);
  OffsetRect(R, GetCaptionRect.Left, GetCaptionRect.Top);

  if not Enabled then
  begin
    Canvas.Font.Color := clBtnHighlight;
    OffsetRect(R, 1, 1);
    DrawText(Canvas, Caption, R, DT_CENTER or DrawTextBiDiModeFlags(WordWraps[FWordWrap]));
    OffsetRect(R, -1, -1);
    Canvas.Font.Color := clBtnShadow;
  end;

  { Draw Text }
  DrawText(Canvas, Caption, R, DT_CENTER or DrawTextBiDiModeFlags(WordWraps[FWordWrap]));
end;

{ Drawing }

