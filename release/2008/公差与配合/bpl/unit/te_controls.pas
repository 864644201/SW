procedure TTeCustomSpinEdit.SetValue(const NewValue: Extended);
var
  AllowChange: boolean;
  OldValue: Extended;

  procedure _SetValue(const _NewValue: Extended);
  begin
     if ValueType = vtFloat then
      Text := FloatToStrF(CheckValue(_NewValue), ffFixed, 15, FDecimal)
    else if ValueType = vtHex then
      Text := IntToHex(Round(CheckValue(_NewValue)), 1)
    else
      Text := IntToStr(Round(CheckValue(_NewValue)));
  end;

begin
  if Value <> NewValue then
  begin
    OldValue:=Value;

    FChanging := False;
    _SetValue(NewValue);
    FChanging := True;

    AllowChange := true;

    if Assigned(FOnChanging) then
    begin
      FOnChanging(Self, AllowChange);
      if not AllowChange then
        _SetValue(OldValue);
    end;
  end;
end;

procedure TTeCustomSpinEdit.SetValueType(const NewType: TTeSpinValueType);
begin
  if FValueType <> NewType then
  begin
    if not (csLoading in ComponentState) then
      if (FValueType = vtFloat) and (NewType={$IFDEF KS_CBUILDER}vtInt{$ELSE}vtInteger{$ENDIF}) then
        Text := IntToStr(Round(GetValue));
    FValueType := NewType;
    Value := GetValue;
    if FValueType in [{$IFDEF KS_CBUILDER} vtInt {$ELSE} vtInteger {$ENDIF}, vtHex] then
    begin
      FIncrement := Round(FIncrement);
      if FIncrement = 0 then FIncrement := 1;
    end;
  end;
end;



