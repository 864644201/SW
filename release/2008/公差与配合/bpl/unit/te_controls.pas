function TTeCustomForm.GetCaptionButtonRect(Button: TTeBorderIcon): TRect;
var
  CaptionRect, BtnRect, R: TRect;
  Pos: integer;
begin
  Result := Rect(0, 0, 0, 0);

  if not (Button in FBorderIcons) then Exit;

  { Default drawing }
  CaptionRect := GetClientBounds;

  CaptionRect.Bottom := CaptionRect.Top;
  CaptionRect.Top := DefaultBorderWidth + 1;

  if Button = kbiSystemMenu then
  begin
    Result := CaptionRect;
    Result.Right := Result.Left + RectHeight(CaptionRect);
    Exit;
  end;

  if UseThemes then
  begin
    { Calc Button size }
    BtnRect := Rect(0, 0, RectHeight(CaptionRect) - 4, RectHeight(CaptionRect) - 4);
    { Start button position }
    Pos := CaptionRect.Right - 2 - RectWidth(BtnRect);

    if FBorderStyle = kbsToolWindow then Inc(Pos, 2);

    Dec(CaptionRect.Top);
  end
  else
  begin
    { Calc Button size }
    BtnRect := Rect(0, 0, RectHeight(CaptionRect) - 2, RectHeight(CaptionRect) - 4);
    { Start button position }
    Pos := CaptionRect.Right - 2 - RectWidth(BtnRect);
  end;


  { Close Button }
  if kbiClose in FBorderIcons then
  begin
    R := BtnRect;
    OffsetRect(R, Pos, CaptionRect.Top + 2);

    if Button = kbiClose then
    begin
      Result := R;
      Exit;
    end;

    Dec(Pos, RectWidth(BtnRect) + 2);
  end;

  if FBorderStyle = kbsToolWindow then Exit;

  { Max Button }
  if (FWindowState <> kwsMinimized) and (kbiMaximize in FBorderIcons) then
  begin
    R := BtnRect;
    OffsetRect(R, Pos, CaptionRect.Top + 2);

    if Button = kbiMaximize then
    begin
      Result := R;
      Exit;
    end;

    Dec(Pos, RectWidth(BtnRect));
    if UseThemes then Dec(Pos, 2);
  end;

  { Min Button }
  if kbiMinimize in FBorderIcons then
  begin
    R := BtnRect;
    OffsetRect(R, Pos, CaptionRect.Top + 2);

    if Button = kbiMinimize then
    begin
      Result := R;
      Exit;
    end;

    Dec(Pos, RectWidth(BtnRect));
    if UseThemes then Dec(Pos, 2);
  end;

  { Roll Button }
  if (FWindowState <> kwsMinimized) and (kbiRollup in FBorderIcons) then
  begin
    if UseThemes then
    begin
      Result := Rect(0, 0, 0, 0);
      Exit; // ThemeAPI not allow to draw custom button
    end;

    if not UseThemes then Dec(Pos, 2);

    R := BtnRect;
    OffsetRect(R, Pos, CaptionRect.Top + 2);

    if Button = kbiRollup then
    begin
      Result := R;
      Exit;
    end;

    Dec(Pos, RectWidth(BtnRect));
    if UseThemes then Dec(Pos, 2);
  end;

  { Tray Button }
  if (FWindowState <> kwsMinimized) and (kbiTray in FBorderIcons) then
  begin
    if UseThemes then
    begin
      Result := Rect(0, 0, 0, 0);
      Exit; // ThemeAPI not allow to draw custom button
    end;

    R := BtnRect;
    OffsetRect(R, Pos, CaptionRect.Top + 2);

    if Button = kbiTray then
    begin
      Result := R;
      Exit;
    end;

    Dec(Pos, RectWidth(BtnRect));
    if UseThemes then Dec(Pos, 2);
  end;

  { Help Button }
  if (FWindowState <> kwsRollup) and (FWindowState <> kwsMinimized) and (kbiHelp in FBorderIcons) then
  begin
    Dec(Pos, 2);

    R := BtnRect;
    OffsetRect(R, Pos, CaptionRect.Top + 2);

    if Button = kbiHelp then
    begin
      Result := R;
      Exit;
    end;
  end;
end;

procedure TTeCustomForm.DrawCaptionButton(Canvas: TCanvas; R: TRect; Kind: TTeBorderIcon;
  Pressed, Hover: boolean);
var
  Flag: integer;
  Theme: HTheme;
  Part, State: integer;
begin
  if Form = nil then Exit;
  if RectWidth(R) = 0 then Exit;
  if (THackForm(Form).FormStyle = fsMDIChild) and (FWindowState = kwsMaximized) then Exit;

  Flag := 0;

  if Pressed then
  begin
    Flag := Flag or DFCS_PUSHED;
    State := integer(SBS_PUSHED);
  end
  else
    if Hover then
    begin
      Flag := Flag{ or DFCS_FLAT};
      State := integer(SBS_HOT);
    end
    else
      State := integer(SBS_NORMAL);

  if not FFormActive then State := 5;

  case Kind of
    kbiSystemMenu: DrawIcon(Canvas, R, GetIcon);
    kbiClose:
      begin
        if UseThemes then
        begin
          Theme := OpenThemeData(0, 'Window');
          Part := integer(WP_CLOSEBUTTON);
          DrawThemeBackground(Theme, Canvas.Handle, Part, State, R, nil);
          CloseThemeData(Theme);
        end
        else
          DrawFrameControl(Canvas.Handle, R, DFC_CAPTION, DFCS_CAPTIONCLOSE or Flag);
      end;
    kbiHelp:
      begin
        if UseThemes then
        begin
          Theme := OpenThemeData(0, 'Window');
          Part := integer(WP_HELPBUTTON);
          DrawThemeBackground(Theme, Canvas.Handle, Part, State, R, nil);
          CloseThemeData(Theme);
        end
        else
          DrawFrameControl(Canvas.Handle, R, DFC_CAPTION, DFCS_CAPTIONHELP or Flag);
      end;
    kbiMaximize:
      begin
        if FWindowState = kwsMaximized then
        begin
          if UseThemes then
          begin
            Theme := OpenThemeData(0, 'Window');
            Part := integer(WP_RESTOREBUTTON);
            DrawThemeBackground(Theme, Canvas.Handle, Part, State, R, nil);
            CloseThemeData(Theme);
          end
          else
            DrawFrameControl(Canvas.Handle, R, DFC_CAPTION, DFCS_CAPTIONRESTORE or Flag);
        end
        else
        begin
          if UseThemes then
          begin
            Theme := OpenThemeData(0, 'Window');
            Part := integer(WP_MAXBUTTON);
            DrawThemeBackground(Theme, Canvas.Handle, Part, State, R, nil);
            CloseThemeData(Theme);
          end
          else
            DrawFrameControl(Canvas.Handle, R, DFC_CAPTION, DFCS_CAPTIONMAX or Flag);
        end;
      end;
    kbiMinimize:
      begin
        if FWindowState = kwsMinimized then
        begin
          if UseThemes then
          begin
            Theme := OpenThemeData(0, 'Window');
            Part := integer(WP_RESTOREBUTTON);
            DrawThemeBackground(Theme, Canvas.Handle, Part, State, R, nil);
            CloseThemeData(Theme);
          end
          else
            DrawFrameControl(Canvas.Handle, R, DFC_CAPTION, DFCS_CAPTIONRESTORE or Flag)
        end
        else
        begin
          if UseThemes then
          begin
            Theme := OpenThemeData(0, 'Window');
            Part := integer(WP_MINBUTTON);
            DrawThemeBackground(Theme, Canvas.Handle, Part, State, R, nil);
            CloseThemeData(Theme);
          end
          else
            DrawFrameControl(Canvas.Handle, R, DFC_CAPTION, DFCS_CAPTIONMIN or Flag);
        end;
      end;
    kbiRollup:
      begin
        if UseThemes then
        begin
          Exit; // ThemeAPI not allow to draw custom button

          Theme := OpenThemeData(0, 'Window');
          Part := integer(WP_MINBUTTON);
          DrawThemeBackground(Theme, Canvas.Handle, Part, State, R, nil);
          DrawRect(Canvas, R, clRed);
          CloseThemeData(Theme);
        end
        else
        begin
          DrawFrameControl(Canvas.Handle, R, DFC_BUTTON, DFCS_BUTTONPUSH or Flag);
          { Draw Glyph }
          InflateRect(R, -4, -5);
          if not Pressed then
            OffsetRect(R, -1, -1);

          Canvas.Brush.Color := clBlack;
          Canvas.Pen.Color := clBlack;
          if FWindowState = kwsRollup then
          begin
            Canvas.Polygon([Point(R.Left, R.Top), Point(R.Right, R.Top),
              Point((R.Left + R.Right) div 2, R.Bottom)])
          end
          else
          begin
            Canvas.Polygon([Point(R.Left, R.Bottom), Point(R.Right, R.Bottom),
              Point((R.Left + R.Right) div 2, R.Top)])
          end;
        end;
      end;
    kbiTray:
      begin
        if UseThemes then
        begin
          Exit; // ThemeAPI not allow to draw custom button

          Theme := OpenThemeData(0, 'Window');
          Part := Integer(WP_MINBUTTON);
          DrawThemeBackground(Theme, Canvas.Handle, Part, State, R, nil);
          DrawRect(Canvas, R, clRed);
          CloseThemeData(Theme);
        end
        else
        begin
          DrawFrameControl(Canvas.Handle, R, DFC_BUTTON, DFCS_BUTTONPUSH or Flag);
          { Draw Glyph }
          InflateRect(R, -5, -5);
          OffsetRect(R, 0, 2);
          if Pressed then
            OffsetRect(R, 1, 1);

          Canvas.Brush.Color := clBlack;
          Canvas.Pen.Color := clBlack;
          Canvas.Ellipse(R.Left, R.Top, R.Right, R.Bottom);
        end;
      end;
  end;
end;

procedure TTeCustomForm.DrawCaption(Canvas: TCanvas);
var
  CaptionRect, R: TRect;
  Pressed, Hover: boolean;
  LeftColor, RightColor: TColor;
  S: WideString;
  Count: integer;
  Theme: HTheme;
  Part, State: integer;
begin
  { Paint Caption }
  CaptionRect := GetClientBounds;

  { Calc rects }
  CaptionRect.Bottom := CaptionRect.Top;
  CaptionRect.Top := DefaultBorderWidth;

  { Select font }
  if FBorderStyle = kbsToolWindow then
    Canvas.Font := SmCaptionFont
  else
    Canvas.Font := CaptionFont;

  { Calc Caption width }
  if (BorderStyle = kbsToolWindow) then
    S := FormatStr(Canvas.Handle, FCaption, FWidth - CaptionRect.Left - DefaultToolCaptionHeight * 2)
  else
  begin
    Count := 1;
    if kbiClose in BorderIcons then Inc(Count);
    if kbiMaximize in BorderIcons then Inc(Count);
    if kbiMinimize in BorderIcons then Inc(Count);
    if kbiHelp in BorderIcons then Inc(Count);
    if kbiRollup in BorderIcons then Inc(Count);
    if kbiTray in BorderIcons then Inc(Count);

    S := FormatStr(Canvas.Handle, Caption, FWidth - CaptionRect.Left - DefaultButtonHeight * Count)
  end;

  { Drawing }
  if not UseThemes then
  begin
    { Win9x style }

    { Draw Caption back }
    if FFormActive then
    begin
      LeftColor := GetSysColor(COLOR_ACTIVECAPTION);
      RightColor := GetSysColor(COLOR_GRADIENTACTIVECAPTION);
    end
    else
    begin
      LeftColor := GetSysColor(COLOR_INACTIVECAPTION);
      RightColor := GetSysColor(COLOR_GRADIENTINACTIVECAPTION);
    end;

    { Draw Gradient }
    FillGradientRect(Canvas, CaptionRect, LeftColor, RightColor, false);
  
    { Draw Text }
    if Form <> nil then
    begin
      if FFormActive then
        Canvas.Font.Color := clCaptionText
      else
        Canvas.Font.Color := clInactiveCaptionText;

      R := CaptionRect;

      if (FBorderStyle <> kbsToolWindow) and (kbiSystemMenu in FBorderIcons) then
        inc(R.Left, RectHeight(CaptionRect));

      { Draw text }
      Canvas.Brush.Style := bsClear;
      InflateRect(R, -2, 0);
      DrawText(Canvas, S, R, Form.DrawTextBiDiModeFlags(DT_LEFT or DT_VCENTER or DT_SINGLELINE));
    end;

  end
  else
  begin
    { WinXP Style }
    Theme := OpenThemeData(0, 'Window');

    { Caption }
    if FFormActive then
    begin
      State := integer(CS_ACTIVE);
      Canvas.Font.Color := GetThemeSysColor(Theme, clCaptionText);
      Canvas.Font.Color := clCaptionText;
    end
    else
    begin
      State := integer(CS_INACTIVE);
      Canvas.Font.Color := GetThemeSysColor(Theme, clInactiveCaptionText);
    end;

    R := CaptionRect;
    if (FBorderStyle <> kbsToolWindow) and (kbiSystemMenu in FBorderIcons) then
      inc(R.Left, RectHeight(CaptionRect));
    InflateRect(R, -2, 0);

    Part := integer(WP_CAPTION);
    DrawThemeText(Theme, Canvas.Handle, Part, State, PWideChar(S), Length(S), DT_SINGLELINE or DT_VCENTER, 0, R);
    DrawText(Canvas, S, R, DT_SINGLELINE or DT_VCENTER);

    CloseThemeData(Theme);
  end;

  { Paint Buttons }

  { Close Button }
  if kbiClose in FBorderIcons then
  begin
    R := GetCaptionButtonRect(kbiClose);

    Pressed := (ssLeft in FShift) and (FDownHitTest = khtCloseButton) and (FMoveHitTest = khtCloseButton);
    Hover := (FMoveHitTest = khtCloseButton) and not FDragged;
    DrawCaptionButton(Canvas, R, kbiClose, Pressed, Hover);
    { Draw Glyph }
  end;

  if FBorderStyle = kbsToolWindow then Exit;

  { Icon Button }
  if kbiSystemMenu in FBorderIcons then
  begin
    R := GetCaptionButtonRect(kbiSystemMenu);
    DrawCaptionButton(Canvas, R, kbiSystemMenu, false, false);
    { Draw Glyph }
  end;

  { Min Button }
  if kbiMinimize in FBorderIcons then
  begin
    R := GetCaptionButtonRect(kbiMinimize);

    Pressed := (ssLeft in FShift) and (FDownHitTest = khtMinButton) and (FMoveHitTest = khtMinButton);
    Hover := (FMoveHitTest = khtMinButton) and not FDragged;
    DrawCaptionButton(Canvas, R, kbiMinimize, Pressed, Hover);
  end;

  { Max Button }
  if kbiMaximize in FBorderIcons then
  begin
    R := GetCaptionButtonRect(kbiMaximize);

    Pressed := (ssLeft in FShift) and (FDownHitTest = khtMaxButton) and (FMoveHitTest = khtMaxButton);
    Hover := (FMoveHitTest = khtMaxButton) and not FDragged;
    DrawCaptionButton(Canvas, R, kbiMaximize, Pressed, Hover);
  end;

  { Roll Button }
  if kbiRollup in FBorderIcons then
  begin
    R := GetCaptionButtonRect(kbiRollup);

    Pressed := (ssLeft in FShift) and (FDownHitTest = khtRollButton) and (FMoveHitTest = khtRollButton);
    Hover := (FMoveHitTest = khtRollButton) and not FDragged;
    DrawCaptionButton(Canvas, R, kbiRollup, Pressed, Hover);
  end;

  { Tray Button }
  if kbiTray in FBorderIcons then
  begin
    R := GetCaptionButtonRect(kbiTray);

    Pressed := (ssLeft in FShift) and (FDownHitTest = khtTrayButton) and (FMoveHitTest = khtTrayButton);
    Hover := (FMoveHitTest = khtTrayButton) and not FDragged;
    DrawCaptionButton(Canvas, R, kbiTray, Pressed, Hover);
  end;

  { Help Button }
  if kbiHelp in FBorderIcons then
  begin
    R := GetCaptionButtonRect(kbiHelp);

    Pressed := (ssLeft in FShift) and (FDownHitTest = khtHelpButton) and (FMoveHitTest = khtHelpButton);
    Hover := (FMoveHitTest = khtHelpButton) and not FDragged;
    DrawCaptionButton(Canvas, R, kbiHelp, Pressed, Hover);
  end;
end;

procedure TTeCustomForm.PaintNonClientArea(Canvas: TCanvas);
var
  R: TRect;
  CaptionBuffer: TBitmap;
  Theme: HTheme;
  Part, State: integer;
begin
  if (FBorderStyle = kbsNone) and not FShadow.Enabled then Exit;

  { Paint NC Area }
  R := Rect(0, 0, FWidth, FHeight);

  { Draw Border }
  if not UseThemes then
  begin
    Windows.DrawEdge(Canvas.Handle, R, EDGE_RAISED, BF_RECT);
    InflateRect(R, -2, -2);

    { Draw caption }
    with GetClientBounds do
    begin
      { Left }
      FillRect(Canvas, R.Left, Top, Left, R.Bottom, clBtnFace);
      { Right }
      FillRect(Canvas, Right, Top, R.Right, R.Bottom, clBtnFace);
      { Bottom }
      FillRect(Canvas, R.Left, Bottom, R.Right, R.Bottom, clBtnFace);
      { Caption }
      if FPerformance = ksfpNoBuffer then
      begin
        { Buffering cpation }
        CaptionBuffer := TBitmap.Create;
        CaptionBuffer.Width := FWidth;
        CaptionBuffer.Height := Top;
        FillRect(CaptionBuffer.Canvas, R.Left, R.Top, R.Right, Top, clBtnFace);
        DrawCaption(CaptionBuffer.Canvas);
        Canvas.CopyRect(Rect(R.Left, R.Top, R.Right, Top), CaptionBuffer.Canvas, Rect(R.Left, R.Top, R.Right, Top));
        CaptionBuffer.Free;
      end
      else
      begin
        FillRect(Canvas, R.Left, R.Top, R.Right, Top, clBtnFace);
        DrawCaption(Canvas);
      end;
    end;
  end
  else
  begin
    { WinXP Style }
    Theme := OpenThemeData(0, 'Window');

    if FFormActive then
      State := integer(CS_ACTIVE)
    else
      State := integer(CS_INACTIVE);

    with GetClientBounds do
    begin
      case FBorderStyle of
        kbsStandard:
          begin
            { Left }
            Part := integer(WP_FRAMELEFT);
            DrawThemeBackground(Theme, Canvas.Handle, Part, State, Rect(R.Left, Top, Left, Bottom), nil);
            { Right }
            Part := integer(WP_FRAMERIGHT);
            DrawThemeBackground(Theme, Canvas.Handle, Part, State, Rect(Right, Top, R.Right, Bottom), nil);
            { Bottom }
            Part := integer(WP_FRAMEBOTTOM);
            DrawThemeBackground(Theme, Canvas.Handle, Part, State, Rect(R.Left, Bottom, R.Right, R.Bottom), nil);
            { Caption }
            Part := integer(WP_CAPTION);
            if FPerformance <> ksfpNoBuffer then
              DrawThemeBackground(Theme, Canvas.Handle, Part, State, Rect(R.Left, R.Top, R.Right, Top), nil);
          end;
        kbsToolWindow:
          begin
            { Left }
            Part := integer(WP_SMALLFRAMELEFT);
            DrawThemeBackground(Theme, Canvas.Handle, Part, State, Rect(R.Left, Top, Left, Bottom), nil);
            { Right }
            Part := integer(WP_SMALLFRAMERIGHT);
            DrawThemeBackground(Theme, Canvas.Handle, Part, State, Rect(Right, Top, R.Right, Bottom), nil);
            { Bottom }
            Part := integer(WP_SMALLFRAMEBOTTOM);
            DrawThemeBackground(Theme, Canvas.Handle, Part, State, Rect(R.Left, Bottom, R.Right, R.Bottom), nil);
            { Caption }
            Part := integer(WP_SMALLCAPTION);
            if FPerformance <> ksfpNoBuffer then
              DrawThemeBackground(Theme, Canvas.Handle, Part, State, Rect(R.Left, R.Top, R.Right, Top), nil);
          end;
      end;

      { Caption }
      if FPerformance = ksfpNoBuffer then
      begin
        { Buffering cpation }
        CaptionBuffer := TBitmap.Create;
        CaptionBuffer.Width := FWidth;
        CaptionBuffer.Height := Top;
        DrawThemeBackground(Theme, CaptionBuffer.Canvas.Handle, Part, State, Rect(R.Left, R.Top, R.Right, Top), nil);
        DrawCaption(CaptionBuffer.Canvas);
        Canvas.CopyRect(Rect(R.Left, R.Top, R.Right, Top), CaptionBuffer.Canvas, Rect(R.Left, R.Top, R.Right, Top));
        CaptionBuffer.Free;
      end
      else
      begin
        DrawCaption(Canvas);
      end;
    end;

    CloseThemeData(Theme);
  end;
end;

procedure TTeCustomForm.PaintClientArea;
var
  R: TRect;
  Color: TKColor;
begin
  { Paint Client Area }
  R := GetClientRect;

  { Default drawing }
  Canvas.Brush.Style := bsSolid;
  if Form <> nil then
    Canvas.Brush.Color := Form.Color;
  Canvas.FillRect(R);
end;

procedure TTeCustomForm.MoveWindow(OffsetX, OffsetY: integer);
var
  R: TRect;
begin
  if ((OffsetX <> 0) or (OffsetY <> 0)) and (Form <> nil) then
  begin
    R := Form.BoundsRect;
    with R do
      MoveWindow(Left + OffsetX, Top + OffsetY, FWidth, FHeight);
  end;
end;

procedure TTeCustomForm.MoveWindow(Left, Top, Width, Height: integer);
 procedure ProcessPaintMessages;
 { Dispatches all pending WM_PAINT messages. In effect, this is like an
   'UpdateWindow' on all visible windows }
 var
   Msg: TMsg;
 begin
   while PeekMessage(Msg, 0, WM_PAINT, WM_PAINT, PM_NOREMOVE) do
   begin
     case Integer(GetMessage(Msg, 0, WM_PAINT, WM_PAINT)) of
       -1: Break; { if GetMessage failed }
       0: begin
            { Repost WM_QUIT messages }
            PostQuitMessage(Msg.WParam);
            Break;
          end;
     end;
     DispatchMessage(Msg);
   end;
 end;

begin
  if Form <> nil then
  begin
    Form.BoundsRect := Rect(Left, Top, Left+Width, Top+Height);
    ProcessPaintMessages;
  end;
end;

procedure TTeCustomForm.MoveWindow(Bounds: TRect);
begin
  with Bounds do
    MoveWindow(Left, Top, Right-Left, Bottom-Top);
end;

procedure TTeCustomForm.DrawDragFrame(R: TRect);
var
  DesktopDC: HDC;
  Canvas: TCanvas;
  ParentHandle: HWnd;
begin
  if FWindowState = kwsMaximized then Exit;
  { Copy Screen Rect }
  if Form = nil then Exit;

  if THackForm(Form).FormStyle = fsMDIChild then
    if GetMDIParentForm <> nil then
      ParentHandle := THackForm(GetMDIParentForm).ClientHandle
    else
      ParentHandle := 0
  else
    ParentHandle := 0;

  DesktopDC := GetWindowDC(ParentHandle);
  if (DesktopDC <> 0) then
  begin
    Canvas := TCanvas.Create;
    try
      Canvas.Handle := DesktopDC;
      
      Canvas.Brush.Style := bsClear;
      Canvas.Pen.Style := psInsideFrame;
      Canvas.Pen.Color := clWhite;
      Canvas.Pen.Width := 2;
      Canvas.Pen.Mode := pmXor;

      { Erase old }
      if not IsRectEmpty(FSimpleDrawRect) then
        with FSimpleDrawRect do
          Canvas.Rectangle(Left, Top, Right, Bottom);
      { Draw new }
      if not IsRectEmpty(R) then
        with R do
          Canvas.Rectangle(Left, Top, Right, Bottom);
      { Save old }
      FSimpleDrawRect := R;
    finally
      Canvas.Handle := 0;
      Canvas.Free;
    end;
  end;
  ReleaseDC(ParentHandle, DesktopDC);
end;

{ Protected Routines ==========================================================}

function TTeCustomForm.GetClientBounds: TRect;
begin
  Result := Rect(0, 0, FWidth, FHeight);

  { Return ClientRect in non client origins }
  if (Form <> nil) and (THackForm(Form).FormStyle = fsMDIChild) and (FWindowState = kwsMaximized) then
  begin
    { MDI Child Maximized }
    Exit;
  end;

  { Default }
  case FBorderStyle of
    kbsStandard:
      begin
        { Frame }
        Inc(Result.Left, DefaultBorderWidth);
        Dec(Result.Right, DefaultBorderWidth);
        Inc(Result.Top, DefaultBorderWidth);
        Dec(Result.Bottom, DefaultBorderWidth);
        { Caption }
        Inc(Result.Top, DefaultCaptionHeight);
      end;
    kbsToolWindow:
      begin
        { Frame }
        Inc(Result.Left, DefaultBorderWidth);
        Dec(Result.Right, DefaultBorderWidth);
        Inc(Result.Top, DefaultBorderWidth);
        Dec(Result.Bottom, DefaultBorderWidth);
        { Caption }
        Inc(Result.Top, DefaultToolCaptionHeight);
      end;
  end;
end;

function TTeCustomForm.GetClientRect: TRect;
begin
  Result := GetClientBounds;
  OffsetRect(Result, -Result.Left, -Result.Top);
end;

{ Tracking }

function TTeCustomForm.GetMaxTrackSize: TPoint;
var
  R: TRect;
begin
  R := GetMaximizedRect;
  Result := Point(RectWidth(R), RectHeight(R));

  if (FConstraints.MaxWidth <> 0) then
    Result.X := FConstraints.MaxWidth;
  if (FConstraints.MaxHeight <> 0) then
    Result.Y := FConstraints.MaxHeight;
end;

function TTeCustomForm.GetMinTrackSize: TPoint;
begin
  Result := Point(150, 40);

  if (FConstraints.MinWidth <> 0) then
    Result.X := FConstraints.MinWidth;
  if (FConstraints.MinHeight <> 0) then
    Result.Y := FConstraints.MinHeight;
end;

{ State's rect }

function TTeCustomForm.GetMaximizedRect: TRect;
var
  R: TRect;
  P: TPoint;
  F: TCustomForm;
begin
  if (Form <> nil) and (THackForm(Form).FormStyle <> fsMDIChild) then
  begin
    R := GetRectOfMonitorContainingWindow(Handle, not FStayOnTop);
    with GetClientBounds do
      InflateRect(R, Left, Left);
  end
  else
  begin
    F := GetMDIParentForm;
    if (F <> nil) and (THackForm(F).ClientHandle <> 0) then
      Windows.GetClientRect(THackForm(F).ClientHandle, R)
    else
      R := Rect(0, 0, Screen.Width, Screen.Height);
  end;

  Result := R;
end;

function TTeCustomForm.GetMinimizedRect: TRect;
begin
  with GetClientBounds do
    Result := Rect(0, 0, GetSystemMetrics(SM_CXMINIMIZED), Top + FHeight-Bottom);

  with GetParentRect do
    OffsetRect(Result, 0, Bottom-Result.Bottom);
end;

function TTeCustomForm.GetRollupRect: TRect;
begin
  with GetClientBounds do
    Result := Rect(0, 0, FWidth, Top + FHeight-Bottom);
  if Form <> nil then
    OffsetRect(Result, Form.Left, Form.Top);
end;

function TTeCustomForm.GetHitTest(X, Y: integer): TTeHitTest;
const
  SizeWidth = 20;
var
  R: TRect;
  CaptionHeight: integer;
  StatusBar: TTeCustomStatusBar;
begin
  Result := khtClient;

  R := GetClientBounds;

  { Caption }
  if (Y < R.Top) and (X < FWidth) then
    Result := khtCaption;

  case FBorderStyle of
    kbsNone: CaptionHeight := 0;
    kbsStandard: CaptionHeight := DefaultCaptionHeight;
    kbsToolWindow: CaptionHeight := DefaultToolCaptionHeight;
  end;

  { System Buttons }

  if PtInRect(GetCaptionButtonRect(kbiSystemMenu), Point(X, Y)) then
    Result := khtSysMenuButton;
  if PtInRect(GetCaptionButtonRect(kbiClose), Point(X, Y)) then
    Result := khtCloseButton;
  if PtInRect(GetCaptionButtonRect(kbiMinimize), Point(X, Y)) then
    Result := khtMinButton;
  if PtInRect(GetCaptionButtonRect(kbiMaximize), Point(X, Y)) then
    Result := khtMaxButton;
  if PtInRect(GetCaptionButtonRect(kbiHelp), Point(X, Y)) then
    Result := khtHelpButton;
  if PtInRect(GetCaptionButtonRect(kbiRollup), Point(X, Y)) then
    Result := khtRollButton;
  if PtInRect(GetCaptionButtonRect(kbiTray), Point(X, Y)) then
    Result := khtTrayButton;

  if (FWindowState = kwsMaximized) or
     (FWindowState = kwsMinimized) or
     (FWindowState = kwsRollup) then Exit;
  
  { Top }
  if Y < R.Top - CaptionHeight then
    if X < SizeWidth then Result := khtTopLeft
    else
      if X > FWidth - SizeWidth then Result := khtTopRight
      else
        Result := khtTop;

  { Bottom }
  if (Y > R.Bottom) and (Y < FHeight) then
    if X < SizeWidth then Result := khtBottomLeft
    else
      if X > FWidth - SizeWidth then Result := khtBottomRight
      else
        Result := khtBottom;

  { Left }
  if X < R.Left then
    if Y < SizeWidth then Result := khtTopLeft
    else
      if Y > FHeight - SizeWidth then Result := khtBottomLeft
      else
        Result := khtLeft;

  { Right }
  if (X > R.Right) and (X < FWidth) then
    if Y < SizeWidth then Result := khtTopRight
    else
      if Y > FHeight - SizeWidth then Result := khtBottomRight
      else
        Result := khtRight;

  { StatusBar Grip }
  StatusBar := GetStatusBar(Self);
  if StatusBar <> nil then
  begin
    R := TTeCustomStatusBarHack(StatusBar).GetGripperRect;
    R.TopLeft := NormalizePoint(StatusBar.ClientToScreen(R.TopLeft));
    R.BottomRight := NormalizePoint(StatusBar.ClientToScreen(R.BottomRight));

    if PtInRect(R, Point(X, Y)) then
      Result := khtBottomRight;
  end;
end;

procedure TTeCustomForm.NCMouseDown(Button: TMouseButton;
  Shift: TShiftState; X, Y: integer);
begin
  { Handle HitTest }
  if Button = mbLeft then
  begin
    FDownHitTest := GetHitTest(X, Y);
    FMoveHitTest := FDownHitTest;
    FDownPoint := Point(X, Y);
    FMovePoint := Point(X, Y);

    UpdateNonClientArea(0);

    if FDownHitTest in [khtCaption..khtBottomRight] then
    begin
      FDragged := true;
      FSimpleDrawRect := Rect(0, 0, 0, 0);
      if FDragging.DragMode = kfdmBorder then
      begin
        FAllowDraw := false;
        FSimpleDrawEnabled := true;
      end;
    end;
    SetCapture(Handle);
  end;
end;

procedure TTeCustomForm.NCMouseMove(Shift: TShiftState; X, Y: integer);
var
  NewRect: TRect;
  OldMoveHitTest: TTeHitTest;
begin
  if Form = nil then Exit;
  { Handle HitTest }
  if (ssLeft in Shift) and FDragged then
  begin
    NewRect := Form.BoundsRect;
    { Handle DownHiTest }
    case FDownHitTest of
      khtCaption: if (FDragging.Moveable) and (FWindowState <> kwsMaximized) then
      begin
        OffsetRect(NewRect, X - FDownPoint.X, Y - FDownPoint.Y);
        NewRect := ApplyGravitation(NewRect);
      end;
      khtLeft: if (FDragging.Sizeable) and (FWindowState <> kwsMaximized) and (FWindowState <> kwsMinimized) and (FWindowState <> kwsRollup) then
      begin
        Inc(NewRect.Left, X - FDownPoint.X);
        if NewRect.Left > NewRect.Right - GetMinTrackSize.X then
          NewRect.Left := NewRect.Right - GetMinTrackSize.X;
      end;
      khtRight: if (FDragging.Sizeable) and (FWindowState <> kwsMaximized) and (FWindowState <> kwsMinimized) and (FWindowState <> kwsRollup) then
      begin
        if FSimpleDrawEnabled then
          Inc(NewRect.Right, X - FDownPoint.X)
        else
          Inc(NewRect.Right, X - FMovePoint.X);
      end;
      khtTop: if (FDragging.Sizeable) and (FWindowState <> kwsMaximized) and (FWindowState <> kwsMinimized) and (FWindowState <> kwsRollup) then
      begin
        Inc(NewRect.Top, Y - FDownPoint.Y);
        if NewRect.Top > NewRect.Bottom - GetMinTrackSize.Y then
          NewRect.Top := NewRect.Bottom - GetMinTrackSize.Y;
      end;
      khtBottom: if (FDragging.Sizeable) and (FWindowState <> kwsMaximized) and (FWindowState <> kwsMinimized) and (FWindowState <> kwsRollup) then
      begin
        if FSimpleDrawEnabled then
          Inc(NewRect.Bottom, Y - FDownPoint.Y)
        else
          Inc(NewRect.Bottom, Y - FMovePoint.Y)
      end;
      khtTopLeft: if (FDragging.Sizeable) and (FWindowState <> kwsMaximized) and (FWindowState <> kwsMinimized) and (FWindowState <> kwsRollup) then
      begin
        Inc(NewRect.Top, Y - FDownPoint.Y);
        if NewRect.Top > NewRect.Bottom - GetMinTrackSize.Y then
          NewRect.Top := NewRect.Bottom - GetMinTrackSize.Y;
        Inc(NewRect.Left, X - FDownPoint.X);
        if NewRect.Left > NewRect.Right - GetMinTrackSize.X then
          NewRect.Left := NewRect.Right - GetMinTrackSize.X;
      end;
      khtTopRight: if (FDragging.Sizeable) and (FWindowState <> kwsMaximized) and (FWindowState <> kwsMinimized) and (FWindowState <> kwsRollup) then
      begin
        Inc(NewRect.Top, Y - FDownPoint.Y);
        if NewRect.Top > NewRect.Bottom - GetMinTrackSize.Y then
          NewRect.Top := NewRect.Bottom - GetMinTrackSize.Y;
        if FSimpleDrawEnabled then
          Inc(NewRect.Right, X - FDownPoint.X)
        else
          Inc(NewRect.Right, X - FMovePoint.X);
      end;
      khtBottomLeft: if (FDragging.Sizeable) and (FWindowState <> kwsMaximized) and (FWindowState <> kwsMinimized) and (FWindowState <> kwsRollup) then
      begin
        if FSimpleDrawEnabled then
          Inc(NewRect.Bottom, Y - FDownPoint.Y)
        else
          Inc(NewRect.Bottom, Y - FMovePoint.Y);
        Inc(NewRect.Left, X - FDownPoint.X);
        if NewRect.Left > NewRect.Right - GetMinTrackSize.X then
          NewRect.Left := NewRect.Right - GetMinTrackSize.X;
      end;
      khtBottomRight: if (FDragging.Sizeable) and (FWindowState <> kwsMaximized) and (FWindowState <> kwsMinimized) and (FWindowState <> kwsRollup) then
      begin
        if FSimpleDrawEnabled then
        begin
          Inc(NewRect.Bottom, Y - FDownPoint.Y);
          Inc(NewRect.Right, X - FDownPoint.X);
        end
        else
        begin
          Inc(NewRect.Bottom, Y - FMovePoint.Y);
          Inc(NewRect.Right, X - FMovePoint.X);
        end;
      end;
    end;

    if FDragging.DragMode = kfdmBorder then
    begin
      DrawDragFrame(NewRect);
    end
    else
    begin
      MoveWindow(NewRect);

      { Handle MoveHitTest}
      FMoveHitTest := GetHitTest(X, Y);
      { Repaint NonClient }
      UpdateNonClientArea(0);
    end;
    { Set MovePoint }
    FMovePoint := Point(X, Y);
  end
  else
  begin
    { Handle MoveHitTest}
    OldMoveHitTest := FMoveHitTest;

    FMoveHitTest := GetHitTest(X, Y);
    if FMoveHitTest <> OldMoveHitTest then
      UpdateNonClientArea(0);
  end;
end;

procedure TTeCustomForm.NCMouseUp(Button: TMouseButton; Shift: TShiftState;
  X, Y: integer);
var
  HT: TTeHitTest;
  SaveMode: TTeFormDragMode;
begin
  HT := GetHitTest(X, Y);

  if Button = mbLeft then
  begin
    ReleaseCapture;

    { Action }
    if (ssDouble in Shift) then
    begin
      if (kbiMaximize in BorderIcons) {and (FCanResize) }then
      begin
        { Maximize }
        if (FDownHitTest = khtCaption) then
        begin
          if FWindowState <> kwsMinimized then Maximize
          else Restore;
          Exit;
        end;
      end;
      { Sys Icon }
      if FDownHitTest = khtSysMenuButton then
      begin
        Close;
        Exit;
      end;
    end;

    if FDownHitTest = HT then
      case GetHitTest(X, Y) of
        khtSysMenuButton: SysMenu;
        khtCloseButton: Close;
        khtMinButton: Minimize;
        khtMaxButton: Maximize;
        khtHelpButton: Help;
        khtRollButton: Rollup;
        khtTrayButton: MinToTray;
     end;

    if FDragging.DragMode = kfdmBorder then
    begin
      { Erase last rect }
      DrawDragFrame(Rect(0, 0, 0, 0));
      { Finish simple drag }
      SaveMode := FDragging.DragMode;
      FDragging.DragMode := kfdmFullDrag;
      try
        NCMouseMove([ssLeft], X, Y);
      finally
        FDragging.DragMode := kfdmBorder; 
      end;

      FSimpleDrawEnabled := false;
      FAllowDraw := true;

      UpdateNonClientArea(0);
      Form.Invalidate;
    end
    else
      UpdateNonClientArea(0);

    FDownHitTest := khtClient;

    FDragged := false;
  end;

  if (Button = mbRight) and (HT = khtCaption) and (Form <> nil) then
  begin
    with GetClientBounds do
      FSysMenuPoint := Form.ClientToScreen(Point(X - Left, Y - Top));
    SysMenu;
    FSysMenuPoint := Point(0, 0);
  end;

  FDownHitTest := khtClient;
end;

function TTeCustomForm.GetMDIParentForm: TCustomForm;
begin
  Result := nil;
  if (Form <> nil) and (THackForm(Form).FormStyle = fsMDIChild) then
    if (Form.Owner is TCustomForm) then
      Result := TCustomForm(Form.Owner)
    else
      Result := TCustomForm(Application.MainForm);
end;

function TTeCustomForm.GetMDIParentKsForm: TTeCustomForm;
var
  i: integer;
  ParentForm: TCustomForm;
begin
  Result := nil;

  ParentForm := GetMDIParentForm;
  if ParentForm <> nil then
    with ParentForm do
      for i := 0 to ComponentCount - 1 do
        if (Components[i] is TTeCustomForm) and TTeCustomForm(Components[i]).Active then
        begin
          Result := TTeCustomForm(Components[i]);
          Exit;
        end;
end;

function TTeCustomForm.IsMDIChildMaximized: boolean;
var
  i, c: integer;
begin
  Result := false;

  if Form = nil then Exit;

  if THackForm(Form).FormStyle = fsMDIChild then
  begin
    { From MDIChild }
    if (GetMDIParentForm <> nil) and (THackForm(GetMDIParentForm).MDIChildCount > 0) then
    begin
      for c := 0 to THackForm(GetMDIParentForm).MDIChildCount - 1 do
        with THackForm(GetMDIParentForm) do
        begin
          Result := MDIChildren[c].WindowState = wsMaximized;
          if Result then Exit;

          { Check KSForms }
          with MDIChildren[c] do
            for i := 0 to ComponentCount - 1 do
              if (Components[i] is TTeCustomForm) and TTeCustomForm(Components[i]).Active then
              begin
                Result := TTeCustomForm(Components[i]).WindowState = kwsMaximized;
                if Result then Exit;
              end;
        end;
    end;
  end;

  if THackForm(Form).FormStyle = fsMDIForm then
  begin
    { From MDIChild }
    if (THackForm(Form).MDIChildCount > 0) then
    begin
       for c := 0 to THackForm(Form).MDIChildCount - 1 do
         with THackForm(Form).MDIChildren[c] do
         begin
            { Check KSForms }
            for i := 0 to ComponentCount - 1 do
              if (Components[i] is TTeCustomForm) and TTeCustomForm(Components[i]).Active then
              begin
                Result := TTeCustomForm(Components[i]).WindowState = kwsMaximized;
                If Result then Exit;
              end;
         end;
    end;
  end;
end;

procedure TTeCustomForm.ChangeMDIParentCaption;
var
  S: string;
  ParentForm: TCustomForm;
begin
  ParentForm := GetMDIParentForm;

  if ParentForm <> nil then
  begin
    { Change caption }
    S := ParentForm.Caption;
    if Pos('[', S) > 0 then Delete(S, Pos('[', S)-3, Length(S));

    if IsMDIChildMaximized then
    begin
      ParentForm.Caption := S + ' - [' + THackForm(Form).Caption + ']';
      PostMessage(ParentForm.Handle, WM_UPDATENCAREA, 0, 0);
    end
    else
      ParentForm.Caption := S;
  end;
end;

procedure TTeCustomForm.UpdateWindowMenu;
var
  i, c, Count: integer;
  WCaption: WideString;
  WForm: TTeCustomForm;
  WItem: TTeCustomItem;
  WActive: boolean;
begin
  if FWindowMenuHandling then Exit;

  if (FWindowMenu <> nil) and (Form <> nil) and (THackForm(Form).FormStyle = fsMDIForm) then
  begin
    { Clear window items}
    Count := FWindowMenu.Count;
    for i := 0 to Count - 1 do
    begin
      if Pos(SMDIItemName, FWindowMenu[i].Name) > 0 then
      begin
        for c := i to Count - 1 do
        begin
          WItem := FWindowMenu[i];
          FWindowMenu.Remove(WItem);
          WItem.Free;
        end;
        Break;
      end;
    end;
    { Update }
    if (THackForm(Form).MDIChildCount > 0) then
    begin
       WItem := nil;
       for i := THackForm(Form).MDIChildCount - 1 downto 0 do
         with THackForm(Form).MDIChildren[i] do
         begin
            { Check KsForms }
            WCaption := Caption;
            for c := 0 to ComponentCount - 1 do
              if (Components[c] is TTeCustomForm) and TTeCustomForm(Components[c]).Active then
              begin
                WCaption := TTeCustomForm(Components[c]).Caption;
                WForm := TTeCustomForm(Components[c]);
                WActive := THackForm(Form).ActiveMDIChild = THackForm(Form).MDIChildren[i];
                Break;
              end;
            { Add Separator }
            if WItem = nil then // First item
            begin
              WItem := TTeCustomItemClass(FWindowMenu.ClassType).Create(FWindowMenu.Owner);
              WItem.Caption := '-';
              WItem.Name := SMDIItemName + '_' + IntToStr(Random(1000)) + '_sep';
              FWindowMenu.Add(WItem);
            end;
            { Add Item }
            WItem := TTeCustomItemClass(FWindowMenu.ClassType).Create(FWindowMenu.Owner);
            WItem.Caption := WCaption;
            WItem.Checked := WActive;
            WItem.Name := SMDIItemName + '_' + IntToStr(Random(1000));
            WItem.OnClick := DoWindowItemClick;
            WItem.Tag := Integer(WForm);
            FWindowMenu.Add(WItem);
         end;
    end;
  end;
end;

procedure TTeCustomForm.DoWindowItemClick(Sender: TObject);
var
  WForm: TTeCustomForm;
  i: integer;
begin
  with TTeCustomItem(Sender) do
  begin
    { Clear Checked }
    for i := 0 to FWindowMenu.Count - 1 do
    begin
      if Pos(SMDIItemName, FWindowMenu[i].Name) > 0 then
        FWindowMenu[i].Checked := false;
    end;
    { Activate }
    WForm := TTeCustomForm(Tag);
    if WForm <> nil then
    begin
      FWindowMenuHandling := true;
      WForm.Form.SetFocus;
      WForm.Form.BringToFront;
      FWindowMenuHandling := false;
    end;
    Checked := true;
  end;
end;

procedure TTeCustomForm.RestoreMDIChildren;
var
  c, i: integer;
begin
  { Restore All MDI Children }
  if THackForm(Form).FormStyle = fsMDIChild then
  begin
    { From MDIChild }
    if (GetMDIParentForm <> nil) and (THackForm(GetMDIParentForm).MDIChildCount > 0) then
    begin
      for c := 0 to THackForm(GetMDIParentForm).MDIChildCount - 1 do
        with THackForm(GetMDIParentForm) do
        begin
          { Check KSForms }
          with MDIChildren[c] do
            for i := 0 to ComponentCount - 1 do
              if (Components[i] is TTeCustomForm) and TTeCustomForm(Components[i]).Active then
              begin
                if TTeCustomForm(Components[i]).WindowState = kwsMaximized then
                  TTeCustomForm(Components[i]).Restore;
              end;
        end;
    end;
    ChangeMDIParentCaption;
  end;

  if THackForm(Form).FormStyle = fsMDIForm then
  begin
    for c := 0 to THackForm(Form).MDIChildCount - 1 do
      with THackForm(Form) do
      begin
        { Check KSForms }
        with MDIChildren[c] do
          for i := 0 to ComponentCount - 1 do
            if (Components[i] is TTeCustomForm) and TTeCustomForm(Components[i]).Active then
            begin
              if TTeCustomForm(Components[i]).WindowState = kwsMaximized then
                TTeCustomForm(Components[i]).Restore;
            end;
      end;
  end;
end;

procedure TTeCustomForm.ClientWndProc(var Message: TMessage);

  procedure Default;
  begin
    with Message do
      Result := CallWindowProc(FOldClientProc, THackForm(Form).ClientHandle, Msg, wParam, lParam);
  end;

var
  DC: HDC;
  PS: TPaintStruct;
begin
  if THackForm(Form).ClientHandle = 0 then Exit;

  with Message do
    case Msg of
      WM_NCHITTEST:
        begin
          Default;
          if Result = HTCLIENT then Result := HTTRANSPARENT;
        end;
      WM_ERASEBKGND:
        begin
          if (Form <> nil) and (THackForm(Form).FormStyle = fsMDIForm) and (IsMDIChildMaximized) then
          else
            SendMessage(Handle, WM_ERASEBKGND, TWMEraseBkGnd(Message).DC, 0);
          Result := 0;
        end;
      $3F://!
        begin
          if (THackForm(Form).FormStyle = fsMDIForm) then
            RemoveMDIClientEdge(THackForm(Form).ClientHandle);
        end;
      WM_PAINT:
        begin
          DC := TWMPaint(Message).DC;
          if DC = 0 then TWMPaint(Message).DC := BeginPaint(THackForm(Form).ClientHandle, PS);
          try
          finally
            if DC = 0 then EndPaint(THackForm(Form).ClientHandle, PS);
          end;
          Message.Result := 0;
        end;
    else
      Default;
    end;
end;

procedure TTeCustomForm.DisableDrawing;
begin
  FAllowDraw := false;
end;

procedure TTeCustomForm.EnableDrawing;
begin
  FAllowDraw := true;
end;

procedure TTeCustomForm.InvalidateRect(ARect: TRect);
var
  Msg: TWMEraseBkgnd;
  EBInfo: TEraseBackgroundInfo;
begin
  IntersectRect(ARect, ARect, Rect(0, 0, FRealWidth, FRealHeight));

  EBInfo.Action := keaInvalidateRect;
  EBInfo.Rect := ARect;
  EBInfo.PaintChildren := true;

  Msg.Msg := WM_ERASEBKGND;
  Msg.DC := 0;
  Msg.Unused := Integer(@EBInfo);

  WMEraseBkgnd(Msg);
end;

procedure TTeCustomForm.InvalidateNow;
 procedure ProcessPaintMessages;
 { Dispatches all pending WM_PAINT messages. In effect, this is like an
   'UpdateWindow' on all visible windows }
 var
   Msg: TMsg;
 begin
   while PeekMessage(Msg, 0, WM_PAINT, WM_PAINT, PM_NOREMOVE) do
   begin
     case Integer(GetMessage(Msg, 0, WM_PAINT, WM_PAINT)) of
       -1: Break; { if GetMessage failed }
       0: begin
            { Repost WM_QUIT messages }
            PostQuitMessage(Msg.WParam);
            Break;
          end;
     end;
     DispatchMessage(Msg);
   end;
 end;
begin
  if Form = nil then Exit;

  Form.Invalidate;
  ProcessPaintMessages;
end;

{ Sys commands }

procedure TTeCustomForm.UpdateTrayIcon;
begin
  if (Form <> nil) and (THackForm(Form).Icon <> nil) and (THackForm(Form).Icon.Handle <> 0) then
    FIconData.hIcon := THackForm(Form).Icon.Handle
  else
    FIconData.hIcon := Application.Icon.Handle;
  Shell_NotifyIcon(nim_Modify, @FIconData);
end;

procedure TTeCustomForm.Update;
var
  R: TRect;
  Delta: TPoint;
begin
  if not Active then Exit;
  if Form = nil then Exit;
  if csDesigning in ComponentState then Exit;

  if Active then
  begin
    Delta := Point(0, 0);
    { Update }
    FNoCopyScreen := true;
    try
      { Save current size }
      FSavedClentSize.X := Form.ClientWidth;
      FSavedClentSize.Y := Form.ClientHeight;
      { Update client rect }
//      SetWindowPos(Handle, 0, Form.Left, Form.Top, FWidth, FHeight, SWP_FRAMECHANGED or SWP_NOSENDCHANGING);
      Form.Height := Form.Height + 1;
      Form.Height := Form.Height - 1;
      { Check for border changing }
      if FSavedClentSize.X <> 0 then
        if (FSavedClentSize.X <> Form.ClientWidth) or
           (FSavedClentSize.Y <> Form.ClientHeight)
        then
        begin
          Delta := Point(FSavedClentSize.X - Form.ClientWidth, FSavedClentSize.Y - Form.ClientHeight);
          if (Delta.X <> 0) or (Delta.Y <> 0) then
          begin
            Form.Width := Form.Width + Delta.X;
            Form.Height := Form.Height + Delta.Y;
          end;
        end;
    finally
      FNoCopyScreen := false;
    end;
    R := Rect(0, 0, FWidth, FHeight);
    Windows.InvalidateRect(Form.Handle, @R, true);
  end;
end;

procedure TTeCustomForm.Close;
var
  CloseAction: TCloseAction;
  CallDefault: boolean;
begin
  if Assigned(FOnClose) then
  begin
    CallDefault := true;
    FOnClose(Self, CallDefault);
    if not CallDefault then Exit;
  end;

  if Form <> nil then
  begin
    if fsModal in Form.FormState then
      Form.ModalResult := mrCancel
    else
      if Form.CloseQuery then
      begin
        if THackForm(Form).FormStyle = fsMDIChild then
          if kbiMinimize in BorderIcons then
            CloseAction := caMinimize
          else
            CloseAction := caNone
        else
          CloseAction := caHide;

        THackForm(Form).DoClose(CloseAction);

        if CloseAction <> caNone then
          if Application.MainForm = Form then
            Application.Terminate
          else
            if CloseAction = caHide then
            begin
              { Hide }
              if (GetMDIParentKsForm <> nil) and (GetMDIParentKsForm.MenuBar <> nil) then
                GetMDIParentKsForm.MenuBar.HideMDIItems;
              RestoreMDIChildren;

              Form.Hide;
            end
            else
              if CloseAction = caMinimize then
              begin
                { Minimize }
                Minimize;
              end
              else
              begin
                if (GetMDIParentKsForm <> nil) and (GetMDIParentKsForm.MenuBar <> nil) then
                   GetMDIParentKsForm.MenuBar.HideMDIItems;
                RestoreMDIChildren;
                { Free }
                Form.Release;
              end;
      end;
  end;
end;

procedure TTeCustomForm.Restore;
var
  SaveState: TTeWindowState;
  SaveRect: TRect;
begin
  { Clear MoveHitTest }
  FMoveHitTest := khtNonClient;

  case FWindowState of
    kwsNormal: begin
      FWindowState := kwsNormal;
      MoveWindow(FRestoreRect);
    end;
    kwsMaximized: begin
      case FOldState of
        kwsRollup: begin
          FWindowState := kwsNormal;
          MoveWindow(FRestoreRect);
          Rollup;
        end;
        kwsMinimized: if not FMinimizeApplication then { no MainForm form }
        begin
          FWindowState := kwsNormal;
          MoveWindow(FRestoreRect);
          Maximize;
        end;
      else
        FOldState := FWindowState;
        FWindowState := kwsNormal;
        MoveWindow(FRestoreRect);
        if FShadow.Enabled then
        begin
          if Form <> nil then
            Form.Invalidate;
          UpdateNonClientArea(0);
        end;

        { For MDIChild }
        if (Form <> nil) and (THackForm(Form).FormStyle = fsMDIChild) then
        begin
          Update;
          if Owner is TWinControl then
            PostMessage((Owner as TWinControl).Handle, WM_SIZE, 0, 0);

          if (GetMDIParentKsForm <> nil) and (GetMDIParentKsForm.MenuBar <> nil) then
            GetMDIParentKsForm.MenuBar.HideMDIItems;

          RestoreMDIChildren;
        end;
      end;
    end;
    kwsMinimized: begin
      case FOldState of
        kwsMaximized: begin
          Maximize;
          FOldState := kwsNormal;
        end;
        kwsRollup: begin
          Rollup;
          FOldState := kwsNormal;
        end;
      else
        FWindowState := kwsNormal;
        MoveWindow(FRestoreRect);
      end;
    end;
    kwsRollup: begin
      if (FWidth = RectWidth(GetMaximizedRect)) or (FOldState = kwsMaximized) then
      begin
        Maximize;
        FOldState := kwsNormal;
      end
      else
      begin
        FWindowState := kwsNormal;
        OffsetRect(FRestoreRect, -FRestoreRect.Left, -FRestoreRect.Top);
        OffsetRect(FRestoreRect, Form.Left, Form.Top);
        MoveWindow(FRestoreRect);
      end;
    end;
    kwsTray: begin
      { Restore window }
      SaveRect := FRestoreRect;
      SaveState := FOldState;
      if FMinimizeApplication then { MainForm }
      begin
        Application.Restore;
        ShowWindow(Application.Handle, sw_Restore);
        SetForegroundWindow(Application.Handle);
      end
      else
      begin
        ShowWindow(Handle, sw_Restore);
        SetForegroundWindow(Handle);
      end;
      Shell_NotifyIcon(nim_Delete, @FIconData);
      FOldState := SaveState;
      FRestoreRect := SaveRect;
      { Restore state }
      case FOldState of
        kwsMaximized: begin
          Maximize;
          FRestoreRect := SaveRect;
          FOldState := kwsNormal;
        end;
        kwsRollup: begin
          Rollup;
          FRestoreRect := SaveRect;
          FOldState := kwsNormal;
        end;
      else
        FWindowState := kwsNormal;
        MoveWindow(FRestoreRect);
      end;
    end;
  end;
end;

procedure TTeCustomForm.Maximize;
var
  CallDefault: boolean;
begin
  { Clear MoveHitTest }
  FMoveHitTest := khtNonClient;

  if Assigned(FOnMaximize) then
  begin
    CallDefault := true;
    FOnMaximize(Self, CallDefault);
    if not CallDefault then Exit;
  end;

  if FWindowState <> kwsMaximized then
  begin
    FOldState := FWindowState;

    if FLoadedState = kwsNormal then
      if (FOldState <> kwsRollup) and (FOldState <> kwsMinimized) then
        FRestoreRect := Form.BoundsRect;

    FWindowState := kwsMaximized;
    MoveWindow(GetMaximizedRect);
    if Form <> nil then
      Form.Invalidate;
    UpdateNonClientArea(0);

    { For MDIChild }
    if (Form <> nil) and (THackForm(Form).FormStyle = fsMDIChild) then
    begin
      Update;

      if (GetMDIParentKsForm <> nil) and (GetMDIParentKsForm.MenuBar <> nil) then
        GetMDIParentKsForm.MenuBar.ShowMDIItems(Self);
      ChangeMDIParentCaption;
    end;
  end
  else
    Restore;

  FLoadedState := kwsNormal;
end;

procedure TTeCustomForm.Minimize;
var
  CallDefault: boolean;
  WndParent: cardinal;
begin
  { Clear MoveHitTest }
  FMoveHitTest := khtNonClient;

  if Form = nil then Exit;
  if fsModal in Form.FormState then Exit;

  if Assigned(FOnMinimize) then
  begin
    CallDefault := true;
    FOnMinimize(Self, CallDefault);
    if not CallDefault then Exit;
  end;

  if FWindowState <> kwsMinimized then
  begin
    FOldState := FWindowState;
    FWindowState := kwsMinimized;

    if FLoadedState = kwsNormal then
      if (FOldState <> kwsRollup) and (FOldState <> kwsMaximized) then
        FRestoreRect := Form.BoundsRect;

    { For MDIChild }
    if (Form <> nil) and (THackForm(Form).FormStyle = fsMDIChild) then
    begin
      Update;
      if Owner is TWinControl then
        PostMessage((Owner as TWinControl).Handle, WM_SIZE, 0, 0);

      if (GetMDIParentKsForm <> nil) and (GetMDIParentKsForm.MenuBar <> nil) then
        GetMDIParentKsForm.MenuBar.HideMDIItems;

      RestoreMDIChildren;
    end;

    WndParent := GetWindowLong(Handle, GWL_HWNDPARENT);
    if WndParent = 0 then
      PostMessage(Handle, WM_SYSCOMMAND, SC_MINIMIZE, 0)
    else
      if FMinimizeApplication then { MainForm }
        Application.Minimize
      else
        MoveWindow(GetMinimizedRect);
  end
  else
    Restore;

  FLoadedState := kwsNormal;
end;

procedure TTeCustomForm.Rollup;
var
  CallDefault: boolean;
begin
  { Clear MoveHitTest }
  FMoveHitTest := khtNonClient;

  if Assigned(FOnRollup) then
  begin
    CallDefault := true;
    FOnRollup(Self, CallDefault);
    if not CallDefault then Exit;
  end;

  if FWindowState <> kwsRollup then
  begin
    FOldState := FWindowState;
    FWindowState := kwsRollup;

    if (FOldState <> kwsMinimized) and (FOldState <> kwsMaximized) then
      FRestoreRect := Form.BoundsRect;

    MoveWindow(GetRollupRect);
  end
  else
    Restore;

  FLoadedState := kwsNormal;
end;

procedure TTeCustomForm.MinToTray;
var
  CallDefault: boolean;
begin
  { Clear MoveHitTest }
  FMoveHitTest := khtNonClient;

  if fsModal in Form.FormState then Exit;

  if Assigned(FOnMinToTray) then
  begin
    CallDefault := true;
    FOnMinToTray(Self, CallDefault);
    if not CallDefault then Exit;
  end;

  if Form = nil then Exit;

  if FWindowState <> kwsTray then
  begin
    FOldState := FWindowState;
    FWindowState := kwsTray;

    if FLoadedState = kwsNormal then
      if (FOldState <> kwsMinimized) and (FOldState <> kwsMaximized) and (FOldState <> kwsRollup) then
        FRestoreRect := Form.BoundsRect;

    if FMinimizeApplication then { MainForm }
    begin
      { Set Hint }
      StrPLCopy(FIconData.szTip, Application.Title, SizeOf(FIconData.szTip ) - 1);
      { Min }
      Application.Minimize;
      ShowWindow(Application.Handle, SW_HIDE);
    end
    else
    begin
      { Set Hint }
      if Form <> nil then
        StrPLCopy(FIconData.szTip, Form.Caption, SizeOf(FIconData.szTip ) - 1);
      { Min }
      ShowWindow(Handle, SW_HIDE);
    end;

    Shell_NotifyIcon(nim_Add, @FIconData);
  end
  else
    Restore;

  FLoadedState := kwsNormal;
end;

procedure TTeCustomForm.Help;
begin
  SendMessage(Handle, WM_SYSCOMMAND, SC_CONTEXTHELP, 0)
end;

procedure TTeCustomForm.SysMenu;
var
  P: TPoint;
begin
  { Clear MoveHitTest }
  FMoveHitTest := khtNonClient;

  if FWindowState = kwsTray then
    GetCursorPos(P)
  else
    if (FSysMenuPoint.X = 0) and (FSysMenuPoint.Y = 0) then
      P := Form.ClientToScreen(Point(0, 0))
    else
      P := FSysMenuPoint;

  if (FWindowState = kwsTray) and (FTrayMenuLink <> nil) then
  begin
    { New tray menu }
    if FTrayMenuLink is TTeCustomPopupMenu then
    begin
      (FTrayMenuLink as TTeCustomPopupMenu).PopupMenuOptions := FTrayMenuOptions;
      (FTrayMenuLink as TTeCustomPopupMenu).Items.Tray := true;
    end;

    FTrayMenuLink.Popup(P.X, P.Y);
    Exit;
  end;

  if (FWindowState <> kwsTray) and (FSystemMenuLink <> nil) then
  begin
    { New system menu }
    if FSystemMenuLink is TTeCustomPopupMenu then
    begin
      (FSystemMenuLink as TTeCustomPopupMenu).PopupMenuOptions := FSystemMenuOptions;
    end;

    FSystemMenuLink.Popup(P.X, P.Y);
    Exit;
  end;

  { System menu }
  CreateSysMenu;
  if FSysMenu <> nil then
  begin
    FSysMenu.Tray := FWindowState = kwsTray;
    FSysMenu.Popup(nil, P.X, P.Y, Rect(0, 0, 0, 0));
  end;
end;

procedure TTeCustomForm.Cascade;
begin
  if IsMDIChildMaximized then
    RestoreMDIChildren;

  Application.ProcessMessages;

  if Form <> nil then
    TForm(Form).Cascade;
end;

procedure TTeCustomForm.Tile;
begin
  if IsMDIChildMaximized then
    RestoreMDIChildren;

  Application.ProcessMessages;

  if Form <> nil then
    TForm(Form).Tile;
end;

