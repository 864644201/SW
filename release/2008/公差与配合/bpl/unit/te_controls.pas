const
  ActivePopup: TTeCustomPopupMenu = nil;

var
  ItemClass: TTeCustomItemClass;

{ TTeMenuBarView ==============================================================}

constructor TTeMenuBarView.CreateView(AOwner: TComponent; ACanvas: TCanvas);
begin
  inherited CreateView(AOwner, true, voHorizontal);
  FMenuBar := (AOwner as TTeCustomMenuBar);
  Canvas := ACanvas; 
end;

procedure TTeMenuBarView.InvalidateView;
begin
  if FMenuBar.FUpdating = 0 then
    FMenuBar.Invalidate;
end;

procedure TTeMenuBarView.InvalidateItem(AItem: TTeCustomItem);
var
  R: TRect;
begin
  if FMenuBar.FUpdating = 0 then
  begin
    if FMenuBar.Parent is TTeCustomControlBar then
    begin
      FMenuBar.Invalidate;
      Exit;
    end;
    if FMenuBar.Performance = kspNoBuffer then
    begin
      { Direct updating }
      R := GetItemRect(AItem);
      AItem.DrawItem(FMenuBar.Canvas, Self, R, AItem = SelItem, not Loop);
    end
    else
      FMenuBar.Invalidate;
  end;
end;

procedure TTeMenuBarView.SetPosition(APosition: TPoint);
begin
  inherited SetPosition(APosition);
end;

procedure TTeMenuBarView.SetSize(ASize: TPoint);
var
  R: TRect;
begin
  inherited SetSize(ASize);
  { Set MenuBar size }
  if not FMenuBar.FAutoSize then Exit;

  R := FMenuBar.GetViewRect; 
  with FMenuBar do
    SetBounds(Left, Top, Width, ASize.Y + R.Top + (FHeight - R.Bottom));
end;

{ TTeCustomMenuBar ===============================================================}

constructor TTeCustomMenuBar.Create(AOwner: TComponent);
begin
  RegisterContainerClass(ClassType, InsertItemProc, GetItemClassProc);
  inherited Create(AOwner);
  ControlStyle := ControlStyle + [csActionClient];

  FCalcSize := true;
  FAutoSize := true;
  FShowBevel := false;

  FPopupMenuOptions := TTePopupMenuOptions.Create;

  GetItemClassProc(ItemClass);
  FItems := ItemClass.Create(Self);
  FItems.ParentComponent := Self;
  if not (csDesigning in ComponentState) then
    FItems.OnInternalChange := DoInternalChange;

  FView := TTeMenuBarView.CreateView(Self, Canvas);
  FView.ParentComponent := Self;
  FView.Items := FItems;
  FView.Window := Self;

  Color := clMenu;

  Height := GetSystemMetrics(SM_CYMENU);
end;

destructor TTeCustomMenuBar.Destroy;
begin
  FItems.PopupMenuOptions := nil;

  FView.Free;
  FItems.Free;
  FPopupMenuOptions.Free;
  inherited Destroy;
  UnregisterContainerClass(ClassType);
end;

procedure TTeCustomMenuBar.Loaded;
begin
  inherited;
  PopupMenuOptions := FPopupMenuOptions;

  Items.IsToolbar := Parent is TTeCustomControlBar;

  { For MDI }
  if not (csDesigning in ComponentState) and (Owner is TForm) and ((Owner as TForm).FormStyle = fsMDIForm) then
  begin
    GetItemClassProc(ItemClass);
    FSysMenu := ItemClass.Create(Owner);
    FSysMenu.MDIItemKind := mikSysMenu;
    FSysMenu.Visible := false;
    FSysMenu.OnClick := DoMDIItemClick;
    Items.Insert(0, FSysMenu);

    FMin := ItemClass.Create(Owner);
    FMin.MDIItemKind := mikMinimize;
    FMin.Visible := false;
    FMin.OnClick := DoMDIItemClick;
    Items.Add(FMin);

    FRestore := ItemClass.Create(Owner);
    FRestore.MDIItemKind := mikRestore;
    FRestore.Visible := false;
    FRestore.OnClick := DoMDIItemClick;
    Items.Add(FRestore);

    FClose := ItemClass.Create(Owner);
    FClose.MDIItemKind := mikClose;
    FClose.Visible := false;
    FClose.OnClick := DoMDIItemClick;
    Items.Add(FClose);
  end;

  FCalcSize := false;
  FView.CalcSize;

  FItems.BiDiMode := BiDiMode;
end;

procedure TTeCustomMenuBar.InitiateAction;
begin
  inherited;

  if FView <> nil then
    FView.InitiateAction;
end;

procedure TTeCustomMenuBar.DoInternalChange(Sender: TObject);
begin
  if (csLoading in ComponentState) or (csDestroying in ComponentState) then Exit;

  if not FDisableUpdate then
    ItemsChanged; 
end;

procedure TTeCustomMenuBar.ItemsChanged;
begin
  PopupMenuOptions := FPopupMenuOptions;

  if Owner is TWinControl then
    FItems.OwnerForm := TWinControl(Owner);

  Items.IsToolbar := Parent is TTeCustomControlBar;

  if View <> nil then View.CalcSize;
  Invalidate;
end;

procedure TTeCustomMenuBar.GetChildren(Proc: TGetChildProc;
  Root: TComponent);
begin
  FItems.GetChildren(Proc, Root);
  inherited ;
end;

class procedure TTeCustomMenuBar.GetItemClassProc(var AItemClass: TTeCustomItemClass);
begin
  AItemClass := TTeCustomItem;
end;

class procedure TTeCustomMenuBar.InsertItemProc(AParent: TComponent;
  AItem: TTeCustomItem);
begin
  (AParent as TTeCustomMenuBar).Items.Add(AItem);
end;

{ Overrides }

function TTeCustomMenuBar.GetViewRect: TRect;
begin
  Result := Rect(0, 0, FWidth, FHeight);

  case Align of
    alTop: Dec(Result.Bottom, 2);
    alBottom: Inc(Result.Top, 2);
  end;
end;

procedure TTeCustomMenuBar.PaintBuffer;
var
  Theme: HTheme;
  Part, ThemeState: integer;
  R: TRect;
begin
  if Parent is TTeCustomControlBar then
  begin
    { ControlBar's owner }
    if not UseThemes then
    begin
      FillRect(Canvas, Rect(0, 0, Width, Height), TTeCustomControlBar(Parent).Color);
    end
    else
    begin
      { XP Style }
      Theme := OpenThemeData(0, 'Rebar');
      Part := integer(0);
      ThemeState := integer(0);

      R := Parent.ClientRect;
      OffsetRect(R, -Left, -Top);

      DrawThemeBackground(Theme, Canvas.Handle, Part, ThemeState, R, nil);

      CloseThemeData(Theme);
    end;
  end
  else
    inherited ;

  if (FView <> nil) then
  begin
    { Draw view }
    with GetViewRect do
    begin
      FView.Left := Left;
      FView.Top := Top;
    end;
    FView.Paint(Canvas);
    { Draw bevel }
    if FShowBevel then
    begin
      case Align of
        alTop:
          begin
            if not UseThemes then
              DrawEdge(Canvas, Rect(0, FHeight-2, FWidth, FHeight), clBtnShadow, clBtnHighlight)
            else
              DrawRect(Canvas, Rect(0, FHeight-1, FWidth, FHeight), clHighlight)
          end;
        alBottom:
          begin
            if not UseThemes then
              DrawEdge(Canvas, Rect(0, 0, FWidth, 2), clBtnShadow, clBtnHighlight)
            else
              DrawRect(Canvas, Rect(0, 0, FWidth, 1), clHighlight)
        end;
      end;
    end;
  end;
end;

