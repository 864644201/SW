procedure TTeCustomListBox.SetSelected(Index: Integer;
  const Value: boolean);
begin
  if Low(FSelected) <= High(FSelected) then
    if (Index >= Low(FSelected)) and (Index <= High(FSelected)) then
      if Value <> FSelected[Index] then
      begin
        FSelected[Index] := Value;
        Invalidate;
      end;
end;

