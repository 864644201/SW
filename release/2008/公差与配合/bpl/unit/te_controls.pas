  case FComboStyle of
    kcsDropDown:
      begin
        if not (csLoading in ComponentState) then
        begin
          ReadOnly := FOldReadOnly;
        end;
        
        if HandleAllocated then ShowCaret;
        FOldReadOnly := ReadOnly;
      end;
    kcsDropDownList:
      begin
        if ItemIndex = -1 then ItemIndex := 0;
        FOldReadOnly := ReadOnly;
        ReadOnly := true;
        Text := '';
        if HandleAllocated then HideCaret;
      end;
  end;

  Invalidate;
end;

