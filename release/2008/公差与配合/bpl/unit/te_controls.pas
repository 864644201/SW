procedure TTeCustomControlBar.CMControlListChange(var Message: TCMControlListChange);
begin
  inherited;
  if not Message.Inserting then
  begin
    if Message.Control = FDragControl then
      FDragControl := nil;
    UnDockControl(Message.Control);
    if AutoSize then AdjustSize;
    Invalidate;
  end;
end;

procedure TTeCustomControlBar.CMDesignHitTest(var Message: TCMDesignHitTest);
begin
  Message.Result := Ord((FDragControl <> nil) or
    (HitTest(Message.XPos, Message.YPos) <> nil));
end;



const
  WideSpace = WideChar(#32);

type
  THackClipboard = class(TClipboard);

function CharToWideChar(Ch: Char): WideChar;
var
  S: string;
  W: WideString;
begin
  S := Ch;
  SetLength(W, 1);
  MultibyteToWideChar(CP_ACP, MB_PRECOMPOSED, PChar(S), Length(S), PWideChar(W), SizeOF(W));

  Result := W[1];
end;

