  Width := 121;
  Height := GetSystemMetrics(SM_CYVTHUMB) + FBorderWidth * 2;
  Performance := kspDoubleBuffer;

  FBorderWidth := 1;

  FMin := 0;

  FMax := 100;
  FPageSize := 0;
  FPosition := 0;
  FLargeChange := 1;
  FSmallChange := 1;

  FKind := sbHorizontal;
  FShowButtons := true;

  FSliderCatchCoord := -1;
  FMouseOnSlider := False;
  FMouseOnLeftTopBtn := false;
  FMDownOnLeftTopBtn := false;
  FMouseOnRightBottomBtn := false;
  FMDownOnRightBottomBtn := false;
  FMouseOnLeftTopTrack := false;
