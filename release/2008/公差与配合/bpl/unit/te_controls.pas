procedure TTePopupView.InvalidateView;
begin
  FPopupWindow.FForm.InvalidateNow;
end;

procedure TTePopupView.InvalidateItem(AItem: TTeCustomItem);
begin
  if (FPopupWindow.FForm.Performance = ksfpNoBuffer) and not
     (FPopupWindow.FForm.Blending.Enabled) then
  begin
    { Direct updating }
    AItem.DrawItem(FPopupWindow.FForm.Canvas, Self, AItem.ItemRect, AItem = SelItem, not Loop);
  end
  else
  begin
    if AItem.Parent = nil then Exit;

    { Disable drawing all items }
    AItem.Parent.DrawingDisabled := true;
    try
      { Enable drawing only AItem }
      AItem.DrawingDisabled := false;
      { Draw only item }
      FPopupWindow.FForm.InvalidateRect(AItem.ItemRect);
    finally
      { Enable drawing all items }
      AItem.Parent.DrawingDisabled := false;
    end;
  end;
end;

procedure TTePopupView.InvalidateScrollButton(Button: TTeMenuScrollButton);
begin
  if (FPopupWindow.FForm.Performance = ksfpNoBuffer) and not
     (FPopupWindow.FForm.Blending.Enabled) then
  begin
    { Direct updating }
    Items.DrawScrollButton(FPopupWindow.FForm.Canvas, Self, GetScrollButtonRect(Button), Button, ActiveScrollButton = Button);
  end
  else
  begin
    { Disable drawing all items }
    Items.DrawingDisabled := true;
    try
      { Draw only scroll button }
      FPopupWindow.FForm.InvalidateRect(GetScrollButtonRect(Button));
    finally
      { Enable drawing all items }
      Items.DrawingDisabled := false;
    end;
  end;
end;

