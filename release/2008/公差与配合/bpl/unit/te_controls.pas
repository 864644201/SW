{ ProgressBar }

function TTeCustomProgressBar.GetPercent(APosition: integer): single;
begin
  if (Min >= 0) and (APosition >= Min) and (Max >= APosition) and (Max - Min <> 0) then
    Result := (APosition - Min) / (Max - Min)
  else
    Result := 0;
end;

function TTeCustomProgressBar.GetBarRect: TRect;
begin
  Result := Rect(0, 0, FWidth, FHeight);

  if FShowBorder then
    InflateRect(Result, -2, -2);

  InflateRect(Result, -FBorderWidth, -FBorderWidth);
end;

procedure TTeCustomProgressBar.PaintFrame;
var
  R: TRect;
  BackColor: TKColor;
  RColor, SColor: TKColor;
  Theme: HTheme;
  Part, tState: integer;
begin
  R := Rect(0, 0, FWidth, FHeight);

  if not UseThemes then
  begin
    { Draw Border }
    if FShowBorder then
    begin
      DrawEdge(Canvas, R, clBtnShadow, clBtnHighlight);
      InflateRect(R, -1, -1);
    end;

    FillRect(Canvas, R, Color);
  end
  else
  begin
    { XP Style }
    Theme := OpenThemeData(0, 'Progress');

    if FOrientation = kboHorizontal then
      Part := integer(PP_BAR)
    else
      Part := integer(PP_BARVERT);

    if FShowBorder then
      DrawThemeBackground(Theme, Canvas.Handle, Part, tState, R, nil);

    CloseThemeData(Theme);
  end;
end;

procedure TTeCustomProgressBar.PaintBar;
var
  FillR, R: TRect;
  i, W, Pos: integer;
  SegW, SegH, SegCount, FillSegCount: integer;
  FillColor: TColor;
  Theme: HTheme;
  Part, tState: integer;
begin
  R := GetBarRect;
  if Orientation = kboHorizontal then
    W := RectWidth(R)
  else
    W := RectHeight(R);
  { Calc Pos }
  Pos := Round(W * GetPercent(Position));
  { Set FillR }
  FillR := R;

  { Set FillColor }
  FillColor := clHighlight;

  if UseThemes then
  begin
    { XP Style }
    Theme := OpenThemeData(0, 'Progress');

    if FOrientation = kboHorizontal then
    begin
      FillR.Right := FillR.Left + Pos;
      Part := integer(PP_CHUNK)
    end
    else
    begin
      FillR.Top := FillR.Bottom - Pos;
      Part := integer(PP_CHUNKVERT);
    end;

    DrawThemeBackground(Theme, Canvas.Handle, Part, tState, FillR, nil);

    CloseThemeData(Theme);
  end
  else
  begin
    { Draw default bar }
    if FOrientation = kboHorizontal then
    begin
      { Horizontal }
      FillR.Right := FillR.Left + Pos;

      if FSmooth then
      begin
        { Smooth }
        FillRect(Canvas, FillR, FillColor);
      end
      else
      begin
        { Segments }
        SegH := RectHeight(R);
        SegW := Round(SegH * SegRation) + SegSpacing;
        { Calc SegCount }
        SegCount := W div SegW;
        FillSegCount := Round(SegCount * GetPercent(Position));
        { Draw Segments }
        if GetPercent(Position) >= 0.01 then
          for i := 0 to FillSegCount do
          begin
            FillR := R;
            FillR.Right := FillR.Left + SegW - SegSpacing;
            OffsetRect(FillR, i * SegW, 0);
            { Clip }
            IntersectRect(FillR, FillR, R);
            { Draw }
            FillRect(Canvas, FillR, FillColor);
          end;
      end;
    end
    else
    begin
      { Vertical }
      FillR.Top := FillR.Bottom - Pos;

      if FSmooth then
      begin
        { Smooth }
        FillRect(Canvas, FillR, FillColor);
      end
      else
      begin
        { Segments }
        SegH := RectWidth(R);
        SegW := Round(SegH * SegRation) + SegSpacing;
        { Calc SegCount }
        SegCount := W div SegW;
        FillSegCount := Round(SegCount * GetPercent(Position));
        { Draw Segments }
        if GetPercent(Position) >= 0.01 then
          for i := 0 to FillSegCount do
          begin
            FillR := R;
            FillR.Top := FillR.Bottom - SegW + SegSpacing;
            OffsetRect(FillR, 0, - (i * SegW));
            { Clip }
            IntersectRect(FillR, FillR, R);
            { Draw }
            FillRect(Canvas, FillR, FillColor);
          end;
      end;
    end;
  end;
end;

