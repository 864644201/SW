{ Mouse }

procedure TTeCustomButton.KeyDown(var Key: Word; Shift: TShiftState);
begin
  if (Key = vk_Space) and not (ssAlt in Shift) then
  begin
    FState := kbsPressed;
    Invalidate;
  end;
  inherited KeyDown(Key, Shift);
end;

procedure TTeCustomButton.KeyUp(var Key: Word; Shift: TShiftState);
begin
  if Key = vk_Space then
  begin
    FState := kbsNormal;
    Invalidate;
    Click;
    Key := 0;
  end;
  inherited KeyUp(Key, Shift);
end;

procedure TTeCustomButton.MouseDown(Button: TMouseButton; Shift: TShiftState;
  X, Y: Integer);
begin
  inherited MouseDown(Button, Shift, X, Y);

  if (Button = mbLeft) and Enabled then
  begin
   if not (csDesigning in ComponentState) and Enabled then
      SetFocus;
    FState := kbsPressed;
    Invalidate;
    FDragging := True;
  end;
end;

procedure TTeCustomButton.MouseMove(Shift: TShiftState; X, Y: Integer);
var
  NewState: TTeButtonState;
begin
  inherited MouseMove(Shift, X, Y);

  if FDragging then
  begin
    if (X >= 0) and (X < ClientWidth) and (Y >= 0) and (Y <= ClientHeight) then
      NewState := kbsPressed
    else
      NewState := kbsNormal;

    if NewState <> FState then
    begin
      FState := NewState;
      Invalidate;
    end;
  end;
end;

procedure TTeCustomButton.MouseUp(Button: TMouseButton; Shift: TShiftState;
  X, Y: Integer);
begin
  inherited MouseUp(Button, Shift, X, Y);

  if FDragging then
  begin
    FDragging := false;
    FState := kbsNormal;
    if PtInRect(Rect(0, 0, FWidth, FHeight), Point(X, Y)) then
      Click;
    Invalidate;
  end;
end;

