  FDividerWidth := 8;
end;

destructor TTeCustomToolBar.Destroy;
begin
  inherited Destroy;
end;

function TTeCustomToolBar.IsHorizontal: boolean;
begin
  Result := (FWidth >= FHeight) or (Align in [alTop, alBottom]);
end;

procedure TTeCustomToolBar.PaintBuffer;
var
  Theme: HTheme;
  Part, ThemeState: integer;
  R: TRect;
begin
  if not UseThemes then
    FillRect(Canvas, Rect(0, 0, FWidth, FHeight), Color)
  else
  begin
    { XP Style }
    Theme := OpenThemeData(0, 'Rebar');

    Part := integer(0);
    ThemeState := integer(0);

    if Parent is TTeCustomControlBar then
    begin
      R := Parent.ClientRect;
      OffsetRect(R, -Left, -Top);

      DrawThemeBackground(Theme, Canvas.Handle, Part, ThemeState, R, nil)
    end
    else
      DrawThemeBackground(Theme, Canvas.Handle, Part, ThemeState, Rect(0, 0, FWidth, FHeight), nil);

    CloseThemeData(Theme);
  end;
end;

procedure TTeCustomToolBar.AlignControls(AControl: TControl;
  var Rect: TRect);
var
  AlignList: TList;
  FOriginalParentSize: TPoint;
  FAnchorRules: TPoint;

  function InsertBefore(C1, C2: TControl; AAlign: TAlign): Boolean;
  begin
    Result := False;
    case AAlign of
      alTop: Result := C1.Top < C2.Top;
      alBottom: Result := (C1.Top + C1.Height) >= (C2.Top + C2.Height);
      alLeft: Result := C1.Left < C2.Left;
      alRight: Result := (C1.Left + C1.Width) >= (C2.Left + C2.Width);
    end;
  end;

  procedure DoPosition(Control: TControl; AAlign: TAlign);
  var
    NewLeft, NewTop, NewWidth, NewHeight: Integer;
    ParentSize: TPoint;
  begin
    with Rect do
    begin
      NewWidth := Right - Left;
      if (NewWidth < 0) or (AAlign in [alLeft, alRight]) then
        NewWidth := Control.Width;
      NewHeight := Bottom - Top;
      if (NewHeight < 0) or (AAlign in [alTop, alBottom]) then
        NewHeight := Control.Height;
      NewLeft := Left;
      NewTop := Top;
      case AAlign of
        alTop:
          begin
            Inc(Top, NewHeight);
            NewWidth := Right - Left;
          end;
        alBottom:
          begin
            Dec(Bottom, NewHeight);
            NewTop := Bottom;
          end;
        alLeft:
          begin
            Inc(Left, NewWidth);
            NewHeight := Bottom - Top;
          end;
        alRight:
          begin
            Dec(Right, NewWidth);
            NewLeft := Right;
          end;
      end;
    end;

    Control.SetBounds(NewLeft, NewTop, NewWidth, NewHeight);

    { Adjust client rect if control didn't resize as we expected }
    if (Control.Width <> NewWidth) or (Control.Height <> NewHeight) then
      with Rect do
        case AAlign of
          alTop: Dec(Top, NewHeight - Control.Height);
          alBottom: Inc(Bottom, NewHeight - Control.Height);
          alLeft: Dec(Left, NewWidth - Control.Width);
          alRight: Inc(Right, NewWidth - Control.Width);
          alClient:
            begin
              Inc(Right, NewWidth - Control.Width);
              Inc(Bottom, NewHeight - Control.Height);
            end;
        end;
  end;

  procedure DoAlign(AAlign: TAlign);
  var
    I, J: Integer;
    Control: TControl;
  begin
    AlignList.Clear;
    if (AControl <> nil)  then
      AlignList.Add(AControl);
      
    for I := 0 to ControlCount - 1 do
    begin
      Control := Controls[I];
      if not Control.Visible Then Continue; 
      if Control = AControl then Continue;

      J := 0;
      while (J < AlignList.Count) and not InsertBefore(Control,
        TControl(AlignList[J]), AAlign) do Inc(J);
      AlignList.Insert(J, Control);
    end;
    
    for I := 0 to AlignList.Count - 1 do
      DoPosition(TControl(AlignList[I]), AAlign);
  end;

  procedure DoSetWidth;
  var
    i: integer;
    Control: TControl;
  begin
    if not FButtonAutoSize then Exit;

    for i := 0 to ControlCount - 1 do
    begin
      Control := Controls[i];
      if not Control.Visible Then Continue; 

      if Control is TTeCustomSpeedButton then
      begin
        if (Control as TTeCustomSpeedButton).ShowChevron then
          if IsHorizontal then
            Control.Width := FButtonWidth + (Control as TTeCustomSpeedButton).ChevronWidth
          else
            Control.Height := FButtonWidth + (Control as TTeCustomSpeedButton).ChevronWidth
        else
          if IsHorizontal then
            Control.Width := FButtonWidth
          else
            Control.Height := FButtonWidth
      end;

      if Control is TTeSpeedDivider then
        if IsHorizontal then
          Control.Width := FDividerWidth
        else
          Control.Height := FDividerWidth
    end;
  end;

begin
  if Parent <> nil then
    FOriginalParentSize := Point(Parent.Width, Parent.Height)
  else
    FOriginalParentSize := Point(FWidth, FHeight);
  FAnchorRules := Point(0, 0);

  { Set children width }
  DoSetWidth;

  { Aligning }
  AdjustClientRect(Rect);
  AlignList := TList.Create;
  try
    if IsHorizontal then
      DoAlign(alLeft)
    else
      DoAlign(alTop);
  finally
    AlignList.Free;
  end;
end;

