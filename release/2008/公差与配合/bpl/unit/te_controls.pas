procedure DrawBevel(Canvas: TCanvas; var R: TRect; BevelSides: TTeBevelSides; Width: integer; RaisedColor, SunkenColor: TColor);
var
  i: integer;
begin
  for i := 0 to Width - 1 do
  begin
    { Left side }
    if kbsLeft in BevelSides then
    begin
      MoveTo(Canvas, R.Left, R.Top);
      LineTo(Canvas, R.Left, R.Bottom, RaisedColor);
    end;
    { Top side }
    if kbsTop in BevelSides then
    begin
      MoveTo(Canvas, R.Left, R.Top);
      LineTo(Canvas, R.Right, R.Top, RaisedColor);
    end;
    { Bottom side }
    if kbsBottom in BevelSides then
    begin
      MoveTo(Canvas, R.Left, R.Bottom - 1);
      LineTo(Canvas, R.Right, R.Bottom - 1, SunkenColor);
    end;
    { Right side }
    if kbsRight in BevelSides then
    begin
      MoveTo(Canvas, R.Right - 1, R.Top);
      LineTo(Canvas, R.Right - 1, R.Bottom, SunkenColor);
    end;

    { Inflate R }
    if kbsLeft in BevelSides then Inc(R.Left);
    if kbsTop in BevelSides then Inc(R.Top);
    if kbsRight in BevelSides then Dec(R.Right);
    if kbsBottom in BevelSides then Dec(R.Bottom);
  end;
end;

