  Result:= nil;
  for I:= 0 to Count - 1 do
    if Pos(AnsiUpperCase('&' + C), AnsiUpperCase(Items[i].Caption)) > 0 then
    begin
      Result:= Items[i];
      Break;
    end;
end;

function TTeCustomItem.FindItem(Value: Integer; Kind: TFindItemKind): TTeCustomItem;
var
  FoundItem: TTeCustomItem;

  function Find(Item: TTeCustomItem): Boolean;
  var
    I: Integer;
  begin
    Result := False;
    if ((Kind = fkShortCut) and (Value = Item.ShortCut)) then
    begin
      FoundItem := Item;
      Result := True;
      Exit;
    end
    else
      if ((Kind = fkHandle) and (Value = Integer(@Item.OnClick))) and (Assigned(Item.OnClick)) then
      begin
        FoundItem := Item;
        Result := True;
        Exit;
      end
      else
        for I := 0 to Item.Count - 1 do
        if Find(Item[I]) then
        begin
          Result := True;
          Exit;
        end;
  end;

begin
  FoundItem := nil;
  Find(Self);
  Result := FoundItem;
end;

function TTeCustomItem.IsShortCut(var Msg: TWMKey): boolean;
type
  TClickResult = (crDisabled, crClicked, crShortCutMoved, crShortCutFreed);
const
  AltMask = $20000000;
var
  ShortCut: TShortCut;
  ClickResult: TClickResult;
  ShortCutItem: TTeCustomItem;

  function NthParentOf(Item: TTeCustomItem; N: Integer): TTeCustomItem;
  begin
    Result := Item;
    while (N > 0) and (Result <> nil) do
    begin
      Result := Result.Parent;
      Dec(N);
    end;
  end;

  function DoClick(var Item: TTeCustomItem; Level: Integer): TClickResult;
  var
    ItemParent: TTeCustomItem;
  begin
    Result := crClicked;
    ItemParent := Item.Parent;
    // Assert(Item = NthParentOf(ShortCutItem, Level));
    if ItemParent <> nil then Result := DoClick(ItemParent, Level + 1);
    if Result in [crDisabled, crShortCutFreed] then Exit;
    if Result = crShortCutMoved then
    begin
      // Shortcut moved, we need to refind the shortcut and restore Item
      // to point to the parent at the right level, if possible
      if (ShortCutItem = nil) or (ShortCutItem.ShortCut <> ShortCut) then
      begin
        ShortCutItem := FindItem(ShortCut, fkShortCut);
        if ShortCutItem = nil then
        begin
          Result := crShortCutFreed;
          Exit; // Shortcut item could not be found
        end;
      end;
      Item := NthParentOf(ShortCutItem, Level);
      if (Item = nil) or (Item.Parent <> ItemParent) then
        Exit; // Shortcut moved in structure, level not correct
      if Level = 0 then Result := crClicked;
    end;
    if Item.Enabled then
      try
        Item.DoClick;
        if (ShortCutItem = nil) or
          ((Item <> ShortCutItem) and (ShortCutItem.ShortCut <> ShortCut)) then
          Result := crShortCutMoved;
      except
        Application.HandleException(Self);
      end
    else Result := crDisabled;
  end;

begin
  ShortCut := Byte(Msg.CharCode);
  if GetKeyState(VK_SHIFT) < 0 then Inc(ShortCut, scShift);
  if GetKeyState(VK_CONTROL) < 0 then Inc(ShortCut, scCtrl);
  if Msg.KeyData and AltMask <> 0 then Inc(ShortCut, scAlt);
  repeat
    ClickResult := crDisabled;
    ShortCutItem := FindItem(ShortCut, fkShortCut);
    if ShortCutItem <> nil then
    begin
      {$IFNDEF KS_COMPILER4_UP}
      ShortCutItems.Push(@ShortCutItem);
      {$ENDIF}
      try
        ClickResult := DoClick(ShortCutItem, 0);
      finally
        {$IFNDEF KS_COMPILER4_UP}
        ShortCutItems.Pop;
        {$ENDIF}
      end;
    end;
  until ClickResult <> crShortCutMoved;
  Result := ShortCutItem <> nil;
end;

