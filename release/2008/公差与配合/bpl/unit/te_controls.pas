  end;
end;

procedure TTeHeaderSection.SetStyle(const Value: TTeHeaderSectionStyle);
begin
  if FStyle <> Value then
  begin
    FStyle := Value;
    HeaderControl.SectionChanged(Index, False);
  end;
end;

procedure TTeHeaderSection.SetText(const Value: WideString);
begin
  if FText <> Value then
  begin
    FText := Value;
    HeaderControl.SectionChanged(Index, AutoSize)
  end;
end;

procedure TTeHeaderSection.SetWidth(const Value: integer);
begin
  if FWidth <> Value then
  begin
    if Value > MaxWidth then
      FWidth := MaxWidth
    else if Value < MinWidth then
      FWidth := MinWidth
    else
      FWidth := Value;

    if not AutoSize then
      HeaderControl.SectionChanged(Index, True);
  end;
end;

