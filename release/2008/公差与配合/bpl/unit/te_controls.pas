procedure TTeCustomListBox.SetBounds(ALeft, ATop, AWidth,
  AHeight: Integer);
var
  R: TRect;
begin
  if not (csLoading in ComponentState) then
    if not WordWrap and (ListStyle <> lbOwnerDrawVariable) and (ItemHeight > 0) and
      HandleAllocated and (Align in [alNone, alTop, alBottom]) then
    begin
      FHeight := AHeight;
      R := GetBorderRect;
      AHeight := (RectHeight(R) div ItemHeight) * ItemHeight + R.Top + (FHeight - R.Bottom);
    end;

  inherited SetBounds(ALeft, ATop, AWidth, AHeight);
  UpdateScrlBar;
end;

