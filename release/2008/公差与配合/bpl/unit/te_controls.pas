{ Popup }

function TTeCustomItem.GetOwnerCustomForm: TComponent;
var
  Form: TWinControl;
  i: integer;
begin
  Result := nil;

  if FOwnerForm = nil then Exit;

  Form := FOwnerForm as TWinControl;
  if Form <> nil then
  begin
    for i := 0 to Form.ComponentCount - 1 do
      if Form.Components[i] is TTeCustomForm then
      begin
        Result := Form.Components[i] as TTeCustomForm;
        Exit;
      end;
  end
  else
    Result := nil;
end;

procedure TTeCustomItem.Popup(View: TTeItemView; X, Y: integer; Rect: TRect);
var
  PopupWindow: TTePopupWindow;
  ScreenR: TRect;
  OwnerCustomForm: TTeCustomForm;
  ParentForm: TComponent;
  Allow: boolean;
  i: integer;
begin
  if Count = 0 then Exit;

  { Check for empty menu }
  Allow := false;
  for i := 0 to Count - 1 do
    if Items[i].Visible then
      Allow := true;

  if not Allow then Exit;

  if Assigned(FOnBeforeDropDown) then FOnBeforeDropDown(Self);


  PopupWindow := TTePopupWindowClass(CreatePopupWindowClass).CreatePopupWindow(Owner, Self, View);
  try
    { Calc position }
    ScreenR := GetRectOfMonitorContainingPoint(Point(X, Y), false);

    if RectWidth(Rect) > 0 then
    begin
      if View.FIsMenuBar then
      begin
        PopupWindow.SetBounds(Rect.Left, Rect.Bottom, 0, 0);
        PopupWindow.CalcSize;

        if PopupWindow.Left + PopupWindow.Width > ScreenR.Right then
          PopupWindow.Left := Rect.Right - PopupWindow.Width;
        if PopupWindow.Top + PopupWindow.Height > ScreenR.Bottom then
        begin
          PopupWindow.Top := Rect.Top - PopupWindow.Height;
          if PopupWindow.Top < 0 then
            PopupWindow.Top := ScreenR.Top;
        end;
      end
      else
      begin
        PopupWindow.SetBounds(Rect.Right, Rect.Top, 0, 0);
        PopupWindow.CalcSize;

        if PopupWindow.Left + PopupWindow.Width > ScreenR.Right then
          PopupWindow.Left := Rect.Left - PopupWindow.Width;
        if PopupWindow.Top + PopupWindow.Height > ScreenR.Bottom then
          PopupWindow.Top := Rect.Bottom - PopupWindow.Height;
      end;

      if PopupWindow.Left + PopupWindow.Width > ScreenR.Right then
        PopupWindow.Left := ScreenR.Right - PopupWindow.Width;
      if PopupWindow.Top + PopupWindow.Height > ScreenR.Bottom then
        PopupWindow.Top := ScreenR.Bottom - PopupWindow.Height;
    end
    else
    begin
      PopupWindow.SetBounds(X, Y, 0, 0);
      PopupWindow.CalcSize;

      if PopupWindow.Left + PopupWindow.Width > ScreenR.Right then
        PopupWindow.Left := X - PopupWindow.Width;
      if PopupWindow.Top + PopupWindow.Height > ScreenR.Bottom then
        PopupWindow.Top := Y - PopupWindow.Height;
    end;

    { Disable Owner Drawing }
    OwnerCustomForm := TTeCustomForm(GetOwnerCustomForm);
    if OwnerCustomForm <> nil then
      OwnerCustomForm.DisableDrawing;
    { Show Popup Window }
    PopupWindow.Visible := true;
    { Set foreground in application not active }
    if FTray then
      SetForegroundWindow(PopupWindow.Handle);
    { Enable Owner Drawing }
    if OwnerCustomForm <> nil then
      OwnerCustomForm.EnableDrawing;
    { Set internal properties }
    if View <> nil then
      View.FChildView := PopupWindow.View;

    PopupWindow.EnterLoop;

    if View <> nil then
      View.FChildView := nil;
  finally
    PopupWindow.Free;
  end;
end;

{ Measure and Drawing }

function TTeCustomItem.UseRightToLeftReading: Boolean;
begin
  Result := SysLocale.MiddleEast and (BiDiMode <> bdLeftToRight);
end;

function TTeCustomItem.UseRightToLeftAlignment: Boolean;
begin
  Result := SysLocale.MiddleEast and (BiDiMode = bdRightToLeft);
end;

function TTeCustomItem.DrawTextBiDiModeFlags(Flags: Longint): Longint;
begin
  Result := Flags;
  { do not change center alignment }
  if UseRightToLeftAlignment then
    if Result and DT_RIGHT = DT_RIGHT then
      Result := Result and not DT_RIGHT { removing DT_RIGHT, makes it DT_LEFT }
    else if not (Result and DT_CENTER = DT_CENTER) then
      Result := Result or DT_RIGHT;
  Result := Result or DrawTextBiDiModeFlagsReadingOnly;
end;

function TTeCustomItem.DrawTextBiDiModeFlagsReadingOnly: Longint;
begin
  if UseRightToLeftReading then
    Result := DT_RTLREADING
  else
    Result := 0;
end;

function TTeCustomItem.GetGlyphSize: integer;
begin
  if (ImgList <> nil) and (ImgList.Width > MenuHeight) then
    Result := ImgList.Width + 6
  else
    Result := GlyphWidth;
end;

procedure TTeCustomItem.CalcSize(Canvas: TCanvas; View: TTeItemView; var AWidth, AHeight: integer);
begin
  if Canvas = nil then Exit;

  Canvas.Font.Assign(MenuFont);

  AWidth := MenuWidth;
  AHeight := MenuHeight;

  if View.FIsMenuBar then
  begin
    AWidth := TextWidth(Canvas, FCaption, DT_NOPREFIX) + 12;

    if FMDIItemKind <> mikNone then
      AWidth := AHeight;
  end
  else
  begin
    AWidth := GetGlyphSize + TextWidth(Canvas, FCaption, DT_NOPREFIX) + ItemStep + SubMenuWidth;
    if FShortCut <> 0 then
      AWidth := AWidth + Canvas.TextWidth(ShortCutToText(FShortCut));

    { Separator }
    if Caption = '-' then
      AHeight := SepHeight
    else
      if (ImgList <> nil) and (ImgList.Height > AHeight) then
        AHeight := ImgList.Height + 4;
  end;
end;

procedure TTeCustomItem.DrawScrollButton(Canvas: TCanvas;
  View: TTeItemView; Rect: TRect; Button: TTeMenuScrollButton;
  Active: boolean);
var
  R: TRect;
begin
  Canvas.Font.Assign(MenuFont);
  
  FillRect(Canvas, Rect, clMenu);
  if Active then
    DrawEdge(Canvas, Rect, clBtnShadow, clBtnHighlight);

  { Draw Arrow }
  if Button = ksbUp then
  begin
    R := Classes.Rect(0, 0, 7, 4);
    RectCenter(R, Rect);

    Canvas.Pen.Style := psSolid;
    Canvas.Pen.Color := Canvas.Font.Color;
    Canvas.Brush.Style := bsSolid;
    Canvas.Brush.Color := Canvas.Font.Color;
    with R do
      Canvas.Polygon([Point(Left, Bottom - 1),
        Point(Right - 1, Bottom - 1),
        Point((Right - 1 + Left) div 2, Top)]);
  end;

  if Button = ksbDown then
  begin
    R := Classes.Rect(0, 0, 7, 4);
    RectCenter(R, Rect);

    Canvas.Pen.Style := psSolid;
    Canvas.Pen.Color := Canvas.Font.Color;
    Canvas.Brush.Style := bsSolid;
    Canvas.Brush.Color := Canvas.Font.Color;
    with R do
      Canvas.Polygon([Point(Left, Top),
        Point(Right - 1, Top),
        Point((Right - 1 + Left) div 2, Bottom - 1)]);
  end;
end;

procedure TTeCustomItem.DrawItem(Canvas: TCanvas; View: TTeItemView; Rect: TRect;
  Active, Hover: boolean);
var
  R: TRect;
  S: string;
  i, j: integer;
  Color: TColor;
  Points: array[0..11] of TPoint;
  Flags, X, Y: integer;
  IHandle, IHandle2 : HICON;
  IconX, IconY : integer;
  ID: boolean;
  Theme: HTheme;
  Part, tState: integer;
begin
  Canvas.Font.Assign(MenuFont);

  if View.FIsMenuBar then
  begin
    { MDI Items }
    if FMDIItemKind <> mikNone then
    begin
      FillRect(Canvas, Rect, clMenu);

      Flags := DFCS_BUTTONPUSH;
      
      if Active then
        if Hover then
          Flags := Flags or DFCS_FLAT
        else
          Flags := Flags or DFCS_PUSHED;

      case FMDIItemKind of
        mikSysMenu: if (FActiveMDIForm <> nil) and (FActiveMDIForm is TTeCustomForm) then
        begin
          ID := false;
          if TForm((FActiveMDIForm as TTeCustomForm).Form).Icon.Handle <> 0 then
            IHandle := TForm((FActiveMDIForm as TTeCustomForm).Form).Icon.Handle
          else
            if Application.Icon.Handle <> 0 then
              IHandle := Application.Icon.Handle
            else
            begin
              IHandle := LoadIcon(0, IDI_APPLICATION);
              ID := true;
            end;
          IconX := GetSystemMetrics(SM_CXSMICON);
          if IconX = 0 then IconX := GetSystemMetrics(SM_CXSIZE);
          IconY := GetSystemMetrics(SM_CYSMICON);
          if IconY = 0 then IconY := GetSystemMetrics(SM_CYSIZE);
          IHandle2 := CopyImage(IHandle, IMAGE_ICON, IconX, IconY, LR_COPYFROMRESOURCE);

          if Active then
            if Hover then
              DrawEdge(Canvas, Rect, clBtnHighlight, clBtnShadow)
            else
              DrawEdge(Canvas, Rect, clBtnShadow, clBtnHighlight);

          InflateRect(Rect, -1, -1);
          DrawIconEx(Canvas.Handle, Rect.Left, Rect.Top, IHandle2, 0, 0, 0, 0, DI_NORMAL);

          DestroyIcon(IHandle2);
          if ID then DestroyIcon(IHandle);
        end;
        mikMinimize: begin
          InflateRect(Rect, -2, -2);
          Inc(Rect.Right);
          Dec(Rect.Bottom);

          Flags := Flags or DFCS_CAPTIONMIN;
          DrawFrameControl(Canvas.Handle, Rect, DFC_CAPTION, Flags);
        end;
        mikRestore: begin
          InflateRect(Rect, -2, -2);
          Inc(Rect.Right);
          Dec(Rect.Bottom);

          Flags := Flags or DFCS_CAPTIONRESTORE;
          DrawFrameControl(Canvas.Handle, Rect, DFC_CAPTION, Flags);
        end;
        mikClose: begin
          InflateRect(Rect, -2, -2);
          Inc(Rect.Right);
          Dec(Rect.Bottom);

          Flags := Flags or DFCS_CAPTIONCLOSE;
          DrawFrameControl(Canvas.Handle, Rect, DFC_CAPTION, Flags);
        end;
      end;

      Exit;
    end;

    if UseThemes and (GetParentComponent <> nil) and (GetParentComponent is TTeCustomMenuBar) and
      ((GetParentComponent as TWinControl).Parent is TTeCustomControlBar) then
    begin
      { ControlBar's chldren }
      Theme := OpenThemeData(0, 'Toolbar');
      Part := integer(TP_BUTTON);

      tState := integer(TS_NORMAL);
      if Active then
      begin
        if Hover then
          tState := integer(TS_HOT)
        else
          tState := integer(TS_PRESSED);
      end;

      DrawThemeBackground(Theme, Canvas.Handle, Part, tState, Rect, nil);
      CloseThemeData(Theme);

      { Draw Text }
      DrawText(Canvas, Caption, Rect, DrawTextBiDiModeFlags(DT_CENTER or DT_VCENTER or DT_SINGLELINE));
    end
    else
    begin
      { Standard menu }
      FillRect(Canvas, Rect, clMenu);
      if Enabled then
        if not UseThemes then
        begin
          if Active then
          begin
            if Hover then
              DrawEdge(Canvas, Rect, clBtnHighlight, clBtnShadow)
            else
              DrawEdge(Canvas, Rect, clBtnShadow, clBtnHighlight);
          end;
        end
        else
          if Active then
          begin
            R := Rect;
            InflateRect(R, -1, -1);
            FillRect(Canvas, R, clHighlight); // XP Style
          end;

      if UseThemes then
      begin
        if Active then
          Canvas.Font.Color := clHighlightText
        else
          Canvas.Font.Color := clMenuText;
      end
      else
        Canvas.Font.Color := clMenuText;

      if not Enabled then
      begin
        OffsetRect(Rect, 1, 1);
        Canvas.Font.Color := clBtnHighlight;
        DrawText(Canvas, Caption, Rect, DrawTextBiDiModeFlags(DT_CENTER or DT_VCENTER or DT_SINGLELINE));
        OffsetRect(Rect, -1, -1);
        Canvas.Font.Color := clBtnShadow;
      end;

      DrawText(Canvas, Caption, Rect, DrawTextBiDiModeFlags(DT_CENTER or DT_VCENTER or DT_SINGLELINE));
    end;
  end
  else
  begin
    { Separator }
    if Caption = '-' then
    begin
      FillRect(Canvas, Rect, clMenu);
      InflateRect(Rect, -2, -((SepHeight div 2)));
      Rect.Bottom := Rect.Top + 2;
      DrawEdge(Canvas, Rect, clBtnShadow, clBtnHighlight);
    end
    else
    begin
      if Active then
      begin
        Color := clHighlight;
        FillRect(Canvas, Rect, Color);
        Canvas.Font.Color := clHighlightText;
      end
      else
      begin
        Color := clMenu;
        Canvas.Font.Color := clMenuText;
        FillRect(Canvas, Rect, Color);
      end
    end;

    { Draw Image and Checked }
    if (FChecked) or ((ImgList <> nil) and (FImageIndex >= 0)) then
    begin
      { Draw Edge }
      R := Rect;
      R.Right := R.Left + GetGlyphSize;

      if not UseThemes then
        FillRect(Canvas, R, clBtnFace);

      R.Right := R.Left + RectHeight(R);
      if Checked then
        if Active then
        begin
          { Checked and Active }
          if not UseThemes then
            DrawEdge(Canvas, R, clBtnShadow, clBtnHighlight)
        end
        else
        begin
          { Checked and Inactive }
          FillHalftoneRect(Canvas, R, clBtnFace, ckWhite);
          DrawEdge(Canvas, R, clBtnShadow, clBtnHighlight)
        end
      else
        if Active then
        begin
          { Unchecked and Active }
          if not UseThemes then
            DrawEdge(Canvas, R, clBtnHighlight, clBtnShadow);
        end;

      { Draw Glyph }
      if (ImgList <> nil) and (FImageIndex >= 0) then
      begin
        { Draw Image }
        R := Rect;
        R.Right := R.Left + RectHeight(R);
        ImgList.Draw(Canvas,
          R.Left + ((R.Right - R.Left) - ImgList.Width) div 2,
          R.Top + ((R.Bottom - R.Top) - ImgList.Height) div 2,
          FImageIndex, FEnabled);
      end
      else
      begin
        { Draw CheckBox }
        X := (R.Left + R.Right) div 2 - 2;
        Y := (R.Top + R.Bottom) div 2 + 1;
        System.Move(CheckMarkPoints, Points, 12 * SizeOf(TPoint));
        for i := Low(Points) to High(Points) do
        begin
          Inc (Points[I].X, X);
          Inc (Points[I].Y, Y);
        end;
        Canvas.Pen.Color := clBlack;
        Polyline(Canvas.Handle, Points[0], 7);
        Canvas.Pen.Color := clWhite;
        Polyline(Canvas.Handle, Points[7], 5);
      end;
    end;

    { Draw Caption }
    R := Rect;
    Inc(R.Left, GetGlyphSize + 4);

    { Check Enabled }
    if not Enabled then
    begin
      if not Active then
      begin
        OffsetRect(R, 1, 1);
        Canvas.Font.Color := clBtnHighlight;
        DrawText(Canvas, FCaption, R, DrawTextBiDiModeFlags(DT_VCENTER or DT_SINGLELINE));
        OffsetRect(R, -1, -1);
      end;
      Canvas.Font.Color := clBtnShadow;
    end;

    { Draw Caption }
    DrawText(Canvas, FCaption, R, DrawTextBiDiModeFlags(DT_VCENTER or DT_SINGLELINE));

    { Draw ShortCut }
    if FShortCut <> 0 then
    begin
      S := ShortCutToText(FShortCut);
      Dec(R.Right, SubMenuWidth);
      { Check Enabled }
      if not Enabled then
      begin
        if not Active then
        begin
          OffsetRect(R, 1, 1);
          Canvas.Font.Color := clBtnHighlight;
          DrawText(Canvas, S, R, DrawTextBiDiModeFlags(DT_RIGHT or DT_VCENTER or DT_SINGLELINE));
          OffsetRect(R, -1, -1);
        end;
        Canvas.Font.Color := clBtnShadow;
      end;
      { Draw Shortcut }
      DrawText(Canvas, S, R, DrawTextBiDiModeFlags(DT_RIGHT or DT_VCENTER or DT_SINGLELINE));
    end;

    { Draw Submenu Arrow }
    if Count > 0 then
    begin
      R := Rect;
      Dec(R.Right, 2);
      R.Left := R.Right - SubMenuWidth;
      R.Top := R.Top + (RectHeight(R) - SubMenuBitmap.Height) div 2;

      DrawSubMenuBitmap(Canvas, R.Left, R.Top, Canvas.Font.Color);
    end;
  end;
end;

