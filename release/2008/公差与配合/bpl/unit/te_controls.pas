procedure TTeBitmap.MoveTo(X, Y: integer);
begin
  FLinePos := Point(X, Y);
  MoveToEx(FDC, FLinePos.X, FLinePos.Y, nil);
end;

procedure TTeBitmap.LineTo(X, Y: integer; Color: TKColor);
var
  Pen: TPen;
  SavePen: integer;
begin
  Pen := TPen.Create;
  try
    { Set Pen }
    Pen.Style := psSolid;
    Pen.Color := RGB(TKColorRec(Color).R, TKColorRec(Color).G, TKColorRec(Color).B);
    { Select Object }
    SavePen := SelectObject(FDC, Pen.Handle);
    { Draw Line }
    Windows.LineTo(FDC, X, Y);

    FLinePos := Point(X, Y);
  finally
    SelectObject(FDC, SavePen);
    Pen.Free;
  end;
end;

procedure TTeBitmap.DrawLine(R: TRect; Color: TKColor);
begin
  MoveTo(R.Left, R.Top);
  LineTo(R.Right, R.Bottom, Color);
end;

procedure TTeBitmap.DrawEdge(R: TRect; RaisedColor, SunkenColor: TKColor);
var
  Color: TKColor;
  i, j: integer;
begin
  if R.Left < 0 then R.Left := 0;
  if R.Top < 0 then R.Top := 0;
  if R.Right > Width then R.Right := Width;
  if R.Bottom > Height then R.Bottom := Height;
  if RectWidth(R) <= 0 then Exit;
  if RectHeight(R) <= 0 then Exit;

  Color := RaisedColor;
  j := R.Top;
  for i := R.Left to R.Right-2 do
    FBits[i + j * FWidth] := BlendPixel(Color, FBits[i + j * FWidth]);
  i := R.Left;
  for j := R.Top to R.Bottom-2 do
    FBits[i + j * FWidth] := BlendPixel(Color, FBits[i + j * FWidth]);

  Color := SunkenColor;
  j := R.Bottom-1;
  for i := R.Left to R.Right-1 do
    FBits[i + j * FWidth] := BlendPixel(Color, FBits[i + j * FWidth]);
  i := R.Right-1;
  for j := R.Top to R.Bottom-2 do
    FBits[i + j * FWidth] := BlendPixel(Color, FBits[i + j * FWidth]);
end;

procedure TTeBitmap.DrawBevel(R: TRect; Color: TKColor; Width: integer; Down: boolean);
var
  i: integer;
  SColor, RColor: TKColor;
begin
  { Draw bevel }
  for i := 0 to Width-1 do
  begin
    if Width = 1 then
    begin
      SColor := SunkenColor(Color, 35);
      RColor := RaisedColor(Color, 35);
    end
    else
    begin
      SColor := SunkenColor(Color, 17 * (Width-i));
      RColor := RaisedColor(Color, 17 * (Width-i));
    end;

    if Down then
      DrawEdge(R, SColor, RColor)
    else
      DrawEdge(R, RColor, SColor);

    InflateRect(R, -1, -1);
  end;
end;

procedure TTeBitmap.DrawRect(R: TRect; Color: TKColor);
begin
  DrawEdge(R, Color, Color);
end;

