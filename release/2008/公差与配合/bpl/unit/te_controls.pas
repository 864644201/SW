constructor TTeCustomStatusBar.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);
  BevelSides := [kbsLeft, kbsTop, kbsRight, kbsBottom];
  BevelInner := kbvSpace;
  BevelOuter := kbvRaised;
  BevelWidth := 0;
  BorderWidth := 2;

  DrawXPBorder := false; // Disable drawing XP border 

  FPanels := TTeStatusPanels.Create(Self);
  FMouseDownOnPanel := nil;
  FImageList := nil;
  FSizeGrip := true;
  Height := 22;
  ControlStyle := [csAcceptsControls, csCaptureMouse, csDoubleClicks, csClickEvents];
end;

destructor TTeCustomStatusBar.Destroy;
begin
  FPanels.Free;
  inherited;
end;

function TTeCustomStatusBar.GetPanelAt(Pt: TPoint) : TTeStatusPanel;
var
  CurPanelRight: integer;
  TmpRect: TRect;
  CurPanel : integer;
begin
  TmpRect := GetBorderRect;
  with Pt do
    if (y < TmpRect.Top) or (y > TmpRect.Bottom) or
       (x < TmpRect.Left) or (Panels.Count <= 0) then
      CurPanel := -1
    else
    begin
      CurPanelRight := TmpRect.Left;
      CurPanel := -1;
      while (CurPanelRight < x) and (CurPanel+1 <= Panels.Count-1) do
      begin
        Inc(CurPanel);
        Inc(CurPanelRight, Panels[CurPanel].CurrentWidth);
      end;
      if CurPanelRight < x then
        CurPanel := -1;
    end;

  if (CurPanel >= 0) and (CurPanel <= Panels.Count-1) then
    Result := Panels[CurPanel]
  else
    Result := nil;
end;

function TTeCustomStatusBar.GetPanelRect(Index: integer): TRect;
var
  TmpRect: TRect;
begin
  TmpRect := GetBorderRect;
  with Result do
  begin
    Left := Panels[Index].Left;
    Right := Panels[Index].Right;
    Top := TmpRect.Top;
    Bottom := TmpRect.Bottom;
  end;
end;

procedure TTeCustomStatusBar.MouseDown(Button: TMouseButton;
  Shift: TShiftState; x, y: integer);
var
  ParentForm: TTeCustomForm;
  P: TPoint;
  SmallPoint: TSmallPoint;
begin
  inherited;
  if (Button = mbLeft) and Enabled then
    FMouseDownOnPanel := GetPanelAt(Point(x,y));

  if IsSizeGripVisible then
  begin
    ParentForm := GetParentKsForm(Self);

    if PtInRect(GetGripperRect, Point(x, y)) and (ParentForm <> nil) then
    begin
      P := ClientToScreen(Point(x, y));

      SmallPoint.x := P.x;
      SmallPoint.y := P.y;
      SendMessage(ParentForm.Handle, WM_NCLBUTTONDOWN, 0, Longint(SmallPoint));
    end;
  end;
end;

procedure TTeCustomStatusBar.MouseMove(Shift: TShiftState; x,
  y: integer);
var
  ParentForm: TTeCustomForm;
  P: TPoint;
begin
  inherited;

  if IsSizeGripVisible then
  begin
    if PtInRect(GetGripperRect, Point(x, y)) then
      Cursor := crSizeNWSE
    else
      Cursor := crDefault;
  end;
end;

procedure TTeCustomStatusBar.MouseUp(Button: TMouseButton;
  Shift: TShiftState; x, y: integer);
begin
  inherited;
  if FMouseDownOnPanel <> nil then
    if GetPanelAt(Point(x,y)) = FMouseDownOnPanel then
      DoPanelClick(GetPanelAt(Point(x,y)));
end;

procedure TTeCustomStatusBar.PaintBorder;
begin
  if not UseThemes then inherited;
