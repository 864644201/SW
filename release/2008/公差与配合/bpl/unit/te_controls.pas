function KsMessageDlgPosHelp(AOwner: TTeCustomMessage; const Msg: WideString; AType: TMsgDlgType;
  AButtons: TMsgDlgButtons; HelpCtx: Longint; X, Y: Integer;
  const HelpFileName: WideString): Integer;
var
  Form: TTeMessageForm;
begin
  if AOwner = nil then
  begin
    Form := TTeMessageForm(KsCreateMessageDialog(CheckGlobalMsgComp, Msg, AType, AButtons));
    AOwner := GlobalMsgComp;
  end
  else
    Form := TTeMessageForm(KsCreateMessageDialog(AOwner, Msg, AType, AButtons));

  with Form do
  begin
    try
      HelpContext := HelpCtx;
      HelpFile := HelpFileName;
      if (Y < 0) and (X < 0) then
        Position := AOwner.Position
      else
        Position := poDefault;
      if X >= 0 then Left := X;
      if Y >= 0 then Top := Y;

      Application.ProcessMessages;
      FForm.Update;

      Result := ShowModal;
    finally
      Free;
    end;
  end;
end;

