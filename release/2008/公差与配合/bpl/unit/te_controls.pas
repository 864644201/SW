procedure TTeCustomControl.DoHScroll(Sender: TObject; ScrollCode: TTeScrollCode; var ScrollPos: Integer);
var
  Code: integer;
begin
  if FDisableScrollBarUpdate then Exit;

  case ScrollCode of
    kscLineUp: Code := SB_LINELEFT;
    kscLineDown: Code := SB_LINERIGHT;
    kscPageUp: Code := SB_PAGELEFT;
    kscPageDown: Code := SB_PAGERIGHT;
    kscPosition: Code := SB_THUMBPOSITION;
    kscTrack: Code := SB_THUMBTRACK;
    kscTop: Code := SB_LEFT;
    kscBottom: Code := SB_RIGHT;
    kscEndScroll: Code := SB_ENDSCROLL;
  else
    Code := 0;
  end;

  Perform(WM_HSCROLL, Code, ScrollPos);

  ScrollPos := TTeCustomScrollBar(FHScrollBar).Position;
end;

procedure TTeCustomControl.DoVScroll(Sender: TObject; ScrollCode: TTeScrollCode; var ScrollPos: Integer);
var
  Code: integer;
begin
  if FDisableScrollBarUpdate then Exit;

  case ScrollCode of
    kscLineUp: Code := SB_LINEUP;
    kscLineDown: Code := SB_LINEDOWN;
    kscPageUp: Code := SB_PAGEUP;
    kscPageDown: Code := SB_PAGEDOWN;
    kscPosition: Code := SB_THUMBPOSITION;
    kscTrack: Code := SB_THUMBTRACK;
    kscTop: Code := SB_TOP;
    kscBottom: Code := SB_BOTTOM;
    kscEndScroll: Code := SB_ENDSCROLL;
  else
    Code := 0;
  end;

  Perform(WM_VSCROLL, Code, ScrollPos);

  ScrollPos := TTeCustomScrollBar(FVScrollBar).Position;
end;

procedure TTeCustomControl.UpdateScrollBars;
var
  IsUpdate: boolean;
  R: TRect;
  HGrip, VGrip: integer;
begin
  if (FWidth < 0) or (FHeight < 0) then Exit;

  { Update scrollbars }
  if Parent = nil then
    R := Rect(0, 0, FWidth, FHeight)
  else
  begin
    Windows.GetClientRect(Handle, R);
    with GetBorderRect do
    begin
      Inc(R.Left, Left);
      Inc(R.Top, Top);
      Dec(R.Right, FWidth - Right);
      Dec(R.Bottom, FHeight - Bottom);
    end;
  end;

  { Update SizeGrip}
  HGrip := 0;
  VGrip := 0;
  if FHScrollBar <> nil then HGrip := FHScrollBar.Height;
  if FVScrollBar <> nil then VGrip := FVScrollBar.Width;

  { Update }
  if FHScrollBar <> nil then
    FHScrollBar.BoundsRect := Rect(R.Left, R.Bottom - HGrip, R.Right - VGrip, R.Bottom);
  if FVScrollBar <> nil then
    FVScrollBar.BoundsRect := Rect(R.Right-VGrip, R.Top, R.Right, R.Bottom - HGrip);
end;

{ Paint routines }

function TTeCustomControl.GetClientRect: TRect;
begin
  Result := GetBorderRect;

  if FVScrollBar <> nil then
    Dec(Result.Right, FVScrollBar.Width);

  if FHScrollBar <> nil then
    Dec(Result.Bottom, FHScrollBar.Height);
end;

function TTeCustomControl.GetBorderRect: TRect;
begin
  Result := Rect(0, 0, FWidth, FHeight);

  { Inflate to BorderWidth }
  InflateRect(Result, -FBorderWidth, -FBorderWidth);

  { Inflate to Bevel }
  if kbsLeft in FBevelSides then
    Inc(Result.Left, FBevelWidth * (Integer(FBevelInner <> kbvNone) + Integer(FBevelOuter <> kbvNone)));
  if kbsTop in FBevelSides then
    Inc(Result.Top, FBevelWidth * (Integer(FBevelInner <> kbvNone) + Integer(FBevelOuter <> kbvNone)));
  if kbsRight in FBevelSides then
    Dec(Result.Right, FBevelWidth * (Integer(FBevelInner <> kbvNone) + Integer(FBevelOuter <> kbvNone)));
  if kbsBottom in FBevelSides then
    Dec(Result.Bottom, FBevelWidth * (Integer(FBevelInner <> kbvNone) + Integer(FBevelOuter <> kbvNone)));
end;

