    SysMenuImages.AddMasked(B, RGB(255,0,255));
    B.Handle := LoadBitmap(HInstance, PChar('TE_FORM_ROLLUP'));
    SysMenuImages.AddMasked(B, RGB(255,0,255));
    B.Handle := LoadBitmap(HInstance, PChar('TE_FORM_TRAY'));
