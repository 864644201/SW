procedure TTeCustomButton.CMDialogKey(var Msg: TCMDialogKey);
begin
  with Msg do
  begin
    if ( ((CharCode = vk_Return) and FActiveDefault) or
         ((CharCode = vk_Return) and Focused) or
         ((CharCode = vk_Escape) and FCancel) ) and
       (KeyDataToShiftState(KeyData) = []) and CanFocus then
    begin
      Click;
      Result := 1;
    end
    else
      inherited;
  end;
end;

procedure TTeCustomButton.CMDialogChar(var Message: TCMDialogChar);
begin
  with Message do
    if IsAccel(CharCode, Caption) and CanFocus then
    begin
      if CanFocus then SetFocus;
      Click;
      Result := 1;
    end
    else
      inherited;
end;

