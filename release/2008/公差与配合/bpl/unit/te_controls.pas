procedure TTeCustomEditButton.CreateWnd;
begin
  inherited;
end;

function TTeCustomEditButton.IsCustomGlyph: Boolean;
begin
  Result := FGlyphKind = gkCustom;
end;

function InplaceMax(A, B: Longint): Longint;
begin
  if A > B then
    Result := A
  else
    Result := B;
end;

procedure TTeCustomEditButton.SetGlyphKind(Value: TGlyphKind);
begin
  if FGlyphKind <> Value then
  begin
    FGlyphKind := Value;
    if (FGlyphKind = gkCustom) and (csReading in ComponentState) then
      Glyph := nil;

    RecreateGlyph;
    if (FGlyphKind = gkDefault) and (Glyph <> nil) then
      if TTeCustomButton(Button).NumGlyphs > 0 then
        ButtonWidth := InplaceMax(Glyph.Width div TTeCustomButton(Button).NumGlyphs + 6, FButton.Width)
      else
        ButtonWidth := InplaceMax(Glyph.Width + 6, FButton.Width)
  end;
end;

function TTeCustomEditButton.GetDefaultBitmap(var DestroyNeeded: Boolean): TBitmap;
begin
  Result := nil;
end;

procedure TTeCustomEditButton.SetButtonWidth(Value: Integer);
begin
  if ButtonWidth <> Value then
  begin
    FButton.Visible := Value > 1;
    if (csCreating in ControlState) then
    begin
      FButton.Width := Value;
      with FButton do
        ControlStyle := ControlStyle - [csFixedWidth];
      RecreateGlyph;
    end
    else
      if (Value <> ButtonWidth) and (Value < ClientWidth) then
      begin
        FButton.Width := Value;
        with FButton do
          ControlStyle := ControlStyle - [csFixedWidth];
        if HandleAllocated then RecreateWnd;
        RecreateGlyph;
      end;
  end;
end;

function TTeCustomEditButton.GetGlyph: TBitmap;
begin
  Result := TTeCustomButton(Button).Glyph;
end;

procedure TTeCustomEditButton.SetGlyph(Value: TBitmap);
begin
  TTeCustomButton(Button).Glyph := Value;
  FGlyphKind := gkCustom;
end;

function TTeCustomEditButton.GetNumGlyphs: TNumGlyphs;
begin
  Result := TTeCustomButton(Button).NumGlyphs;
end;

procedure TTeCustomEditButton.SetNumGlyphs(Value: TNumGlyphs);
begin
  if FGlyphKind = gkEllipsis then
    TTeCustomButton(FButton).NumGlyphs := 1
  else
    if FGlyphKind = gkDefault then
      TTeCustomButton(Button).NumGlyphs := FDefNumGlyphs
    else
      TTeCustomButton(Button).NumGlyphs := Value;
end;

function TTeCustomEditButton.BtnWidthStored: Boolean;
begin
  if (FGlyphKind = gkDefault) and (Glyph <> nil) then
    if TTeCustomButton(Button).NumGlyphs > 0 then
      Result := ButtonWidth <> InplaceMax(Glyph.Width div TTeCustomButton(Button).NumGlyphs + 6,
        DefEditBtnWidth)
    else
      Result := ButtonWidth <> InplaceMax(Glyph.Width + 6,
        DefEditBtnWidth)
  else
    Result := ButtonWidth <> DefEditBtnWidth;
end;

procedure TTeCustomEditButton.RecreateGlyph;
  function CreateEllipsisGlyph: TBitmap;
  var
    W, G, I: Integer;
  begin
    Result := TBitmap.Create;
    with Result do
    try
      Monochrome := True;
      Width := InplaceMax(1, FButton.Width - 6);
      Height := 4;
      W := 2;
      G := (Result.Width - 3 * W) div 2;
      if G <= 0 then G := 1;
      if G > 3 then G := 3;
      I := (Width - 3 * W - 2 * G) div 2;
      PatBlt(Canvas.Handle, I, 1, W, W, BLACKNESS);
      PatBlt(Canvas.Handle, I + G + W, 1, W, W, BLACKNESS);
      PatBlt(Canvas.Handle, I + 2 * G + 2 * W, 1, W, W, BLACKNESS);
    except
      Free;
      raise;
    end;
  end;

var
  NewGlyph: TBitmap;
  DestroyNeeded: Boolean;
begin
  case FGlyphKind of
    gkDefault:
      begin
        DestroyNeeded := False;
        NewGlyph := GetDefaultBitmap(DestroyNeeded);
        try
          TTeCustomButton(Button).Glyph.Assign(NewGlyph);
          NumGlyphs := FDefNumGlyphs;
        finally
          if DestroyNeeded then NewGlyph.Destroy;
        end;
      end;
    gkEllipsis:
      begin
        NewGlyph := CreateEllipsisGlyph;
        try
          TTeCustomButton(Button).Glyph := NewGlyph;
          NumGlyphs := 1;
        finally
          NewGlyph.Destroy;
        end;
      end;
  end;
end;



{ TTeCustomLabel }

constructor TTeCustomLabel.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);
  ControlStyle := ControlStyle + [csOpaque, csReplicatable];
  Width := 65;
  Height := 17;
  FAutoSize := True;
  FShowAccelChar := true;
  Transparent := true;
end;

procedure TTeCustomLabel.Loaded;
begin
  inherited Loaded;
  AdjustBounds;
end;

function TTeCustomLabel.GetLabelText: WideString;
begin
  Result := Caption;
end;

procedure TTeCustomLabel.DoDrawText(var Rect: TRect; Flags: Longint);
var
  Text: WideString;
begin
  if Parent = nil then Exit;
  
  Text := GetLabelText;
  if (Flags and DT_CALCRECT <> 0) and ((Text = '') or FShowAccelChar and
    (Text[1] = '&') and (Text[2] = #0)) then Text := Text + ' ';
  if not FShowAccelChar then Flags := Flags or DT_NOPREFIX;
  Flags := DrawTextBiDiModeFlags(Flags);

  Canvas.Font := Font;

  if not Enabled then
  begin
    OffsetRect(Rect, 1, 1);
    Canvas.Font.Color := clBtnHighlight;
    DrawText(Canvas, Text, Rect, Flags);
    OffsetRect(Rect, -1, -1);
    Canvas.Font.Color := clBtnShadow;
    DrawText(Canvas, Text, Rect, Flags);
  end
  else
    DrawText(Canvas, Text, Rect, Flags);
end;

procedure TTeCustomLabel.PaintBuffer;
const
  Alignments: array[TAlignment] of Word = (DT_LEFT, DT_RIGHT, DT_CENTER);
  WordWraps: array[Boolean] of Word = (0, DT_WORDBREAK);
var
  Rect, CalcRect: TRect;
  DrawStyle: Longint;
begin
  inherited ;

  Rect := ClientRect;
  { DoDrawText takes care of BiDi alignments }
  DrawStyle := DT_EXPANDTABS or WordWraps[FWordWrap] or Alignments[FAlignment];
  { Calculate vertical layout }
  if FLayout <> tlTop then
  begin
    CalcRect := Rect;
    DoDrawText(CalcRect, DrawStyle or DT_CALCRECT);
    if FLayout = tlBottom then OffsetRect(Rect, 0, Height - CalcRect.Bottom)
    else OffsetRect(Rect, 0, (Height - CalcRect.Bottom) div 2);
  end;
  DoDrawText(Rect, DrawStyle);
end;

procedure TTeCustomLabel.AdjustBounds;
const
  WordWraps: array[Boolean] of Word = (0, DT_WORDBREAK);
var
  X: Integer;
  Rect: TRect;
  AAlignment: TAlignment;
begin
  if not (csReading in ComponentState) and FAutoSize then
  begin
    Rect := ClientRect;
    DoDrawText(Rect, (DT_EXPANDTABS or DT_CALCRECT) or WordWraps[FWordWrap]);
    X := Left;
    AAlignment := FAlignment;
    if UseRightToLeftAlignment then ChangeBiDiModeAlignment(AAlignment);
    if AAlignment = taRightJustify then Inc(X, Width - Rect.Right);
    SetBounds(X, Top, Rect.Right, Rect.Bottom);
  end;
end;

procedure TTeCustomLabel.SetAlignment(Value: TAlignment);
begin
  if FAlignment <> Value then
  begin
    FAlignment := Value;
    Invalidate;
  end;
end;

procedure TTeCustomLabel.SetAutoSize(Value: Boolean);
begin
  if FAutoSize <> Value then
  begin
    FAutoSize := Value;
    AdjustBounds;
  end;
end;

function TTeCustomLabel.GetTransparent: Boolean;
begin
  Result := not (csOpaque in ControlStyle);
end;

procedure TTeCustomLabel.SetFocusControl(Value: TWinControl);
begin
  FFocusControl := Value;
  if Value <> nil then Value.FreeNotification(Self);
end;

procedure TTeCustomLabel.SetShowAccelChar(Value: Boolean);
begin
  if FShowAccelChar <> Value then
  begin
    FShowAccelChar := Value;
    Invalidate;
  end;
end;

procedure TTeCustomLabel.SetTransparent(Value: Boolean);
begin
  if Transparent <> Value then
  begin
    if Value then
      ControlStyle := ControlStyle - [csOpaque] else
      ControlStyle := ControlStyle + [csOpaque];
    Invalidate;
  end;
end;

procedure TTeCustomLabel.SetLayout(Value: TTextLayout);
begin
  if FLayout <> Value then
  begin
    FLayout := Value;
    Invalidate;
  end;
end;

procedure TTeCustomLabel.SetWordWrap(Value: Boolean);
begin
  if FWordWrap <> Value then
  begin
    FWordWrap := Value;
    AdjustBounds;
    Invalidate;
  end;
end;

procedure TTeCustomLabel.Notification(AComponent: TComponent;
  Operation: TOperation);
begin
  inherited Notification(AComponent, Operation);
  if (Operation = opRemove) and (AComponent = FFocusControl) then
    FFocusControl := nil;
end;

procedure TTeCustomLabel.CMTextChanged(var Message: TMessage);
begin
  FCaption := inherited Caption;
  AdjustBounds;
end;

procedure TTeCustomLabel.CMFontChanged(var Message: TMessage);
begin
  inherited;
  AdjustBounds;
end;

procedure TTeCustomLabel.CMDialogChar(var Message: TCMDialogChar);
begin
  if (FFocusControl <> nil) and Enabled and ShowAccelChar and
    IsAccel(Message.CharCode, Caption) then
    with FFocusControl do
      if CanFocus then
      begin
        SetFocus;
        Message.Result := 1;
      end;
end;

procedure TTeCustomLabel.SetCaption(const Value: WideString);
begin
  if FCaption <> Value then
  begin
    FCaption := Value;
    AdjustBounds;
    Invalidate;
    Repaint;
  end;
end;




procedure InitTrueTypeBitmap;
var
  Bitmap: TBitmap;
begin
  Bitmap := TBitmap.Create;
  try
    Bitmap.Handle := LoadBitmap(HInstance, 'TE_LIST_TRUETYPE');

    TrueTypeBmp := TTeBitmap.Create;
    TrueTypeBmp.Assign(Bitmap);
    TrueTypeBmp.Blend := true;
    TrueTypeBmp.PerformTransparent(KColor(255, 0, 255));
  finally
    Bitmap.Free;
  end;
end;

type

  TEkListBoxItems = class(TStringList)
  private
    FListBox: TTeCustomListBox;
  protected
    procedure Put(Index: Integer; const S: string); override;
    procedure PutObject(Index: Integer; AObject: TObject); override;
    procedure SetUpdateState(Updating: Boolean); override;
  public
    procedure Clear; override;
    procedure Delete(Index: Integer); override;
    procedure Insert(Index: Integer; const S: string); override;
    procedure Exchange(Index1, Index2: Integer); override;
    function Add(const S: string): Integer; override;
    function AddObject(const S: string; AObject: TObject): Integer; override;
  end;

{ TEkListBoxItems =============================================================}

function TEkListBoxItems.Add(const S: string): Integer;
begin
  Result := inherited Add(S);
  FListBox.ItemsChanged;
end;

function TEkListBoxItems.AddObject(const S: string;
  AObject: TObject): Integer;
begin
  Result := inherited AddObject(S, AObject);
  FListBox.ItemsChanged;
end;

procedure TEkListBoxItems.Clear;
begin
  inherited Clear;
  FListBox.ItemsChanged;
end;

procedure TEkListBoxItems.Delete(Index: Integer);
var
  i: integer;
begin
  inherited Delete(Index);

  { Update State }
  with FListBox do
    for i := Index to High(FState) - 1 do
      FState[i] := FState[i + 1];

  FListBox.ItemsChanged;
end;

procedure TEkListBoxItems.Exchange(Index1, Index2: Integer);
var
  i: integer;
  TempState: TCheckBoxState;
begin
  { Update State }
  with FListBox do
  begin
    if (Index1 >= Low(FState)) and (Index1 <= High(FState)) and
       (Index2 >= Low(FState)) and (Index2 <= High(FState)) then
    begin
      TempState := FState[Index1];
      FState[Index1] := FState[Index2];
      FState[Index2] := TempState;
    end;
  end;

  inherited;
  
  FListBox.ItemsChanged;
end;

procedure TEkListBoxItems.Insert(Index: Integer; const S: string);
var
  i: integer;
begin
  inherited Insert(Index, S);

  { Update State }
  with FListBox do
  begin
    if High(FState) < 0 then
      SetLength(FState, 1)
    else
      SetLength(FState, High(FState) - Low(FState) + 1);

    for i := High(FState) - 1 downto Index do
      FState[i + 1] := FState[i];

    FState[Index] := cbUnchecked;
  end;

  FListBox.ItemsChanged;
end;

procedure TEkListBoxItems.Put(Index: Integer; const S: string);
begin
  inherited Put(Index, S);

  FListBox.ItemsChanged;
end;

procedure TEkListBoxItems.PutObject(Index: Integer; AObject: TObject);
begin
  inherited PutObject(Index, AObject);
  FListBox.ItemsChanged;
end;

procedure TEkListBoxItems.SetUpdateState(Updating: Boolean);
begin
  inherited SetUpdateState(Updating);
  FListBox.FUpdating := Updating;
  if not Updating then
  begin
    FListBox.Invalidate;
    FListBox.ItemsChanged;
  end;
end;

{ TTeCustomListBox ============================================================}

constructor TTeCustomListBox.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);
  FUpdating := false;
  FKeyboardClick := true;

  Performance := kspDoubleBuffer;

  Color := clWindow;
  BevelKind := kbkSingle;
  BevelWidth := 1;
  BorderWidth := 0;

  FItems := TEkListBoxItems.Create;
  TEkListBoxItems(FItems).FListBox := Self;

  FScrlBar := CreateScrollBar;
  with FScrlBar do
  begin
    Parent := Self;
    Kind := sbVertical;
    BorderWidth := 0;
    Visible := true;

    OnScroll := ScrlBarScroll;
    OnChange := ScrlBarChange;
  end;

  FItemHeight := 16; 
  FAlwaysShowScrlBar := false;
  FShowCheckBoxes := false;
  FFlat := true;
  FItemIndex := -1;
  FMultiSelect := false;
  FWordWrap := false;
  FListStyle := lbStandard;
  ParentColor := false;
  TabStop := true;
  FSorted := false;
  FFontValue := TFont.Create;

  FMOldx := -1;
  FMOldy := -1;

  FSelRangeBeg := -1;

  FMousePressed := false;

  FMouseOnItemIndex := -1;
  FMouseOnCheckBoxIndex := -1;

  Width := 121;
  Height := 97;

  ControlStyle := ControlStyle + [csCaptureMouse, csDoubleClicks];
  TabStop := true;
end;

destructor TTeCustomListBox.Destroy;
begin
  FFontValue.Free;
//  FScrlBar.Free;
  FItems.Free;
  inherited;
end;

procedure TTeCustomListBox.Loaded;
begin
  inherited;
  UpdateScrlBar;
end;

procedure TTeCustomListBox.EnumColorsProc(const S: string);
begin
  Items.Add(S);
end;

procedure TTeCustomListBox.BuildColorList;
begin
  FItems.Clear;
  UpdateSelRange;
  Sorted := false;

  GetColorValues(EnumColorsProc);
end;

function EnumFontsProc(var LogFont: TLogFont; var TextMetric: TTextMetric;
  FontType: Integer; Data: Pointer): Integer; stdcall;
begin
  with TTeCustomListBox(Data), TextMetric do
  begin
    case FontType of
      ftAll:
        Items.AddObject(LogFont.lfFaceName, TObject(tmPitchAndFamily));
      ftTrueType:
        if (tmPitchAndFamily and tmpf_TrueType) = tmpf_TrueType then
          Items.AddObject(LogFont.lfFaceName, TObject(tmPitchAndFamily));
      ftFixedPitch:
        if (tmPitchAndFamily and tmpf_Fixed_Pitch) = 0 then
          Items.AddObject(LogFont.lfFaceName, TObject(tmPitchAndFamily));
    end;
    Result := 1;
  end;
end;

procedure TTeCustomListBox.BuildFontList;
var
  DC: HDC;
begin

  FItems.Clear;
  Sorted := true;
  UpdateSelRange;

  if FFontDevice = fdScreen then
  begin
    DC := GetDC(0);
    try                 
      EnumFontFamilies(DC, nil, @EnumFontsProc, Longint(Self));
    finally
      ReleaseDC(0, DC);
    end;
  end
  else
  begin
    EnumFontFamilies(Printer.Handle, nil, @EnumFontsProc, Longint(Self));
  end;
end;

function TTeCustomListBox.CreateScrollBar: TTeCustomScrollBar;
begin
  Result := TTeCustomScrollBar.Create(Self);
end;

procedure TTeCustomListBox.PaintBuffer;
var
  SaveIndex: integer;
begin
  if FScrlBar = nil then Exit;

  inherited;

  DrawBackground;

  SaveIndex := SaveDC(Canvas.Handle);
  try
    with GetBorderRect do
      IntersectClipRect(Canvas.Handle, Left, Top, Right, Bottom);

    DrawItems;
  finally
    RestoreDC(Canvas.Handle, SaveIndex);
  end;
end;

procedure TTeCustomListBox.ItemsChanged;
var
  i, OldHigh: integer;
begin
  if FItems.Count <= 0 then
    FItemIndex := -1
  else
    if FItemIndex = -1 then
    FItemIndex := 0;

  if High(FState) < 0 then
    OldHigh := 0
  else
    OldHigh := High(FState);

  SetLength(FState, Items.Count);
{  for i := OldHigh to High(FState) do
    FState[i] := cbUnchecked;}

  if High(FItemEnabled) < 0 then
    OldHigh := 0
  else
    OldHigh := High(FItemEnabled);

  SetLength(FItemEnabled, Items.Count);
  for i := OldHigh to High(FItemEnabled) do
    FItemEnabled[i] := true;

  if High(FSelected) < 0 then
    OldHigh := 0
  else
    OldHigh := High(FSelected);

  SetLength(FSelected, Items.Count);
  for i := OldHigh to High(FSelected) do
    Selected[i] := false;

  if not FUpdating then
  begin
    UpdateScrlBar;
    Invalidate;
  end;
end;

function TTeCustomListBox.GetItemHeight(Index: integer): integer;
var
  TmpS: string;
  TmpRect: TRect;
begin
  Canvas.Font := Font;
  if (FListStyle = lbOwnerDrawVariable) and Assigned(FOnMeasureItem) then
    Result := DoMeasureItem(Index)
  else
    if WordWrap then
    begin
      TmpS := Items[Index];
      TmpRect := Rect(0, 0, GetItemWidth - 2, TextHeight(Canvas, 'Pq'));
      Result := DrawText(Canvas, TmpS, TmpRect, DrawTextBiDiModeFlags(DT_CALCRECT or DT_WORDBREAK or DT_NOPREFIX));
    end
    else
      Result := FItemHeight;
end;

function TTeCustomListBox.GetListHeight: integer;
var
  CurLine: integer;
begin
  Result := 0;
  for CurLine := 0 to Items.Count - 1 do
    Result := Result + GetItemHeight(CurLine);
end;

procedure TTeCustomListBox.DrawBackground;
begin
  FillRect(Canvas, GetBorderRect, Color);
end;

function TTeCustomListBox.GetItemTop(Index: integer): integer;
var
  CurItem: integer;
begin
  Result := -1;
  if FScrlBar = nil then Exit;
  
  if Index < FScrlBar.Position then
  begin
    Result := -1;
    Exit;
  end;

  Result := GetBorderRect.Top;
  for CurItem := FScrlBar.Position to Index - 1 do
    Result := Result + GetItemHeight(CurItem);
end;

function TTeCustomListBox.GetItemRect(Index: integer): TRect;
begin
  Result := Rect(0, 0, 0, 0);
  if FScrlBar = nil then Exit;

  with Result do
  begin
    Left := GetBorderRect.Left;
    Top := GetItemTop(Index);
    Right := GetBorderRect.Right - FScrlBar.Width;
    Bottom := Top + GetItemHeight(Index);
  end;
end;

procedure TTeCustomListBox.DrawItems;
var
  CurItem: integer;
  CurItemTop: integer;
  ItemLeft: integer;
  LCurItemHeight: integer;
  CL, TmpRect: TRect;

  CurCol: integer;
  FirstInCol: boolean;
begin
  if not HandleAllocated then Exit;
  if FScrlBar = nil then Exit;

  CL := GetBorderRect;

  if Columns <= 0 then
  begin
    CurItem := FScrlBar.Position;
    CurItemTop := CL.Top;
    while (CurItemTop < CL.Bottom) and (CurItem <= Items.Count - 1) do
    begin
      LCurItemHeight := GetItemHeight(CurItem);

      ItemLeft := CL.Left;
      if ShowCheckBoxes then
      begin
        with TmpRect do
        begin
          Left := CL.Left + (GetChckBxFieldWidth - GetCheckBoxSize.x) div 2;
          Top := CurItemTop + (LCurItemHeight - GetCheckBoxSize.y) div 2;
          Right := Left + GetCheckBoxSize.x;
          Bottom := Top + GetCheckBoxSize.y;
        end;
        DrawCheckBox(CurItem, TmpRect);
        ItemLeft := ItemLeft + GetChckBxFieldWidth;
      end;

      DrawItem(Canvas, CurItem, Rect(ItemLeft, CurItemTop, ItemLeft + GetItemWidth, CurItemTop + LCurItemHeight));

      CurItemTop := CurItemTop + LCurItemHeight;
      Inc(CurItem);
    end;
  end
  else
  begin
    { MultiColumn mode }
    CurItem := 0;
    CurCol := 0;
    FirstInCol := true;
    CurItemTop := CL.Top;

    while (CurCol - FScrlBar.Position < Columns) and (CurItem < Items.Count) do
    begin
      LCurItemHeight := GetItemHeight(CurItem);

      with TmpRect do
      begin
        if ShowCheckBoxes then
          Left := (CurCol - FScrlBar.Position) * (GetChckBxFieldWidth + GetItemWidth) + CL.Left
        else
          Left := (CurCol - FScrlBar.Position) * GetItemWidth + CL.Left;
        Top := CurItemTop;
        Right := Left + GetItemWidth;
        Bottom := Top + LCurItemHeight;
      end;

      if CurItemTop + LCurItemHeight > GetItemAreaBottom then
      begin
        if FirstInCol then
        begin
          if (CurCol - FScrlBar.Position >= 0) then
          begin
            if ShowCheckBoxes then
              with TmpRect do
              begin
                DrawCheckBox(CurItem,
                  Rect(Left + (GetChckBxFieldWidth - GetCheckBoxSize.x) div 2,
                  Top + (LCurItemHeight - GetCheckBoxSize.y) div 2,
                  Left + (GetChckBxFieldWidth - GetCheckBoxSize.x) div 2 + GetCheckBoxSize.x,
                  Top + (LCurItemHeight - GetCheckBoxSize.y) div 2 + GetCheckBoxSize.y));
                Left := Left + GetChckBxFieldWidth;
                Right := Right + GetChckBxFieldWidth;
              end;
            DrawItem(Canvas, CurItem, TmpRect);
          end;
          CurItem := CurItem + 1;
        end;
        CurCol := CurCol + 1;
        FirstInCol := true;
        CurItemTop := CL.Top;
      end
      else
      begin
        if (CurCol - FScrlBar.Position >= 0) then
        begin
          if ShowCheckBoxes then
            with TmpRect do
            begin
              DrawCheckBox(CurItem,
                Rect(Left + (GetChckBxFieldWidth - GetCheckBoxSize.x) div 2,
                Top + (LCurItemHeight - GetCheckBoxSize.y) div 2,
                Left + (GetChckBxFieldWidth - GetCheckBoxSize.x) div 2 + GetCheckBoxSize.x,
                Top + (LCurItemHeight - GetCheckBoxSize.y) div 2 + GetCheckBoxSize.y));
              Left := Left + GetChckBxFieldWidth;
              Right := Right + GetChckBxFieldWidth;
            end;
          DrawItem(Canvas, CurItem, TmpRect);
        end;
        FirstInCol := false;
        CurItem := CurItem + 1;
        CurItemTop := CurItemTop + LCurItemHeight;
      end;
    end;
  end;
end;

procedure TTeCustomListBox.DrawItem(Canvas: TCanvas; Index: integer; ARect: TRect);
var
  TmpS: string;
  R, TmpRect: TRect;
  TmpState: TOwnerDrawState;
  Color: Longint;
begin
  TmpRect := ARect;
  Inc(TmpRect.Left, 2);

  if FListStyle in [lbFonts, lbFontSamples, lbColors, lbColorNames] then
  begin
    if Index < 0 then
      TmpS := ''
    else
      TmpS := Items[Index];
    { Font and Color }
    case FListStyle of
      lbFonts:
        begin
          { Font Listbox }
          Canvas.Font := Font;

          if Selected[Index] then
          begin
            FillRect(Canvas, ARect, clHighlight);
            Canvas.Font.Color := clHighlightText;

            if Focused and not MultiSelect then
              DrawFocusRect(Canvas, ARect, clBlack);
          end
          else
            if Focused and (ItemIndex = Index) and (not MultiSelect) then
              DrawFocusRect(Canvas, ARect, clBlack);


          if (TrueTypeBmp <> nil) and (Integer(Items.Objects[Index]) and TMPF_TRUETYPE <> 0) then
          begin
            R := Rect(0, 0, TrueTypeBmp.Width, TrueTypeBmp.Height);
            RectCenter(R, Rect(TmpRect.Left, TmpRect.Top, TmpRect.Left + DefaultFontColorHeight, TmpRect.Bottom));
            TrueTypeBmp.Draw(Canvas, R.Left, R.Top, true);
          end;

          Inc(TmpRect.Left, DefaultFontColorHeight + 4);
          DrawText(Canvas, TmpS, TmpRect, DrawTextBiDiModeFlags(DT_LEFT or DT_VCENTER or DT_SINGLELINE or DT_NOPREFIX));
        end;
      lbFontSamples:
        begin
          { Font Listbox }
          Canvas.Font.Assign(Font);

          if Selected[Index] then
          begin
            FillRect(Canvas, ARect, clHighlight);
            Canvas.Font.Color := clHighlightText;

            if Focused and not MultiSelect then
              DrawFocusRect(Canvas, ARect, clBlack);
          end
          else
            if Focused and (ItemIndex = Index) and (not MultiSelect) then
              DrawFocusRect(Canvas, ARect, clBlack);

          if (TrueTypeBmp <> nil) and (Integer(Items.Objects[Index]) and TMPF_TRUETYPE <> 0) then
          begin
            R := Rect(0, 0, TrueTypeBmp.Width, TrueTypeBmp.Height);
            RectCenter(R, Rect(TmpRect.Left, TmpRect.Top, TmpRect.Left + DefaultFontColorHeight, TmpRect.Bottom));
            TrueTypeBmp.Draw(Canvas, R.Left, R.Top, true);
          end;

          Inc(TmpRect.Left, DefaultFontColorHeight + 4);
          if Index >= 0 then
          begin
            Canvas.Font.Name := Items[Index];

//            Canvas.Brush.Style := bsClear;
//            Canvas.TextOut(TmpRect.Left, TmpRect.Top, TmpS);
            DrawText(Canvas, TmpS, TmpRect, DrawTextBiDiModeFlags(DT_LEFT or DT_VCENTER or DT_SINGLELINE or DT_NOPREFIX));
          end;
        end;
      lbColors:
        begin
          { Font Listbox }
          if Selected[Index] then
          begin
            FillRect(Canvas, ARect, clHighlight);
            if Focused then
              DrawFocusRect(Canvas, ARect, clBlack);
          end
          else
            if Focused and (ItemIndex = Index) and (not MultiSelect) then
              DrawFocusRect(Canvas, ARect, clBlack);

          { Draw Color Rect }
          InflateRect(TmpRect, -4, -4);
          Color := StringToColor(TmpS);
          FillRect(Canvas, TmpRect, Color);
          DrawRect(Canvas, TmpRect, clBlack);
        end;
      lbColorNames:
        begin
          { Font Listbox }
          Canvas.Font := Font;

          if Selected[Index] then
          begin
            FillRect(Canvas, ARect, clHighlight);
            Canvas.Font.Color := clHighlightText;

            if Focused and (not MultiSelect) then
              DrawFocusRect(Canvas, ARect, clBlack);
          end
          else
            if Focused and (ItemIndex = Index) and (not MultiSelect) then
              DrawFocusRect(Canvas, ARect, clBlack);

          { Draw Color Rect }
          Color := StringToColor(TmpS);
          R := Rect(0, 0, ColorRectWidth, DefaultFontColorHeight - 4);
          RectCenter(R, Rect(TmpRect.Left, TmpRect.Top, TmpRect.Left + ColorRectWidth, TmpRect.Bottom));
          FillRect(Canvas, R, Color);
          DrawRect(Canvas, R, clBlack);
          { Draw Text}
          if Pos('cl', TmpS) > 0 then
            Delete(TmpS, 1, 2);
          Inc(TmpRect.Left, ColorRectWidth + 4);
          DrawText(Canvas, TmpS, TmpRect, DrawTextBiDiModeFlags(DT_LEFT or DT_VCENTER or DT_SINGLELINE or DT_NOPREFIX));
        end;
    end;

    Exit;
  end;

  if (FListStyle = lbStandard) or (not Assigned(FOnDrawItem)) then
  begin
    if Index >= 0 then
      TmpS := Items[Index]
    else
      TmpS := '';

    if (TmpS = '-') then // Separator
    begin
      { Separator }
      R := TmpRect;
      InflateRect(R, -3, -(RectHeight(R) div 2 - 1));
      R.Bottom := R.Top + 1;
      FillRect(Canvas, R, Font.Color);

      Exit;
    end;

    Canvas.Font := Font;

    if Selected[Index] then
    begin
      FillRect(Canvas, ARect, clHighlight);
      Canvas.Font.Color := clHighlightText;
    end;

    if (Index = MouseOnItemIndex) and not Selected[Index] then
      Canvas.Font.Color := clHighlight;

    if WordWrap then
      DrawText(Canvas, TmpS, TmpRect, DrawTextBiDiModeFlags(DT_LEFT or DT_WORDBREAK or DT_NOPREFIX))
    else
      DrawText(Canvas, TmpS, TmpRect, DrawTextBiDiModeFlags(DT_LEFT or DT_VCENTER or DT_SINGLELINE or DT_NOPREFIX));

    if Selected[Index] and Focused and (not MultiSelect) then
    begin
      Canvas.Font.Color := clHighlight;
      DrawFocusRect(Canvas, ARect, clBlack);
    end;

    if not Selected[Index] and Focused and (ItemIndex = Index) and (not MultiSelect) then
      DrawFocusRect(Canvas, ARect, clBlack);
  end
  else
  begin
    { Owner Draw }
    TmpState := [];
    if Selected[Index] then
      TmpState := TmpState + [odSelected]
    {$IFDEF KS_COMPILER5_UP}
    else
      if Index = MouseOnItemIndex then
        TmpState := TmpState + [odHotLight]
    {$ENDIF};
    if (Index = ItemIndex) and Focused then
      TmpState := TmpState + [odFocused];

    DoDrawItem(Index, TmpRect, TmpState);
  end;
end;

procedure TTeCustomListBox.DrawCheckBox(Index: integer; ARect: TRect);
begin
  if not ((not Flat) or ((Index = MouseOnCheckBoxIndex) and ItemEnabled[Index])) then
  begin
    if State[Index] in [cbChecked, cbGrayed] then
    begin
      DrawFrameControl(Canvas.Handle, ARect, DFC_BUTTON, DFCS_BUTTONCHECK or DFCS_CHECKED or DFCS_FLAT);
      DrawRect(Canvas, ARect, clWindow);
    end;
    with ARect do
      DrawRect(Canvas, Rect(Left + 1, Top + 1, Right - 1, Bottom - 1), clBtnShadow);
  end
  else
  begin
    if State[Index] in [cbChecked, cbGrayed] then
      DrawFrameControl(Canvas.Handle, ARect, DFC_BUTTON, DFCS_BUTTONCHECK or DFCS_CHECKED)
    else
      DrawFrameControl(Canvas.Handle, ARect, DFC_BUTTON, DFCS_BUTTONCHECK);
  end;
end;

procedure TTeCustomListBox.ScrlBarScroll(Sender: TObject;
  ScrollCode: TTeScrollCode; var ScrollPos: Integer);
begin
  with Sender as TTeCustomScrollBar do
    if (ScrollPos > Max - PageSize + 1) and (PageSize <> 0) then
      ScrollPos := Max - PageSize + 1;
end;

procedure TTeCustomListBox.ScrlBarChange(Sender: TObject);
begin
  if FScrlBar = nil then Exit;

  if FScrlBar.AutoScrollUp then
  begin
    UpdateVisibleRange;
    ItemIndex := FFirstVisibleItem;
    UpdateSelRange;
  end
  else
    if FScrlBar.AutoScrollDown then
  begin
    UpdateVisibleRange;
    ItemIndex := FLastVisibleItem;
    UpdateSelRange;
  end;

  UpdatePtInPart(FMOldx, FMOldy);
  Invalidate;
end;

procedure TTeCustomListBox.UpdateScrlBar;
var
  CurItemTop: integer;
  LTmpMax: integer;
  TmpColCount: integer;
  CurItem: integer;
  LCurItemHeight: integer;
  AB: integer;
  CL: TRect;
begin
  if FScrlBar = nil then Exit;

  CL := GetBorderRect;

  FScrlBar.Min := 0;
  if Columns <= 0 then
  begin
    FScrlBar.Kind := sbVertical;
    FScrlBar.Top := CL.Top;
    FScrlBar.Height := RectHeight(CL);
    FScrlBar.UpdateSytemSize;
    FScrlBar.Left := CL.Right - FScrlBar.Width;

    if (FListStyle in [lbOwnerDrawFixed, lbStandard, lbFonts, lbFontSamples, lbColors, lbColorNames]) and (not WordWrap) then
    begin
      FScrlBar.Max := Items.Count - 1;
      if (Items.Count > 0) and (GetItemHeight(0) > 0) then
        FScrlBar.PageSize := (RectHeight(CL)) div GetItemHeight(0)
      else
        FScrlBar.PageSize := 0;
    end
    else
    begin
      FScrlBar.PageSize := 0;
      if Items.Count > 0 then
      begin
        FScrlBarVizible := false;
        FScrlBar.Visible := true;
        LTmpMax := Items.Count - 1;
        CurItemTop := CL.Bottom - GetItemHeight(LTmpMax) {+2};
        while (LTmpMax > 0) and ((CurItemTop - GetItemHeight(LTmpMax - 1) >= CL.Top) or not FScrlBarVizible) do
        begin
          CurItemTop := CurItemTop - GetItemHeight(LTmpMax - 1);
          LTmpMax := LTmpMax - 1;

          if (CurItemTop < CL.Top) and not FScrlBarVizible then
          begin
            FScrlBarVizible := true;
            LTmpMax := Items.Count - 1;
            CurItemTop := CL.Bottom - GetItemHeight(LTmpMax);
          end;
        end;
        FScrlBar.Max := LTmpMax;
      end
      else
        FScrlBar.Max := 0;
    end;

  end
  else
  begin
    { MultiColumn mode }
    FScrlBar.Kind := sbHorizontal;
    FScrlBar.Left := CL.Left;
    FScrlBar.Width := RectWidth(CL);
    FScrlBar.UpdateSytemSize;
    FScrlBar.Top := CL.Bottom - FScrlBar.Height;

    CurItem := 0;
    TmpColCount := 1;
    CurItemTop := CL.Top;

    AB := CL.Bottom;
    if AlwaysShowScrlBar or (csDesigning in ComponentState) then
      AB := AB - FScrlBar.Height;

    while CurItem < Items.Count do
    begin

      LCurItemHeight := GetItemHeight(CurItem);
      CurItemTop := CurItemTop + LCurItemHeight;

      if CurItemTop > AB then
      begin
        CurItemTop := CL.Top + LCurItemHeight;
        TmpColCount := TmpColCount + 1;
      end;

      if (TmpColCount > Columns) and (AB = CL.Bottom) then
      begin
        CurItem := 0;
        TmpColCount := 1;
        CurItemTop := CL.Top;
        AB := AB - FScrlBar.Height;
      end
      else
        CurItem := CurItem + 1;
    end;

    FScrlBar.Max := TmpColCount - 1;

    FScrlBar.PageSize := Columns;
  end;

  with FScrlBar do
  begin
    if csDesigning in ComponentState then
      Visible := true
    else
      Visible := FAlwaysShowScrlBar or ((PageSize < Max - Min + 1) and (Max - Min <> 0));
    FScrlBarVizible := Visible;
    Enabled := (PageSize < Max - Min + 1) and (Max - Min <> 0);
  end;
end;

function TTeCustomListBox.GetItemWidth: integer;
begin
  Result := RectWidth(GetBorderRect);
  if FScrlBar = nil then Exit;

  if Columns > 0 then
    Result := Result div Columns
  else
    if (FScrlBar.Visible and FScrlBarVizible) or (csDesigning in ComponentState) or
    AlwaysShowScrlBar then
    Result := Result - FScrlBar.Width;

  if ShowCheckBoxes then
    Result := Result - GetChckBxFieldWidth;
end;

function TTeCustomListBox.GetChckBxFieldWidth: integer;
begin
  Result := 15;
end;

procedure TTeCustomListBox.UpdatePtInPart(x, y: integer);
var
  CurItem: integer;
  CurItemTop: integer;
  ItemLeft: integer;
  LCurItemHeight: integer;
  TmpRect: TRect;
  CurCol: integer;
  FirstInCol: boolean;
  CL: TRect;
begin
  if FScrlBar = nil then Exit;

  FMouseOnItemIndex := -1;
  FMouseOnCheckBoxIndex := -1;

  CL := GetBorderRect;

  if Columns <= 0 then
  begin
    CurItem := FScrlBar.Position;
    CurItemTop := CL.Top;
    while (CurItemTop < CL.Bottom) and (CurItem <= Items.Count - 1) do
    begin
      LCurItemHeight := GetItemHeight(CurItem);
      ItemLeft := CL.Left;
      if ShowCheckBoxes then
      begin
        with TmpRect do
        begin
          Left := CL.Left + (GetChckBxFieldWidth - GetCheckBoxSize.x) div 2;
          Top := CurItemTop + (LCurItemHeight - GetCheckBoxSize.y) div 2;
          Right := Left + GetCheckBoxSize.x;
          Bottom := Top + GetCheckBoxSize.y;
        end;

        if PtInCheckBox(x, y, CurItem, TmpRect) then
        begin
          FMouseOnCheckBoxIndex := CurItem;
          Exit;
        end;

        ItemLeft := ItemLeft + GetChckBxFieldWidth;
      end;

      if PtInItem(x, y, CurItem,
        Rect(ItemLeft,
        CurItemTop,
        ItemLeft + GetItemWidth,
        CurItemTop + LCurItemHeight)) then
      begin
        FMouseOnItemIndex := CurItem;
        Exit;
      end;

      Inc(CurItem);
      CurItemTop := CurItemTop + LCurItemHeight;
    end;
  end
  else
  begin
    { MultiColumn mode }
    CurItem := 0;
    CurCol := 0;
    FirstInCol := true;
    CurItemTop := CL.Top;

    while (CurCol - FScrlBar.Position < Columns) and (CurItem < Items.Count) do
    begin
      LCurItemHeight := GetItemHeight(CurItem);

      with TmpRect do
      begin
        if ShowCheckBoxes then
          Left := (CurCol - FScrlBar.Position) * (GetChckBxFieldWidth + GetItemWidth) + CL.Left
        else
          Left := (CurCol - FScrlBar.Position) * GetItemWidth + CL.Left;
        Top := CurItemTop;
        Right := Left + GetItemWidth;
        Bottom := Top + LCurItemHeight;
      end;

      if CurItemTop + LCurItemHeight > GetItemAreaBottom then
      begin
        if FirstInCol then
        begin
          if (CurCol - FScrlBar.Position >= 0) then
          begin
            if ShowCheckBoxes then
              with TmpRect do
              begin
                if PtInCheckBox(x, y, CurItem,
                  Rect(Left + (GetChckBxFieldWidth - GetCheckBoxSize.x) div 2,
                  Top + (LCurItemHeight - GetCheckBoxSize.y) div 2,
                  Left + (GetChckBxFieldWidth - GetCheckBoxSize.x) div 2 + GetCheckBoxSize.x,
                  Top + (LCurItemHeight - GetCheckBoxSize.y) div 2 + GetCheckBoxSize.y)) then
                begin
                  FMouseOnCheckBoxIndex := CurItem;
                  Exit;
                end;
                Left := Left + GetChckBxFieldWidth;
                Right := Right + GetChckBxFieldWidth;
              end;
            if PtInItem(x, y, CurItem, TmpRect) then
            begin
              FMouseOnItemIndex := CurItem;
              Exit;
            end;
          end;
          CurItem := CurItem + 1;
        end;
        CurCol := CurCol + 1;
        FirstInCol := true;
        CurItemTop := CL.Top;
      end
      else
      begin
        if (CurCol - FScrlBar.Position >= 0) then
        begin
          if ShowCheckBoxes then
            with TmpRect do
            begin
              if PtInCheckBox(x, y, CurItem,
                Rect(Left + (GetChckBxFieldWidth - GetCheckBoxSize.x) div 2,
                Top + (LCurItemHeight - GetCheckBoxSize.y) div 2,
                Left + (GetChckBxFieldWidth - GetCheckBoxSize.x) div 2 + GetCheckBoxSize.x,
                Top + (LCurItemHeight - GetCheckBoxSize.y) div 2 + GetCheckBoxSize.y)) then
              begin
                FMouseOnCheckBoxIndex := CurItem;
                Exit;
              end;
              Left := Left + GetChckBxFieldWidth;
              Right := Right + GetChckBxFieldWidth;
            end;
          if PtInItem(x, y, CurItem, TmpRect) then
          begin
            FMouseOnItemIndex := CurItem;
            Exit;
          end;
        end;
        FirstInCol := false;
        CurItem := CurItem + 1;
        CurItemTop := CurItemTop + LCurItemHeight;
      end;
    end;
  end;
end;

procedure TTeCustomListBox.MouseMove(Shift: TShiftState; x, y: integer);
var
  OldMouseOnItemIndex,
    OldMouseOnCheckBoxIndex: integer;
begin
  if FScrlBar = nil then Exit;
  
  inherited;

  FMOldx := x;
  FMOldy := y;

  OldMouseOnItemIndex := MouseOnItemIndex;
  OldMouseOnCheckBoxIndex := MouseOnCheckBoxIndex;
  UpdatePtInPart(x, y);

  if (OldMouseOnItemIndex <> MouseOnItemIndex) or
    (OldMouseOnCheckBoxIndex <> MouseOnCheckBoxIndex) then
  begin
    Invalidate;
    Application.ProcessMessages;
  end;

  if ((y < 0) and (Columns = 0)) or ((x < 0) and (Columns <> 0)) then
    FScrlBar.AutoScrollUp := true
  else
    if ((y > Height) and (Columns = 0)) or ((x > Width) and (Columns <> 0)) then
      FScrlBar.AutoScrollDown := true
  else
  begin
    FScrlBar.AutoScrollUp := false;
    FScrlBar.AutoScrollDown := false;
    if (MouseOnItemIndex <> -1) and FMousePressed and not (ssCtrl in Shift) then
    begin
      ItemIndex := MouseOnItemIndex;
      UpdateSelRange;
    end;
  end;
end;

function TTeCustomListBox.PtInItem(x, y, Index: integer;
  ARect: TRect): boolean;
begin
  Result := PtInRect(ARect, Point(x, y));
end;

function TTeCustomListBox.PtInCheckBox(x, y, Index: integer;
  ARect: TRect): boolean;
begin
  Result := PtInRect(ARect, Point(x, y));
end;

function TTeCustomListBox.GetState(Index: Integer): TCheckBoxState;
begin
  Result := FState[Index];
end;

procedure TTeCustomListBox.MouseDown(Button: TMouseButton;
  Shift: TShiftState; x, y: integer);
begin
  if CanFocus then SetFocus;

  if Button <> mbLeft then Exit;

  FMousePressed := true;

  if (MouseOnItemIndex <> -1) or (MouseOnCheckBoxIndex <> -1) then
  begin

    if MouseOnItemIndex <> -1 then
      ItemIndex := MouseOnItemIndex
    else
    begin
      ItemIndex := MouseOnCheckBoxIndex;
      if ItemEnabled[ItemIndex] then
        case State[ItemIndex] of
          cbUnchecked: State[ItemIndex] := cbChecked;
          cbChecked:
            if AllowGrayed then
              State[ItemIndex] := cbGrayed
            else
              State[ItemIndex] := cbUnchecked;
          cbGrayed: State[ItemIndex] := cbUnchecked;
        end;
    end;

    if not (ssShift in Shift) then
      FSelRangeBeg := ItemIndex;

    if (ssCtrl in Shift) and MultiSelect then
      Selected[ItemIndex] := not Selected[ItemIndex]
    else
      UpdateSelRange;

  end;

  inherited;
end;

function TTeCustomListBox.GetCheckBoxSize: TPoint;
begin
  with Result do
  begin
    x := 13;
    y := 13;
  end;
end;

function TTeCustomListBox.GetItemEnabled(Index: Integer): boolean;
begin
  Result := FItemEnabled[Index];
end;

procedure TTeCustomListBox.DoEnter;
begin
  inherited;
  Invalidate;
end;

procedure TTeCustomListBox.DoExit;
begin
  inherited;
  Invalidate;
end;

function TTeCustomListBox.GetSelected(Index: Integer): boolean;
begin
  Result := false;
  if (Low(FSelected) <= High(FSelected)) and
     (Index >= Low(FSelected)) and (Index <= High(FSelected))
  then
    Result := FSelected[Index];
end;

function TTeCustomListBox.GetItemAreaBottom: integer;
begin
  Result := RectHeight(GetBorderRect);
  if FScrlBar = nil then Exit;

  if (Columns > 0) and (FScrlBar.Visible or (csDesigning in ComponentState) or AlwaysShowScrlBar) then
    Result := Result - FScrlBar.Height;
end;

procedure TTeCustomListBox.DoDrawItem;
begin
  if not (csDestroying in ComponentState) then  
    if Assigned(FOnDrawItem) then
      FOnDrawItem(Self, Canvas, Index, Rect, State);
end;

function TTeCustomListBox.DoMeasureItem;
begin
  if Assigned(FOnMeasureItem) then
  begin
    FOnMeasureItem(Self, Canvas, Index, Result);
  end
  else
    Result := -1;
end;

function TTeCustomListBox.ItemAtPos(Pos: TPoint; Existing: Boolean): Integer;
var
  i: integer;
  R: TRect;
begin
  Result := -1;

  for i := 0 to Items.Count - 1 do
  begin
    R := GetItemRect(i);
    if PtInRect(R, Pos) then
    begin
      Result := i;
      Break;
    end;
  end;

  if Result = -1 then
    if not Existing then
      Result := Items.Count; 
end;

procedure TTeCustomListBox.UpdateVisibleRange;
var
  CurItem: integer;
  CurItemTop: integer;
  LCurItemHeight: integer;
  CurCol: integer;
  FirstInCol: boolean;
  CL: TRect;
begin
  if FScrlBar = nil then Exit;

  CL := GetBorderRect;

  if Columns <= 0 then
  begin
    CurItem := FScrlBar.Position;
    FFirstVisibleItem := FScrlBar.Position;
    FLastVisibleItem := -1;
    CurItemTop := CL.Top;
    while (CurItemTop < CL.Bottom) and (CurItem <= Items.Count - 1) do
    begin
      LCurItemHeight := GetItemHeight(CurItem);

      if CurItemTop + LCurItemHeight - 1 < CL.Bottom then
        FLastVisibleItem := CurItem;

      CurItemTop := CurItemTop + LCurItemHeight;
      Inc(CurItem);
    end;
  end
  else
  begin //MultiColumn mode
    FFirstVisibleItem := -1;
    FLastVisibleItem := -1;

    CurItem := 0;
    CurCol := 0;
    FirstInCol := true;
    CurItemTop := CL.Top;

    while (CurCol - FScrlBar.Position < Columns) and (CurItem < Items.Count) do
    begin
      LCurItemHeight := GetItemHeight(CurItem);

      if CurItemTop + LCurItemHeight > GetItemAreaBottom then
      begin
        if (CurCol - FScrlBar.Position = 0) and (FFirstVisibleItem = -1) then
          FFirstVisibleItem := CurItem;

        if FirstInCol then
        begin
          FLastVisibleItem := CurItem;
          CurItem := CurItem + 1;
        end;

        CurCol := CurCol + 1;
        FirstInCol := true;
        CurItemTop := CL.Top;
      end
      else
      begin
        if (CurCol - FScrlBar.Position = 0) and (FFirstVisibleItem = -1) then
          FFirstVisibleItem := CurItem;

        FLastVisibleItem := CurItem;
        FirstInCol := false;
        CurItem := CurItem + 1;
        CurItemTop := CurItemTop + LCurItemHeight;
      end;
    end;
  end;
end;

procedure TTeCustomListBox.KeyDown(var Key: word; Shift: TShiftState);
var
  SaveIndex: integer;
begin
  inherited;

  SaveIndex := FItemIndex;

  case Key of
    VK_UP, VK_LEFT: if ItemIndex > 0 then ItemIndex := ItemIndex - 1;
    VK_DOWN, VK_RIGHT: ItemIndex := ItemIndex + 1;
    VK_PRIOR: if FScrlBar <> nil then
      ItemIndex := ItemIndex - (FScrlBar.PageSize - 1);
    VK_NEXT: if FScrlBar <> nil then
      ItemIndex := ItemIndex + (FScrlBar.PageSize - 1);
    VK_END: ItemIndex := Items.Count - 1;
    VK_HOME: ItemIndex := 0;
    VK_SPACE, VK_RETURN:
      if ItemEnabled[ItemIndex] then
      begin
        case State[ItemIndex] of
          cbUnchecked: State[ItemIndex] := cbChecked;
          cbChecked:
            if AllowGrayed then
              State[ItemIndex] := cbGrayed
            else
              State[ItemIndex] := cbUnchecked;
          cbGrayed: State[ItemIndex] := cbUnchecked;
        end;
      end;
  end;

  if ItemIndex < 0 then ItemIndex := 0;
    
  if FKeyboardClick and (SaveIndex <> FItemIndex) then
    Click;

  if Key in [VK_UP, VK_LEFT, VK_DOWN, VK_RIGHT,
    VK_PRIOR, VK_NEXT, VK_END, VK_HOME] then
  begin
    if not (ssShift in Shift) then
      FSelRangeBeg := ItemIndex;
    UpdateSelRange;
  end;
end;

procedure TTeCustomListBox.KeyUp(var Key: word; Shift: TShiftState);
begin
  inherited;

end;

procedure TTeCustomListBox.MouseUp(Button: TMouseButton;
  Shift: TShiftState; x, y: integer);
begin
  inherited;
  FMousePressed := false;
end;

procedure TTeCustomListBox.UpdateSelRange;
var
  i: integer;
begin
  if FSelRangeBeg = -1 then Exit;

  for i := Low(FSelected) to High(FSelected) do
    Selected[i] := false;

  if MultiSelect then
  begin
    if FSelRangeBeg > ItemIndex then
      for i := ItemIndex to FSelRangeBeg do
        Selected[i] := true
    else
      for i := ItemIndex downto FSelRangeBeg do
        Selected[i] := true;
  end
  else
    Selected[ItemIndex] := true;

  Repaint;
end;

function TTeCustomListBox.GetSelCount: Integer;
var
  i: integer;
begin
  Result := 0;
  for i := 0 to Items.Count - 1 do
    if Selected[i] then
      Inc(Result);
end;

procedure TTeCustomListBox.CMMouseLeave(var Msg: TMessage);
begin
  FMOldx := -1;
  FMOldy := -1;
  if (FMouseOnItemIndex > -1) or
    (FMouseOnCheckBoxIndex > -1) then
  begin
    FMouseOnItemIndex := -1;
    FMouseOnCheckBoxIndex := -1;
    Invalidate;
  end;
end;

procedure TTeCustomListBox.CMEnabledChanged(var Msg: TMessage);
begin
  inherited;
  Invalidate;
end;

procedure TTeCustomListBox.WMGetDlgCode(var Msg: TWMGetDlgCode);
begin
  inherited;
  Msg.Result := dlgc_WantArrows;
end;

procedure TTeCustomListBox.CMMouseWheel(var Msg: TCMMouseWheel);
var
  Dy: integer;
  sl: integer;
begin
  if FScrlBar = nil then Exit;

  if IsWinNT or IsWin98 then
    SystemParametersInfo(SPI_GETWHEELSCROLLLINES, 0, @sl, SPIF_SENDCHANGE)
  else
    sl := 3;

  if sl = 0 then
    sl := 1;
    
  Dy := Msg.WheelDelta div (MOUSE_WHEEL_DELTA div sl);
  with FScrlBar do
    if Dy <> 0 then
      if (FScrlBar.Position - Dy > Max - PageSize + 1) and (PageSize <> 0) then
        FScrlBar.Position := Max - PageSize + 1
      else
        FScrlBar.Position := FScrlBar.Position - Dy;
end;

procedure TTeCustomListBox.WndProc(var Message: TMessage);
begin
  {for auto drag mode, let listbox handle itself, instead of TControl}
  if not (csDesigning in ComponentState) and ((Message.Msg = WM_LBUTTONDOWN) or
    (Message.Msg = WM_LBUTTONDBLCLK)) and not Dragging then
  begin
    if DragMode = dmAutomatic then
    begin
      if IsControlMouseMsg(TWMMouse(Message)) then
        Exit;
      ControlState := ControlState + [csLButtonDown];
      Dispatch(Message);  {overrides TControl's BeginDrag}
      Exit;
    end;
  end;
  inherited WndProc(Message);
end;

procedure TTeCustomListBox.WMLButtonDown(var Msg: TWMLButtonDown);
var
  ItemNo : Integer;
  ShiftState: TShiftState;
begin
  ShiftState := KeysToShiftState(Msg.Keys);
  if (DragMode = dmAutomatic) and FMultiSelect then
  begin
    if not (ssShift in ShiftState) or (ssCtrl in ShiftState) then
    begin
      ItemNo := ItemAtPos(SmallPointToPoint(Msg.Pos), True);
      if (ItemNo >= 0) and (Selected[ItemNo]) then
      begin
        BeginDrag (False);
        Exit;
      end;
    end;
  end;
  inherited;
  if (DragMode = dmAutomatic) and not (FMultiSelect and
    ((ssCtrl in ShiftState) or (ssShift in ShiftState))) then
    BeginDrag(False);
end;

procedure TTeCustomListBox.WMMouseWheel(var Msg: TWMMouseWheel);
var
  Dy: integer;
  sl: integer;
begin
  if FScrlBar = nil then Exit;

  if IsWinNT or IsWin98 then
    SystemParametersInfo(SPI_GETWHEELSCROLLLINES, 0, @sl, SPIF_SENDCHANGE)
  else
    sl := 3;

  if sl = 0 then
    sl := 1;

  Dy := Msg.WheelDelta div (MOUSE_WHEEL_DELTA div sl);
  with FScrlBar do
    if Dy <> 0 then
      if (FScrlBar.Position - Dy > Max - PageSize + 1) and (PageSize <> 0) then
        FScrlBar.Position := Max - PageSize + 1
      else
        FScrlBar.Position := FScrlBar.Position - Dy
end;

