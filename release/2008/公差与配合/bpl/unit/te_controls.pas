type

  TParentControl_Tab = class(TWinControl);

  TTeTabStringList = class(TStringList)
  private
    FTabControl: TTeCustomTabControl;
  protected
    procedure Put(Index: Integer; const S: string); override;
    procedure SetUpdateState(Updating: Boolean); override;
  public
    procedure Clear; override;
    procedure Delete(Index: Integer); override;
    procedure Insert(Index: Integer; const S: string); override;
    function Add(const S: string): Integer; override;
    procedure Assign(Source: TPersistent); override;
  end;

{ TTeTabStringList }

function TTeTabStringList.Add(const S: string): Integer;
begin
  Result := inherited Add(S);
  FTabControl.TabsChanged;
end;

procedure TTeTabStringList.Assign(Source: TPersistent);
var
  i: integer;
begin
  if Source is TStrings then
  begin
    BeginUpdate;
    try
      inherited Clear;
      for i := 0 to TStrings(Source).Count - 1 do
        inherited Add(TStrings(Source).Strings[i]);
    finally
      FTabControl.TabsChanged;
      EndUpdate;
    end;
    Exit;
  end;
  inherited;
end;

procedure TTeTabStringList.Clear;
begin
  inherited Clear;
  FTabControl.TabsChanged;
end;

procedure TTeTabStringList.Delete(Index: Integer);
begin
  inherited Delete(Index);
  FTabControl.TabsChanged;
end;

procedure TTeTabStringList.Insert(Index: Integer; const S: string);
begin
  inherited Insert(Index, S);
  FTabControl.TabsChanged;
end;

procedure TTeTabStringList.Put(Index: Integer; const S: string);
begin
  inherited Put(Index, S);
  FTabControl.TabsChanged;
end;

procedure TTeTabStringList.SetUpdateState(Updating: Boolean);
begin
  inherited SetUpdateState(Updating);
  FTabControl.FUpdating := Updating;
  if not Updating then
  begin
    FTabControl.Invalidate;
    FTabControl.TabsChanged;
  end;
end;

