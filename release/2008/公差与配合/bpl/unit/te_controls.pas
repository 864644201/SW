{ ScrollBars }

procedure TTeCustomControl.InitScrollBars;
begin
  if Parent = nil then Exit;
   
  if FHScrollBar <> nil then
  begin
    FHScrollBar.Free;
    FHScrollBar := nil;
  end;

  if FScrollBars in [ssHorizontal, ssBoth] then
  begin
    FHScrollBar := CreateScrollBar;

    with TTeCustomScrollBar(FHScrollBar) do
    begin
      BorderWidth := 0;
      Parent := Self;
      Kind := sbHorizontal;
      Height := GetScrollBarHeight;
      Visible := true;
      Transparent := false;
      OnScroll := DoHScroll;
    end;
  end;

  if FVScrollBar <> nil then
  begin
    FVScrollBar.Free;
    FVScrollBar := nil;
  end;

  if FScrollBars in [ssVertical, ssBoth] then
  begin
    FVScrollBar := CreateScrollBar;

    with TTeCustomScrollBar(FVScrollBar) do
    begin
      BorderWidth := 0;
      Parent := Self;
      Kind := sbVertical;
      Width := GetScrollBarHeight;
      Visible := true;
      Transparent := false;
      OnScroll := DoVScroll;
    end;
  end;
end;

