procedure TTeCustomForm.CMPaintToBitmap(var Msg: TMessage);
var
  DC: HDC;
  Point: TSmallPoint;
  SaveActive: boolean;
  SaveDC: HDC;
begin
  Msg.Result := 0;

  Point := TSmallPoint(Msg.WParam);
  DC := Msg.LParam;

  if DC = 0 then Exit;

  SaveActive := FFormActive;
  SaveDC := Canvas.Handle;
  Canvas.Lock;
  try
    FFormActive := true;

    Canvas.Handle := DC;

    { Paint nc area }
    MoveWindowOrg(Canvas.Handle, Point.X, Point.Y);
    PaintNonClientArea(Canvas);
    MoveWindowOrg(Canvas.Handle, -Point.X, -Point.Y);

    { Paint client area }
    with GetClientBounds do
    begin
      MoveWindowOrg(Canvas.Handle, Point.X + Left, Point.Y + Top);
      if Assigned(FOnPaint) and not (csLoading in ComponentState) then
        FOnPaint(Self) { Call OnPaint event }
      else
        PaintClientArea;
      MoveWindowOrg(Canvas.Handle, -(Point.X + Left), -(Point.Y + Top));
    end;
  finally
    Canvas.Handle := SaveDC;
    Canvas.Unlock;
    FFormActive := SaveActive;
  end;

  { Set handled flag }
  Msg.Result := 1;
  MessageHandled;
end;

