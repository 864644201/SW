  if (View <> nil) and (View.Canvas <> nil) and (not FCalcSize) and (not FAutoSize) then
  begin
    FCalcSize := true;
    try
      inherited SetBounds(ALeft, ATop, AWidth, AHeight);
      View.CalcSize;
    finally
      FCalcSize := false;
    end;
  end
  else
  begin
    inherited SetBounds(ALeft, ATop, AWidth, AHeight);

    if (View <> nil) and (View.Canvas <> nil) then
    begin
      FCalcSize := true;
      FAutoSize := false;
      try
        View.CalcSize;
      finally
        FCalcSize := false;
        FAutoSize := true;
      end
    end;
  end;
end;

