procedure TTeCustomScrollBar.DrawSlider;
var
  TmpRect: TRect;
  Theme: HTheme;
  Part, tState: integer;
begin
  TmpRect := GetSliderRect;

  if not UseThemes then
  begin
    with TmpRect do
    begin
      if SliderPressed then
        DrawScrlBarLoweredBtn(Canvas, Left, Top, Right, Bottom)
      else
        DrawScrlBarRaisedBtn(Canvas, Left, Top, Right, Bottom);
    end;
  end
  else
  begin
    { XP drawing }
    Theme := OpenThemeData(0, 'ScrollBar');
    if Kind = sbHorizontal then
      Part := integer(SBP_THUMBBTNHORZ)
    else
      Part := integer(SBP_THUMBBTNVERT);

    if not Enabled then
      tState := integer(SCRBS_DISABLED)
    else
      if SliderPressed then
        tState := integer(SCRBS_PRESSED)
      else
        if MouseOnSlider then
          tState := integer(SCRBS_HOT)
        else
          tState := integer(SCRBS_NORMAL);

    DrawThemeBackground(Theme, Canvas.Handle, Part, tState, TmpRect, nil);

    CloseThemeData(Theme);
  end;
end;

function TTeCustomScrollBar.GetBackgroundRect: TRect;
var
  LBtnSize: integer;
begin
  Result := RectOffset(Rect(0, 0, Width, Height), -BorderWidth);
  LBtnSize := GetBtnSize;
  if ShowButtons then
    with Result do
      if Kind = sbHorizontal then
      begin
        Left := Left + LBtnSize;
        Right := Right - LBtnSize;
      end
      else
      begin
        Top := Top + LBtnSize;
        Bottom := Bottom - LBtnSize;
      end;
end;

function TTeCustomScrollBar.GetBtnSize: integer;
var
  TmpSize: integer;
begin
  Result := GetSystemMetrics(SM_CYVTHUMB);
  if Kind = sbHorizontal then
    TmpSize := Width
  else
    TmpSize := Height;

  if Result * 2 > TmpSize - BorderWidth * 2 then
    Result := (TmpSize - BorderWidth * 2) div 2
end;

function TTeCustomScrollBar.GetLeftTopBtnRect: TRect;
begin
  with Result do
    if Kind = sbHorizontal then
    begin
      Left := BorderWidth;
      Top := BorderWidth;
      Right := Left + GetBtnSize;
      Bottom := Height - BorderWidth;
    end
    else
    begin
      Left := BorderWidth;
      Top := BorderWidth;
      Right := Width - BorderWidth;
      Bottom := Top + GetBtnSize;
    end;
end;

function TTeCustomScrollBar.GetRightBottomBtnRect: TRect;
begin
  with Result do
    if Kind = sbHorizontal then
    begin
      Right := Width - BorderWidth;
      Left := Right - GetBtnSize;
      Top := BorderWidth;
      Bottom := Height - BorderWidth;
    end
    else
    begin
      Left := BorderWidth;
      Right := Width - BorderWidth;
      Bottom := Height - BorderWidth;
      Top := Bottom - GetBtnSize;
    end;
end;

function TTeCustomScrollBar.GetSliderRect: TRect;
begin
  with Result do
    if Kind = sbHorizontal then
    begin
      Left := PositionCoordinate(Position);
      Top := GetBackgroundRect.Top;
      Right := Left + GetSliderSize;
      Bottom := GetBackgroundRect.Bottom;
    end
    else
    begin
      Left := GetBackgroundRect.Left;
      Top := PositionCoordinate(Position);
      Right := GetBackgroundRect.Right;
      Bottom := Top + GetSliderSize;
    end;
end;

function TTeCustomScrollBar.GetLeftTopTrackRect: TRect;
begin
  with Result do
    if Kind = sbHorizontal then
    begin
      Left := GetBackgroundRect.Left;
      Top := GetBackgroundRect.Top;
      Right := PositionCoordinate(Position);
      Bottom := GetBackgroundRect.Bottom;
    end
    else
    begin
      Left := GetBackgroundRect.Left;
      Top := GetBackgroundRect.Top;
      Right := GetBackgroundRect.Right;
      Bottom := PositionCoordinate(Position);
    end;
end;

function TTeCustomScrollBar.GetRightBottomTrackRect: TRect;
begin
  with Result do
    if Kind = sbHorizontal then
    begin
      Left := PositionCoordinate(Position) + GetSliderSize;
      Top := GetBackgroundRect.Top;
      Right := GetBackgroundRect.Right;
      Bottom := GetBackgroundRect.Bottom;
    end
    else
    begin
      Left := GetBackgroundRect.Left;
      Top := PositionCoordinate(Position) + GetSliderSize;
      Right := GetBackgroundRect.Right;
      Bottom := GetBackgroundRect.Bottom;
    end;
end;

function TTeCustomScrollBar.GetSliderSize: integer;
var
  TmpBackRect: TRect;
  TmpBackSize: integer;
begin
  if PageSize <= 0 then
    Result := GetSystemMetrics(SM_CYVTHUMB)
  else
    Result := CalculateSliderSize;

  TmpBackRect := GetBackgroundRect;

  if Kind = sbHorizontal then
    TmpBackSize := TmpBackRect.Right - TmpBackRect.Left
  else
    TmpBackSize := TmpBackRect.Bottom - TmpBackRect.Top;

  if Result >= TmpBackSize then
    Result := 0;
end;

function TTeCustomScrollBar.PtInLeftTopBtn(x, y: integer): boolean;
begin
  Result := PtInRect(GetLeftTopBtnRect, Point(x, y));
end;

function TTeCustomScrollBar.PtInRightBottomBtn(x, y: integer): boolean;
begin
  Result := PtInRect(GetRightBottomBtnRect, Point(x, y));
end;

function TTeCustomScrollBar.PtInSlider(x, y: integer): boolean;
begin
  Result := PtInRect(GetSliderRect, Point(x, y));
end;

function TTeCustomScrollBar.PtInLeftTopTrack(x, y: integer): boolean;
begin
  Result := PtInRect(GetLeftTopTrackRect, Point(x, y));
end;

function TTeCustomScrollBar.PtInRightBottomTrack(x, y: integer): boolean;
begin
  Result := PtInRect(GetRightBottomTrackRect, Point(x, y));
end;

procedure TTeCustomScrollBar.ImitateKeyDown(var Key: word; Shift: TShiftState);
var
  NewPos: integer;

  procedure CorrectNewPos;
  begin
    if NewPos > Max then
      NewPos := Max
    else
      if NewPos < Min then
        NewPos := Min;
  end;

begin
  case Key of
    VK_PRIOR:
      begin
        if PageSize > 0 then
          NewPos := Position - PageSize
        else
          NewPos := Position - LargeChange;
        CorrectNewPos;
        Scroll(kscPageUp, NewPos);
        Position := NewPos;
      end;
    VK_NEXT:
      begin
        if PageSize > 0 then
          NewPos := Position + PageSize
        else
          NewPos := Position + LargeChange;
        CorrectNewPos;
        Scroll(kscPageDown, NewPos);
        Position := NewPos;
      end;
    VK_END:
      begin
        NewPos := Max;
        CorrectNewPos;
        Scroll(kscBottom, NewPos);
        Position := NewPos;
      end;
    VK_HOME:
      begin
        NewPos := Min;
        CorrectNewPos;
        Scroll(kscTop, NewPos);
        Position := NewPos;
      end;
    VK_LEFT, VK_UP:
      begin
        NewPos := Position - SmallChange;
        CorrectNewPos;
        Scroll(kscLineUp, NewPos);
        Position := NewPos;
        if (Position <= Min) and AutoScrollUp then
          AutoScrollUp := false;
      end;
    VK_RIGHT, VK_DOWN:
      begin
        NewPos := Position + SmallChange;
        CorrectNewPos;
        Scroll(kscLineDown, NewPos);
        Position := NewPos;
        if (Position >= Max) and AutoScrollDown then
          AutoScrollDown := false;
      end;
  end;
end;

procedure TTeCustomScrollBar.MouseDown(Button: TMouseButton;
  Shift: TShiftState; x, y: integer);
var
  OldLeftTopBtnPressed,
    OldRightBottomBtnPressed,
    OldLeftTopTrackPressed,
    OldRightBottomTrackPressed: boolean;
  NewPos: integer;
begin
  inherited MouseDown(Button, Shift, x, y);

  if Button <> mbLeft then Exit;

  if PtInSlider(x, y) then
  begin
    if Kind = sbHorizontal then
      FSliderCatchCoord := x - GetSliderRect.Left
    else
      FSliderCatchCoord := y - GetSliderRect.Top;

    NewPos := Position;
    Scroll(kscTrack, NewPos);
    Position := NewPos;

    Invalidate;
  end;

  OldLeftTopBtnPressed := LeftTopBtnPressed;
  OldRightBottomBtnPressed := RightBottomBtnPressed;
  OldLeftTopTrackPressed := LeftTopTrackPressed;
  OldRightBottomTrackPressed := RightBottomTrackPressed;

  if PtInLeftTopBtn(x, y) then
    FMDownOnLeftTopBtn := true;

  if PtInRightBottomBtn(x, y) then
    FMDownOnRightBottomBtn := true;

  if PtInLeftTopTrack(x, y) then
    FMDownOnLeftTopTrack := true;

  if PtInRightBottomTrack(x, y) then
    FMDownOnRightBottomTrack := true;

  if ((OldLeftTopBtnPressed = false) and (LeftTopBtnPressed = true)) or
    ((OldRightBottomBtnPressed = false) and (RightBottomBtnPressed = true)) or
    ((OldLeftTopTrackPressed = false) and (LeftTopTrackPressed = true)) or
    ((OldRightBottomTrackPressed = false) and (RightBottomTrackPressed = true)) then
  begin
    Invalidate;
    PartPress(True);
  end;
end;

procedure TTeCustomScrollBar.MouseMove(Shift: TShiftState; x, y: integer);
var
  TmpCoord, NewPos: integer;
  OldMouseOnSlider,
  OldMouseOnLeftTopBtn,
  OldMouseOnRightBottomBtn,
  OldMouseOnLeftTopTrack,
  OldMouseOnRightBottomTrack: boolean;
begin
  inherited;

  FLastMouseX := x;
  FLastMouseY := y;

  if FSliderCatchCoord > 0 then
  begin
    if Kind = sbHorizontal then
    begin
      TmpCoord := x - FSliderCatchCoord;
      if (TmpCoord < GetBackgroundRect.Left) then
        TmpCoord := GetBackgroundRect.Left
      else
        if TmpCoord > GetBackgroundRect.Right then
        TmpCoord := GetBackgroundRect.Right;
    end
    else
    begin
      TmpCoord := y - FSliderCatchCoord;
      if (TmpCoord < GetBackgroundRect.Top) then
        TmpCoord := GetBackgroundRect.Top
      else
        if TmpCoord > GetBackgroundRect.Bottom then
        TmpCoord := GetBackgroundRect.Bottom;

    end;

    NewPos := CoordinatePosition(TmpCoord);
    Scroll(kscTrack, NewPos);
    Position := CoordinatePosition(TmpCoord);
  end;

  OldMouseOnSlider := FMouseOnSlider;
  FMouseOnSlider := PtInSlider(x, y);

  OldMouseOnLeftTopBtn := FMouseOnLeftTopBtn;
  FMouseOnLeftTopBtn := PtInLeftTopBtn(x, y) and ShowButtons;

  OldMouseOnRightBottomBtn := FMouseOnRightBottomBtn;
  FMouseOnRightBottomBtn := PtInRightBottomBtn(x, y) and ShowButtons;

  OldMouseOnLeftTopTrack := FMouseOnLeftTopTrack;
  FMouseOnLeftTopTrack := PtInLeftTopTrack(x, y);

  OldMouseOnRightBottomTrack := FMouseOnRightBottomTrack;
  FMouseOnRightBottomTrack := PtInRightBottomTrack(x, y);

  if (OldMouseOnSlider <> FMouseOnSlider) or
    (OldMouseOnLeftTopBtn <> FMouseOnLeftTopBtn) or
    (OldMouseOnRightBottomBtn <> FMouseOnRightBottomBtn) or
    (OldMouseOnLeftTopTrack <> FMouseOnLeftTopTrack) or
    (OldMouseOnRightBottomTrack <> FMouseOnRightBottomTrack) then
    Invalidate;
end;

procedure TTeCustomScrollBar.MouseUp(Button: TMouseButton;
  Shift: TShiftState; x, y: integer);
var
  NewPos: integer;
begin
  inherited;

  if Button <> mbLeft then Exit;

  if FSliderCatchCoord <> -1 then
  begin
    NewPos := Position;
    Scroll(kscPosition, NewPos);
    Position := NewPos;
  end;

  FSliderCatchCoord := -1;
  FMDownOnLeftTopBtn := false;
  FMDownOnRightBottomBtn := false;
  FMDownOnLeftTopTrack := false;
  FMDownOnRightBottomTrack := false;

  if FRepeatTimer <> nil then
    FRepeatTimer.Enabled := False;

  NewPos := Position;
  Scroll(kscEndScroll, NewPos);
  Position := NewPos;

  Invalidate;
end;

procedure TTeCustomScrollBar.PaintBuffer;
begin
  inherited;
  DrawBorder;
  DrawBackground;

  if ShowButtons then
  begin
    DrawLeftTopBtn;
    DrawRightBottomBtn;
  end;

  if IsSliderVizible then
  begin
    DrawSlider;

    if LeftTopTrackPressed then
      DrawLeftTopTrack;

    if RightBottomTrackPressed then
      DrawRightBottomTrack;
  end;
end;

procedure TTeCustomScrollBar.TimerExpired(Sender: TObject);
var
  OldMouseOnLeftTopTrack,
    OldMouseOnRightBottomTrack: boolean;
  LKey: word;
begin
  FRepeatTimer.Interval := GetKeyBoardSpeedInterval;
  try
    if LeftTopBtnPressed or FAutoScrollUp then
    begin
      LKey := VK_Left;
      ImitateKeyDown(LKey, []);
    end
    else
      if RightBottomBtnPressed or FAutoScrollDown then
    begin
      LKey := VK_Right;
      ImitateKeyDown(LKey, []);
    end
    else
    begin
      OldMouseOnLeftTopTrack := FMouseOnLeftTopTrack;
      FMouseOnLeftTopTrack := PtInLeftTopTrack(FLastMouseX, FLastMouseY);
      if LeftTopTrackPressed then
      begin
        LKey := VK_Prior;
        ImitateKeyDown(LKey, []);
      end
      else
      begin
        OldMouseOnRightBottomTrack := FMouseOnRightBottomTrack;
        FMouseOnRightBottomTrack := PtInRightBottomTrack(FLastMouseX, FLastMouseY);
        if RightBottomTrackPressed then
        begin
          LKey := VK_Next;
          ImitateKeyDown(LKey, []);
        end;

        if (OldMouseOnLeftTopTrack <> FMouseOnLeftTopTrack) or
          (OldMouseOnRightBottomTrack <> FMouseOnRightBottomTrack) then
          Invalidate;
      end;
    end;
  except
    FRepeatTimer.Enabled := False;
  end;
end;

procedure TTeCustomScrollBar.PartPress(FirstTime: boolean);
begin
  if FRepeatTimer = nil then
  begin
    FRepeatTimer := TTimer.Create(Self);
    FRepeatTimer.OnTimer := TimerExpired;
  end;
  if FirstTime then
  begin
    FRepeatTimer.OnTimer(FRepeatTimer);
    FRepeatTimer.Interval := GetKeyBoardDelayInterval;
  end
  else
    FRepeatTimer.Interval := GetKeyBoardSpeedInterval;

  FRepeatTimer.Enabled := true;
end;

function TTeCustomScrollBar.IsSliderVizible: boolean;
var
  TmpRect: TRect;
begin
  TmpRect := GetSliderRect;
  Result := ((Enabled = true) or (csDesigning in ComponentState)) and
    not ((TmpRect.Right - TmpRect.Left <= 0) or
      (TmpRect.Bottom - TmpRect.Top <= 0));
end;

procedure TTeCustomScrollBar.CMEnabledChanged(var Msg: TMessage);
begin
  inherited;
  Invalidate;
end;

procedure TTeCustomScrollBar.MouseLeave;
begin
  if FMouseOnSlider or
    FMouseOnLeftTopBtn or
    FMouseOnRightBottomBtn or
    FMouseOnLeftTopTrack or
    FMouseOnRightBottomTrack then
  begin
    FMouseOnSlider := false;
    FMouseOnLeftTopBtn := false;
    FMouseOnRightBottomBtn := false;
    FMouseOnLeftTopTrack := false;
    FMouseOnRightBottomTrack := false;
    Invalidate;
  end;
end;

procedure TTeCustomScrollBar.WMGetDlgCode(var Msg: TWMGetDlgCode);
begin
  inherited;
  Msg.Result := dlgc_WantArrows;
end;

procedure TTeCustomScrollBar.SetBorderWidth(const Value: integer);
begin
  if FBorderWidth <> Value then
  begin
    FBorderWidth := Value;
    Invalidate;
  end;
end;

procedure TTeCustomScrollBar.SetKind(const Value: TScrollBarKind);
var
  TmpValue: integer;
begin
  if FKind <> Value then
  begin
    FKind := Value;
    if (csDesigning in ComponentState)
      and (((FKind = sbHorizontal) and (Height > Width))
      or ((FKind = sbVertical) and (Height < Width))) then
    begin
      TmpValue := Width;
      Width := Height;
      Height := TmpValue;
    end;
    Invalidate;
  end;
end;

procedure TTeCustomScrollBar.SetMax(const Value: integer);
begin
  if (FMax <> Value) then
  begin
    if Value < Min then
      FMax := Min
    else
      FMax := Value;

    if Position > FMax then
      Position := FMax;

    if FPageSize > FMax - FMin+1 then
      FPageSize := FMax - FMin+1;

    Invalidate;
  end;
end;

procedure TTeCustomScrollBar.SetMin(const Value: integer);
begin
  if (FMin <> Value) then
  begin
    if Value > Max then
      FMin := Max
    else
      FMin := Value;


    if Position < FMin then
      Position := FMin;

    if FPageSize > FMax - FMin+1 then
      FPageSize := FMax - FMin+1;

    Invalidate;
  end;
end;

procedure TTeCustomScrollBar.SetPageSize(const Value: integer);
begin
  if (FPageSize <> Value) and (Value >= 0) then
  begin
    FPageSize := Value;

    if FPageSize > FMax - FMin+1 then
      FPageSize := FMax - FMin+1;

    Invalidate;
  end;
end;

procedure TTeCustomScrollBar.SetPosition(const Value: integer);
begin
  if FPosition <> Value then
  begin
    if Value > Max then
      FPosition := Max
    else
      if Value < Min then
        FPosition := Min
    else
      FPosition := Value;
    Invalidate;
    Change;
  end;
end;

procedure TTeCustomScrollBar.SetShowButtons(const Value: boolean);
begin
  if FShowButtons <> Value then
  begin
    FShowButtons := Value;
    Invalidate;
  end;
end;

function TTeCustomScrollBar.GetSliderPressed: boolean;
begin
  Result := FSliderCatchCoord > -1;
end;

function TTeCustomScrollBar.GetLeftTopBtnPressed: boolean;
begin
  Result := FMDownOnLeftTopBtn and MouseOnLeftTopBtn;
end;

function TTeCustomScrollBar.GetRightBottomBtnPressed: boolean;
begin
  Result := FMDownOnRightBottomBtn and MouseOnRightBottomBtn;
end;

function TTeCustomScrollBar.GetLeftTopTrackPressed: boolean;
begin
  Result := FMDownOnLeftTopTrack and MouseOnLeftTopTrack;
end;

function TTeCustomScrollBar.GetRightBottomTrackPressed: boolean;
begin
  Result := FMDownOnRightBottomTrack and MouseOnRightBottomTrack;
end;

procedure TTeCustomScrollBar.SetAutoSrcollUp(const Value: boolean);
begin
  if FAutoScrollUp <> Value then begin
    FAutoScrollUp := Value;

    if FAutoScrollUp then begin
      AutoScrollDown := not FAutoScrollUp;
      PartPress(false);
    end else
      if FRepeatTimer <> nil then
        FRepeatTimer.Enabled := false;
  end;
end;

procedure TTeCustomScrollBar.SetAutoSrcollDown(const Value: boolean);
begin
  if FAutoScrollDown <> Value then begin
    FAutoScrollDown := Value;

    if FAutoScrollDown then begin
      AutoScrollUp := not FAutoScrollDown;
      PartPress(false);
    end
    else
      if FRepeatTimer <> nil then
        FRepeatTimer.Enabled := false;
  end;
end;



{ TTeCustomSpeedButton }

constructor TTeCustomSpeedButton.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);

  FNumGlyphs := 1;
  FState := bsUp;
  ControlStyle := ControlStyle + [csCaptureMouse, csDoubleClicks];
  FShowChevron := false;
  FFlat := false;
  FGroupIndex := 0;
  FAllowAllUp := false;
  FMenuPosition := dmpBottom;
  FMargin := -1;
  FSpacing := 4;
  FLayout := blGlyphLeft;
  FDown := false;
  FShowCaption := true;
  FShowGlyph := true;

  FMouseDown := false;

  FGlyph := TBitmap.Create;
  FGlyph.OnChange := GlyphChangedHandler;

  Transparent := true; 
  
  SetBounds(0, 0, 29, 29);
end;

destructor TTeCustomSpeedButton.Destroy;
begin
  if FRepeatTimer <> nil then
    FRepeatTimer.Free;
  FGlyph.Free;
  inherited;
end;

procedure TTeCustomSpeedButton.Loaded;
begin
  inherited;
end;

procedure TTeCustomSpeedButton.TimerExpired(Sender: TObject);
begin
  FRepeatTimer.Interval := RepeatPause;
  if (FState = bsDown) and MouseCapture then
  begin
    try
      Click;
    except
      FRepeatTimer.Enabled := False;
      raise;
    end;
  end;
end;

procedure TTeCustomSpeedButton.Click;
begin
  if FState = bsChevronDown then Exit;
  
  if Assigned(FOnClick) and (Action <> nil) and (@FOnClick <> @Action.OnExecute) then
    FOnClick(Self)
  else
    if not (csDesigning in ComponentState) and (ActionLink <> nil) then
      ActionLink.Execute
    else
      if Assigned(FOnClick) then
        FOnClick(Self);
end;

procedure TTeCustomSpeedButton.DrawDropDownArrow(Offset: TPoint);
var
  LPaintRect: TRect;
begin
  LPaintRect := GetDropDownArrowRect;
  with Offset do
    OffsetRect(LPaintRect, x, y);

  with LPaintRect, Offset do
    if FState <> bsDisabled then
    begin
      FillPolygon(Canvas, [Point(Left, Top),
        Point(Right - 1, Top),
        Point((Right - 1 + Left) div 2, Bottom - 1)],
        clBtnText);
    end
    else
    begin
      MoveTo(Canvas, (Right + Left) div 2, Bottom - 1);
      LineTo(Canvas, Left, Top, clBtnShadow);
      LineTo(Canvas, Right, Top, clBtnShadow);
      MoveTo(Canvas, Right, Top);
      LineTo(Canvas, (Right + Left) div 2 + 1 - 1, Bottom + 1 - 1, clBtnHighlight);
    end;
end;

procedure TTeCustomSpeedButton.DrawGlyph(Offset: TPoint);
var
  R: TRect;
  SrcRect: TRect;
  i, j, W, H: Integer;
  NewColor, TransparentColor: TColor;
  cH, cS, cL: single;
begin
  if FGlyph = nil then Exit;
  if FGlyph.Empty then Exit;

  R := Rect(0, 0, GetGlyphSize.x, GetGlyphSize.y);
  RectCenter(R, GetGlyphRect);
  with Offset do
    OffsetRect(R, x, y);

  W := FGlyph.Width div FNumGlyphs;
  H := FGlyph.Height;

  SrcRect := Rect(0, 0, W, H);

  if (FNumGlyphs > 1) and not Enabled then
    OffsetRect(SrcRect, W, 0);

  if (FNumGlyphs = 4) and (State = bsExclusive) then
    OffsetRect(SrcRect, W * 3, 0);

  if (FNumGlyphs >= 3) and (State = bsDown) then
    OffsetRect(SrcRect, W * 2, 0);

  TransparentColor := FGlyph.Canvas.Pixels[0, H - 1];

  { Copy to Buffer }
  for i := 0 to W-1 do
    for j := 0 to H-1 do
    begin
      NewColor := FGlyph.Canvas.Pixels[SrcRect.Left + i, SrcRect.Top + j];
      if (FBlackAndWhiteGlyph) and (not MouseInControl) and (NewColor <> TransparentColor) then
      begin
        RGBtoHSL(KColor(NewColor), cH, cS, cL);
        NewColor := RGB(Round(cL * $FF), Round(cL * $FF), Round(cL * $FF));
      end;
      if NumGlyphs = 1 then
        if (not Enabled) and (NewColor <> TransparentColor) then
        begin
          RGBtoHSL(KColor(NewColor), cH, cS, cL);
          NewColor := RGB(160+Round(cL * 50), 160+Round(cL * 50), 160+Round(cL * 50));
        end;
      if NewColor <> TransparentColor then
        Canvas.Pixels[R.Left + i, R.Top + j] := NewColor;
    end;
end;

procedure TTeCustomSpeedButton.DrawCaption(Offset: TPoint);
var
  LPaintRect: TRect;
begin
  LPaintRect := GetCaptionRect;
  with Offset do
    OffsetRect(LPaintRect, x, y);

  Canvas.Font := ControlFont;
  if FState <> bsDisabled then
    DrawText(Canvas, Caption, LPaintRect, DrawTextBiDiModeFlags(DT_LEFT))
  else
  begin
    OffsetRect(LPaintRect, 1, 1);
    Canvas.Font.Color := clBtnHighlight;
    DrawText(Canvas, Caption, LPaintRect, DrawTextBiDiModeFlags(DT_LEFT));
    OffsetRect(LPaintRect, -1, -1);
    Canvas.Font.Color := clBtnShadow;
    DrawText(Canvas, Caption, LPaintRect, DrawTextBiDiModeFlags(DT_LEFT));
  end;
end;

function TTeCustomSpeedButton.GetDropDownArrowSize: TPoint;
begin
  with Result do
  begin
    x := 5;
    y := 3;
  end;
end;

function TTeCustomSpeedButton.GetGlyphSize: TPoint;
begin
  with Result do
  begin
    x := FGlyph.Width div FNumGlyphs;
    y := FGlyph.Height;
  end;
end;

function TTeCustomSpeedButton.GetCaptionSize: TPoint;
var
  R: TRect;
begin
  Result := Point(0, 0);

  Canvas.Font := ControlFont;

  Result.x := TextWidth(Canvas, Caption);
  if Caption <> '' then
    Result.y := TextHeight(Canvas, 'Pq')
  else
    Result.y := 0;
end;

function TTeCustomSpeedButton.GetChevronWidth: integer;
begin
  Result := 14;
end;

procedure TTeCustomSpeedButton.PaintBuffer;
const
  DownStyles: array[boolean] of integer = (BDR_RAISEDINNER, BDR_SUNKENOUTER);
  FillStyles: array[Boolean] of Integer = (BF_MIDDLE, 0);
var
  DrawFlags: integer;
  LButtonRect, LChevronRect, R: TRect;
  ButtonOffset, ChevronOffset: TPoint;
  SaveFlat: boolean;
  Theme: HTheme;
  Part, tState: integer;
begin
  if not Transparent and (Performance <> kspNobuffer) then
    inherited ;

  if not Enabled then
    FState := bsDisabled;

  LButtonRect := GetButtonRect;
  LChevronRect := GetChevronRect;

  if not UseThemes then
  begin
    { Default draiwng }
    if (Owner is TTeCustomSpinButton) and (FState = bsUp) then
    begin
      SaveFlat := FFlat;
      FFlat := false;
    end;

    if Flat then
    begin
      if (Enabled and
        ((FState in [bsDown, bsExclusive]) or
        (MouseInControl and (FState <> bsDisabled)) or
        ((FState = bsUp) and FMouseDown) or
        (FState = bsChevronDown))) or
        (csDesigning in ComponentState) then
      begin
        if not Transparent then
        begin
          FillRect(Canvas, LButtonRect, clBtnFace);
          if ShowChevron then
            FillRect(Canvas, LChevronRect, clBtnFace);
        end;

        if (FState = bsExclusive) and (not FFlat or not MouseInControl) then
          FillHalftoneRect(Canvas, LButtonRect, clBtnFace, clBtnHighlight);

        if FState in [bsDown, bsExclusive] then
          DrawEdge(Canvas, LButtonRect, clBtnShadow, clBtnHighlight)
        else
          DrawEdge(Canvas, LButtonRect, clBtnHighlight, clBtnShadow);

        if ShowChevron then
        begin
          if (FState in [bsChevronDown, bsExclusive]) or Down then
            DrawEdge(Canvas, LChevronRect, clBtnShadow, clBtnHighlight)
          else
            DrawEdge(Canvas, LChevronRect, clBtnHighlight, clBtnShadow);
        end;
      end;
    end
    else
    begin
      DrawFlags := DFCS_BUTTONPUSH or DFCS_ADJUSTRECT;

      if FState in [bsDown, bsExclusive] then
        DrawFlags := DrawFlags or DFCS_PUSHED;
      DrawFrameControl(Canvas.Handle, LButtonRect, DFC_BUTTON, DrawFlags);

      DrawFlags := DFCS_BUTTONPUSH or DFCS_ADJUSTRECT;
      if FState in [bsChevronDown, bsExclusive] then
        DrawFlags := DrawFlags or DFCS_PUSHED;

      if ShowChevron then
        DrawFrameControl(Canvas.Handle, LChevronRect, DFC_BUTTON, DrawFlags);

      if (FState = bsExclusive) and (not FFlat or not MouseInControl) then
        FillHalftoneRect(Canvas, LButtonRect, clBtnFace, clBtnHighlight);
    end;

    ButtonOffset := Point(0, 0);
    ChevronOffset := Point(0, 0);

    if FState in [bsDown, bsExclusive] then
      ButtonOffset := Point(1, 1);

    if (FState in [bsChevronDown, bsExclusive]) or Down then
      ChevronOffset := Point(1, 1);

    if ShowGlyph then
      DrawGlyph(ButtonOffset);

    if ShowCaption then
      DrawCaption(ButtonOffset);

    if ShowChevron then
      DrawDropDownArrow(ChevronOffset);

    if (Owner is TTeCustomSpinButton) then
      FFlat := SaveFlat;
  end
  else
  begin
    { XP Style }
    if not Enabled then
      tState := integer(TS_DISABLED)
    else
      if not Flat then
      begin
        { Normal }
        tState := integer(TS_HOT);

        if State = bsDown then
        begin
          if not (FState = bsExclusive) then
            tState := integer(TS_PRESSED)
          else
            tState := integer(TS_CHECKED);
        end
        else
          if not (FState = bsExclusive) then
            tState := integer(TS_HOT)
          else
            tState := integer(TS_CHECKED);
      end
      else
      begin
        { Flat }
        if State = bsDown then
          tState := integer(TS_PRESSED)
        else
          if MouseInControl then
            if not (FState = bsExclusive) then
              tState := integer(TS_HOT)
            else
              tState := integer(TS_HOTCHECKED)
          else
            if (FState = bsExclusive) then
              tState := integer(TS_CHECKED)
      end;

    { Draw Face }
    if Parent is TTeCustomSpinButton then
    begin
      { Spin button }
      Theme := OpenThemeData(0, 'Spin');
      if Caption = 'up' then
        Part := integer(SPNP_UP)
      else
        Part := integer(SPNP_DOWN);

      R := GetButtonRect;
      DrawThemeBackground(Theme, Canvas.Handle, Part, tState, R, nil);
    end
    else
    begin
      { Standard }
      Theme := OpenThemeData(0, 'Toolbar');
      Part := integer(TP_BUTTON);

      R := LButtonRect;
      DrawThemeBackground(Theme, Canvas.Handle, Part, tState, R, nil);

      if ShowChevron then
      begin
        { Draw Chavron }
        if FState = bsChevronDown then
          tState := integer(TS_PRESSED);

        R := LChevronRect;
        DrawThemeBackground(Theme, Canvas.Handle, Part, tState, R, nil);
      end;
    end;

    CloseThemeData(Theme);

    { Draw Glyph }
    ButtonOffset := Point(0, 0);
    ChevronOffset := Point(0, 0);

    if FState in [bsDown, bsExclusive] then
      ButtonOffset := Point(1, 1);

    if (FState in [bsChevronDown, bsExclusive]) or Down then
      ChevronOffset := Point(1, 1);

    if ShowGlyph and not (Parent is TTeCustomSpinButton) then
      DrawGlyph(ButtonOffset);

    if ShowCaption then
      DrawCaption(ButtonOffset);

    if ShowChevron then
      DrawDropDownArrow(ChevronOffset);
  end;
end;

function TTeCustomSpeedButton.GetButtonRect: TRect;
begin
  Result := GetClientRect;
  if ShowChevron then
    Result.Right := Result.Right - GetChevronWidth;
end;

function TTeCustomSpeedButton.GetChevronRect: TRect;
begin
  Result := GetClientRect;
  if ShowChevron then
    Result.Left := Result.Right - GetChevronWidth
  else
    Result.Left := Result.Right;
end;

procedure TTeCustomSpeedButton.MouseDown(Button: TMouseButton;
  Shift: TShiftState; X, Y: Integer);
var
  FOldState: TTeSpeedButtonState;
begin
  inherited MouseDown(Button, Shift, X, Y);
  FMouseDown := true;

  if (Button = mbLeft) and Enabled then
  begin
    if PtInRect(GetButtonRect, Point(x, y)) then
      FState := bsDown
    else
      if PtInRect(GetChevronRect, Point(x, y)) then
    begin
      if not (FState in [bsDown, bsExclusive]) then
      begin
        FState := bsChevronDown;
        Invalidate;
      end;

      FState := bsChevronDown;
      ChevronClick;
      Invalidate;
      Exit;

      if not (FState in [bsDown, bsExclusive]) then
      begin
        FState := bsUp;
        FMouseDown := false;
      end;
    end;
    Invalidate;
  end;

  if FAllowTimer then
  begin
    if FRepeatTimer = nil then
      FRepeatTimer := TTimer.Create(Self);

    FRepeatTimer.OnTimer := TimerExpired;
    FRepeatTimer.Interval := InitRepeatPause;
    FRepeatTimer.Enabled  := True;
  end;
end;

procedure TTeCustomSpeedButton.MouseUp(Button: TMouseButton; Shift: TShiftState;
  X, Y: Integer);
var
  DoClick: Boolean;
begin
  inherited MouseUp(Button, Shift, X, Y);
  FMouseDown := false;

  DoClick := (X >= 0) and (X < ClientWidth) and (Y >= 0) and (Y <= ClientHeight)
    and (FState in [bsDown, bsExclusive]);

  if (FState = bsChevronDown) then
  begin
    if Assigned(FChevronMenu) then
      CheckChevronDropDown;
      
    FState := bsUp;
    Invalidate;
  end;

  if (FState <> bsChevronDown) and not FDown then
  begin
    FState := bsUp;
    Invalidate;
  end;

  if DoClick then
  begin
    if (not Down) and (GroupIndex <> 0) then
      Down := true
    else
    begin
      if AllowAllUp then
        Down := false
      else
        if (GroupIndex <> 0) then
          FState := bsExclusive;
    end;

    Invalidate;
  end;

  if FRepeatTimer <> nil then
    FRepeatTimer.Enabled  := false;
end;

procedure TTeCustomSpeedButton.UpdateExclusive;
var
  Msg: TMessage;
begin
  if (FGroupIndex <> 0) and (Parent <> nil) then
  begin
    Msg.Msg := CM_BUTTONPRESSED;
    Msg.WParam := FGroupIndex;
    Msg.LParam := Longint(Self);
    Msg.Result := 0;
    Parent.Broadcast(Msg);
  end;
end;

procedure TTeCustomSpeedButton.Notification(AComponent: TComponent;
  Operation: TOperation);
begin
  inherited Notification(AComponent, Operation);
  if (AComponent = ChevronMenu) and (Operation = opRemove) then
    ChevronMenu := nil;
end;

function TTeCustomSpeedButton.GeTTeChevronPos: TPoint;
begin
  if Assigned(FChevronMenu) then
  begin
    if MenuPosition = dmpBottom then
    begin
      case FChevronMenu.Alignment of
        paLeft: Result := Point(GetChevronRect.Left - 1, Height);
        paRight: Result := Point(Width + 1, Height);
      else {paCenter}
        Result := Point(Width div 2, Height);
      end;
    end
    else { dmpRight }
    begin
      case FChevronMenu.Alignment of
        paLeft: Result := Point(Width, -1);
        paRight: Result := Point(-1, -1);
      else {paCenter}
        Result := Point(Width div 2, Height);
      end;
    end;
  end
  else
    Result := Point(0, 0);
end;

function TTeCustomSpeedButton.CheckChevronDropDown: Boolean;
begin
  Result := CheckMenuDropDown(PointToSmallPoint(GeTTeChevronPos), True);
end;

function TTeCustomSpeedButton.CheckMenuDropDown(const Pos: TSmallPoint;
  Manual: Boolean): Boolean;
var
  Form: TCustomForm;
begin
  Result := False;
  if csDesigning in ComponentState then Exit;
  if Assigned(FChevronMenu) and (ChevronMenu.AutoPopup or Manual) then
  begin
    Form := GetParentForm(Self);
    if Form <> nil then
      Form.SendCancelMode(nil);
    ChevronMenu.PopupComponent := Self;
    with ClientToScreen(SmallPointToPoint(Pos)) do
      ChevronMenu.Popup(X, Y);
    Result := True;
  end;
end;

function TTeCustomSpeedButton.GetDropDownArrowRect: TRect;
var
  LSize: TPoint;
  LChevronWidth: integer;
begin
  LSize := GetDropDownArrowSize;
  LChevronWidth := GetChevronWidth;
  with Result do
  begin
    Left := GetChevronRect.Right - LChevronWidth + (LChevronWidth - LSize.x) div 2;
    Top := (GetChevronRect.Bottom - LSize.y) div 2;
    Right := Left + LSize.x;
    Bottom := Top + LSize.y
  end;
end;

function TTeCustomSpeedButton.GetGlyphRect: TRect;
var
  LGlyphSize,
    LCaptionSize: TPoint;
  LButtonRect: TRect;
begin
  if ShowGlyph then
    LGlyphSize := GetGlyphSize
  else
    LGlyphSize := Point(0, 0);

  if ShowCaption then
    LCaptionSize := GetCaptionSize
  else
    LCaptionSize := Point(0, 0);

  LButtonRect := GetButtonRect;
  with Result do
  begin
    case Layout of
      blGlyphLeft, blGlyphRight:
        begin
          if (LGlyphSize.x = 0) or not ShowGlyph then
            Left := LButtonRect.Left
          else
            if Margin <> -1 then
              Left := Margin
          else
            if (LCaptionSize.x = 0) or not ShowCaption then
              Left := ((LButtonRect.Right - LButtonRect.Left) - LGlyphSize.x) div 2
          else
            if Spacing <> -1 then
              Left := ((LButtonRect.Right - LButtonRect.Left) - LGlyphSize.x
                - Spacing - LCaptionSize.x) div 2
          else
            Left := ((LButtonRect.Right - LButtonRect.Left) - LGlyphSize.x
              - LCaptionSize.x) div 3;

          Top := ((LButtonRect.Bottom - LButtonRect.Top) - LGlyphSize.y) div 2;
        end;
      blGlyphTop, blGlyphBottom:
        begin
          Left := ((LButtonRect.Right - LButtonRect.Left) - LGlyphSize.x) div 2;

          if (LGlyphSize.y = 0) or not ShowGlyph then
            Top := LButtonRect.Top
          else
            if Margin <> -1 then
            Top := Margin
          else
            if (LCaptionSize.y = 0) or not ShowCaption then
            Top := ((LButtonRect.Bottom - LButtonRect.Top) - LGlyphSize.y) div 2
          else
            if Spacing <> -1 then
            Top := ((LButtonRect.Bottom - LButtonRect.Top) - LGlyphSize.y
              - Spacing - LCaptionSize.y) div 2
          else
            Top := ((LButtonRect.Bottom - LButtonRect.Top) - LGlyphSize.y
              - LCaptionSize.y) div 3;
        end;
    end;

    {Mirror reflection}
    if Layout = blGlyphRight then
      Left := LButtonRect.Right - Left - LGlyphSize.x - 1;

    if Layout = blGlyphBottom then
      Top := LButtonRect.Bottom - Top - LGlyphSize.y - 1;

    Right := Left + LGlyphSize.x;
    Bottom := Top + LGlyphSize.y;
  end;
end;

function TTeCustomSpeedButton.GetCaptionRect: TRect;
var
  LGlyphSize,
    LCaptionSize: TPoint;
  LButtonRect,
    LGlyphRect: TRect;

begin
  LGlyphSize := GetGlyphSize;
  LCaptionSize := GetCaptionSize;
  LButtonRect := GetButtonRect;
  LGlyphRect := GetGlyphRect;

  if Glyph.Empty then
  begin
    Result := Rect(0, 0, GetCaptionSize.X, GetCaptionSize.Y);
    RectCenter(Result, Rect(0, 0, Width, Height));
    Exit;
  end;

  with Result do
  begin
    case Layout of
      blGlyphLeft:
        begin
          if Spacing <> -1 then
            Left := LGlyphRect.Right + Spacing
          else
            Left := LGlyphRect.Right + ((LButtonRect.Right - LGlyphRect.Right) - LCaptionSize.x) div 2;

          Top := ((LButtonRect.Bottom - LButtonRect.Top) - LCaptionSize.y) div 2;
        end;
      blGlyphTop:
        begin
          Left := ((LButtonRect.Right - LButtonRect.Left) - LCaptionSize.x) div 2;

          if Spacing <> -1 then
            Top := LGlyphRect.Bottom + Spacing
          else
            Top := LGlyphRect.Bottom + ((LButtonRect.Bottom - LGlyphRect.Bottom) - LCaptionSize.y) div 2;
        end;
      blGlyphRight:
        begin
          if Spacing <> -1 then
            Left := LGlyphRect.Left - Spacing - LCaptionSize.x
          else
            Left := ((LGlyphRect.Left - LButtonRect.Left) - LCaptionSize.x) div 2;

          Top := ((LButtonRect.Bottom - LButtonRect.Top) - LCaptionSize.y) div 2;
        end;
      blGlyphBottom:
        begin
          Left := ((LButtonRect.Right - LButtonRect.Left) - LCaptionSize.x) div 2;

          if Spacing <> -1 then
            Top := LGlyphRect.Top - Spacing - LCaptionSize.y
          else
            Top := ((LGlyphRect.Top - LButtonRect.Top) - LCaptionSize.y) div 2;
        end;
    end;

    Right := Left + LCaptionSize.x;
    Bottom := Top + LCaptionSize.y;
  end;
end;

procedure TTeCustomSpeedButton.ActionChange(Sender: TObject;
  CheckDefaults: Boolean);

  procedure CopyImage(ImageList: TCustomImageList; Index: Integer);
  begin
    with Glyph do
    begin
      Width := ImageList.Width;
      Height := ImageList.Height;
      Canvas.Brush.Color := clFuchsia;
      Canvas.FillRect(Rect(0, 0, Width, Height));
      ImageList.Draw(Canvas, 0, 0, Index);
    end;
  end;

begin
  inherited ActionChange(Sender, CheckDefaults);
  if Sender is TCustomAction then
    with TCustomAction(Sender) do
      if (Glyph.Empty) and (ActionList <> nil) and (ActionList.Images <> nil) and
        (ImageIndex >= 0) and (ImageIndex < ActionList.Images.Count) then
      begin

        CopyImage(ActionList.Images, ImageIndex);
        Invalidate;
      end
end;

