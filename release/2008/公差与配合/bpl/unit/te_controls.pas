{ Properties }

procedure TTeCustomTrackBar.SetMax(const Value: integer);
begin
  if (FMax <> Value) and (Value > Min)  then
  begin
    FMax := Value;
    if Position > FMax then
      Position := FMax;
    Invalidate;
  end;
end;

procedure TTeCustomTrackBar.SetMin(const Value: integer);
begin
  if (FMin <> Value) and (Value < Max) then
  begin
    FMin := Value;
    if Position < FMin then
      Position := FMin;
    Invalidate;
  end;
end;

procedure TTeCustomTrackBar.SetOrientation(const Value: TTrackOrientation);
var
  TmpValue: integer;
begin
  if FOrientation <> Value then
  begin
    FOrientation := Value;
    if (csDesigning in ComponentState)
      and (((FOrientation = toHorizontal) and (Height > Width))
      or ((FOrientation = toVertical) and (Height < Width))) then
    begin
      TmpValue := Width;
      Width := Height;
      Height := TmpValue;
    end;
    Invalidate;
  end;
end;

procedure TTeCustomTrackBar.SetPosition(const Value: integer);
begin
  if FPosition <> Value then
  begin
    if Value > FMax then
      FPosition := FMax
    else
      if Value < FMin then
      FPosition := FMin
    else
      FPosition := Value;
    Invalidate;
    Change;
  end;
end;

procedure TTeCustomTrackBar.SetShowTicks(const Value: boolean);
begin
  if FShowTicks <> Value then
  begin
    FShowTicks := Value;
    Invalidate;
  end;
end;

procedure TTeCustomTrackBar.SetThumbHalfWidth(const Value: word);
begin
  if FThumbHalfWidth <> Value then
  begin
    FThumbHalfWidth := Value;
    Invalidate;
  end;
end;

procedure TTeCustomTrackBar.SetTickMarks(const Value: TTickMark);
begin
  if Value <> FTickMarks then
  begin
    FTickMarks := Value;
    Invalidate;
  end;
end;

procedure TTeCustomTrackBar.SetLineSize(const Value: Integer);
begin
