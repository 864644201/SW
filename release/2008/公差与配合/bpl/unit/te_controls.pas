procedure TTeCustomForm.DoAfterMessage(var Msg: TMessage; var Handled: Boolean);
var
  i: integer;
  ChildForm: TTeCustomForm;
  R: TRect;
  NewCaption: string;
begin
  { After form handled }
  with Msg do
    case Msg of
      WM_SYSCOMMAND:
        begin
          if (wParam and $FFF0 = SC_CONTEXTHELP) then
            UpdateNonClientArea(0);
        end;
      WM_NCACTIVATE:
        begin
          if GetWindowLong(Handle, GWL_HWNDPARENT) = 0 then
          begin
            UpdateNonClientArea(0);
          end;
          if (Form <> nil) and (THackForm(Form).FormStyle = fsMDIChild) then
          begin
            UpdateNonClientArea(0);
            { Post for update }
            PostMessage(Handle, WM_UPDATENCAREA, 0, 0);
          end;
        end;
      WM_GETTEXT:
        if (FOldCaption <> string(PChar(lParam))) then
        begin
          { Disabled caption }
          SetWindowLong(Handle, GWL_STYLE, GetWindowLong(Handle, GWL_STYLE ) and not WS_CAPTION);

          FCaption := PChar(lParam);

          { Post for update }
          PostMessage(Handle, WM_UPDATENCAREA, WM_GETTEXT, 0);
          { Save Result }
          FOldCaption := PChar(lParam);

          { For MDIChild }
          if (Form <> nil) and (THackForm(Form).FormStyle = fsMDIChild) and
            IsMDIChildMaximized
          then
            ChangeMDIParentCaption;

          { Set handled flag }
          Result := 0;
        end;
      WM_SIZE:
        if (Form <> nil) and (THackForm(Form).FormStyle = fsMDIForm) and
           (THackForm(Form).MDIChildCount > 0) and (IsMDIChildMaximized)
        then
        begin
          for i := 0 to THackForm(Form).MDIChildCount - 1 do
          begin
            if THackForm(Form).ClientHandle <> 0 then
              Windows.GetClientRect(THackForm(Form).ClientHandle, R)
            else
              Windows.GetClientRect(Handle, R);

            if THackForm(Form).MDIChildren[i] = THackForm(Form).ActiveMDIChild then
              THackForm(Form).MDIChildren[i].BoundsRect := R;
          end;
        end;
    end;
end;

procedure TTeCustomForm.WMNCCalcSize(var Msg: TWMNCCalcSize);
var
  rgrc: PNCCalcSizeParams;
  WP: PWindowPos;
  m_lLeft, m_lRight, m_lTop, m_lBottom: integer;
begin
  if (Msg.CalcValidRects) then
  begin
    rgrc := Msg.CalcSize_Params;

    with GetClientBounds do
    begin
      m_lLeft := left;
      m_lRight := FRealWidth-right;
      m_lTop := top;
      m_lBottom := FRealHeight-bottom;
    end;

    WP := rgrc.lppos;
    with rgrc^.rgrc[0] do
    begin
      left := WP^.x;
      top := WP^.y;
      right := WP^.x + WP^.cx;
      bottom := WP^.y + WP^.cy;
      left := left + m_lLeft;
      top := top + m_lTop;
      right := right - m_lRight;
      bottom := bottom - m_lBottom;
    end;
    rgrc^.rgrc[1] := rgrc^.rgrc[0];
    Msg.CalcSize_Params := rgrc;
    Msg.Result := WVR_VALIDRECTS;
  end;

  { Set handled flag }
  Msg.Result := 0;
  MessageHandled;
end;

procedure TTeCustomForm.WMNCPaint(var Msg: TMessage);
begin
  UpdateNonClientArea(Msg.wParam);
  { Set handled flag }
  Msg.Result := 0;
  MessageHandled;
end;

procedure TTeCustomForm.WMNCActivate(var Msg: TWMNCActivate);
begin
  FFormActive := Msg.Active;

  if (not FSetAppEvent) and (Form <> nil) and (FMinimizeApplication) then
  begin
    FOldApplicationMinimize := Application.OnMinimize;
    Application.OnMinimize := DoApplicationMinimize;
    FOldApplicationRestore := Application.OnRestore;
    Application.OnRestore := DoApplicationRestore;
    FSetAppEvent := true
  end;

  { Set handled flag }
  if not Msg.Active then
  begin
    UpdateNonClientArea(0);
    Msg.Result := 1;
    MessageHandled;
  end
  else
  begin
    if GetWindowLong(Handle, GWL_HWNDPARENT) = 0 then
    begin
      { Dekstop's window }
      UpdateNonClientArea(0);
    end
    else
      if not ((Form <> nil) and (THackForm(Form).FormStyle = fsMDIChild)) then
      begin
        UpdateNonClientArea(0);
        Msg.Result := 0;
        MessageHandled;
      end
      else
        Msg.Result := 0;
  end;
end;

procedure TTeCustomForm.WMNCHitTest(var Msg: TWMNCHitTest);
var
  P: TPoint;
begin
  P := NormalizePoint(Point(Msg.XPos, Msg.YPos));

  Msg.Result := HTCLIENT;

  case GetHitTest(P.X, P.Y) of
    khtCaption: if FDragging.Moveable then Msg.Result := HTCAPTION;
    khtLeft: if FDragging.Sizeable and (FWindowState <> kwsMaximized) then Msg.Result := HTLEFT;
    khtTop: if FDragging.Sizeable and (FWindowState <> kwsMaximized) then Msg.Result := HTTOP;
    khtRight: if FDragging.Sizeable and (FWindowState <> kwsMaximized) then Msg.Result := HTRIGHT;
    khtBottom: if FDragging.Sizeable and (FWindowState <> kwsMaximized) then Msg.Result := HTBOTTOM;
    khtBorder: Msg.Result := HTBORDER;
    khtTopLeft: if FDragging.Sizeable and (FWindowState <> kwsMaximized) then Msg.Result := HTTOPLEFT;
    khtTopRight: if FDragging.Sizeable and (FWindowState <> kwsMaximized) then Msg.Result := HTTOPRIGHT;
    khtBottomLeft: if FDragging.Sizeable and (FWindowState <> kwsMaximized) then Msg.Result := HTBOTTOMLEFT;
    khtBottomRight: if FDragging.Sizeable and (FWindowState <> kwsMaximized) then Msg.Result := HTBOTTOMRIGHT;
    khtCloseButton:Msg.Result := HTCLOSE;
    khtHelpButton: Msg.Result := HTHELP;
    khtMinButton: Msg.Result := HTMINBUTTON;
    khtMaxButton: Msg.Result := HTMAXBUTTON;
    khtRollButton: Msg.Result := HTBORDER;
    khtTrayButton: Msg.Result := HTBORDER;
    khtSysMenuButton: Msg.Result := HTBORDER;
    khtNonClient: Msg.Result := HTBORDER;
  end;

  { Set handled flag }
  MessageHandled;
end;

