procedure TTeCustomScrollBar.DrawLeftTopBtn;
var
  TmpRect: TRect;
  Flags : UINT;
  Theme: HTheme;
  Part, tState: integer;
begin
  TmpRect := GetLeftTopBtnRect;

  if not UseThemes then
  begin
    { Default drawing }
    if Kind = sbHorizontal then
      Flags := DFCS_SCROLLLEFT
    else
      Flags := DFCS_SCROLLUP;

    if LeftTopBtnPressed then
      Flags := Flags or DFCS_PUSHED or DFCS_FLAT;

    if (Enabled = false) and not (csDesigning in ComponentState) then
      Flags := Flags or DFCS_INACTIVE;

    DrawFrameControl(Canvas.Handle, TmpRect, DFC_SCROLL, Flags);
  end
  else
  begin
    { XP drawing }
    Theme := OpenThemeData(0, 'ScrollBar');
    Part := integer(SBP_ARROWBTN);

    if Kind = sbHorizontal then
    begin
      { Left }
      if not Enabled then
        tState := integer(ABS_LEFTDISABLED)
      else
        if LeftTopBtnPressed then
          tState := integer(ABS_LEFTPRESSED)
        else
          if MouseOnLeftTopBtn then
            tState := integer(ABS_LEFTHOT)
          else
            tState := integer(ABS_LEFTNORMAL);
    end
    else
    begin
      { Left }
      if not Enabled then
        tState := integer(ABS_UPDISABLED)
      else
        if LeftTopBtnPressed then
          tState := integer(ABS_UPPRESSED)
        else
          if MouseOnLeftTopBtn then
            tState := integer(ABS_UPHOT)
          else
            tState := integer(ABS_UPNORMAL);
    end;
    DrawThemeBackground(Theme, Canvas.Handle, Part, tState, TmpRect, nil);

    CloseThemeData(Theme);
  end;
end;

