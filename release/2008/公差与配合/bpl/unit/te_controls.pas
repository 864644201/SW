  begin
    if csDesigning in ComponentState then
    begin
      FWindowState := Value;
      Exit;
    end;

    if not (csLoading in ComponentState) then
    begin
      case Value of
        kwsNormal: Restore;
        kwsMaximized: Maximize;
        kwsMinimized: Minimize;
        kwsRollup: Rollup;
        kwsTray: MinToTray;
      else
        FWindowState := Value;
      end;
    end
    else
      FLoadedState := Value;
  end;
end;

