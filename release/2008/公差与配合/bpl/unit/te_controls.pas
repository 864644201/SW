procedure DrawLeftTopCorner(x, y: integer; Canvas: TCanvas);
begin
  MoveTo(Canvas, x, y + 2);
  LineTo(Canvas, x + 3, y - 1, clBtnHighlight);
end;

procedure DrawRightTopCorner(x, y: integer; Canvas: TCanvas);
begin
  MoveTo(Canvas, x - 3, y);
  LineTo(Canvas, x - 2, y + 1, clBtnHighlight);

  LineTo(Canvas, x, y + 3, cl3DDkShadow);

  MoveTo(Canvas, x - 2, y + 2);
  LineTo(Canvas, x - 1, y + 2, clBtnShadow);
end;

procedure DrawRightBottomCorner(x, y: integer; Canvas: TCanvas);
begin
  MoveTo(Canvas, x - 1, y - 3);
  LineTo(Canvas, x - 4, y, cl3DDkShadow);

  MoveTo(Canvas, x - 2, y - 3);
  LineTo(Canvas, x - 4, y - 1, clBtnShadow);
end;

procedure DrawLeftBottomCorner(x, y: integer;  Canvas: TCanvas);
begin
  MoveTo(Canvas, x, y - 3);
  LineTo(Canvas, x + 2, y - 1, clBtnHighlight);

  LineTo(Canvas, x + 2, y - 2, cl3DDkShadow);

  LineTo(Canvas, x + 2, y - 3, clBtnShadow);
end;

procedure DrawTopLine(Bx, Ex, y: integer; Canvas: TCanvas);
begin
  MoveTo(Canvas, Bx, y);
  LineTo(Canvas, Ex, y, clBtnHighlight);
end;

procedure DrawLeftLine(x, By, Ey: integer; Canvas: TCanvas);
begin
  MoveTo(Canvas, x, By);
  LineTo(Canvas, x, Ey, clBtnHighlight);
end;

procedure DrawRightLine(x, By, Ey: integer; Canvas: TCanvas);
begin
  MoveTo(Canvas, x - 1, By);
  LineTo(Canvas, x - 1, Ey, cl3DDkShadow);

  MoveTo(Canvas, x - 2, By);
  LineTo(Canvas, x - 2, Ey, clBtnShadow);
end;

procedure DrawBottomLine(Bx, Ex, y: integer; Canvas: TCanvas);
begin
  MoveTo(Canvas, Bx, y - 1);
  LineTo(Canvas, Ex, y - 1, cl3DDkShadow);

  MoveTo(Canvas, Bx, y - 2);
  LineTo(Canvas, Ex, y - 2, clBtnShadow);
end;

{ TTeCustomTabSheet }

constructor TTeCustomTabSheet.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);
  FImageIndex := -1;

  Align := alClient;
  ControlStyle := ControlStyle + [csAcceptsControls, csNoDesignVisible];
  PageVisible := true;
  Visible := False;
end;

destructor TTeCustomTabSheet.Destroy;
begin
  FDestoying := true;
  if (FTabControl <> nil) and not (csDestroying in FTabControl.ComponentState) then
    FTabControl.RemovePage(Self);
    
  inherited Destroy;
end;

procedure TTeCustomTabSheet.DoHide;
begin
  if Assigned(FOnHide) then FOnHide(Self);
end;

procedure TTeCustomTabSheet.DoShow;
begin
  if Assigned(FOnShow) then FOnShow(Self);
end;

procedure TTeCustomTabSheet.CreateParams(var Params: TCreateParams);
begin
  inherited CreateParams(Params);
  with Params.WindowClass do
    Style := Style and not (CS_HREDRAW or CS_VREDRAW);
end;

procedure TTeCustomTabSheet.PaintOwnerBackground(DC: HDC);
var
  P: TPoint;
  i, SaveIndex, SavedDC: Integer;
begin
  if Parent = nil then Exit;

  { Paint Owner Background }
  SaveIndex := SaveDC(DC);
  try
    P := ClientOrigin;
    if csDesigning in ComponentState then
    begin
      { DesignTime }
      Windows.ScreenToClient(Parent.Handle, P);
      MoveWindowOrg(DC, -P.X, -P.Y);
      if Parent is TCustomForm then
        SendMessage(Parent.Handle, WM_ERASEBKGND, DC, 0)
      else
        Parent.Perform(WM_ERASEBKGND, DC, 0);
      TParentControl_Tab(Parent).PaintControls(DC, nil);
      MoveWindowOrg(DC, P.X, P.Y);
    end
    else
    begin
      { Run-Time No Buffer }
{      Buffer := TTeBitmap.Create;
      Buffer.SetSize(Width, Height);
      Buffer.Draw(DC, 0, 0);
      Buffer.Free; }

      Windows.ScreenToClient(Parent.Handle, P);
      MoveWindowOrg(DC, -P.X, -P.Y);

      SavedDC := FTabControl.Canvas.Handle;
      FTabControl.Canvas.Handle := DC;
      FTabControl.DrawBorder;
      FTabControl.Canvas.Handle := SavedDC;

      MoveWindowOrg(DC, P.X, P.Y);
    end;
  finally
    RestoreDC(DC, SaveIndex);
  end;
end;

procedure TTeCustomTabSheet.WMEraseBkgnd(var Msg: TWmEraseBkgnd);
begin
  if (csDesigning in ComponentState) then inherited ;

  if (Msg.DC <> 0) then
  begin
    if (FTabControl <> nil) and (FTabControl.FActivePage = Self) then
    begin
      if (Pointer(Msg.Unused) <> nil) and (PEraseBackgroundInfo(Msg.Unused)^.Action = keaPaintBackground) then
      begin
        PaintOwnerBackground(Msg.DC);
      end
      else
        PaintOwnerBackground(Msg.DC);
    end;
  end;

  Msg.Result := 1;
end;

procedure TTeCustomTabSheet.WMPaint(var Message: TWMPaint);
var
  DC: HDC;
  PS: TPaintStruct;
begin
  DC := BeginPaint(Handle, PS);
  try
    if (FTabControl <> nil) and (FTabControl.FActivePage = Self) then
      PaintControls(DC, nil);
  finally
    EndPaint(Handle, PS);
  end;
end;

procedure TTeCustomTabSheet.ReadState(Reader: TReader);
begin
  inherited ReadState(Reader);
  if Reader.Parent is TTeCustomTabControl then
    TabControl := TTeCustomTabControl(Reader.Parent);
end;

procedure TTeCustomTabSheet.SetTabControl(ATabControl: TTeCustomTabControl);
begin
  if FTabControl <> ATabControl then
  begin
    if FTabControl <> nil then
    begin
      FTabControl.RemovePage(Self);
      FPageVisible := false;
    end;
    FTabControl := ATabControl;
    if FTabControl <> nil then
    begin
      FTabControl.AddPage(Self);
    end;
  end;
end;

procedure TTeCustomTabSheet.CMTextChanged(var Msg: TMessage);
var
  Index: integer;
begin
  inherited ;
  if FTabControl <> nil then
  begin
    Index := FTabControl.GetTabIndexFromPageIndex(PageIndex);
    if (Index >= 0) and (Index < FTabControl.FTabs.Count) then
    begin
      FTabControl.FTabs[Index] := Caption;
    end;
  end;
end;

procedure TTeCustomTabSheet.CMShowingChanged(var Message: TMessage);
begin
  inherited;
  if Showing then
  begin
    try
      DoShow
    except
      Application.HandleException(Self);
    end;
  end else if not Showing then
  begin
    try
      DoHide;
    except
      Application.HandleException(Self);
    end;
  end;
end;

function TTeCustomTabSheet.GetPageIndex: Integer;
begin
  if FTabControl <> nil then
    Result := FTabControl.FPages.IndexOf(Self)
  else
    Result := -1;
end;

function TTeCustomTabSheet.GetPageVisible: boolean;
begin
  Result := FPageVisible;
end;

procedure TTeCustomTabSheet.SetImageIndex(const Value: integer);
begin
  if FImageIndex <> Value then
  begin
    FImageIndex := Value;

    if FTabControl <> nil then FTabControl.Invalidate;
  end;
end;

procedure TTeCustomTabSheet.SetPageIndex(const Value: Integer);
begin
  if csLoading in ComponentState then Exit;
  
  if (FTabControl <> nil) and (Value <> PageIndex) then
  begin
    FTabControl.FPages.Exchange(PageIndex, Value);
    FTabControl.TabsChanged;
  end;
end;

procedure TTeCustomTabSheet.SetPageVisible(const Value: boolean);
begin
  if csLoading in ComponentState then
  begin
    FPageVisible := Value;
    Exit;
  end;

  if FPageVisible <> Value then
  begin
    FPageVisible := Value;

    if FTabControl <> nil then FTabControl.TabsChanged;
  end;
end;

