  if Msg.wParam = WM_GETTEXT then
  begin
    { Posted from WM_GETTEXT }
    { Enabled caption }
    SetWindowLong(Handle, GWL_STYLE, GetWindowLong(Handle, GWL_STYLE ) or WS_CAPTION);
  end;
  { Update }
  UpdateNonClientArea(0);
  { Set Handled }
  MessageHandled;
end;

