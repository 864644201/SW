constructor TTeCustomCheckBox.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);
  Width := 98;
  Height := 20;
  TabStop := true;
  Transparent := true;
  Performance := kspDoubleBuffer;
  Caption := 'CheckBox';

  FAllowGrayed := false;
  FSpacing := 5;
end;

destructor TTeCustomCheckBox.Destroy;
begin
  inherited Destroy;
end;

{ CheckBox }

procedure TTeCustomCheckBox.Toggle;
begin
  case State of
    cbUnchecked: if FAllowGrayed then State := cbGrayed else State := cbChecked;
    cbChecked: State := cbUnchecked;
    cbGrayed: State := cbChecked;
  end;
end;

function TTeCustomCheckBox.GetBoxSize: TPoint;
begin
  Result := Point(13, 13);
end;

procedure TTeCustomCheckBox.PaintBox;
var
  R: TRect;
  BackColor, CheckColor, RColor, SColor: TKColor;
  B: TTeBitmap;
  i, j: integer;
  Theme: HTheme;
  Part, ThemeState: integer;
begin
  { Draw Box }
  with Canvas do
  begin
    R := Rect(0, 0, GetBoxSize.X, GetBoxSize.Y);
    if Alignment = ktaLeftJustify then
      RectVCenter(R, Rect(0, 0, FWidth, FHeight))
    else
      RectVCenter(R, Rect(FWidth-GetBoxSize.X, 0, FWidth, FHeight));

    { Draw standard box }
    if not UseThemes then
    begin
      { Standard }
      case State of
        cbUnChecked: begin
          if not Enabled then
            DrawFrameControl(Handle, R, DFC_BUTTON, DFCS_BUTTONCHECK or DFCS_INACTIVE)
          else
            DrawFrameControl(Handle, R, DFC_BUTTON, DFCS_BUTTONCHECK);
        end;
        cbChecked: begin
          if not Enabled then
            DrawFrameControl(Handle, R, DFC_BUTTON, DFCS_BUTTONCHECK or DFCS_CHECKED or DFCS_INACTIVE)
          else
            DrawFrameControl(Handle, R, DFC_BUTTON, DFCS_BUTTONCHECK or DFCS_CHECKED)
        end;
        cbGrayed: begin
          if not Enabled then
            DrawFrameControl(Handle, R, DFC_BUTTON, DFCS_BUTTON3STATE or DFCS_CHECKED or DFCS_INACTIVE)
          else
            DrawFrameControl(Handle, R, DFC_BUTTON, DFCS_BUTTON3STATE or DFCS_CHECKED)
        end;
      end;
    end
    else
    begin
      { XP Style }
      Theme := OpenThemeData(0, 'Button');

      Part := integer(BP_CHECKBOX);
      ThemeState := integer(CBS_MIXEDNORMAL);

      case State of
        cbUnChecked:
          begin
            if not Enabled then
              ThemeState := integer(CBS_UNCHECKEDDISABLED)
            else
              if Pressed then
                ThemeState := integer(CBS_UNCHECKEDPRESSED)
              else
                if MouseInControl then
                  ThemeState := integer(CBS_UNCHECKEDHOT)
                else
                  ThemeState := integer(CBS_UNCHECKEDNORMAL);
          end;
        cbChecked:
          begin
            if not Enabled then
              ThemeState := integer(CBS_CHECKEDDISABLED)
            else
              if Pressed then
                ThemeState := integer(CBS_CHECKEDPRESSED)
              else
                if MouseInControl then
                  ThemeState := integer(CBS_CHECKEDHOT)
                else
                  ThemeState := integer(CBS_CHECKEDNORMAL);
          end;
        cbGrayed:
          begin
            if not Enabled then
              ThemeState := integer(CBS_MIXEDDISABLED)
            else
              if Pressed then
                ThemeState := integer(CBS_MIXEDPRESSED)
              else
                if MouseInControl then
                  ThemeState := integer(CBS_MIXEDHOT)
                else
                  ThemeState := integer(CBS_MIXEDNORMAL);
          end;
      end;

      DrawThemeBackground(Theme, Canvas.Handle, Part, ThemeState, R, nil);

      CloseThemeData(Theme);
    end;
  end
end;

procedure TTeCustomCheckBox.PaintText;
var
  R: TRect;
begin
  { Draw Text }
  with Canvas do
  begin
    Font.Assign(ControlFont);

    { Calc Rect }
    R := Rect(0, 0, Width - GetBoxSize.X - 10 {space}, TextHeight(Caption));
    DrawText(Canvas, Caption, R, DrawTextBiDiModeFlags(DT_CALCRECT or DT_EXPANDTABS or WordWraps[FWordWrap]));

    if Alignment = ktaLeftJustify then
      RectVCenter(R, Rect(GetBoxSize.X + FSpacing, 0, FWidth, FHeight))
    else
      RectVCenter(R, Rect(2, 0, FWidth-GetBoxSize.X + FSpacing, FHeight));

    { Draw Text }
    if not Enabled then
    begin
      Font.Color := clBtnHighlight;
      OffsetRect(R, 1, 1);
      DrawText(Canvas, Caption, R, DrawTextBiDiModeFlags(DT_EXPANDTABS or WordWraps[FWordWrap]));
      OffsetRect(R, -1, -1);

      Font.Color := clBtnShadow;
    end;
    DrawText(Canvas, Caption, R, DrawTextBiDiModeFlags(DT_EXPANDTABS or WordWraps[FWordWrap]));
  end;

  { Draw Focus }
  if Focused then
  begin
    InflateRect(R, 1, 2);
    Inc(R.Right, 2);
    DrawFocusRect(Canvas, R, clBtnShadow);
  end;
end;

