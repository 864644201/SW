procedure DoConvert(const ParentItem: TTeCustomItem; const Menu: TMenu;
  const Owner: TComponent; ItemClass: TTeCustomItemClass; Log: TStrings);

  procedure AddToLog(S: string);
  begin
    if Log <> nil then Log.Add(S);
  end;

  procedure Recurse(MenuItem: TMenuItem; KItem: TTeCustomItem);
  var
    I: Integer;
    Src: TMenuItem;
    IsSep, IsSubmenu: Boolean;
    Dst: TTeCustomItem;
    N: String;
  begin
    for I := 0 to MenuItem.Count-1 do
    begin
      Src := MenuItem[I];

      Dst := ItemClass.Create(Owner);

      Dst.Action := Src.Action;
      Dst.Caption := Src.Caption;
      Dst.Checked := Src.Checked;
      Dst.Enabled := Src.Enabled;
      Dst.HelpContext := Src.HelpContext;
      Dst.ImageIndex := Src.ImageIndex;
      Dst.ShortCut := Src.ShortCut;
      Dst.OnClick := Src.OnClick;
      Dst.Hint := Src.Hint;
      Dst.Tag := Src.Tag;
      Dst.Visible := Src.Visible;

      try
        N := Src.Name;
        if N = '' then
          Src.Name := N + IntToStr(Random(10000)) + '_old'
        else
          Src.Name := N + '_old';
        Dst.Name := N;
      finally
        Dst.OnClick := Src.OnClick;
      end;

      KItem.Add(Dst);

      AddToLog(' Convertion item: ' + Dst.Name);
      if KItem.Count > 0 then
        Recurse(Src, Dst);
    end;
  end;

begin
  if ItemClass = nil then Exit;
  AddToLog('');
  AddToLog('Start menu convetion');
  AddToLog('');

  Recurse(Menu.Items, ParentItem);

  AddToLog(' Set Images property');
  ParentItem.Images := Menu.Images;

  AddToLog('');
  AddToLog('Menu convetion complete !');
end;



