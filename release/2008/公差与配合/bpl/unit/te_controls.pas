procedure TTeCustomRangeBar.MouseDown(Button: TMouseButton; Shift: TShiftState;
  x, y: integer);
begin
  inherited MouseDown(Button, Shift, x, y);
  SetFocus;
  if PtInLowThumb(x, y) and (Button = mbLeft) then
    FLowSliding := true
  else
    if PtInHighThumb(x, y) and (Button = mbLeft) then
    FHighSliding := true;
  if (not (FHighSliding or FLowSliding) and (Button = mbLeft)) then
  begin
    if Orientation = toHorizontal then
    begin
      LowPosition := CoordinatePosition(x);
      HighPosition := CoordinatePosition(x);
    end
    else
    begin
      LowPosition := CoordinatePosition(y);
      HighPosition := CoordinatePosition(y);
    end;
  end;
end;

procedure TTeCustomRangeBar.MouseMove(Shift: TShiftState; x, y: integer);
var
  TmpCoord: integer;
  OldLow, OldHigh: boolean;
begin
  inherited MouseMove(Shift, x, y);

  if Orientation = toHorizontal then
  begin
    TmpCoord := x;
    if (x < 0) then
      TmpCoord := 0
    else
      if x > ClientWidth then
      TmpCoord := ClientWidth
  end
  else
  begin
    TmpCoord := y;
    if (y < 0) then
      TmpCoord := 0
    else
      if y > ClientHeight then
      TmpCoord := ClientHeight
  end;

  if FLowSliding then
    LowPosition := CoordinatePosition(TmpCoord + GetThumbWidth div 2);

  if FHighSliding then
    HighPosition := CoordinatePosition(TmpCoord - GetThumbWidth div 2);

  OldLow := FMouseOnLowThumb;
  if PtInLowThumb(x, y) then
    FMouseOnLowThumb := true
  else
    FMouseOnLowThumb := false;

  OldHigh := FMouseOnHighThumb;
  if PtInHighThumb(x, y) then
    FMouseOnHighThumb := true
  else
    FMouseOnHighThumb := false;

  if (FMouseOnLowThumb <> OldLow) or (FMouseOnHighThumb <> OldHigh) then
    Invalidate;
end;

procedure TTeCustomRangeBar.MouseUp(Button: TMouseButton; Shift: TShiftState; x,
  y: integer);
begin
  inherited MouseUp(Button, Shift, x, y);
  if Button = mbLeft then
  begin
    FLowSliding := false;
    FHighSliding := false;
    Invalidate;
  end;
end;

