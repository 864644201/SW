  if MenuHeight < 20 then MenuHeight := 20;
end;

procedure RegisterContainerClass(const AClass: TClass; AInsertItemProc: TTeInsertItemProc;
  AGetItemClassProc: TTeGetItemClassProc);
var
  i: Integer;
  Data: PContainerClassData;
begin
  if ContainerClassList = nil then ContainerClassList := TList.Create;
  for i := 0 to ContainerClassList.Count-1 do
    with PContainerClassData(ContainerClassList[I])^ do
      if Cls = AClass then
      begin
        Inc (RefCount);
        InsertItemProc := AInsertItemProc;
        GetItemClassProc := AGetItemClassProc;
        Exit;
      end;
  ContainerClassList.Expand;
  New(Data);
  Data.Cls := AClass;
  Data.RefCount := 1;
  Data.InsertItemProc := AInsertItemProc;
  Data.GetItemClassProc := AGetItemClassProc;
  ContainerClassList.Add (Data);
end;

procedure UnregisterContainerClass(const AClass: TClass);
var
  i: Integer;
  Data: PContainerClassData;
begin
  if Assigned(ContainerClassList) then
    for i := 0 to ContainerClassList.Count-1 do
    begin
      Data := ContainerClassList[I];
      if Data.Cls = AClass then
      begin
        Dec (Data.RefCount);
        if Data.RefCount = 0 then
        begin
          ContainerClassList.Delete (I);
          Dispose (Data);
          if ContainerClassList.Count = 0 then
          begin
            ContainerClassList.Free;
            ContainerClassList := nil;
          end;
        end;
        Break;
      end;
    end;
end;

function GetItemClass(const AClass: TClass): TTeCustomItemClass;
var
  i: integer;
  C: TTeCustomItemClass;
begin
  Result := nil;
  if ContainerClassList = nil then Exit;

  for i := 0 to ContainerClassList.Count-1 do
    with PContainerClassData(ContainerClassList[I])^ do
      if Cls = AClass then
      begin
        GetItemClassProc(Result);
        Exit;
      end;
end;

