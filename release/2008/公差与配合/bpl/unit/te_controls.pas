  W, H, DW, DH: integer;
begin
  W := RectWidth(SrcRect);
  H := RectHeight(SrcRect);
  if W * H = 0 then Exit;

  SrcR := Rect(0, 0, W, H);
  OffsetRect(SrcR, DstRect.Left, DstRect.Top);

  Cx := RectWidth(DstRect) div W;
  if RectWidth(DstRect) mod W <> 0 then Inc(Cx);
  Cy := RectHeight(DstRect) div H;
  if RectHeight(DstRect) mod H <> 0 then Inc(Cy);

  for i := 0 to Cx do
    for j := 0 to Cy do
    begin
      R := SrcR;
      OffsetRect(R, i * W, j * H);

      IntersectRect(R, R, DstRect);

      DW := RectWidth(R);
      DH := RectHeight(R);

      if (DW = 0) or (DH = 0) then Break;

      if (DW <> W) or (DH <> H) then
      begin
        R1 := SrcRect;
        R1.Right := R1.Left + DW;
        R1.Bottom := R1.Top + DH;
        Draw(Canvas, R, R1, Transparent);
      end
      else
        Draw(Canvas, R, SrcRect, Transparent);
    end;
end;

procedure TTeBitmap.DrawMarginRect(Buffer: TTeBitmap; MarginRect, MarginDstRect: TRect;
  Stretch: boolean);
var
  DstRect, R: TRect;
  i, j: integer;
  W, H: integer;
  DW, DH: integer;
begin
  W := RectWidth(MarginRect);
  H := RectHeight(MarginRect);
  if W * H = 0 then Exit;

  if not Stretch then
    DrawTile(Buffer, MarginDstRect, MarginRect)
  else
    Draw(Buffer, MarginDstRect, MarginRect);
end;

procedure TTeBitmap.DrawMargin(Bitmap: TTeBitmap; DstRect, SrcRect: TRect;
  MarginLeft, MarginTop, MarginRight, MarginBottom: integer;
  Stretch: boolean);
var
  MarginSrcRect, MarginDstRect: TRect;
begin
  { Draw with margin }
  if (MarginLeft = 0) and (MarginTop = 0) and
     (MarginRight = 0) and (MarginBottom = 0) then
  begin
    Draw(Bitmap, DstRect, SrcRect);
    Exit;
  end;

  { Draw Center Rect }
  with SrcRect do
    MarginSrcRect := Rect(Left + MarginLeft, Top + MarginTop, Right - MarginRight,
      Bottom - MarginBottom);
  with DstRect do
    MarginDstRect := Rect(Left + MarginLeft, Top + MarginTop, Right - MarginRight,
      Bottom - MarginBottom);
  DrawMarginRect(Bitmap, MarginSrcRect, MarginDstRect, Stretch);

  { Draw Top Border }
  with SrcRect do
    MarginSrcRect := Rect(Left + MarginLeft, Top, Right - MarginRight, Top + MarginTop);
  with DstRect do
    MarginDstRect := Rect(Left + MarginLeft, Top, Right - MarginRight, Top + MarginTop);
  DrawMarginRect(Bitmap, MarginSrcRect, MarginDstRect, Stretch);

  { Draw Bottom Border }
  with SrcRect do
    MarginSrcRect := Rect(Left + MarginLeft, Bottom - MarginBottom, Right - MarginRight, Bottom);
  with DstRect do
    MarginDstRect := Rect(Left + MarginLeft, Bottom - MarginBottom, Right - MarginRight, Bottom);
  DrawMarginRect(Bitmap, MarginSrcRect, MarginDstRect, Stretch);

  { Draw Left Border }
  with SrcRect do
    MarginSrcRect := Rect(Left, Top + MarginTop, Left + MarginLeft, Bottom - MarginBottom);
  with DstRect do
    MarginDstRect := Rect(Left, Top + MarginTop, Left + MarginLeft, Bottom - MarginBottom);
  DrawMarginRect(Bitmap, MarginSrcRect, MarginDstRect, Stretch);

  { Draw Right Border }
  with SrcRect do
    MarginSrcRect := Rect(Right - MarginRight, Top + MarginTop, Right,
      Bottom - MarginBottom);
  with DstRect do
    MarginDstRect := Rect(Right - MarginRight, Top + MarginTop, Right,
      Bottom - MarginBottom);
  DrawMarginRect(Bitmap, MarginSrcRect, MarginDstRect, Stretch);

  { Draw Angles }
  with SrcRect do
    MarginSrcRect := Rect(Left, Top, Left + MarginLeft, Top + MarginTop);
  with DstRect do
    Draw(Bitmap, Left, Top, MarginSrcRect);

  with SrcRect do
    MarginSrcRect := Rect(Right - MarginRight, Top, Right, Top + MarginTop);
  with DstRect do
    Draw(Bitmap, Right - MarginRight, Top, MarginSrcRect);

  with SrcRect do
    MarginSrcRect := Rect(Left, Bottom - MarginBottom, Left + MarginLeft, Bottom);
  with DstRect do
    Draw(Bitmap, Left, Bottom - MarginBottom, MarginSrcRect);

  with SrcRect do
    MarginSrcRect := Rect(Right - MarginRight, Bottom - MarginBottom, Right, Bottom);
  with DstRect do
    Draw(Bitmap, Right - MarginRight, Bottom - MarginBottom, MarginSrcRect);
end;

