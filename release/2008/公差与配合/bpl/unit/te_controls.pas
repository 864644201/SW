procedure TTeCustomScrollBar.UpdateSytemSize;
begin
  if Kind = sbHorizontal then
    Height := GetSystemMetrics(SM_CYVTHUMB)+BorderWidth*2
  else
    Width := GetSystemMetrics(SM_CYVTHUMB)+BorderWidth*2;
end;

function TTeCustomScrollBar.CalculateSliderSize: integer;
var
  LBackRect: TRect;
  LScaleSize: integer;
begin
  LBackRect := GetBackgroundRect;
  if Kind = sbHorizontal then
    LScaleSize := LBackRect.Right - LBackRect.Left
  else
    LScaleSize := LBackRect.Bottom - LBackRect.Top;

  Result := Round((PageSize * LScaleSize) / (Max - Min+1));
  if Result < GetSystemMetrics(SM_CYVTHUMB) div 3 * 2 then
    Result := GetSystemMetrics(SM_CYVTHUMB) div 3 * 2;
end;

function TTeCustomScrollBar.PositionCoordinate(APos: integer): word;
var
  LBackRect: TRect;
  LScaleSize: integer;
  LVirtScaleSize : integer;
begin
  LBackRect := GetBackgroundRect;
  LVirtScaleSize := Max - Min-PageSize;
  if PageSize <> 0 then
    LVirtScaleSize := LVirtScaleSize+1;

  if Kind = sbHorizontal then
  begin
    LScaleSize := LBackRect.Right - LBackRect.Left - GetSliderSize;
    if ((Max - Min-PageSize+1) > 0) and (LVirtScaleSize > 0) then
    begin
      if (Position <= Max-PageSize+1) then
        Result := Round((LScaleSize * (Position - Min)) / LVirtScaleSize) + LBackRect.Left
      else
        Result := LScaleSize + LBackRect.Left;
    end
    else
      Result := LBackRect.Left;
  end
  else
  begin
    LScaleSize := LBackRect.Bottom - LBackRect.Top- GetSliderSize;
    if ((Max - Min-PageSize+1) > 0) and (LVirtScaleSize > 0) then
    begin
      if (Position <= Max-PageSize+1) then
        Result := Round((LScaleSize * (Position - Min)) / LVirtScaleSize) + LBackRect.Top
      else
        Result := LScaleSize + LBackRect.Top;
    end
    else
      Result := LBackRect.Top;
  end;
end;

function TTeCustomScrollBar.CoordinatePosition(ACoord: word): integer;
var
  LBackRect: TRect;
  LScaleSize: integer;
  LVirtScaleSize : integer;
begin
  LBackRect := GetBackgroundRect;
  LVirtScaleSize := Max - Min-PageSize;
  if PageSize <> 0 then
    LVirtScaleSize := LVirtScaleSize+1;
  if Kind = sbHorizontal then
  begin
    LScaleSize := LBackRect.Right - LBackRect.Left - GetSliderSize;
    if (LScaleSize <> 0) and (LVirtScaleSize > 0) then
      Result := Round(((ACoord - LBackRect.Left) * LVirtScaleSize) / LScaleSize + Min)
    else
      Result := 0;
  end
  else
  begin
    LScaleSize := LBackRect.Bottom - LBackRect.Top - GetSliderSize;
    if (LScaleSize <> 0) and (LVirtScaleSize > 0) then
      Result := Round(((ACoord - LBackRect.Top) * LVirtScaleSize) / LScaleSize + Min)
    else
      Result := 0;
  end;

  if Result < Min then
    Result := Min;
  if Result > Max-PageSize+1 then
    Result := Max-PageSize+1;
end;

