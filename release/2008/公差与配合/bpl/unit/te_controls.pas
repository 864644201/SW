constructor TTeCustomHint.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);
  FAnimation := TTeAnimation.Create;
  FBlending := TTeBlending.Create;
  FShadow := TTeShadow.Create;

  FActive := true;
  VarHint := Self;
end;

destructor TTeCustomHint.Destroy;
begin
  if not (csDesigning in ComponentState) then
  begin
    if Assigned(FOldShowHint) then
      Application.OnShowHint := FOldShowHint
    else
      Application.OnShowHint := nil;

    HintWindowClass := FOldHintWindowClass;
  end;
    
  FAnimation.Free;
  FBlending.Free;
  FShadow.Free;
  inherited Destroy;
end;

procedure TTeCustomHint.DoShowHint(var HintStr: string; var CanShow: Boolean;
  var HintInfo: THintInfo);
begin
  if (csDesigning in ComponentState) then Exit;
  
  HintInfo.HintData := Self;
  if Assigned(FOnShowHint) then FOnShowHint(HintStr, CanShow, HintInfo);
end;

{ Abstracts }

function TTeCustomHint.GetHintBounds(Canvas: TCanvas; const AHint: string): TRect;
begin
  Result := Rect(0, 0, 1000, 1000);
  if Owner is TWinControl then
    DrawText(Canvas, AHint, Result, (Owner as TWinControl).DrawTextBiDiModeFlags(DT_CALCRECT or DT_LEFT or DT_WORDBREAK or DT_NOPREFIX));

  Inc(Result.Right, 6);
  Inc(Result.Bottom, 6);
  if FShadow.Enabled then
  begin
    Inc(Result.Right, FShadow.Size);
    Inc(Result.Bottom, FShadow.Size);
  end;
end;

procedure TTeCustomHint.PaintHint(Canvas: TCanvas; R: TRect; const AHint: string);
var
  TextRect: TRect;
begin
  FillRect(Canvas, R, Application.HintColor);
  if not UseThemes then
    DrawEdge(Canvas, R, cl3DLight, cl3DDkShadow)
  else
    DrawRect(Canvas, R, clBtnShadow);

  { Draw text }
  if Owner is TWinControl then
  begin
    { Calc Rect }
    TextRect := R;
    DrawText(Canvas, AHint, TextRect, TWinControl(Owner).DrawTextBiDiModeFlags(DT_CENTER or DT_WORDBREAK or DT_CALCRECT));
    RectCenter(TextRect, R);

    { Draw text }
    DrawText(Canvas, AHint, TextRect, TWinControl(Owner).DrawTextBiDiModeFlags(DT_CENTER or DT_WORDBREAK))
  end;
end;

