procedure TTeBitmap.Draw(Bitmap: TTeBitmap; DstRect, SrcRect: TRect);
var
  SrcW, SrcH, DstW, DstH: integer;
  R: TRect;
  SFX, SFY: integer;
  B, F: PKColor;
  DstX, DstY, SrcX: integer;
  SX, SY: integer;
  DX, DY: integer;
  TP: PKColor;
  Alpha: byte;
begin
  { Stretch }
  if not FBlend then
    StretchBlt(Bitmap.FDC, DstRect.Left, DstRect.Top, RectWidth(DstRect), RectHeight(DstRect),
      FDC, SrcRect.Left, SrcRect.Top, RectWidth(SrcRect), RectHeight(SrcRect), SRCCOPY)
  else
  begin
    { KSDev Stretch Blend }
    IntersectRect(R, SrcRect, Rect(0, 0, FWidth, FHeight));
    if (RectWidth(R) <= 0) or (RectHeight(R) <= 0) then Exit;
    if (RectWidth(DstRect) <= 0) or (RectHeight(DstRect) <= 0) then Exit;
    IntersectRect(R, DstRect, Rect(0, 0, Bitmap.FWidth, Bitmap.FHeight));
    if (RectWidth(R) <= 0) or (RectHeight(R) <= 0) then Exit;

    SrcW := RectWidth(SrcRect);
    SrcH := RectHeight(SrcRect);
    DstW := RectWidth(DstRect);
    DstH := RectHeight(DstRect);

    SFX := MulDiv((R.Left - DstRect.Left) * SrcW, 65535, DstW);
    SFY := MulDiv((R.Top - DstRect.Top) * SrcH, 65535, DstH);

    DX := (SrcW shl 16) div DstW;
    DY := (SrcH shl 16) div DstH;
    SY := SFY;

    for DstY := R.Top to R.Bottom - 1 do
    begin
      F := @Bits[SrcRect.Left + (SY shr 16 + SrcRect.Top) * FWidth];
      B := @Bitmap.Bits[R.Left + (DstY * Bitmap.FWidth)];
      SX := SFX;
      for DstX := R.Left to R.Right - 1 do
      begin
        SrcX := SX shr 14 and $FFFFFFFC;
        Inc(SX, DX);
        { Get fore pixel }
        TP := PKColor(Integer(F) + SrcX);
        { Blend }
        Alpha := TP^ shr 24;
        if Alpha = 0 then
          // Skip
        else
          if Alpha = $FF then
            B^ := TP^
          else
            B^ := BlendPixel(TP^, B^); { Blend }

        Inc(B);
      end;
      Inc(SY, DY);
    end;
  end;
end;

procedure TTeBitmap.DrawTile(Bitmap: TTeBitmap; DstRect, SrcRect: TRect);
var
  i, j: integer;
  R, R1, SrcR: TRect;
  Cx, Cy: integer;
  W, H, DW, DH: integer;
begin
  W := RectWidth(SrcRect);
  H := RectHeight(SrcRect);
  if W * H = 0 then Exit;

  SrcR := Rect(0, 0, W, H);
  OffsetRect(SrcR, DstRect.Left, DstRect.Top);

  Cx := RectWidth(DstRect) div W;
  if RectWidth(DstRect) mod W <> 0 then Inc(Cx);
  Cy := RectHeight(DstRect) div H;
  if RectHeight(DstRect) mod H <> 0 then Inc(Cy);

  for i := 0 to Cx do
    for j := 0 to Cy do
    begin
      R := SrcR;
      OffsetRect(R, i * W, j * H);

      IntersectRect(R, R, DstRect);

      DW := RectWidth(R);
      DH := RectHeight(R);

      if (DW = 0) or (DH = 0) then Break;

      if (DW <> W) or (DH <> H) then
      begin
        R1 := SrcRect;
        R1.Right := R1.Left + DW;
        R1.Bottom := R1.Top + DH;
        Draw(Bitmap, R, R1);
      end
      else
        Draw(Bitmap, R, SrcRect);

    end;
end;

procedure TTeBitmap.DrawTile(Canvas: TCanvas; DstRect, SrcRect: TRect; Transparent: boolean = false);
var
  i, j: integer;
  R, R1, SrcR: TRect;
