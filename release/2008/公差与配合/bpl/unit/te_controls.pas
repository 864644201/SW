constructor TTeBitmap.Create;
begin
  inherited Create;
  FFont := TFont.Create;
  with FBitmapInfo.bmiHeader do
  begin
    biSize := SizeOf(TBitmapInfoHeader);
    biPlanes := 1;
    biBitCount := 32;
    biCompression := BI_RGB;
  end;

  FBlend := false;
end;

destructor TTeBitmap.Destroy;
begin
  if Assigned(FOnBeforeChange) then FOnBeforeChange(Self);

  if FDC <> 0 then DeleteDC(FDC);
  if FHandle <> 0 then DeleteObject(FHandle);
  FFont.Free;

  inherited Destroy;
end;

procedure TTeBitmap.AssignTo(Dst: TPersistent);
var
  Bmp: TBitmap;

  procedure CopyToBitmap(Bmp: TBitmap);
  begin
    Bmp.Width := Width;
    Bmp.Height := Height;
    Draw(Bmp.Canvas, 0, 0);
  end;

begin
  if Dst is TPicture then CopyToBitmap(TPicture(Dst).Bitmap)
  else if Dst is TBitmap then CopyToBitmap(TBitmap(Dst))
  else if Dst is TClipboard then
  begin
    Bmp := TBitmap.Create;
    try
      CopyToBitmap(Bmp);
      TClipboard(Dst).Assign(Bmp);
    finally
      Bmp.Free;
    end;
  end
  else inherited;
end;

procedure TTeBitmap.Assign(Source: TPersistent);

  procedure AssignFromBitmap(SrcBmp: TBitmap);
  begin
    SetSize(SrcBmp.Width, SrcBmp.Height);
    if Empty then Exit;
    BitBlt(FDC, 0, 0, Width, Height, SrcBmp.Canvas.Handle, 0, 0, SRCCOPY);
    SetAlpha($FF);
  end;

var
  Canvas: TCanvas;
begin
  if Source is TTeBitmap then
  begin
  end
  else
    if Source is TBitmap then
    begin
      SetSize((Source as TBitmap).Width, (Source as TBitmap).Height);
      if Empty then Exit;
      BitBlt(FDC, 0, 0, FWidth, FHeight, (Source as TBitmap).Canvas.Handle, 0, 0, SRCCOPY);
      SetAlpha($FF);
    end
    else
      if Source is TGraphic then
      begin
        SetSize(TGraphic(Source).Width, TGraphic(Source).Height);
        if Empty then Exit;
        Canvas := TCanvas.Create;
        try
          Canvas.Handle := FDC;
          TGraphicAccess(Source).Draw(Canvas, Rect(0, 0, Width, Height));
          SetAlpha($FF);
        finally
          Canvas.Free;
        end;
      end
      else
        if Source is TPicture then
        begin
          with TPicture(Source) do
          begin
            if TPicture(Source).Graphic is TBitmap then
              AssignFromBitmap(TBitmap(TPicture(Source).Graphic))
            else
            begin
              // icons, metafiles etc...
              SetSize(TPicture(Source).Graphic.Width, TPicture(Source).Graphic.Height);
              if Empty then Exit;
              Canvas := TCanvas.Create;
              try
                Canvas.Handle := FDC;
                TGraphicAccess(Graphic).Draw(Canvas, Rect(0, 0, Width, Height));
                SetAlpha(255);
              finally
                Canvas.Free;
              end;
            end;
          end;
        end
        else  { inherited }
          inherited;
end;

procedure TTeBitmap.SetSize(AWidth, AHeight: Integer);
begin
  AWidth := Abs(AWidth);
  AHeight := Abs(AHeight);
  if (AWidth = 0) or (AHeight = 0) then Exit;
  if (AWidth = Width) and (AHeight = Height) then Exit;

  try
    if Assigned(FOnBeforeChange) then FOnBeforeChange(Self);
    
    { Free resource }
    if FDC <> 0 then DeleteDC(FDC);
    FDC := 0;
    if FHandle <> 0 then DeleteObject(FHandle);
    FHandle := 0;
    FBits := nil;
    FWidth := 0;
    FHeight := 0;

    { Initialization }
    with FBitmapInfo.bmiHeader do
    begin
      biWidth := AWidth;
      biHeight := -AHeight;
    end;

    { Create new DIB }
    FHandle := CreateDIBSection(0, FBitmapInfo, DIB_RGB_COLORS, Pointer(FBits), 0, 0);
    if FBits = nil then
      raise Exception.Create('Can''t allocate the DIB handle');

    FDC := CreateCompatibleDC(0);
    if FDC = 0 then
    begin
      DeleteObject(FHandle);
      FHandle := 0;
      FBits := nil;
      raise Exception.Create('Can''t create compatible DC');
    end;

    if SelectObject(FDC, FHandle) = 0 then
    begin
      DeleteDC(FDC);
      DeleteObject(FHandle);
      FDC := 0;
      FHandle := 0;
      FBits := nil;
      raise Exception.Create('Can''t select an object into DC');
    end;

    FWidth := AWidth;
    FHeight := AHeight;
  finally
    Changed;
  end;
end;

function TTeBitmap.Empty: Boolean;
begin
  Result := FHandle = 0;
end;

procedure TTeBitmap.Clear(Color: TKColor);
begin
  FillLongword(FBits^, FWidth * FHeight, Color);
end;

const

  Quantity = 6; 

procedure TTeBitmap.PerformTransparent(Color: TKColor);
var
  i: integer;
  C: PKColor;
begin
  C := @FBits[0];
  for i := 0 to FWidth * FHeight - 1 do
  begin
    if (Abs(TKColorRec(C^).R - TKColorRec(Color).R) < Quantity) and
       (Abs(TKColorRec(C^).G - TKColorRec(Color).G) < Quantity) and
       (Abs(TKColorRec(C^).B - TKColorRec(Color).B) < Quantity)
    then
      C^ := ckTransparent;

    Inc(C);
  end;
end;

procedure TTeBitmap.PerformTransparentRect(Color: TKColor; ARect: TRect);
var
  i, j: integer;
  C: PKColor;
begin
  for i := ARect.Left to ARect.Right - 1 do
    for j := ARect.Top to ARect.Bottom - 1 do
    begin
      C := @FBits[i + j * FWidth];
      if (Abs(TKColorRec(C^).R - TKColorRec(Color).R) < Quantity) and
         (Abs(TKColorRec(C^).G - TKColorRec(Color).G) < Quantity) and
         (Abs(TKColorRec(C^).B - TKColorRec(Color).B) < Quantity)
      then
        C^ := ckTransparent;
    end;
end;

procedure TTeBitmap.Changed;
begin
  if Assigned(FOnChanged) then
    FOnChanged(Self);
end;

procedure TTeBitmap.ChangeBitmapHue(DeltaHue: integer);
var
  i: integer;
  Color: PKColor;
begin
  if FWidth * FHeight = 0 then Exit;

  for i := 0 to FWidth * FHeight - 1 do
  begin
    Color := @Bits[i];

    if (TKColorRec(Color^).A = 0) then Continue;

    Color^ := ChangeHue(Color^, DeltaHue);
  end;
end;

procedure TTeBitmap.ChangeBitmapBrightness(DeltaBrightness: integer);
var
  i: integer;
  Color: PKColor;
begin
  if FWidth * FHeight = 0 then Exit;

  for i := 0 to FWidth * FHeight - 1 do
  begin
    Color := @Bits[i];

    if (TKColorRec(Color^).A = 0) then Continue;

    Color^ := ChangeBrightness(Color^, DeltaBrightness);
  end;
end;

