  ksthemeedits in 'ksthemeedits.pas',
  ksthemegrids in 'ksthemegrids.pas',
  ksthemegroupboxs in 'ksthemegroupboxs.pas',
  ksthemeheader in 'ksthemeheader.pas',
  ksthemehints in 'ksthemehints.pas',
  ksthemeinplaceedit in 'ksthemeinplaceedit.pas',
  ksthemelabels in 'ksthemelabels.pas',
  ksthememessages in 'ksthememessages.pas',
  ksthemepanels in 'ksthemepanels.pas',
  ksthemeprogress in 'ksthemeprogress.pas',
  ksthemereg in 'ksthemereg.pas',
  ksthemespeedbuttons in 'ksthemespeedbuttons.pas',
  ksthemespinbuttons in 'ksthemespinbuttons.pas',
  ksthemespinedit in 'ksthemespinedit.pas',
  ksthemesplitter in 'ksthemesplitter.pas',
  ksthemestatusbar in 'ksthemestatusbar.pas',
  ksthemestdcontrol in 'ksthemestdcontrol.pas',
  ksthemetabs in 'ksthemetabs.pas',
  ksthemetoolbars in 'ksthemetoolbars.pas',
  ksthemetrackbars in 'ksthemetrackbars.pas',
  te_convert in 'te_convert.pas',
  te_designer in 'te_designer.pas',
