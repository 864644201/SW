<Window x:Class="McBom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="麦豆宝 - BOM明细表" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA">

    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D0D0D0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#B8B8B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <ToolBarTray DockPanel.Dock="Top" Background="#F0F0F0">
            <ToolBar Band="0" BandIndex="0">
                <Button Content="打开装配体" Style="{StaticResource ToolbarButton}"
                        Click="BtnOpenAssembly_Click" ToolTip="打开SolidWorks装配体文件"/>
                <Separator/>
                <Button Content="刷新BOM" Style="{StaticResource ToolbarButton}"
                        Click="BtnRefresh_Click" ToolTip="重新提取BOM数据"/>
                <Separator/>
                <Button Content="导出Excel" Style="{StaticResource ToolbarButton}"
                        Click="BtnExportExcel_Click" ToolTip="导出为Excel文件"/>
                <Button Content="导出PDF" Style="{StaticResource ToolbarButton}"
                        Click="BtnExportPdf_Click" ToolTip="导出为PDF文件"/>
                <Separator/>
                <Button Content="截图" Style="{StaticResource ToolbarButton}"
                        Click="BtnScreenshot_Click" ToolTip="截取当前视图"/>
                <Button Content="设置" Style="{StaticResource ToolbarButton}"
                        Click="BtnSettings_Click" ToolTip="BOM配置设置"/>
            </ToolBar>
        </ToolBarTray>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="#E0E0E0">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="就绪"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="txtItemCount" Text="共 0 项"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Search Bar -->
        <DockPanel DockPanel.Dock="Top" Margin="5,3">
            <TextBlock Text="搜索:" VerticalAlignment="Center" Margin="5,0"/>
            <TextBox x:Name="txtSearch" Width="250" VerticalAlignment="Center"
                     TextChanged="TxtSearch_TextChanged" Margin="5,0"/>
            <TextBlock Text="过滤:" VerticalAlignment="Center" Margin="15,0,5,0"/>
            <ComboBox x:Name="cmbFilter" Width="120" VerticalAlignment="Center"
                      SelectionChanged="CmbFilter_SelectionChanged" Margin="5,0">
                <ComboBoxItem Content="全部" IsSelected="True"/>
                <ComboBoxItem Content="仅零件"/>
                <ComboBoxItem Content="仅装配体"/>
                <ComboBoxItem Content="仅隐藏项"/>
            </ComboBox>
            <TextBlock Text="分组:" VerticalAlignment="Center" Margin="15,0,5,0"/>
            <ComboBox x:Name="cmbGroup" Width="120" VerticalAlignment="Center"
                      SelectionChanged="CmbGroup_SelectionChanged" Margin="5,0">
                <ComboBoxItem Content="不分组" IsSelected="True"/>
                <ComboBoxItem Content="按材料"/>
                <ComboBoxItem Content="按层级"/>
            </ComboBox>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="260" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- Assembly Tree -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="装配体结构" FontSize="14" FontWeight="Bold"
                           Margin="8,5" Foreground="#333"/>
                <TreeView x:Name="treeAssembly" Margin="5"
                          SelectedItemChanged="TreeAssembly_SelectedItemChanged"
                          BorderBrush="#CCCCCC" Background="White">
                    <TreeView.Resources>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="True"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="2"/>
                        </Style>
                    </TreeView.Resources>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="#E0E0E0" VerticalAlignment="Stretch"/>

            <!-- BOM Data Grid -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="BOM明细" FontSize="14" FontWeight="Bold"
                           Margin="8,5" Foreground="#333"/>
                <DataGrid x:Name="dgBom" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserSortColumns="True"
                          CanUserReorderColumns="True" SelectionMode="Extended"
                          AlternatingRowBackground="#F8F8F8"
                          GridLinesVisibility="Horizontal"
                          BorderBrush="#CCCCCC" Background="White"
                          SelectionChanged="DgBom_SelectionChanged"
                          Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="序号" Binding="{Binding ID}" Width="60"/>
                        <DataGridTextColumn Header="零件号" Binding="{Binding PartNo}" Width="130"/>
                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="150"/>
                        <DataGridTextColumn Header="材料" Binding="{Binding Material}" Width="100"/>
                        <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="60"/>
                        <DataGridTextColumn Header="单重(kg)" Binding="{Binding UnitWeight, StringFormat=F3}" Width="80"/>
                        <DataGridTextColumn Header="总重(kg)" Binding="{Binding TotalWeight, StringFormat=F3}" Width="80"/>
                        <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
                          Background="#E0E0E0" VerticalAlignment="Stretch"/>

            <!-- Property Panel -->
            <DockPanel Grid.Column="4">
                <TextBlock DockPanel.Dock="Top" Text="属性详情" FontSize="14" FontWeight="Bold"
                           Margin="8,5" Foreground="#333"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="5">
                    <StackPanel x:Name="panelProperties">
                        <TextBlock Text="请选择BOM项目查看属性" Foreground="#999"
                                   Margin="10" FontSize="13"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
