<Window x:Class="MaidouBao.Launcher.BookReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="书籍阅读器" Height="750" Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="#FFF0F0F0"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 主内容区 -->
        <DockPanel>
            <!-- 工具栏 -->
            <Border DockPanel.Dock="Top" Background="#FF2D5F8A" Padding="12,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="titleText" Text="书籍阅读器" FontSize="16" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="filePathText" FontSize="11" Foreground="#FFB0C4DE" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0">
                        <Button Content="笔记" Click="BtnToggleNotes_Click" Padding="12,4" Margin="20,0,0,0" x:Name="btnToggleNotes"/>
                        <Button Content="外部打开" Click="BtnOpenExternal_Click" Padding="12,4" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 阅读内容 -->
            <Grid x:Name="contentArea">
                <!-- PDF 用 WebBrowser -->
                <WebBrowser x:Name="pdfViewer" Visibility="Collapsed"/>
                <!-- TXT 用 TextBox -->
                <ScrollViewer x:Name="txtScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="txtViewer" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                             FontFamily="Consolas" FontSize="14" Padding="16" Background="White"
                             BorderThickness="0"/>
                </ScrollViewer>
                <!-- 不支持的格式 -->
                <StackPanel x:Name="unsupportedPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="该格式暂不支持内置阅读" FontSize="16" Foreground="#FF888888" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="unsupportedExt" FontSize="13" Foreground="#FFAAAAAA" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <Button Content="用外部程序打开" Click="BtnOpenExternal_Click" Padding="16,6" Margin="0,16,0,0"/>
                </StackPanel>
            </Grid>
        </DockPanel>

        <!-- 分隔线 -->
        <GridSplitter Grid.Column="1" Width="3" Background="#FFD0D0D0" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

        <!-- 笔记面板 -->
        <Border x:Name="notesPanel" Grid.Column="2" Width="320" Background="#FFFAFAFA" BorderBrush="#FFE0E0E0" BorderThickness="1,0,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#FFF0F4F8" Padding="10,8" BorderBrush="#FFE0E5EA" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="我的笔记" FontSize="14" FontWeight="Bold" Foreground="#FF2D5F8A" VerticalAlignment="Center"/>
                        <TextBlock x:Name="noteStatus" Text="" FontSize="11" Foreground="#FF888888" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                </Border>
                <DockPanel DockPanel.Dock="Bottom" Margin="10,8">
                    <Button DockPanel.Dock="Right" Content="保存" Click="BtnSaveNote_Click" Padding="16,4" x:Name="btnSaveNote"/>
                    <TextBlock x:Name="noteSavedHint" Text="关闭窗口时自动保存" FontSize="11" Foreground="#FFAAAAAA" VerticalAlignment="Center" Margin="0,0,10,0"/>
                </DockPanel>
                <TextBox x:Name="noteTextBox" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Padding="10"
                         FontSize="13" FontFamily="Microsoft YaHei"
                         TextChanged="NoteTextBox_TextChanged"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
