<Window x:Class="MaidouBao.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="麦豆宝工具集" Height="820" Width="1280"
        MinHeight="720" MinWidth="1060"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="#FFF5F7FA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFFFFFFF" BorderBrush="#FFE0E6EE" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="麦豆宝工具集" FontSize="26" Foreground="#FF172033" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Border Background="#FFEAF3FC" CornerRadius="6" Padding="8,3" Margin="12,2,0,0">
                            <TextBlock Text="v3.0" FontSize="12" Foreground="#FF2D6EA8" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="机械设计、资料、表格和外部工具的本地工作台"
                               FontSize="12" Foreground="#FF64748B" Margin="0,5,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="本地工具中心" VerticalAlignment="Center"
                           Foreground="#FF64748B" FontSize="13"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#FFF9FBFD" BorderBrush="#FFE0E6EE" BorderThickness="0,0,0,1">
            <Grid Margin="24,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="moduleSearchBox" Height="38" VerticalContentAlignment="Center"
                         Padding="12,0" FontSize="13"
                         TextChanged="ModuleSearchBox_TextChanged"
                         ToolTip="搜索模块、资料、手册或外部工具"/>
                <Button Grid.Column="1" Content="刷新模块" Click="BtnRefreshModules_Click"
                        Margin="12,0,0,0" Padding="16,7"/>
                <TextBlock x:Name="moduleSummaryText" Grid.Column="2" Margin="16,0,0,0"
                           VerticalAlignment="Center" FontSize="12" Foreground="#FF64748B"/>
            </Grid>
        </Border>

        <!-- 搜索结果视图（搜索时显示，隐藏 TabControl） -->
        <ScrollViewer Grid.Row="2" Margin="16" VerticalScrollBarVisibility="Auto" x:Name="searchResultScroll" Visibility="Collapsed">
            <StackPanel x:Name="searchResultPanel" Margin="2"/>
        </ScrollViewer>

        <!-- Tab Control for Categories -->
        <TabControl Grid.Row="2" Margin="16" x:Name="tabControl">
            <!-- 设计工具 -->
            <TabItem Header="设计工具">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FFFFFFFF" Padding="16,12" BorderBrush="#FFE0E6EE" BorderThickness="0,0,0,1">
                        <TextBlock Text="自研设计工具，覆盖传动、轴系、型材和强度校核。支持直接搜索模块名称。" Foreground="#FF64748B" TextWrapping="Wrap"/>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="designToolsPanel" Margin="12"/>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- 表格工具大全 -->
            <TabItem Header="表格工具大全">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FFFFFFFF" Padding="16,12" BorderBrush="#FFE0E6EE" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="自动扫描 tables 目录下的 Excel 文件，点击直接打开。" Foreground="#FF64748B" VerticalAlignment="Center"/>
                            <Button Content="刷新" Click="BtnRefreshTableTools_Click" Padding="12,4" Margin="16,0,0,0"/>
                            <TextBlock x:Name="tableToolsHint" Text="将 xlsx/xls 放入 tables 文件夹可自动显示" VerticalAlignment="Center" FontSize="11" Foreground="#FF8492A6" Margin="16,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="tableToolsPanel" Margin="12"/>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- 书籍资料 -->
            <TabItem Header="书籍资料">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FFFFFFFF" Padding="16,12" BorderBrush="#FFE0E6EE" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="自动扫描 books 目录下的文档文件，点击直接打开。支持 PDF/CHM/EPUB/TXT/DOC 等格式。" Foreground="#FF64748B" VerticalAlignment="Center"/>
                            <Button Content="刷新" Click="BtnRefreshBooks_Click" Padding="12,4" Margin="16,0,0,0"/>
                            <TextBlock x:Name="booksHint" Text="将书籍文件放入 books 文件夹可自动显示" VerticalAlignment="Center" FontSize="11" Foreground="#FF8492A6" Margin="16,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Top" Padding="12,8" BorderBrush="#FFE0E6EE" BorderThickness="0,0,0,1" Background="#FFF9FBFD">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="分类:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#FF475569" Margin="0,0,8,0"/>
                            <WrapPanel x:Name="bookCategoryBar"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="booksPanel" Margin="12"/>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- 机械设计手册 -->
            <TabItem Header="机械设计手册">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FFFFFFFF" Padding="16,12" BorderBrush="#FFE0E6EE" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="经典机械设计手册工具，来源于迈迪设计宝 v1 版本。涵盖传动、轴系、公差、连接等设计计算。" Foreground="#FF64748B" VerticalAlignment="Center"/>
                            <Button Content="刷新" Click="BtnRefreshManualTools_Click" Padding="12,4" Margin="16,0,0,0"/>
                            <TextBlock x:Name="manualToolsHint" Text="" VerticalAlignment="Center" FontSize="11" Foreground="#FF8492A6" Margin="16,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="manualToolsPanel" Margin="12"/>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- 大国工匠 -->
            <TabItem Header="大国工匠">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#FFFFFFFF" BorderBrush="#FFE0E6EE" BorderThickness="0,0,0,1" Padding="12,10">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="添加程序" Click="BtnAddCustomTool_Click" Padding="12,4" Margin="0,0,8,0"/>
                        <Button Content="删除选中" Click="BtnRemoveCustomTool_Click" Padding="12,4" Margin="0,0,8,0"/>
                        <Button Content="刷新" Click="BtnRefreshCustomTools_Click" Padding="12,4" Margin="0,0,16,0"/>
                        <RadioButton x:Name="radGridView" Content="图标" IsChecked="True" Checked="ViewMode_Changed" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <RadioButton x:Name="radListView" Content="列表" Checked="ViewMode_Changed" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock x:Name="customToolsHint" Text="将exe放入 tools 文件夹可自动显示" VerticalAlignment="Center" FontSize="11" Foreground="#FF8492A6"/>
                    </StackPanel>
                    </Border>
                    <!-- 图标视图 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" x:Name="gridViewScroll">
                        <WrapPanel x:Name="customToolsPanel" Margin="12"/>
                    </ScrollViewer>
                    <!-- 列表视图 -->
                    <ListView x:Name="customToolsListView" Grid.Row="1" Margin="10" Visibility="Collapsed"
                              MouseDoubleClick="CustomToolsListView_DoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="名称" Width="200" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="路径" Width="500" DisplayMemberBinding="{Binding ExePath}"/>
                                <GridViewColumn Header="来源" Width="80" DisplayMemberBinding="{Binding Source}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#FFFFFFFF" BorderBrush="#FFE0E6EE" BorderThickness="0,1,0,0">
            <TextBlock x:Name="statusText" Text="就绪" Margin="10,0" VerticalAlignment="Center"
                       FontSize="11" Foreground="#FF64748B"/>
        </Border>
    </Grid>
</Window>
